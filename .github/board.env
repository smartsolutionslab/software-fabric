# Board settings for .github/scripts/board (board protocol, docs/adr). A non-empty environment variable of the same name wins.
# The GitHub Project that holds Status and Executor; leave empty to run on labels and comments only.
BOARD_PROJECT_OWNER=
BOARD_PROJECT_NUMBER=
# Hours without a push after which a claim lapses.
BOARD_LEASE_HOURS=2
# Who reviews a pull request whose commits name no executor (a developer's): claude or codex.
BOARD_DEFAULT_REVIEWER=claude
