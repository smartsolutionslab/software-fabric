{{~ func guard_exception(bcl)
  if project["backend.guards"] == "ensure-that"
    ret "GuardException"
  end
  ret bcl
end ~}}
using {{ namespace }}.Modules.{{ module.namespace }}.Domain.Samples;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Tests.Samples;

public class SampleNameTests
{
    {{ test_attribute }}
    public void A_name_holds_its_value()
    {
        var name = SampleName.From("Ada");

        {{ `name.Value` | should_be `"Ada"` }};
        {{ `name.ToString()` | should_be `"Ada"` }};
        {{ `name` | should_be `SampleName.From("Ada")` }};
    }

    {{ test_cases_attribute }}
    {{ test_case_attribute `""` }}
    {{ test_case_attribute `"   "` }}
    public void A_blank_name_is_refused(string value) =>
        {{ should_throw (guard_exception "ArgumentException") `() => SampleName.From(value)` }};

    {{ test_attribute }}
    public void A_name_longer_than_the_maximum_is_refused() =>
        {{ should_throw (guard_exception "ArgumentOutOfRangeException") `() => SampleName.From(new string('a', SampleName.MaxLength + 1))` }};
}
