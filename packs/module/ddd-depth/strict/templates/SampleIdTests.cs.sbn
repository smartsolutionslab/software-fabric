{{~ func guard_exception(bcl)
  if project["backend.guards"] == "ensure-that"
    ret "GuardException"
  end
  ret bcl
end ~}}
using {{ namespace }}.Modules.{{ module.namespace }}.Domain.Samples;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Tests.Samples;

public class SampleIdTests
{
    {{ test_attribute }}
    public void A_new_identifier_is_a_version_7_guid() =>
        {{ `SampleId.New().Value.Version` | should_be `7` }};

    {{ test_attribute }}
    public void An_identifier_comes_back_from_its_value()
    {
        var identifier = SampleId.New();

        {{ `SampleId.From(identifier.Value)` | should_be `identifier` }};
        {{ `identifier.ToString()` | should_be `identifier.Value.ToString()` }};
    }

    {{ test_attribute }}
    public void An_empty_guid_is_not_an_identifier() =>
        {{ should_throw (guard_exception "ArgumentException") `() => SampleId.From(Guid.Empty)` }};
}
