{{~ if module.values["module.style"] == "event-sourced" ~}}
using {{ namespace }}.BuildingBlocks.EventSourcing;

{{~ end ~}}
namespace {{ namespace }}.Modules.{{ module.namespace }}.Domain.Samples;

/// <summary>
/// The shape of an identifier in a strict module, emitted by fabric add-module: rename it after your aggregate
/// (<c>InvoiceId</c>) or delete it. A new one is a time-ordered Guid v7; an empty Guid is never one.
/// </summary>
public sealed record SampleId : IValueObject<Guid>{{ if module.values["module.style"] == "event-sourced" }}, IAggregateId{{ end }}
{
    private SampleId(Guid value) => Value = value;

    public Guid Value { get; }

    public static SampleId New() => new(Guid.CreateVersion7());

    public static SampleId From(Guid value)
    {
{{~ if project["backend.guards"] == "ensure-that" ~}}
        Ensure.That(value).IsNotEmpty();
{{~ else ~}}
        if (value == Guid.Empty)
        {
            throw new ArgumentException("An identifier is never an empty Guid.", nameof(value));
        }
{{~ end ~}}
        return new SampleId(value);
    }

    public override string ToString() => Value.ToString();
}
