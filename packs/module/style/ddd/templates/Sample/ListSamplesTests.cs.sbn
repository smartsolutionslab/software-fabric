using {{ namespace }}.Modules.{{ module.namespace }}.Application.Commands.CreateSample;
using {{ namespace }}.Modules.{{ module.namespace }}.Application.Queries.ListSamples;
using {{ namespace }}.Modules.{{ module.namespace }}.Domain.Samples;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Tests.Samples;

public class ListSamplesTests
{
    {{ test_attribute }}
    public async Task Samples_are_listed_by_name_a_page_at_a_time_with_how_many_there_are()
    {
        var store = new InMemorySampleStore();
        foreach (var name in new[] { "Cleo", "Ada", "Bea" })
        {
            await new CreateSampleHandler(store, store).HandleAsync(new CreateSample(SampleName.From(name)), {{ test_cancellation_token }});
        }

        var page = await new ListSamplesHandler(store).HandleAsync(new ListSamples(PageOf(2), PageSizeOf(2)), {{ test_cancellation_token }});

        {{ should_be ((should_have_single_item `page.Value.Items`) + ".Name") `"Cleo"` }};
        {{ `page.Value.TotalCount` | should_be `3` }};
        {{ `page.Value.Page` | should_be `2` }};
        {{ `page.Value.PageSize` | should_be `2` }};
    }

    {{ test_attribute }}
    public async Task Without_samples_the_first_page_is_empty()
    {
        var page = await new ListSamplesHandler(new InMemorySampleStore()).HandleAsync(new ListSamples(Page.First, PageSize.Default), {{ test_cancellation_token }});

        {{ `page.Value.Items` | should_be_empty }};
        {{ `page.Value.TotalCount` | should_be `0` }};
    }

    private static Page PageOf(int value) =>
        Page.TryFrom(value, out var page) ? page : throw new InvalidOperationException($"{value} is not a page.");

    private static PageSize PageSizeOf(int value) =>
        PageSize.TryFrom(value, out var pageSize) ? pageSize : throw new InvalidOperationException($"{value} is not a page size.");
}
