{{~ typed = project["backend.result-style"] == "typed-outcomes" ~}}
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.{{ module.namespace }}.Application.DTOs;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Application.Queries.ListSamples;

public sealed class ListSamplesHandler(ISampleStore samples)
    : IQueryHandler<ListSamples, Result<PagedResult<{{ module.namespace }}SampleDto>, ApiError>>
{
    public async Task<Result<PagedResult<{{ module.namespace }}SampleDto>, ApiError>> HandleAsync(ListSamples query, CancellationToken cancellationToken)
    {
        {{ not_null "query" }}

        var page = await samples.ListAsync(query.Page, query.PageSize, cancellationToken);
        var dtos = new PagedResult<{{ module.namespace }}SampleDto>([.. page.Items.Select(sample => sample.ToDto())], page.TotalCount, page.Page, page.PageSize);
        return {{ if typed }}Success(dtos){{ else }}Result<PagedResult<{{ module.namespace }}SampleDto>, ApiError>.Success(dtos){{ end }};
    }
}
