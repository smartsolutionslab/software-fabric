namespace {{ namespace }}.BuildingBlocks.DomainEvents;

/// <summary>A domain-event reaction failed. The changes that raised the event are committed; the message names the reaction.</summary>
public sealed class DomainEventDispatchException : Exception
{
    public DomainEventDispatchException()
    {
    }

    public DomainEventDispatchException(string message)
        : base(message)
    {
    }

    public DomainEventDispatchException(string message, Exception innerException)
        : base(message, innerException)
    {
    }
}
