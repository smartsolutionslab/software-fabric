{{~ typed = project["backend.result-style"] == "typed-outcomes" ~}}
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.{{ module.namespace }}.Domain.Samples;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Application.Commands.CreateSample;

public sealed class CreateSampleHandler(ISampleStore samples, I{{ module.namespace }}UnitOfWork unitOfWork)
    : ICommandHandler<CreateSample, Result<Guid, ApiError>>
{
    public async Task<Result<Guid, ApiError>> HandleAsync(CreateSample command, CancellationToken cancellationToken)
    {
        {{ not_null "command" }}

        if (string.IsNullOrWhiteSpace(command.Name) || command.Name.Length > Sample.MaxNameLength)
        {
            return {{ if typed }}Failure(SampleFailures.InvalidName()){{ else }}Result<Guid, ApiError>.Failure(SampleFailures.InvalidName()){{ end }};
        }

        var sample = new Sample { Id = Guid.CreateVersion7(), Name = command.Name };
        samples.Add(sample);
        await unitOfWork.CommitAsync(cancellationToken);
        return {{ if typed }}Success(sample.Id){{ else }}Result<Guid, ApiError>.Success(sample.Id){{ end }};
    }
}
