using System.Reflection;

namespace {{ namespace }}.Architecture.Tests.Rules;

public sealed class QueriesReadOnlyReadModels : IArchitectureRule
{
    // By name: the rule needs no reference to what it keeps queries away from.
    private static readonly string[] WriteSide =
    [
        "{{ namespace }}.BuildingBlocks.EventSourcing.IAggregateStore",
        "{{ namespace }}.BuildingBlocks.EventSourcing.IEventSourced",
        "Microsoft.EntityFrameworkCore.DbContext",
    ];

    private const string ReadModels = "{{ namespace }}.BuildingBlocks.ReadModels.IReadModels";

    public string Description => "Nothing in a Queries namespace of a physical-CQRS module depends on the write side (aggregate stores, aggregates, DbContexts); queries read read models.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        // module.cqrs is per module: only modules with a read side (I<Module>ReadModels) chose physical CQRS.
        var physical = model.ModuleAssemblies
            .Where(assembly => assembly.GetTypes().Any(type => type.IsInterface && type.GetInterfaces().Any(contract => contract.FullName == ReadModels)))
            .Select(ModuleOf)
            .ToHashSet(StringComparer.Ordinal);

        var queries = model.ModuleAssemblies
            .Where(assembly => physical.Contains(ModuleOf(assembly)))
            .SelectMany(assembly => assembly.GetTypes())
            .Where(type => type.Namespace?.Contains(".Queries", StringComparison.Ordinal) == true);

        foreach (var type in queries)
        {
            // Whatever reaches the type: constructor and method parameters (a handler's Handle may be static) and fields.
            var dependencies = type.GetConstructors(BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance)
                .SelectMany(constructor => constructor.GetParameters().Select(parameter => parameter.ParameterType))
                .Concat(type.GetMethods(BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly)
                    .SelectMany(method => method.GetParameters().Select(parameter => parameter.ParameterType)))
                .Concat(type.GetFields(BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static).Select(field => field.FieldType))
                .Distinct();

            foreach (var dependency in dependencies.Where(IsWriteSide))
            {
                yield return $"{type.FullName} reads the write side ({dependency.Name}); a query reads read models through I<Module>ReadModels.";
            }
        }
    }

    /// <summary><c>{{ namespace }}.Modules.Billing.Application</c> belongs to module <c>{{ namespace }}.Modules.Billing</c>.</summary>
    private static string ModuleOf(Assembly assembly)
    {
        var name = assembly.GetName().Name!;
        return name[..name.LastIndexOf('.')];
    }

    private static bool IsWriteSide(Type type)
    {
        for (var current = type; current is not null; current = current.BaseType)
        {
            if (WriteSide.Contains(current.FullName) || current.GetInterfaces().Any(contract => WriteSide.Contains(contract.FullName)))
            {
                return true;
            }
        }

        return false;
    }
}
