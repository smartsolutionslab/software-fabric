using System.Reflection;
using System.Reflection.Emit;

namespace {{ namespace }}.Architecture.Tests.Rules;

public sealed class {{ module.namespace }}HandlersBuildNoDtos : IArchitectureRule
{
    private const string Module = "{{ namespace }}.Modules.{{ module.namespace }}.";

    private const BindingFlags Declared = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly;

    private static readonly string[] Handlers = ["IQueryHandler`2", "ICommandHandler`2"];

    private static readonly Dictionary<short, OpCode> OpCodesByValue = typeof(OpCodes)
        .GetFields(BindingFlags.Public | BindingFlags.Static)
        .Select(field => (OpCode)field.GetValue(null)!)
        .ToDictionary(code => code.Value);

    public string Description => "No handler in the {{ module.namespace }} module builds a *Dto itself, in a lambda or in a helper of its own; a model becomes a DTO through the To<Name>Dto() extensions of its <Model>Mappings class.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        var handlers = model.ModuleAssemblies
            .Where(assembly => assembly.GetName().Name!.StartsWith(Module, StringComparison.Ordinal))
            .SelectMany(assembly => assembly.GetTypes())
            .Where(type => !type.IsInterface && type.GetInterfaces().Any(contract => contract.IsGenericType && Handlers.Contains(contract.GetGenericTypeDefinition().Name)));

        foreach (var handler in handlers.OrderBy(type => type.FullName, StringComparer.Ordinal))
        {
            foreach (var dto in BuiltDtos(handler).Select(Name).Distinct().Order(StringComparer.Ordinal))
            {
                yield return $"{handler.FullName} builds {dto} itself; map it with To{dto}() from its <Model>Mappings class instead.";
            }
        }
    }

    /// <summary>
    /// The *Dto types whose constructors the handler's code calls or hands to an expression tree, including the code the
    /// compiler moves into nested types: lambdas, closures and async state machines.
    /// </summary>
    private static IEnumerable<Type> BuiltDtos(Type handler) =>
        WithNested(handler)
            .SelectMany(type => type.GetMethods(Declared).Cast<MethodBase>().Concat(type.GetConstructors(Declared)))
            .SelectMany(ConstructorsUsed)
            .Select(constructor => constructor.DeclaringType!)
            .Where(type => Name(type).EndsWith("Dto", StringComparison.Ordinal));

    /// <summary>PageDto rather than PageDto`1.</summary>
    private static string Name(Type type) => type.Name.Split('`')[0];

    private static IEnumerable<Type> WithNested(Type type) =>
        type.GetNestedTypes(BindingFlags.Public | BindingFlags.NonPublic).SelectMany(WithNested).Prepend(type);

    /// <summary>Constructors a method body names with newobj, call (a struct built in place) or ldtoken (an expression tree's New).</summary>
    private static IEnumerable<ConstructorInfo> ConstructorsUsed(MethodBase method)
    {
        var il = method.GetMethodBody()?.GetILAsByteArray() ?? [];
        var typeArguments = method.DeclaringType is { IsGenericType: true } declaring ? declaring.GetGenericArguments() : null;
        var methodArguments = method is MethodInfo { IsGenericMethod: true } ? method.GetGenericArguments() : null;

        var position = 0;
        while (position < il.Length)
        {
            var twoBytes = il[position] == 0xFE;
            var code = OpCodesByValue[twoBytes ? unchecked((short)(0xFE00 | il[position + 1])) : il[position]];
            position += twoBytes ? 2 : 1;

            if ((code == OpCodes.Newobj || code == OpCodes.Call || code == OpCodes.Ldtoken)
                && method.Module.ResolveMember(BitConverter.ToInt32(il, position), typeArguments, methodArguments) is ConstructorInfo constructor)
            {
                yield return constructor;
            }

            position += OperandSize(code, il, position);
        }
    }

    private static int OperandSize(OpCode code, byte[] il, int position) => code.OperandType switch
    {
        OperandType.InlineNone => 0,
        OperandType.ShortInlineBrTarget or OperandType.ShortInlineI or OperandType.ShortInlineVar => 1,
        OperandType.InlineVar => 2,
        OperandType.InlineI8 or OperandType.InlineR => 8,
        OperandType.InlineSwitch => 4 + (4 * BitConverter.ToInt32(il, position)),
        _ => 4,
    };
}
