{{~ if project["backend.tenancy"] != "none" ~}}
{{~ # Marten's streams are not separated by tenant yet; rendering them would leak (ADR-0006: fail loudly). ~}}
{{ marten_event_store_needs_backend_tenancy_none }}
{{~ end ~}}
using System.Text.RegularExpressions;
using {{ namespace }}.BuildingBlocks.EventSourcing;
using {{ namespace }}.BuildingBlocks.Modules;
using JasperFx;
using JasperFx.Events.Projections;
using Marten;
using Microsoft.Extensions.Configuration;

namespace Microsoft.Extensions.DependencyInjection;

public static partial class EventStoreRegistration
{
    private const string ConnectionStringName = "database";

    /// <summary>
    /// Gives the module its own Marten store, in its own schema of the project's database, when its Infrastructure
    /// project has adapters over one: classes whose constructor takes an <see cref="IDocumentStore"/>. Each adapter is
    /// registered as the module's Application interfaces it implements (I&lt;Module&gt;AggregateStore, ...). The store
    /// knows the module's domain events and runs the projections of its Infrastructure project inline.
    /// </summary>
    public static IServiceCollection AddModuleEventStore<TModule>(this IServiceCollection services, IConfiguration configuration)
        where TModule : IModule
    {
        {{ not_null "configuration" }}

        var infrastructure = ModuleAssemblies.Of<TModule>("Infrastructure");
        var adapters = infrastructure.GetTypes()
            .Where(type => type is { IsClass: true, IsAbstract: false }
                && type.GetConstructors().Any(constructor => constructor.GetParameters() is [{ ParameterType: var parameter }] && parameter == typeof(IDocumentStore)))
            .ToList();
        if (adapters.Count == 0)
        {
            return services;
        }

        var connectionString = configuration.GetConnectionString(ConnectionStringName)
            ?? throw new InvalidOperationException($"Connection string '{ConnectionStringName}' is missing; Aspire provides it.");
        var schema = SchemaOf(typeof(TModule));
        var domainEvents = ModuleAssemblies.Of<TModule>("Domain").GetTypes()
            .Where(type => type is { IsClass: true, IsAbstract: false } && typeof(IDomainEvent).IsAssignableFrom(type))
            .ToList();
        var projections = infrastructure.GetTypes()
            .Where(type => type is { IsClass: true, IsAbstract: false } && typeof(IProjectionSource<IDocumentOperations, IQuerySession>).IsAssignableFrom(type))
            .ToList();

        var key = typeof(TModule).FullName!;
        services.AddKeyedSingleton<IDocumentStore>(key, (_, _) => DocumentStore.For(options =>
        {
            options.Connection(connectionString);
            options.DatabaseSchemaName = schema;
            options.Events.DatabaseSchemaName = schema;
            options.UseSystemTextJsonForSerialization();
            // The store creates its tables on first use; see docs/adr for why this is not a migration yet.
            options.AutoCreateSchemaObjects = AutoCreate.CreateOrUpdate;
            options.Events.AddEventTypes(domainEvents);
            foreach (var projection in projections)
            {
                options.Projections.Add((IProjectionSource<IDocumentOperations, IQuerySession>)Activator.CreateInstance(projection)!, ProjectionLifecycle.Inline);
            }
        }));

        var application = ModuleAssemblies.Of<TModule>("Application");
        foreach (var adapter in adapters)
        {
            foreach (var contract in adapter.GetInterfaces().Where(contract => contract.Assembly == application))
            {
                services.AddScoped(contract, provider => ActivatorUtilities.CreateInstance(provider, adapter, provider.GetRequiredKeyedService<IDocumentStore>(key)));
            }
        }

        return services;
    }

    /// <summary>The module's schema, as its DbContext names it: BillingModule is billing, OrderHandlingModule order_handling.</summary>
    private static string SchemaOf(Type module) =>
        WordStart().Replace(module.Name[..^"Module".Length], "_$1").ToLowerInvariant();

    [GeneratedRegex("(?<!^)([A-Z])")]
    private static partial Regex WordStart();
}
