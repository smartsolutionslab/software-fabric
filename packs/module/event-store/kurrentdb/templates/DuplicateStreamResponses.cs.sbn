using KurrentDB.Client;
using Microsoft.AspNetCore.Diagnostics;
using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.Logging;

namespace Microsoft.Extensions.DependencyInjection;

public static partial class DuplicateStreamResponses
{
    /// <summary>
    /// A save that starts a stream another save has already started answers <c>409</c> problem details with the code
    /// <see cref="DuplicateStreamExceptionHandler.Code"/>; every other event store failure stays a <c>500</c>.
    /// </summary>
    public static IServiceCollection AddDuplicateStreamResponses(this IServiceCollection services) =>
        services.AddProblemDetails()
            .AddExceptionHandler<DuplicateStreamExceptionHandler>();

    /// <summary>
    /// The backstop for two creates of one aggregate id, the event store's counterpart of a unique index. Both can find
    /// no aggregate before either saves; KurrentDB then refuses the second append, which expected no stream
    /// (<see cref="WrongExpectedVersionException"/> with <see cref="StreamState.NoStream"/>), and this answers <c>409</c>
    /// instead of <c>500</c>.
    /// </summary>
    private sealed partial class DuplicateStreamExceptionHandler(IProblemDetailsService problemDetails, ILogger<DuplicateStreamExceptionHandler> logger) : IExceptionHandler
    {
        /// <summary>The <c>code</c> of every problem a duplicate stream answers, the one a unique index's refusal answers too.</summary>
        public const string Code = "already-exists";

        /// <summary>
        /// Only a stream that had to be new: an append that loses to another on a stream that exists (the same exception,
        /// expecting a revision) is a lost update, not a duplicate, and stays a <c>500</c>.
        /// </summary>
        public async ValueTask<bool> TryHandleAsync(HttpContext httpContext, Exception exception, CancellationToken cancellationToken)
        {
            {{ not_null "httpContext" }}

            if (exception is not WrongExpectedVersionException { ExpectedStreamState: var expected } || expected != StreamState.NoStream)
            {
                return false;
            }

            LogRefused(logger);

            httpContext.Response.StatusCode = StatusCodes.Status409Conflict;

            // Nothing from the exception reaches the caller: its message names the stream.
            await problemDetails.TryWriteAsync(new ProblemDetailsContext
            {
                HttpContext = httpContext,
                ProblemDetails =
                {
                    Status = StatusCodes.Status409Conflict,
                    Title = "Something with that name or key already exists.",
                    Detail = "Choose a different one; retrying this request unchanged is refused again.",
                    Extensions = { ["code"] = Code },
                },
            });

            return true;
        }

        [LoggerMessage(Level = LogLevel.Information, Message = "The event store refused a stream that already exists; answered 409")]
        private static partial void LogRefused(ILogger logger);
    }
}
