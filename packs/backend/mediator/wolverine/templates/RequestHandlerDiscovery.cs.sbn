using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.BuildingBlocks.Modules;
using Wolverine;

namespace Microsoft.Extensions.DependencyInjection;

public static class RequestHandlerDiscovery
{
    private static readonly Type[] HandlerDefinitions = [typeof(ICommandHandler<,>), typeof(IQueryHandler<,>)];

    /// <summary>
    /// Makes every command and query handler in the assemblies Wolverine searches a Wolverine handler, so IDispatcher
    /// invokes it on the bus. A handler that takes IDispatcher, to run an agent or a widget's query, gets it from the
    /// message's scope: Wolverine cannot build the dispatcher itself, since the dispatcher finds the bus through that scope.
    /// </summary>
    public static WolverineOptions DiscoverRequestHandlers(this WolverineOptions options)
    {
        {{ not_null "options" }}

        options.Discovery.CustomizeHandlerDiscovery(query => query.Includes.WithCondition("command and query handlers", IsRequestHandler));
        options.CodeGeneration.AlwaysUseServiceLocationFor<IDispatcher>();
        return options;
    }

    /// <summary>
    /// Gives a handler each module's own services from the message's scope: every interface a module's Application
    /// project declares and its Infrastructure project implements, its unit of work and aggregate store among them.
    /// Wolverine's generated code cannot build those itself (the unit of work takes the service provider, an event
    /// store's adapters are made by a factory), and taking them all from one scope keeps them on one DbContext.
    /// </summary>
    public static WolverineOptions ResolveModuleServicesFromScope(this WolverineOptions options, IEnumerable<IModule> modules)
    {
        {{ not_null "options" }}
        {{ not_null "modules" }}

        foreach (var service in modules.SelectMany(ModuleServices).Distinct())
        {
            options.CodeGeneration.AlwaysUseServiceLocationFor(service);
        }

        return options;
    }

    private static IEnumerable<Type> ModuleServices(IModule module)
    {
        var application = ModuleAssemblies.Of(module, "Application");
        return ModuleAssemblies.Of(module, "Infrastructure").GetTypes()
            .Where(type => type is { IsClass: true, IsAbstract: false })
            .SelectMany(type => type.GetInterfaces())
            .Where(contract => contract.Assembly == application);
    }

    private static bool IsRequestHandler(Type type) =>
        type is { IsClass: true, IsAbstract: false }
        && type.GetInterfaces().Any(contract => contract.IsGenericType && HandlerDefinitions.Contains(contract.GetGenericTypeDefinition()));
}
