using System.Text.RegularExpressions;

namespace {{ namespace }}.Kernel.Tests;

public partial class EnsureTests
{
    private static readonly Guid InvoiceIdentifier = new("0193a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b");

    {{ test_attribute }}
    public void A_string_that_meets_every_guard_passes_them_all() =>
        {{ should_not_throw `() => Ensure.That("INV-0001", "number")
    .IsNotNull()
    .IsNotNullOrWhiteSpace()
    .HasMinLength(3)
    .HasMaxLength(20)
    .StartsWith("INV-", StringComparison.Ordinal)
    .Matches(InvoiceNumber(), "must be INV- and digits")
    .Satisfies(text => text.Length == 8, "must be eight characters")` }};

    {{ test_attribute }}
    public void A_null_string_fails_its_null_guard() =>
        {{ should_throw `GuardException` `() => Ensure.That((string)null!, "number").IsNotNull()` }}
            {{ `.Message` | should_start_with `"number must not be null."` }};

    {{ test_attribute }}
    public void A_blank_string_fails_its_blank_guard() =>
        {{ should_throw `GuardException` `() => Ensure.That(" ", "number").IsNotNullOrWhiteSpace()` }}
            {{ `.Message` | should_start_with `"number must not be null or whitespace."` }};

    {{ test_attribute }}
    public void A_short_string_fails_its_minimum_length() =>
        {{ should_throw `GuardException` `() => Ensure.That("IN", "number").HasMinLength(3)` }}
            {{ `.Message` | should_start_with `"number must be at least 3 character(s)."` }};

    {{ test_attribute }}
    public void A_long_string_fails_its_maximum_length() =>
        {{ should_throw `GuardException` `() => Ensure.That("INV-0001", "number").HasMaxLength(4)` }}
            {{ `.Message` | should_start_with `"number must be no more than 4 character(s)."` }};

    {{ test_attribute }}
    public void A_string_without_the_prefix_fails_it() =>
        {{ should_throw `GuardException` `() => Ensure.That("ORD-1", "number").StartsWith("INV-", StringComparison.Ordinal)` }}
            {{ `.Message` | should_start_with `"number must start with 'INV-'."` }};

    {{ test_attribute }}
    public void A_string_that_does_not_match_fails_with_the_message_given() =>
        {{ should_throw `GuardException` `() => Ensure.That("INV-X", "number").Matches(InvoiceNumber(), "must be INV- and digits")` }}
            {{ `.Message` | should_start_with `"number: must be INV- and digits"` }};

    {{ test_attribute }}
    public void A_string_that_does_not_satisfy_the_predicate_fails_with_the_message_given() =>
        {{ should_throw `GuardException` `() => Ensure.That("INV-1", "number").Satisfies(text => text.Length == 8, "must be eight characters")` }}
            {{ `.Message` | should_start_with `"number: must be eight characters"` }};

    {{ test_attribute }}
    public void An_object_guard_names_the_argument_it_was_given()
    {
        object invoice = null!;

        {{ ((should_throw `GuardException` `() => Ensure.That(invoice).IsNotNull()`) + `.ParamName`) | should_be `"invoice"` }};
        {{ should_not_throw `() => Ensure.That(new object()).IsNotNull()` }};
    }

    {{ test_attribute }}
    public void An_empty_guid_fails_with_the_default_or_the_given_message()
    {
        {{ should_throw `GuardException` `() => Ensure.That(Guid.Empty).IsNotEmpty()` }}
            {{ `.Message` | should_start_with `"Guid.Empty must not be empty."` }};
        {{ should_throw `GuardException` `() => Ensure.That(Guid.Empty).IsNotEmpty("an invoice needs an identifier")` }}
            {{ `.Message` | should_start_with `"Guid.Empty: an invoice needs an identifier"` }};
        {{ should_not_throw `() => Ensure.That(InvoiceIdentifier).IsNotEmpty()` }};
    }

    {{ test_attribute }}
    public void A_number_inside_its_bounds_passes()
    {
        var quantity = 5;
        var amount = 9.5m;

        {{ should_not_throw `() => Ensure.That(quantity).AtLeast(1).InRange(1, 10).Satisfies(value => value % 5 == 0, "must be a multiple of five")` }};
        {{ should_not_throw `() => Ensure.That(amount).AtLeast(0m).InRange(0m, 10m)` }};
    }

    {{ test_attribute }}
    public void A_number_outside_its_bounds_fails_naming_the_bound_and_the_value()
    {
        var quantity = 0;

        {{ should_throw `GuardException` `() => Ensure.That(quantity).AtLeast(1)` }}
            {{ `.Message` | should_start_with `"quantity must be >= 1; got 0."` }};
        {{ should_throw `GuardException` `() => Ensure.That(quantity).InRange(1, 10)` }}
            {{ `.Message` | should_start_with `"quantity must be in [1, 10]; got 0."` }};
        {{ should_throw `GuardException` `() => Ensure.That(quantity + 11).InRange(1, 10)` }}
            {{ `.Message` | should_start_with `"quantity + 11 must be in [1, 10]; got 11."` }};
        {{ should_throw `GuardException` `() => Ensure.That(quantity).Satisfies(value => value > 0, "must be positive")` }}
            {{ `.Message` | should_start_with `"quantity: must be positive"` }};
    }

    {{ test_attribute }}
    public void A_guard_exception_is_an_argument_exception_that_keeps_what_it_is_given()
    {
        var inner = new InvalidOperationException("inner");

        {{ `new GuardException()` | should_be_assignable_to `ArgumentException` }};
        {{ `new GuardException("message").Message` | should_be `"message"` }};
        {{ `new GuardException("message", inner).InnerException` | should_be_same_as `inner` }};
        {{ `new GuardException("message", "number").ParamName` | should_be `"number"` }};
    }

    [GeneratedRegex("^INV-[0-9]+$")]
    private static partial Regex InvoiceNumber();
}
