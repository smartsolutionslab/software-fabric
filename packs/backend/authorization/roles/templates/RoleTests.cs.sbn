using System.Net;

namespace {{ namespace }}.Integration.Tests;

/// <summary>The {{ module.name }} module's sample policy {{ module.name }}.manage requires the realm role manager{{ if project["backend.authorization"] | array.contains "claims" }} (and the claim department=finance){{ end }}, which developer holds and visitor does not.</summary>
public class {{ module.namespace }}RoleTests(AspireFixture aspire)
{
    private static readonly Uri ManagePermission = new("/{{ module.name }}/permissions/manage", UriKind.Relative);

    {{ test_attribute }}
    public async Task A_user_with_the_manager_role_is_allowed()
    {
        using var client = await aspire.CreateHostClientAsync("developer");

        using var response = await client.GetAsync(ManagePermission, {{ test_cancellation_token }});

        {{ status "response" "OK" }}
    }

    {{ test_attribute }}
    public async Task A_signed_in_user_without_the_role_is_forbidden()
    {
        using var client = await aspire.CreateHostClientAsync("visitor");

        using var response = await client.GetAsync(ManagePermission, {{ test_cancellation_token }});

        {{ status "response" "Forbidden" }}
    }

    {{ test_attribute }}
    public async Task An_anonymous_caller_is_unauthorized()
    {
        using var client = aspire.CreateHostClient();

        using var response = await client.GetAsync(ManagePermission, {{ test_cancellation_token }});

        {{ status "response" "Unauthorized" }}
    }
}
