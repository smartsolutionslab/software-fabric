using Aspire.Hosting;
using Aspire.Hosting.ApplicationModel;
using Aspire.Hosting.Testing;
using Microsoft.Extensions.Configuration;

namespace {{ namespace }}.Mcp.Tests;

/// <summary>
/// The configuration the host receives for the MCP servers declared in the AppHost: the project's own AppHost model,
/// with the test's servers declared on its host the way AppHost.cs declares them. Nothing is started.
/// </summary>
internal static class DeclaredServers
{
    public static async Task<IConfiguration> HostConfigurationAsync(
        Action<IDistributedApplicationTestingBuilder, IResourceBuilder<ProjectResource>> declare,
        IReadOnlyDictionary<string, string> parameters,
        CancellationToken cancellationToken)
    {
        var builder = await DistributedApplicationTestingBuilder.CreateAsync<Projects.AppHost>(cancellationToken);
        foreach (var (name, value) in parameters)
        {
            builder.Configuration[$"Parameters:{name}"] = value;
        }

        var host = builder.CreateResourceBuilder(builder.Resources.OfType<ProjectResource>().Single(resource => resource.Name == "host"));
        declare(builder, host);

        // The host's environment as its declarations add it; only the MCP servers' values are resolved, because the
        // database's and the other resources' need a running application.
        Dictionary<string, object> environment = [];
        var context = new EnvironmentCallbackContext(builder.ExecutionContext, host.Resource, environment, cancellationToken);
        foreach (var callback in host.Resource.Annotations.OfType<EnvironmentCallbackAnnotation>())
        {
            await callback.Callback(context);
        }

        Dictionary<string, string?> configuration = [];
        foreach (var (variable, value) in environment.Where(entry => entry.Key.StartsWith("Mcp__", StringComparison.Ordinal)))
        {
            configuration[variable.Replace("__", ":", StringComparison.Ordinal)] = value switch
            {
                string text => text,
                IValueProvider provider => await provider.GetValueAsync(cancellationToken),
                _ => throw new InvalidOperationException($"{variable} is neither text nor a value Aspire resolves."),
            };
        }

        return new ConfigurationBuilder().AddInMemoryCollection(configuration).Build();
    }
}
