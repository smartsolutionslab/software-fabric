using Aspire.Hosting;
using Aspire.Hosting.ApplicationModel;
using Aspire.Hosting.Testing;
using {{ namespace }}.BuildingBlocks.Mcp;
using {{ namespace }}.Mcp.TestServer;
using Microsoft.AspNetCore.Builder;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Mcp.Tests;

/// <summary>
/// Servers declared in the AppHost, reached by the host's MCP clients: a tiny server each test starts itself, never a
/// real one. The token is a stand-in, not a credential.
/// </summary>
public sealed class McpClientTests
{
    private const string Token = "stand-in-token";
    private const string HostOnlyVariable = "MCP_TESTS_HOST_ONLY";

    {{ test_attribute }}
    public async Task A_server_declared_by_url_lists_its_tools_and_answers_a_call()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var server = await EchoServer.StartHttpAsync(Token, "echo", cancellationToken);
        await using var services = await HostServicesAsync(DeclareByUrl(withToken: true), UrlParameters(server), cancellationToken);
        var tools = services.GetRequiredService<IMcpTools>();

        var listed = await tools.ListAsync(cancellationToken);
        var result = await tools.CallAsync("echo-server", "echo", new Dictionary<string, object?> { ["text"] = "hello" }, cancellationToken);

        {{ `listed.Select(tool => $"{tool.Server}/{tool.Name}").Order(StringComparer.Ordinal)` | should_be `["echo-server/echo", "echo-server/sees"]` }};
        {{ `result.IsError` | should_be_false }};
        {{ `result.Text` | should_be `"echo: hello"` }};
    }

    {{ test_attribute }}
    public async Task A_server_declared_by_url_without_its_token_refuses_the_client()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var server = await EchoServer.StartHttpAsync(Token, "echo", cancellationToken);
        await using var services = await HostServicesAsync(DeclareByUrl(withToken: false), UrlParameters(server), cancellationToken);
        var tools = services.GetRequiredService<IMcpTools>();

        var refusal = await {{ should_throw_async `HttpRequestException` `() => tools.ListAsync(cancellationToken)` }};

        {{ `refusal.StatusCode` | should_be `System.Net.HttpStatusCode.Unauthorized` }};
    }

    {{ test_attribute }}
    public async Task A_server_declared_by_command_gets_its_secret_and_none_of_the_hosts_environment()
    {
        var cancellationToken = {{ test_cancellation_token }};
        Environment.SetEnvironmentVariable(HostOnlyVariable, "the host's own configuration");
        var serverAssembly = Path.Combine(AppContext.BaseDirectory, "Mcp.TestServer.dll");
        await using var services = await HostServicesAsync(
            (builder, host) => host.WithMcpServerCommand(
                "echo-process",
                builder.AddParameter("echo-process-command"),
                [serverAssembly],
                new Dictionary<string, IResourceBuilder<ParameterResource>> { [EchoServer.TokenVariable] = builder.AddParameter("echo-process-token", secret: true) }),
            new Dictionary<string, string> { ["echo-process-command"] = "dotnet", ["echo-process-token"] = Token },
            cancellationToken);
        var tools = services.GetRequiredService<IMcpTools>();

        var echo = await tools.CallAsync("echo-process", "echo", new Dictionary<string, object?> { ["text"] = "hello" }, cancellationToken);
        var seesToken = await tools.CallAsync("echo-process", "sees", new Dictionary<string, object?> { ["variable"] = EchoServer.TokenVariable }, cancellationToken);
        var seesHostOnly = await tools.CallAsync("echo-process", "sees", new Dictionary<string, object?> { ["variable"] = HostOnlyVariable }, cancellationToken);

        {{ `echo.Text` | should_be `"echo: hello"` }};
        {{ `seesToken.Text` | should_be `"true"` }};
        {{ `seesHostOnly.Text` | should_be `"false"` }};
    }

    {{ test_attribute }}
    public async Task A_tool_call_the_model_asks_for_runs_on_the_server_and_its_result_goes_back_to_the_model()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var server = await EchoServer.StartHttpAsync(Token, "echo", cancellationToken);
        await using var services = await HostServicesAsync(DeclareByUrl(withToken: true), UrlParameters(server), cancellationToken);
        using var chat = new ChatClientBuilder(new ToolCallingChatClient("echo-server__echo")).UseMcpTools(AllowEveryCall).Build(services);

        var response = await chat.GetResponseAsync("Say hello through the echo tool.", cancellationToken: cancellationToken);

        {{ `response.Text` | should_start_with `"The tool said:"` }};
        {{ `response.Text` | should_contain `"echo: hello"` }};
    }

    {{ test_attribute }}
    public async Task Two_servers_with_a_tool_of_the_same_name_offer_it_under_their_own_names_and_each_call_reaches_its_server()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var first = await EchoServer.StartHttpAsync(Token, "first", cancellationToken);
        await using var second = await EchoServer.StartHttpAsync(Token, "second", cancellationToken);
        await using var services = await HostServicesAsync(
            (builder, host) => host
                .WithMcpServerUrl("first", builder.AddParameter("first-url"), builder.AddParameter("first-token", secret: true))
                .WithMcpServerUrl("second", builder.AddParameter("second-url"), builder.AddParameter("second-token", secret: true)),
            new Dictionary<string, string> { ["first-url"] = Endpoint(first), ["first-token"] = Token, ["second-url"] = Endpoint(second), ["second-token"] = Token },
            cancellationToken);
        var model = new ToolCallingChatClient("second__echo");
        using var chat = new ChatClientBuilder(model).UseMcpTools(AllowEveryCall).Build(services);

        var response = await chat.GetResponseAsync("Say hello through the second server's echo.", cancellationToken: cancellationToken);

        {{ `model.Offered` | should_contain `"first__echo"` }};
        {{ `model.Offered` | should_contain `"second__echo"` }};
        {{ `response.Text` | should_contain `"second: hello"` }};
    }

    {{ test_attribute }}
    public async Task A_tool_call_the_check_refuses_never_reaches_the_server_and_the_model_is_told_so()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var server = await EchoServer.StartHttpAsync(Token, "echo", cancellationToken);
        await using var services = await HostServicesAsync(DeclareByUrl(withToken: true), UrlParameters(server), cancellationToken);
        List<McpToolCall> checkedCalls = [];
        using var chat = new ChatClientBuilder(new ToolCallingChatClient("echo-server__echo"))
            .UseMcpTools(call =>
            {
                checkedCalls.Add(call);
                return false;
            })
            .Build(services);

        var response = await chat.GetResponseAsync("Say hello through the echo tool.", cancellationToken: cancellationToken);

        var refused = {{ `checkedCalls` | should_have_single_item }};
        {{ `refused.Server` | should_be `"echo-server"` }};
        {{ `refused.Tool` | should_be `"echo"` }};
        {{ `refused.Arguments["text"]?.ToString()` | should_be `"hello"` }};
        {{ `response.Text` | should_not_contain `"echo: hello"` }};
        {{ `response.Text` | should_contain `"refused"` }};
    }

    /// <summary>The check a test passes when the call itself is not under test; a project checks the arguments.</summary>
    private static bool AllowEveryCall(McpToolCall call) => true;

    private static Action<IDistributedApplicationTestingBuilder, IResourceBuilder<ProjectResource>> DeclareByUrl(bool withToken) =>
        (builder, host) => host.WithMcpServerUrl(
            "echo-server",
            builder.AddParameter("echo-server-url"),
            withToken ? builder.AddParameter("echo-server-token", secret: true) : null);

    private static Dictionary<string, string> UrlParameters(WebApplication server) =>
        new() { ["echo-server-url"] = Endpoint(server), ["echo-server-token"] = Token };

    private static string Endpoint(WebApplication server) => $"{server.Urls.Single()}/mcp";

    private static async Task<ServiceProvider> HostServicesAsync(
        Action<IDistributedApplicationTestingBuilder, IResourceBuilder<ProjectResource>> declare,
        IReadOnlyDictionary<string, string> parameters,
        CancellationToken cancellationToken)
    {
        var configuration = await DeclaredServers.HostConfigurationAsync(declare, parameters, cancellationToken);
        return new ServiceCollection().AddLogging().AddMcpClients(configuration).BuildServiceProvider();
    }
}
