<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tiny MCP server for tests/Mcp.Tests: in process over HTTP, or started as a process over stdio. Never deployed. -->
  <PropertyGroup>
    <RootNamespace>{{ namespace }}.Mcp.TestServer</RootNamespace>
    <!-- tests/Directory.Build.props makes every project a test project; this one is a program with its own entry point. -->
    <IsTestProject>false</IsTestProject>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

</Project>
