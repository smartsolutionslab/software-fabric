using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Mcp.TestServer;

public static class EchoServer
{
    /// <summary>The variable a started server needs, as a stand-in for a credential; it refuses to start without it.</summary>
    public const string TokenVariable = "MCP_TEST_SERVER_TOKEN";

    /// <summary>The server over HTTP on a free local port, answering only requests that carry the bearer token.</summary>
    public static async Task<WebApplication> StartHttpAsync(string bearerToken, CancellationToken cancellationToken)
    {
        var builder = WebApplication.CreateSlimBuilder();
        builder.WebHost.UseUrls("http://127.0.0.1:0");
        builder.Services.AddMcpServer().WithHttpTransport(options => options.Stateless = true).WithTools([typeof(EchoTools)]);

        var app = builder.Build();
        app.Use(async (context, next) =>
        {
            if (context.Request.Headers.Authorization != $"Bearer {bearerToken}")
            {
                context.Response.StatusCode = StatusCodes.Status401Unauthorized;
                return;
            }

            await next(context);
        });
        app.MapMcp("/mcp");
        await app.StartAsync(cancellationToken);
        return app;
    }
}
