using System.ComponentModel;
using Microsoft.Extensions.Configuration;
using ModelContextProtocol.Server;

namespace {{ namespace }}.Mcp.TestServer;

/// <summary>The test server's tools; the echo carries the server's label, so a test sees which server answered.</summary>
[McpServerToolType]
public sealed class EchoTools(IConfiguration configuration)
{
    public const string LabelKey = "EchoLabel";

    [McpServerTool(Name = "echo")]
    [Description("Answers with the text it was given.")]
    public string Echo(string text) => $"{configuration[LabelKey] ?? "echo"}: {text}";

    [McpServerTool(Name = "sees")]
    [Description("Whether this server's process sees the environment variable.")]
    public static bool Sees(string variable) => Environment.GetEnvironmentVariable(variable) is not null;
}
