{{~ policies = object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
namespace {{ namespace }}.BuildingBlocks.Mcp;

/// <summary>
/// Offers a command or query to MCP clients as a tool: opt-in, so a request without it is never exposed. The tool's
/// arguments are the request record's properties, and a call goes through <c>IDispatcher</c> as an endpoint's does.
/// </summary>
/// <param name="description">What the tool does, for the model that decides whether to call it.</param>
[AttributeUsage(AttributeTargets.Class, Inherited = false)]
public sealed class McpToolAttribute(string description) : Attribute
{
    public string Description { get; } = description;
{{~ if policies ~}}

    /// <summary>
    /// The policy a caller must satisfy, named by the request's own module in <c>&lt;Module&gt;PolicyNames</c>
    /// (<c>Policy = BillingPolicyNames.Manage</c>). Without it, any signed-in caller may call the tool.
    /// </summary>
    public string? Policy { get; init; }
{{~ end ~}}
}
