{{~ auth = project["backend.auth"] != "none" ~}}
{{~ wolverine = project["backend.mediator"] == "wolverine" ~}}
{{~ policies = object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
using {{ namespace }}.BuildingBlocks.Messaging;
{{~ if auth ~}}
using Microsoft.AspNetCore.Authentication;
{{~ end ~}}
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.AspNetCore.TestHost;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Microsoft.Extensions.Hosting;
using ModelContextProtocol.Client;
{{~ if wolverine ~}}
using Wolverine;
using Wolverine.Runtime;
{{~ end ~}}

namespace {{ namespace }}.Mcp.Server.Tests;

/// <summary>
/// The real host in process, with this assembly's samples offered as a module's requests would be. Nothing it would
/// reach is started: no hosted service runs{{ if wolverine }} but Wolverine, in process{{ end }}{{ if auth }}, and a test user signs in in place of the identity provider{{ end }}.
/// </summary>
public sealed class McpHost : WebApplicationFactory<Program>
{
{{~ if auth ~}}
    /// <summary>An MCP client of the host, signed in as the user with the permissions, or anonymous for none.</summary>
    public async Task<McpClient> ConnectAsync(string? user, IReadOnlyList<string> permissions, CancellationToken cancellationToken)
    {
        {{ not_null "permissions" }}

        var http = CreateClient();
        if (user is not null)
        {
            http.DefaultRequestHeaders.Add(TestUser.Header, user);
        }

        foreach (var permission in permissions)
        {
            http.DefaultRequestHeaders.Add(TestUser.PermissionHeader, permission);
        }

{{~ else ~}}
    /// <summary>An MCP client of the host; nobody signs in.</summary>
    public async Task<McpClient> ConnectAsync(CancellationToken cancellationToken)
    {
        var http = CreateClient();
{{~ end ~}}
        var transport = new HttpClientTransport(
            new HttpClientTransportOptions { Endpoint = new Uri(http.BaseAddress!, McpServerEndpoint.Route), TransportMode = HttpTransportMode.StreamableHttp },
            http,
            ownsHttpClient: true);
        return await McpClient.CreateAsync(transport, cancellationToken: cancellationToken);
    }

    protected override void ConfigureWebHost(IWebHostBuilder builder)
    {
        {{ not_null "builder" }}

        builder.UseEnvironment(Environments.Development);
        builder.UseSetting("ConnectionStrings:database", "Host=localhost;Database=unused");
{{~ if project["backend.bus.transport"] == "kafka" ~}}
        builder.UseSetting("ConnectionStrings:messaging", "localhost:9092");
{{~ else if project["backend.bus.transport"] != "none" ~}}
        builder.UseSetting("ConnectionStrings:messaging", "amqp://localhost");
{{~ end ~}}
{{~ if auth ~}}
        {{ unstarted_host_settings }}
{{~ end ~}}
        builder.ConfigureTestServices(services =>
        {
            services.RemoveAll<IHostedService>();
{{~ if wolverine ~}}
            // But Wolverine's runtime, which IDispatcher sends requests through: in process, with no broker and no message
            // store, and with this assembly's handlers beside the modules'.
            services.AddSingleton<IHostedService>(provider => (IHostedService)provider.GetRequiredService<IWolverineRuntime>())
                .DisableAllExternalWolverineTransports()
                .DisableAllWolverineMessagePersistence()
                .ConfigureWolverine(options => options.Discovery.IncludeAssembly(typeof(ShoutHandler).Assembly));
{{~ end ~}}
{{~ if auth ~}}
            services.AddAuthentication(options =>
                {
                    options.DefaultScheme = TestUser.SchemeName;
                    options.DefaultAuthenticateScheme = TestUser.SchemeName;
                    options.DefaultChallengeScheme = TestUser.SchemeName;
                })
                .AddScheme<AuthenticationSchemeOptions, TestUser>(TestUser.SchemeName, _ => { });
{{~ end ~}}
{{~ if policies ~}}
            new SamplePolicies().AddPolicies(services.AddAuthorizationBuilder());
            services.AddSingleton<Approvals>()
                .AddScoped<ICommandHandler<Approve, Result<Approved, ApiError>>, ApproveHandler>();
{{~ end ~}}
{{~ if project["backend.absence"] == "option" ~}}
            services.AddScoped<IQueryHandler<Lookup, Result<Option<Found>, ApiError>>, LookupHandler>();
{{~ end ~}}
            services.AddScoped<IQueryHandler<Shout, Result<Shouted, ApiError>>, ShoutHandler>()
                .AddScoped<IQueryHandler<Whisper, Result<Shouted, ApiError>>, WhisperHandler>()
                .AddMcpRequestTools("Samples", typeof(Shout).Assembly{{ if policies }}, typeof(SamplePolicies).Assembly{{ end }});
        });
    }
}
