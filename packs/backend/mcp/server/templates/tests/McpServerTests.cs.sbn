{{~ auth = project["backend.auth"] != "none" ~}}
{{~ policies = object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
{{~ if auth ~}}
using System.Net;
{{~ end ~}}
using System.Text.Json;
{{~ if policies ~}}
using Microsoft.Extensions.DependencyInjection;
using ModelContextProtocol;
{{~ end ~}}
using ModelContextProtocol.Client;
using ModelContextProtocol.Protocol;

namespace {{ namespace }}.Mcp.Server.Tests;

/// <summary>
/// The host's MCP endpoint through the SDK's own client: a command or query is a tool only when marked [McpTool], and
/// a call reaches its handler through the dispatcher{{ if auth }}; a caller who is not signed in{{ if policies }}, or lacks the tool's policy,{{ end }} is refused{{ end }}.
/// </summary>
public sealed class McpServerTests : IDisposable
{
{{~ if auth ~}}
    private static readonly string[] NoPermissions = [];
{{~ end ~}}
{{~ if policies ~}}

    private static readonly string[] Manage = ["manage"];
{{~ end ~}}

    private readonly McpHost host = new();

    {{ test_attribute }}
    public async Task The_marked_query_is_listed_with_its_description_and_the_unmarked_one_is_not()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var client = await ConnectAsync(cancellationToken);

        var tools = await client.ListToolsAsync(cancellationToken: cancellationToken);

        {{ `tools.Select(tool => tool.Name)` | should_contain `"samples_shout"` }};
        {{ `tools.Select(tool => tool.Name)` | should_not_contain `"samples_whisper"` }};
        {{ `tools.Single(tool => tool.Name == "samples_shout").Description` | should_be `"Answers with the text it was given, in capitals."` }};
    }

    {{ test_attribute }}
    public async Task A_tools_input_schema_is_its_request_records()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var client = await ConnectAsync(cancellationToken);

        var tools = await client.ListToolsAsync(cancellationToken: cancellationToken);

        var properties = tools.Single(tool => tool.Name == "samples_shout").JsonSchema.GetProperty("properties");
        {{ `properties.EnumerateObject().Select(property => property.Name)` | should_be `["text"]` }};
        {{ `properties.GetProperty("text").GetProperty("type").GetString()` | should_be `"string"` }};
    }

    {{ test_attribute }}
    public async Task Calling_the_marked_query_answers_with_its_handlers_result()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var client = await ConnectAsync(cancellationToken);

        var result = await client.CallToolAsync("samples_shout", new Dictionary<string, object?> { ["text"] = "hello" }, cancellationToken: cancellationToken);

        {{ `(result.IsError ?? false)` | should_be_false }};
        {{ `Text(result)` | should_be `"{\"text\":\"HELLO\"}"` }};
    }

    {{ test_attribute }}
    public async Task A_failed_result_is_a_tool_error_starting_with_the_errors_code()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var client = await ConnectAsync(cancellationToken);

        var result = await client.CallToolAsync("samples_shout", new Dictionary<string, object?> { ["text"] = string.Empty }, cancellationToken: cancellationToken);

        {{ `(result.IsError ?? false)` | should_be_true }};
        {{ `Text(result)` | should_be `"samples.nothing-to-shout: There is nothing to shout."` }};
    }

    {{ test_cases_attribute }}
    {{ test_case_attribute `"{\"text\":42}"` }}
    {{ test_case_attribute `"{\"text\":null}"` }}
    {{ test_case_attribute `"{}"` }}
    public async Task Arguments_that_are_not_the_request_are_a_tool_error(string arguments)
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var client = await ConnectAsync(cancellationToken);

        var result = await client.CallToolAsync("samples_shout", JsonSerializer.Deserialize<Dictionary<string, object?>>(arguments), cancellationToken: cancellationToken);

        {{ `(result.IsError ?? false)` | should_be_true }};
        {{ `Text(result)` | should_start_with `"The arguments are not a Shout:"` }};
    }
{{~ if project["backend.absence"] == "option" ~}}

    {{ test_cases_attribute }}
    {{ test_case_attribute `"", "null"` }}
    {{ test_case_attribute `"plain", "{\"text\":\"plain\",\"note\":null}"` }}
    {{ test_case_attribute `"rare", "{\"text\":\"rare\",\"note\":\"noted\"}"` }}
    public async Task An_absent_option_is_null_in_the_answer_at_the_top_and_nested(string text, string answer)
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var client = await ConnectAsync(cancellationToken);

        var result = await client.CallToolAsync("samples_lookup", new Dictionary<string, object?> { ["text"] = text }, cancellationToken: cancellationToken);

        {{ `(result.IsError ?? false)` | should_be_false `Text(result)` }};
        {{ `Text(result)` | should_be `answer` }};
    }
{{~ end ~}}
{{~ if auth ~}}

    {{ test_attribute }}
    public async Task An_anonymous_caller_is_refused()
    {
        var cancellationToken = {{ test_cancellation_token }};

        var refused = await {{ should_throw_async `HttpRequestException` `() => host.ConnectAsync(null, NoPermissions, cancellationToken)` }};

        {{ `refused.StatusCode` | should_be `HttpStatusCode.Unauthorized` }};
    }
{{~ else ~}}

    {{ test_attribute }}
    public async Task Anyone_may_call_a_tool_without_signing_in()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var client = await host.ConnectAsync(cancellationToken);

        var result = await client.CallToolAsync("samples_shout", new Dictionary<string, object?> { ["text"] = "hi" }, cancellationToken: cancellationToken);

        {{ `Text(result)` | should_be `"{\"text\":\"HI\"}"` }};
    }
{{~ end ~}}
{{~ if policies ~}}

    {{ test_attribute }}
    public async Task A_caller_without_the_tools_policy_neither_sees_nor_reaches_it()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var client = await host.ConnectAsync("visitor", NoPermissions, cancellationToken);

        var tools = await client.ListToolsAsync(cancellationToken: cancellationToken);
        var refused = await {{ should_throw_async `McpException` `async () =>
            await client.CallToolAsync("samples_approve", new Dictionary<string, object?> { ["number"] = 7 }, cancellationToken: cancellationToken)` }};

        {{ `tools.Select(tool => tool.Name)` | should_not_contain `"samples_approve"` }};
        {{ `refused.Message` | should_contain `"Access forbidden"` }};
        {{ `host.Services.GetRequiredService<Approvals>().Numbers` | should_be_empty }};
    }

    {{ test_attribute }}
    public async Task A_caller_with_the_tools_policy_calls_it()
    {
        var cancellationToken = {{ test_cancellation_token }};
        await using var client = await host.ConnectAsync("developer", Manage, cancellationToken);

        var result = await client.CallToolAsync("samples_approve", new Dictionary<string, object?> { ["number"] = 7 }, cancellationToken: cancellationToken);

        {{ `Text(result)` | should_be `"{\"number\":7}"` }};
        {{ `host.Services.GetRequiredService<Approvals>().Numbers` | should_be `[7]` }};
    }
{{~ end ~}}

    public void Dispose() => host.Dispose();

    private static string Text(CallToolResult result) => result.Content.OfType<TextContentBlock>().Single().Text;

{{~ if auth ~}}
    private Task<McpClient> ConnectAsync(CancellationToken cancellationToken) => host.ConnectAsync("developer", NoPermissions, cancellationToken);
{{~ else ~}}
    private Task<McpClient> ConnectAsync(CancellationToken cancellationToken) => host.ConnectAsync(cancellationToken);
{{~ end ~}}
}
