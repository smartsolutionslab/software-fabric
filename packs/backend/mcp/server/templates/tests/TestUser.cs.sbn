using System.Security.Claims;
using System.Text.Encodings.Web;
using Microsoft.AspNetCore.Authentication;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;

namespace {{ namespace }}.Mcp.Server.Tests;

/// <summary>
/// Signs in the user a request names in <see cref="Header"/>, in place of the identity provider's token; a request
/// without it is anonymous. Each <see cref="PermissionHeader"/> adds a <see cref="PermissionClaim"/> claim.
/// </summary>
public sealed class TestUser(IOptionsMonitor<AuthenticationSchemeOptions> options, ILoggerFactory logger, UrlEncoder encoder)
    : AuthenticationHandler<AuthenticationSchemeOptions>(options, logger, encoder)
{
    public const string SchemeName = "Test";

    public const string Header = "X-Test-User";

    public const string PermissionHeader = "X-Test-Permission";

    public const string PermissionClaim = "permission";

    protected override Task<AuthenticateResult> HandleAuthenticateAsync()
    {
        if (Request.Headers[Header].ToString() is not { Length: > 0 } user)
        {
            return Task.FromResult(AuthenticateResult.NoResult());
        }

        List<Claim> claims = [new(ClaimTypes.Name, user)];
        claims.AddRange(Request.Headers[PermissionHeader].OfType<string>().Select(permission => new Claim(PermissionClaim, permission)));
        var principal = new ClaimsPrincipal(new ClaimsIdentity(claims, SchemeName));
        return Task.FromResult(AuthenticateResult.Success(new AuthenticationTicket(principal, SchemeName)));
    }
}
