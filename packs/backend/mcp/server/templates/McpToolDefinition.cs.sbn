{{~ option = project["backend.absence"] == "option" ~}}
{{~ policies = object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
namespace {{ namespace }}.BuildingBlocks.Mcp;

/// <summary>A marked command or query as an MCP tool.</summary>
/// <param name="Name"><c>&lt;module&gt;_&lt;request&gt;</c> in snake case, e.g. <c>billing_find_invoice</c>.</param>
/// <param name="Description">What the tool does, from <see cref="McpToolAttribute"/>.</param>
/// <param name="Request">The command or query record; its properties are the tool's arguments.</param>
/// <param name="Result">What the request's handler returns.</param>
/// <param name="ReadsOnly">True for a query, false for a command.</param>
{{~ if policies ~}}
/// <param name="Policy">The policy a caller must satisfy, if any beyond being signed in.</param>
{{~ if option ~}}
public sealed record McpToolDefinition(string Name, string Description, Type Request, Type Result, bool ReadsOnly, Option<string> Policy);
{{~ else ~}}
public sealed record McpToolDefinition(string Name, string Description, Type Request, Type Result, bool ReadsOnly, string? Policy);
{{~ end ~}}
{{~ else ~}}
public sealed record McpToolDefinition(string Name, string Description, Type Request, Type Result, bool ReadsOnly);
{{~ end ~}}
