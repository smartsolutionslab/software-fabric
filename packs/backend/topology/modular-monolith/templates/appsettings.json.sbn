{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"{{ if slots["host.log-levels"] != "" }},
{{ slots["host.log-levels"] }}{{ end }}
    }
  },
  "AllowedHosts": "*"{{ if slots["host.kestrel-endpoints"] != "" }},
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5080"
      },
{{ slots["host.kestrel-endpoints"] }}
    }
  }{{ end }}
}
