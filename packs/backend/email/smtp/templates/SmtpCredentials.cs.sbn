namespace {{ namespace }}.BuildingBlocks.Email;

/// <summary>
/// The user the host signs in to the SMTP server as. Its text names the user but never shows the password, so logging
/// the settings leaks nothing.
/// </summary>
public sealed record SmtpCredentials(string UserName, string Password)
{
    public override string ToString() => {%{$"{nameof(SmtpCredentials)} {{ {nameof(UserName)} = {UserName} }}"}%};
}
