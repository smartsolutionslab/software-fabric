using Microsoft.AspNetCore.Diagnostics;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Logging;

namespace {{ namespace }}.BuildingBlocks.Http;

/// <summary>
/// The backstop for preconditions. An <see cref="ArgumentException"/> (or a subclass) that escapes an endpoint was thrown
/// by a guard or a value object's factory on the caller's input, so it answers 400 problem details with a stable code.
/// Expected failures are Results, not exceptions; this only catches the precondition a caller can still break.
/// Every other exception is left to the exception handler middleware, which answers 500 without details.
/// </summary>
public sealed partial class ArgumentExceptionHandler(IProblemDetailsService problemDetails, ILogger<ArgumentExceptionHandler> logger) : IExceptionHandler
{
    /// <summary>The <c>code</c> of every problem a failed guard answers.</summary>
    public const string Code = "invalid-argument";

    public async ValueTask<bool> TryHandleAsync(HttpContext httpContext, Exception exception, CancellationToken cancellationToken)
    {
        {{ not_null "httpContext" }}

        if (exception is not ArgumentException argument)
        {
            return false;
        }

        LogRejected(logger, argument.ParamName, argument.Message);

        httpContext.Response.StatusCode = StatusCodes.Status400BadRequest;

        // A caller that accepts no JSON still gets the status, without a body.
        await problemDetails.TryWriteAsync(new ProblemDetailsContext
        {
            HttpContext = httpContext,
            ProblemDetails =
            {
                Status = StatusCodes.Status400BadRequest,
                Title = "The request is invalid.",
                Detail = argument.Message,
                Extensions = { ["code"] = Code },
            },
        });

        return true;
    }

    [LoggerMessage(Level = LogLevel.Information, Message = "A guard rejected the request's {Parameter}: {Reason}")]
    private static partial void LogRejected(ILogger logger, string? parameter, string reason);
}
