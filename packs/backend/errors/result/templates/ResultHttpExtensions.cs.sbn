using Microsoft.AspNetCore.Http;

namespace {{ namespace }}.BuildingBlocks.Results;

public static class ResultHttpExtensions
{
    /// <summary>200 with the value, or problem details carrying the error's status and code.</summary>
    public static IResult ToHttpResult<TValue, TError>(this Result<TValue, TError> result)
        where TError : ApiError
    {
        ArgumentNullException.ThrowIfNull(result);

        return result.Match<IResult>(
            value => TypedResults.Ok(value),
            error => TypedResults.Problem(
                title: error.Message,
                statusCode: (int)error.Status,
                extensions: new Dictionary<string, object?> { ["code"] = error.Code }));
    }
}
