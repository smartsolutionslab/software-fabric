using System.Runtime.CompilerServices;

namespace {{ namespace }}.Kernel;

/// <summary>
/// Either a value or an expected failure. Read <see cref="Value"/> or <see cref="Error"/> only after checking
/// <see cref="IsSuccess"/>, or use <see cref="Match{TResult}"/>, or <c>switch</c> on it: a union of
/// <see cref="SuccessOutcome{TValue}"/> and <see cref="FailureOutcome{TError}"/>, so a <c>switch</c> that misses either
/// case does not compile.
/// </summary>
[Union]
public sealed class Result<TValue, TError> : Result<TValue, TError>.IUnionMembers
    where TValue : notnull
    where TError : notnull
{
    private readonly TValue? value;
    private readonly TError? error;

    private Result(TValue value)
    {
        this.value = value;
        IsSuccess = true;
    }

    private Result(TError error)
    {
        this.error = error;
    }

    /// <summary>
    /// What makes the result a union, kept apart so that <see cref="Value"/> stays the success's value: the compiler
    /// turns a case into a result with <c>Create</c> and matches a case with <c>TryGetValue</c>, without boxing it.
    /// </summary>
    public interface IUnionMembers
    {
        object? Value { get; }

        bool HasValue { get; }

        static abstract Result<TValue, TError> Create(SuccessOutcome<TValue> outcome);

        static abstract Result<TValue, TError> Create(FailureOutcome<TError> outcome);

        bool TryGetValue(out SuccessOutcome<TValue> outcome);

        bool TryGetValue(out FailureOutcome<TError> outcome);
    }

    public bool IsSuccess { get; }

    public TValue Value => IsSuccess ? value! : throw new InvalidOperationException("A failed result has no value.");

    public TError Error => IsSuccess ? throw new InvalidOperationException("A successful result has no error.") : error!;

    object? IUnionMembers.Value => IsSuccess ? new SuccessOutcome<TValue>(value!) : new FailureOutcome<TError>(error!);

    bool IUnionMembers.HasValue => true;

    static Result<TValue, TError> IUnionMembers.Create(SuccessOutcome<TValue> outcome) => Success(outcome.Value);

    static Result<TValue, TError> IUnionMembers.Create(FailureOutcome<TError> outcome) => Failure(outcome.Error);

#pragma warning disable CA1000 // Static factories on the generic type are the point: Result<Invoice, ApiError>.Success(invoice).
    public static Result<TValue, TError> Success(TValue value) => new(value);

    public static Result<TValue, TError> Failure(TError error)
    {
        {{~ if project["backend.guards"] == "ensure-that" ~}}
        // TError may be a value type, and Ensure.That's object chain takes reference types only.
        Ensure.That<object>(error).IsNotNull();
        {{~ else ~}}
        {{ not_null "error" }}
        {{~ end ~}}
        return new(error);
    }
#pragma warning restore CA1000

    public TResult Match<TResult>(Func<TValue, TResult> success, Func<TError, TResult> failure)
    {
        {{ not_null "success" }}
        {{ not_null "failure" }}

        return IsSuccess ? success(value!) : failure(error!);
    }

    /// <summary>The same outcome with the error translated, e.g. a domain error to an <c>ApiError</c> in Application.</summary>
    public Result<TValue, TOut> MapError<TOut>(Func<TError, TOut> map)
        where TOut : notnull
    {
        {{ not_null "map" }}

        return IsSuccess ? Result<TValue, TOut>.Success(value!) : Result<TValue, TOut>.Failure(map(error!));
    }

    bool IUnionMembers.TryGetValue(out SuccessOutcome<TValue> outcome)
    {
        outcome = IsSuccess ? new SuccessOutcome<TValue>(value!) : default;
        return IsSuccess;
    }

    bool IUnionMembers.TryGetValue(out FailureOutcome<TError> outcome)
    {
        outcome = IsSuccess ? default : new FailureOutcome<TError>(error!);
        return !IsSuccess;
    }
}
