using System.Globalization;
using System.Net;

namespace {{ namespace }}.Kernel.Tests;

public class ResultTests
{
    private static readonly ApiError NotFound = ApiError.NotFound("billing.invoice-not-found", "No such invoice.");

    {{ test_attribute }}
    public void A_success_has_its_value_and_no_error()
    {
        var result = Result<int, ApiError>.Success(42);

        {{ `result.IsSuccess` | should_be_true }};
        {{ `result.Value` | should_be `42` }};
        {{ should_throw `InvalidOperationException` `() => result.Error` }};
    }

    {{ test_attribute }}
    public void A_failure_has_its_error_and_no_value()
    {
        var result = Result<int, ApiError>.Failure(NotFound);

        {{ `result.IsSuccess` | should_be_false }};
        {{ `result.Error` | should_be `NotFound` }};
        {{ should_throw `InvalidOperationException` `() => result.Value` }};
    }

    {{ test_attribute }}
    public void A_failure_needs_an_error() =>
        {{ should_throw `ArgumentException` `() => Result<int, ApiError>.Failure(null!)` }};

    {{ test_attribute }}
    public void Match_takes_the_branch_of_the_outcome()
    {
        {{ `Result<int, ApiError>.Success(42).Match(value => value.ToString(CultureInfo.InvariantCulture), error => error.Code)` | should_be `"42"` }};
        {{ `Result<int, ApiError>.Failure(NotFound).Match(value => value.ToString(CultureInfo.InvariantCulture), error => error.Code)` | should_be `"billing.invoice-not-found"` }};
    }

    {{ test_attribute }}
    public void Map_error_translates_a_failure_and_keeps_a_success()
    {
        {{ `Result<int, string>.Success(42).MapError(code => ApiError.Validation(code, "Invalid.")).Value` | should_be `42` }};
        {{ `Result<int, string>.Failure("billing.invalid").MapError(code => ApiError.Validation(code, "Invalid.")).Error.Code` | should_be `"billing.invalid"` }};
    }

    {{ test_attribute }}
    public void Each_api_error_factory_gives_its_status()
    {
        {{ `NotFound.Status` | should_be `HttpStatusCode.NotFound` }};
        {{ `ApiError.Validation("billing.invalid", "Invalid.").Status` | should_be `HttpStatusCode.BadRequest` }};
        {{ `ApiError.Conflict("billing.duplicate", "Duplicate.").Status` | should_be `HttpStatusCode.Conflict` }};
        {{ `ApiError.Forbidden("billing.forbidden", "Forbidden.").Status` | should_be `HttpStatusCode.Forbidden` }};
    }

    {{ test_attribute }}
    public void A_domain_error_becomes_an_api_error_with_the_status_application_gives_it()
    {
        var error = ApiError.From(new InvoiceOverdue(), HttpStatusCode.Conflict);

        {{ `error` | should_be `new ApiError("billing.invoice-overdue", "The invoice is overdue.", HttpStatusCode.Conflict)` }};
        {{ `Unit.Value` | should_be `default(Unit)` }};
    }

    {{ test_attribute }}
    public void A_switch_takes_the_case_of_the_outcome()
    {
        {{ `Describe(Result<int, ApiError>.Success(42))` | should_be `"42"` }};
        {{ `Describe(Result<int, ApiError>.Failure(NotFound))` | should_be `"billing.invoice-not-found"` }};
    }

    {{ test_attribute }}
    public void Every_result_holds_one_of_its_cases_and_the_case_converts_back_to_the_result()
    {
        Result<int, ApiError>.IUnionMembers success = Result<int, ApiError>.Success(42);
        Result<int, ApiError>.IUnionMembers failure = Result<int, ApiError>.Failure(NotFound);

        {{ `success.HasValue` | should_be_true }};
        {{ `failure.HasValue` | should_be_true }};
        Result<int, ApiError> successAgain = {{ `success.Value` | should_be_of_type `SuccessOutcome<int>` }};
        Result<int, ApiError> failureAgain = {{ `failure.Value` | should_be_of_type `FailureOutcome<ApiError>` }};
        {{ `successAgain.Value` | should_be `42` }};
        {{ `failureAgain.Error` | should_be `NotFound` }};
    }

    private static string Describe(Result<int, ApiError> result) =>
        result switch
        {
            SuccessOutcome<int> success => success.Value.ToString(CultureInfo.InvariantCulture),
            FailureOutcome<ApiError> failure => failure.Error.Code,
        };

    private sealed record InvoiceOverdue() : DomainError("billing.invoice-overdue", "The invoice is overdue.");
}
