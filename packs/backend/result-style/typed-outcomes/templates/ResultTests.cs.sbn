using System.Globalization;
using System.Net;

namespace {{ namespace }}.Kernel.Tests;

public class ResultTests
{
    private static readonly ApiError NotFound = new InvoiceNotFound();

    {{ test_attribute }}
    public void A_success_has_its_value_and_no_error()
    {
        Result<int, ApiError> result = Success(42);

        {{ `result.IsSuccess` | should_be_true }};
        {{ `result.IsFailure` | should_be_false }};
        {{ `result.Value` | should_be `42` }};
        {{ should_throw `InvalidOperationException` `() => result.Error` }};
    }

    {{ test_attribute }}
    public void A_failure_has_its_error_and_no_value()
    {
        Result<int, ApiError> result = Failure(NotFound);

        {{ `result.IsSuccess` | should_be_false }};
        {{ `result.IsFailure` | should_be_true }};
        {{ `result.Error` | should_be `NotFound` }};
        {{ should_throw `InvalidOperationException` `() => result.Value` }};
    }

    {{ test_attribute }}
    public void Match_takes_the_branch_of_the_outcome()
    {
        {{ `Result<int, ApiError>.Success(42).Match(value => value.ToString(CultureInfo.InvariantCulture), error => error.Code)` | should_be `"42"` }};
        {{ `Result<int, ApiError>.Failure(NotFound).Match(value => value.ToString(CultureInfo.InvariantCulture), error => error.Code)` | should_be `"billing.invoice-not-found"` }};
    }

    {{ test_attribute }}
    public void Match_needs_both_branches() =>
        {{ should_throw `ArgumentException` `() => Result<int, ApiError>.Success(42).Match(null!, error => error.Code)` }};

    {{ test_attribute }}
    public void Map_error_translates_a_failure_and_keeps_a_success()
    {
        {{ `Result<int, DomainError>.Success(42).MapError(error => ApiError.From(error, HttpStatusCode.Conflict)).Value` | should_be `42` }};
        {{ `Result<int, DomainError>.Failure(new InvoiceOverdue()).MapError(error => ApiError.From(error, HttpStatusCode.Conflict)).Error.Code` | should_be `"billing.invoice-overdue"` }};
    }

    {{ test_attribute }}
    public void A_domain_error_becomes_an_api_error_with_the_status_application_gives_it()
    {
        var overdue = new InvoiceOverdue();

        var error = ApiError.From(overdue, HttpStatusCode.Conflict);

        {{ `error.Code` | should_be `"billing.invoice-overdue"` }};
        {{ `error.Message` | should_be `"The invoice is overdue."` }};
        {{ `error.Status` | should_be `HttpStatusCode.Conflict` }};
        {{ ((`error` | should_be_of_type `DomainFailure`) + `.Error`) | should_be `overdue` }};
        {{ `Unit.Value` | should_be `default(Unit)` }};
    }

    private sealed record InvoiceNotFound() : ApiError("billing.invoice-not-found", "No such invoice.", HttpStatusCode.NotFound);

    private sealed record InvoiceOverdue() : DomainError("billing.invoice-overdue", "The invoice is overdue.");
}
