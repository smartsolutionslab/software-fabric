namespace {{ namespace }}.Kernel.Tests;

public class OptionTests
{
    private static readonly Option<string> Number = Option<string>.Some("INV-1");
    private static readonly Option<string> Nothing = Option<string>.None;

    {{ test_attribute }}
    public void Some_has_its_value_and_none_has_none()
    {
        {{ `Number.HasValue` | should_be_true }};
        {{ `Number.Value` | should_be `"INV-1"` }};
        {{ `Nothing.HasValue` | should_be_false }};
        {{ should_throw `InvalidOperationException` `() => Nothing.Value` }};
    }

    {{ test_attribute }}
    public void Some_refuses_null() =>
        {{ should_throw `ArgumentNullException` `() => Option<string>.Some(null!)` }};

    {{ test_attribute }}
    public void Match_takes_the_branch_of_the_case_it_is()
    {
        {{ `Number.Match(number => number, () => "none")` | should_be `"INV-1"` }};
        {{ `Nothing.Match(number => number, () => "none")` | should_be `"none"` }};
    }

    {{ test_attribute }}
    public void Map_changes_a_value_and_leaves_none_none()
    {
        {{ `Number.Map(number => number.Length)` | should_be `Option<int>.Some(5)` }};
        {{ `Nothing.Map(number => number.Length)` | should_be `Option<int>.None` }};
    }

    {{ test_attribute }}
    public void Get_or_default_falls_back_only_without_a_value()
    {
        {{ `Number.GetOrDefault("INV-0")` | should_be `"INV-1"` }};
        {{ `Nothing.GetOrDefault("INV-0")` | should_be `"INV-0"` }};
    }

    {{ test_attribute }}
    public void Options_are_equal_when_both_are_none_or_both_hold_equal_values()
    {
        {{ `(Number == Option<string>.Some("INV-1"))` | should_be_true }};
        {{ `(Nothing == Option<string>.None)` | should_be_true }};
        {{ `(Number != Nothing)` | should_be_true }};
        {{ `(Number != Option<string>.Some("INV-2"))` | should_be_true }};
        {{ `Number.Equals((object)Option<string>.Some("INV-1"))` | should_be_true }};
        {{ `Number.Equals("INV-1")` | should_be_false }};
        {{ `Number.GetHashCode()` | should_be `Option<string>.Some("INV-1").GetHashCode()` }};
        {{ `Nothing.GetHashCode()` | should_be `Option<string>.None.GetHashCode()` }};
    }

    {{ test_attribute }}
    public void An_option_says_what_it_holds()
    {
        {{ `Number.ToString()` | should_be `"Some(INV-1)"` }};
        {{ `Nothing.ToString()` | should_be `"None"` }};
    }

    {{ test_attribute }}
    public void A_switch_takes_the_case_of_the_option_and_the_default_is_none()
    {
        {{ `Describe(Number)` | should_be `"INV-1"` }};
        {{ `Describe(Nothing)` | should_be `"none"` }};
        {{ `Describe(default)` | should_be `"none"` }};
    }

    {{ test_attribute }}
    public void Every_option_holds_one_of_its_cases_and_the_case_converts_back_to_the_option()
    {
        Option<string>.IUnionMembers number = Number;
        Option<string>.IUnionMembers nothing = Nothing;

        {{ `number.HasValue` | should_be_true }};
        {{ `nothing.HasValue` | should_be_true }};
        Option<string> numberAgain = {{ `number.Value` | should_be_of_type `Some<string>` }};
        Option<string> nothingAgain = {{ `nothing.Value` | should_be_of_type `None` }};
        {{ `numberAgain` | should_be `Number` }};
        {{ `nothingAgain` | should_be `Nothing` }};
    }

    private static string Describe(Option<string> number) =>
        number switch
        {
            Some<string> some => some.Value,
            None => "none",
        };
}
