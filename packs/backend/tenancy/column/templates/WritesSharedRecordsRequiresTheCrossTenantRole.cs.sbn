#error The shared-records rule starts the modular-monolith host only so far (docs/adr/0006 of the generator).
{{~ end ~}}
using {{ namespace }}.BuildingBlocks.Tenancy;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Authorization.Infrastructure;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.AspNetCore.Routing;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Microsoft.Extensions.Hosting;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// An endpoint mapped with <c>WritesSharedRecords()</c> writes the records every tenant reads, so only staff may call
/// it: its authorization, everything it and its group require combined, must require the role in
/// <see cref="CrossTenantRole"/> alone (a requirement another role also meets does not count), and it must not be
/// anonymous. Nor may it also be mapped with <c>AcrossTenants()</c>, which writes nothing. It reads the host's own
/// endpoint table once in Development and once in Production, and asks the host's policy provider what each policy
/// requires, so a policy is judged by what it is, not by its name.
/// </summary>
public sealed class WritesSharedRecordsRequiresTheCrossTenantRole : IArchitectureRule
{
    public string Description => $"Every endpoint mapped with WritesSharedRecords() requires the role {CrossTenantRole.Name} (CrossTenantRole.Name), and none is also mapped with AcrossTenants().";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        return [.. Wrong(Environments.Development)
            .Concat(Wrong(Environments.Production))
            .Distinct(StringComparer.Ordinal)
            .Order(StringComparer.Ordinal)];
    }

    private static List<string> Wrong(string environment)
    {
        using var host = new MappedHost(environment);
        var policies = host.Services.GetRequiredService<IAuthorizationPolicyProvider>();
        var writers = host.Services.GetRequiredService<EndpointDataSource>().Endpoints
            .OfType<RouteEndpoint>()
            .Where(endpoint => endpoint.Metadata.GetMetadata<SharedRecordsWriter>() is not null)
            .ToList();
        return [.. writers
            .Where(endpoint => !RequiresTheRole(endpoint, policies))
            .Select(endpoint => $"{Name(endpoint)} writes records shared by all tenants (WritesSharedRecords()), but its authorization does not require the role {CrossTenantRole.Name} (CrossTenantRole.Name). Name a policy that does, such as <Module>PolicyNames.WriteSharedRecords.")
            .Concat(writers
                .Where(endpoint => endpoint.Metadata.GetMetadata<ReadsAcrossTenants>() is not null)
                .Select(endpoint => $"{Name(endpoint)} is mapped with both WritesSharedRecords() and AcrossTenants(): the one writes nothing, the other exists to write. Map it with one of them."))];
    }

    private static bool RequiresTheRole(RouteEndpoint endpoint, IAuthorizationPolicyProvider policies)
    {
        if (endpoint.Metadata.GetMetadata<IAllowAnonymous>() is not null)
        {
            return false;
        }

        var policy = AuthorizationPolicy.CombineAsync(
            policies,
            endpoint.Metadata.GetOrderedMetadata<IAuthorizeData>(),
            endpoint.Metadata.GetOrderedMetadata<AuthorizationPolicy>()).GetAwaiter().GetResult();

        return policy is not null && policy.Requirements
            .OfType<RolesAuthorizationRequirement>()
            .Any(requirement => requirement.AllowedRoles.All(role => role == CrossTenantRole.Name));
    }

    private static string Name(RouteEndpoint endpoint)
    {
        var methods = endpoint.Metadata.GetMetadata<IHttpMethodMetadata>()?.HttpMethods ?? [];
        var route = "/" + endpoint.RoutePattern.RawText?.TrimStart('/');
        return methods.Count == 0 ? route : $"{string.Join(',', methods)} {route}";
    }

    /// <summary>
    /// The host with every endpoint mapped but nothing started: no hosted service runs, so the configuration Aspire
    /// would provide only has to be present, never reachable.
    /// </summary>
    private sealed class MappedHost(string environment) : WebApplicationFactory<Program>
    {
        protected override void ConfigureWebHost(IWebHostBuilder builder)
        {
            builder.UseEnvironment(environment);
            builder.UseSetting("ConnectionStrings:database", "Host=localhost;Database=unused");
{{~ if project["backend.bus.transport"] == "kafka" ~}}
            builder.UseSetting("ConnectionStrings:messaging", "localhost:9092");
{{~ else if project["backend.bus.transport"] != "none" ~}}
            builder.UseSetting("ConnectionStrings:messaging", "amqp://localhost");
{{~ end ~}}
            {{ unstarted_host_settings }}
            builder.ConfigureServices(services => services.RemoveAll<IHostedService>());
        }
    }
}
