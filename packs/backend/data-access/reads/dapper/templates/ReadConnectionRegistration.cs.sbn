using {{ namespace }}.BuildingBlocks.Persistence;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection.Extensions;

namespace Microsoft.Extensions.DependencyInjection;

public static class ReadConnectionRegistration
{
    private const string ConnectionStringName = "database";

    /// <summary>Registers the one IReadConnection of the project's database, whichever module asks first.</summary>
    public static IServiceCollection AddReadConnection(this IServiceCollection services, IConfiguration configuration)
    {
        {{ not_null "services" }}
        {{ not_null "configuration" }}

        var connectionString = configuration.GetConnectionString(ConnectionStringName)
            ?? throw new InvalidOperationException($"Connection string '{ConnectionStringName}' is missing; Aspire provides it.");
        services.TryAddSingleton<IReadConnection>(_ => new ReadConnection({{ slots["read-connection.data-source"] }}));
        return services;
    }
}
