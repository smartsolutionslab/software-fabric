namespace {{ namespace }}.Architecture.Tests.Rules;

public sealed class DapperReadsOnlyInQueryHandlers : IArchitectureRule
{
    private const string Dapper = "Dapper";
    private const string CommandHandler = "{{ namespace }}.BuildingBlocks.Messaging.ICommandHandler`2";
    private const string ReadConnection = "{{ namespace }}.BuildingBlocks.Persistence.IReadConnection";

    public string Description => "Only a module's Application project references Dapper, and no command handler takes IReadConnection: Dapper reads are queries.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        foreach (var assembly in model.ModuleAssemblies)
        {
            var name = assembly.GetName().Name!;
            if (!name.EndsWith(".Application", StringComparison.Ordinal))
            {
                if (assembly.GetReferencedAssemblies().Any(reference => IsDapper(reference.Name!)))
                {
                    yield return $"{name} references Dapper; only a module's Application project reads with it, in its query handlers.";
                }

                continue;
            }

            foreach (var handler in assembly.GetTypes().Where(IsCommandHandler).Where(TakesReadConnection).OrderBy(type => type.FullName, StringComparer.Ordinal))
            {
                yield return $"{handler.FullName} handles a command and takes IReadConnection; a command changes state through EF Core, only query handlers read with Dapper.";
            }
        }
    }

    private static bool IsDapper(string reference) =>
        reference == Dapper || reference.StartsWith(Dapper + ".", StringComparison.Ordinal);

    private static bool IsCommandHandler(Type type) =>
        type is { IsClass: true, IsAbstract: false } &&
        type.GetInterfaces().Any(contract => contract.IsGenericType && contract.GetGenericTypeDefinition().FullName == CommandHandler);

    private static bool TakesReadConnection(Type type) =>
        type.GetConstructors().Any(constructor => constructor.GetParameters().Any(parameter => parameter.ParameterType.FullName == ReadConnection));
}
