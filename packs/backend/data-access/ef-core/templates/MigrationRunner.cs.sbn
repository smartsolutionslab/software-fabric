using System.Reflection;
using {{ namespace }}.BuildingBlocks.Persistence;
using Microsoft.EntityFrameworkCore;

// Applies every module's migrations, then exits; the AppHost starts the host only after this completes.
var builder = Host.CreateApplicationBuilder(args);
builder.AddServiceDefaults();

var contexts = Directory.EnumerateFiles(AppContext.BaseDirectory, "{{ namespace }}.Modules.*.Infrastructure.dll")
    .Order(StringComparer.Ordinal)
    .Select(Assembly.LoadFrom)
    .SelectMany(assembly => assembly.GetTypes())
    .Where(type => type is { IsClass: true, IsAbstract: false } && typeof(ModuleDbContext).IsAssignableFrom(type))
    .ToList();

foreach (var context in contexts)
{
    builder.Services.AddModuleDbContext(context, builder.Configuration);
}

using var host = builder.Build();
foreach (var context in contexts)
{
    await using var scope = host.Services.CreateAsyncScope();
    await ((DbContext)scope.ServiceProvider.GetRequiredService(context)).Database.MigrateAsync();
}
