{{~ # The sample's one table: the crud entity or the ddd aggregate, or an event-sourced module's read model of its samples. ~}}
{{~ summaries = module.values["module.style"] == "event-sourced" ~}}
{{~ entity = summaries ? "Application.ReadModels.SampleSummary" : "Domain.Samples.Sample" ~}}
{{~ table = summaries ? "sample_summaries" : "samples" ~}}
{{~ sqlserver = project["backend.database"] == "sqlserver" ~}}
{{~ # The tenant column pack adds a TenantId to every table; a schema per tenant keeps tenants apart without one. ~}}
{{~ tenant_column = project["backend.tenancy"] == "column" ~}}
{{~ # The module's schema, as its DbContext names it. ~}}
{{~ schema = module.name | string.replace "-" "_" ~}}
