{{~ moves = slots["persistence.schema"] != "" ~}}
using Microsoft.EntityFrameworkCore;
{{~ if moves ~}}
using Microsoft.EntityFrameworkCore.Diagnostics;
using Microsoft.EntityFrameworkCore.Infrastructure;
using Microsoft.EntityFrameworkCore.Migrations;
{{~ end ~}}
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.BuildingBlocks.Persistence;

/// <summary>The base of every module's DbContext: the module's own schema and its entity configurations.</summary>
public abstract class ModuleDbContext(DbContextOptions options, IServiceProvider services, string schema) : DbContext(options)
{
    /// <summary>The application's services, for conventions that depend on the current request.</summary>
    public IServiceProvider Services { get; } = services;
{{~ if moves ~}}

    /// <summary>The module's own schema: the one its migrations name, and the one the MigrationRunner checks its model in.</summary>
    public string ModuleSchema { get; } = schema;

    /// <summary>The schema this instance works in: its tables, and its migrations history when it migrates.</summary>
    public string CurrentSchema { get; } = {{ slots["persistence.schema"] }};
{{~ end ~}}
{{ slots["persistence.context-members"] }}
{{~ if slots["persistence.save-changes"] != "" ~}}

    public override int SaveChanges(bool acceptAllChangesOnSuccess)
    {
        BeforeSaving();
        return base.SaveChanges(acceptAllChangesOnSuccess);
    }

    public override Task<int> SaveChangesAsync(bool acceptAllChangesOnSuccess, CancellationToken cancellationToken = default)
    {
        BeforeSaving();
        return base.SaveChangesAsync(acceptAllChangesOnSuccess, cancellationToken);
    }
{{~ end ~}}

{{~ if slots["persistence.interceptors"] != "" || moves ~}}

    protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)
    {
        {{ not_null "optionsBuilder" }}
{{~ if slots["persistence.interceptors"] != "" ~}}

        // Per instance: an interceptor may keep state for the context it belongs to.
        optionsBuilder.AddInterceptors(
{{ slots["persistence.interceptors"] }});
{{~ end ~}}
{{~ if moves ~}}

        // EF Core keeps one model per context type; a module context gets one per schema. Its migrations are read
        // through SchemaMigrationsAssembly in every schema, so one that cannot move fails before any of them runs, and
        // SchemaModelCustomizer refuses what its model cannot take to another schema.
        optionsBuilder.ReplaceService<IModelCacheKeyFactory, SchemaModelCacheKeyFactory>()
            .ReplaceService<IModelCustomizer, SchemaModelCustomizer>()
            .ReplaceService<IMigrationsAssembly, SchemaMigrationsAssembly>();
        if (CurrentSchema != ModuleSchema)
        {
            // Outside the module's schema, its migrations (which name the module's schema) and their history move to
            // this one. The model differs from the snapshot here by its schema alone; the MigrationRunner checks the
            // two against each other in the module's schema.
            var relational = RelationalOptionsExtension.Extract(optionsBuilder.Options).WithMigrationsHistoryTableSchema(CurrentSchema);
            ((IDbContextOptionsBuilderInfrastructure)optionsBuilder).AddOrUpdateExtension(relational);
            optionsBuilder.ConfigureWarnings(warnings => warnings.Ignore(RelationalEventId.PendingModelChangesWarning));
        }

{{~ end ~}}
        base.OnConfiguring(optionsBuilder);
    }
{{~ end ~}}

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        {{ not_null "modelBuilder" }}

        modelBuilder.HasDefaultSchema({{ if moves }}CurrentSchema{{ else }}schema{{ end }});
        modelBuilder.ApplyConfigurationsFromAssembly(GetType().Assembly);
{{ slots["persistence.model-conventions"] }}
        base.OnModelCreating(modelBuilder);
    }
{{~ if moves ~}}

    /// <summary>Whether SQL, or a name, qualifies an object with the module's schema: such SQL would reach the module's own objects.</summary>
    internal bool NamesModuleSchema(string sql) => SchemaReferences.Qualify(sql, ModuleSchema);
{{~ end ~}}
{{~ if slots["persistence.save-changes"] != "" ~}}

    private void BeforeSaving()
    {
{{ slots["persistence.save-changes"] }}
    }
{{~ end ~}}
}
