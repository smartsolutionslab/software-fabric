func test_user_token(app, user)
  ret `using var identity = new HttpClient();
var provider = await identity.GetFromJsonAsync<ProviderMetadata>(new Uri(` + app + `.GetEndpoint("identity", "http"), "/organizations/v2.0/.well-known/openid-configuration"))
    ?? throw new InvalidOperationException("The stand-in published no metadata.");
using var form = new FormUrlEncodedContent(new Dictionary<string, string>
{
    ["grant_type"] = "password",
    ["client_id"] = "` + name + `-web",
    ["username"] = ` + user + `,
    ["password"] = ` + user + `,
});
using var response = await identity.PostAsync(provider.TokenEndpoint, form);
response.EnsureSuccessStatusCode();
var token = await response.Content.ReadFromJsonAsync<TokenResponse>()
    ?? throw new InvalidOperationException("The stand-in returned no token.");`
end
func test_user_token_types
  ret `private sealed record ProviderMetadata([property: JsonPropertyName("token_endpoint")] Uri TokenEndpoint);
private sealed record TokenResponse([property: JsonPropertyName("access_token")] string AccessToken);`
end
func short_lived_test_user_token(app, user, lifespan)
  ret `var token = await ShortLivedTokenAsync(` + user + `, ` + lifespan + `, cancellationToken);`
end
func short_lived_test_user_token_members(app)
  ret `/// <summary>
/// A token of the stand-in that expires after lifespan seconds: its password grant takes a lifetime, which Entra ID's
/// token endpoint does not, so other users' tokens are untouched.
/// </summary>
private async Task<Token> ShortLivedTokenAsync(string user, int lifespan, CancellationToken cancellationToken)
{
    using var identity = new HttpClient();
    var provider = await identity.GetFromJsonAsync<StandInMetadata>(new Uri(` + app + `.GetEndpoint("identity", "http"), "/organizations/v2.0/.well-known/openid-configuration"), cancellationToken)
        ?? throw new InvalidOperationException("The stand-in published no metadata.");
    using var form = new FormUrlEncodedContent(new Dictionary<string, string>
    {
        ["grant_type"] = "password",
        ["client_id"] = "` + name + `-web",
        ["username"] = user,
        ["password"] = user,
        ["lifetime"] = lifespan.ToString(CultureInfo.InvariantCulture),
    });
    using var response = await identity.PostAsync(provider.TokenEndpoint, form, cancellationToken);
    response.EnsureSuccessStatusCode();
    return await response.Content.ReadFromJsonAsync<Token>(cancellationToken)
        ?? throw new InvalidOperationException("The stand-in returned no token.");
}`
end
func short_lived_test_user_token_types
  ret `private sealed record StandInMetadata([property: JsonPropertyName("token_endpoint")] Uri TokenEndpoint);

private sealed record Token([property: JsonPropertyName("access_token")] string AccessToken);`
end
