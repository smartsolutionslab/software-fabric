func tenant_claim_adr
  ret "the Entra ID directory that issued it, its `tid` claim, which `AzureAd:Tenants:<tenant> = <directory id>` maps to the tenant (locally `tenant-a` or `tenant-b`); one directory per tenant"
end
func tenant_claim(user)
  ret `var directories = ` + user + `.FindAll(DirectoryClaim)
    .Select(claim => claim.Value)
    .ToList();

return directories is [var directory] ? TenantOf(directory) : null;`
end
func tenant_claim_members
  ret `private const string DirectoryClaim = "tid";

private const string Tenants = "AzureAd:Tenants";

/// <summary>The tenant whose Entra ID directory this is: AzureAd:Tenants:&lt;tenant&gt; = &lt;directory id&gt;.</summary>
private string? TenantOf(string directory) =>
    (accessor.HttpContext?.RequestServices.GetService(typeof(Microsoft.Extensions.Configuration.IConfiguration)) as Microsoft.Extensions.Configuration.IConfiguration)?
        .GetSection(Tenants)
        .GetChildren()
        .Where(tenant => string.Equals(tenant.Value, directory, StringComparison.OrdinalIgnoreCase))
        .Select(tenant => tenant.Key)
        .SingleOrDefault();`
end
