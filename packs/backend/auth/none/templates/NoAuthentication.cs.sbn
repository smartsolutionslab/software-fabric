{{~ if project["backend.topology"] != "modular-monolith" && project["backend.topology"] != "services" ~}}
#error The backend.auth none pack's rule starts the modular-monolith host or the service hosts only so far (docs/adr/0006 of the generator).
{{~ end ~}}
using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.AspNetCore.Routing;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Microsoft.Extensions.Hosting;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// The project has no authentication (backend.auth: none), so every endpoint is anonymous: none may require
/// authorization, the host sets no fallback authorization policy (which would apply to every endpoint), and it
/// registers no authentication scheme of its own. Authentication comes from choosing an identity provider, not from
/// code added by hand. It reads the host's endpoints and services once in Development and
/// once in Production, so what is added in only one of them is checked too.
/// </summary>
public sealed class NoAuthentication : IArchitectureRule
{
    private const string Reason = "but the project has no authentication (backend.auth: none).";

    public string Description => "No endpoint requires authorization, no fallback policy applies and the host registers no authentication scheme: the project has no authentication.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        return [.. Found(Environments.Development)
            .Concat(Found(Environments.Production))
            .Distinct(StringComparer.Ordinal)
            .Order(StringComparer.Ordinal)];
    }

{{~ if project["backend.topology"] == "services" ~}}
    private static List<string> Found(string environment) =>
        [.. ServiceHostEntryPoints.All.SelectMany(entryPoint => Found(entryPoint, environment))];

    private static List<string> Found(Type entryPoint, string environment)
    {
        using var host = (IMappedHost)Activator.CreateInstance(typeof(MappedHost<>).MakeGenericType(entryPoint), environment)!;
{{~ else ~}}
    private static List<string> Found(string environment)
    {
        using var host = new MappedHost(environment);
{{~ end ~}}
        var endpoints = host.Services.GetRequiredService<EndpointDataSource>().Endpoints
            .OfType<RouteEndpoint>()
            .Where(endpoint => endpoint.Metadata.GetOrderedMetadata<IAuthorizeData>().Count > 0)
            .Select(endpoint => $"{Name(endpoint)} requires authorization, {Reason}");
        var schemes = (host.Services.GetService<IAuthenticationSchemeProvider>()?.GetAllSchemesAsync().GetAwaiter().GetResult() ?? [])
            .Select(scheme => $"The host registers the authentication scheme {scheme.Name}, {Reason}");
        List<string> fallback = host.Services.GetService<IAuthorizationPolicyProvider>()?.GetFallbackPolicyAsync().GetAwaiter().GetResult() is null
            ? []
            : [$"The host sets a fallback authorization policy, {Reason}"];

        return [.. endpoints.Concat(schemes).Concat(fallback)];
    }

    private static string Name(RouteEndpoint endpoint)
    {
        var methods = endpoint.Metadata.GetMetadata<IHttpMethodMetadata>()?.HttpMethods ?? [];
        var route = "/" + endpoint.RoutePattern.RawText?.TrimStart('/');
        return methods.Count == 0 ? route : $"{string.Join(',', methods)} {route}";
    }

{{~ if project["backend.topology"] == "services" ~}}
    private interface IMappedHost : IDisposable
    {
        IServiceProvider Services { get; }
    }

{{~ end ~}}
    /// <summary>
    /// The host with every endpoint mapped but nothing started: no hosted service runs, so the configuration Aspire
    /// would provide only has to be present, never reachable.
    /// </summary>
{{~ if project["backend.topology"] == "services" ~}}
    private sealed class MappedHost<TEntryPoint>(string environment) : WebApplicationFactory<TEntryPoint>, IMappedHost
        where TEntryPoint : class
{{~ else ~}}
    private sealed class MappedHost(string environment) : WebApplicationFactory<Program>
{{~ end ~}}
    {
        protected override void ConfigureWebHost(IWebHostBuilder builder)
        {
            builder.UseEnvironment(environment);
            builder.UseSetting("ConnectionStrings:database", "Host=localhost;Database=unused");
{{~ if project["backend.bus.transport"] == "kafka" ~}}
            builder.UseSetting("ConnectionStrings:messaging", "localhost:9092");
{{~ else if project["backend.bus.transport"] != "none" ~}}
            builder.UseSetting("ConnectionStrings:messaging", "amqp://localhost");
{{~ end ~}}
{{~ if project["backend.topology"] == "services" && project["backend.bus.transport"] == "rabbitmq" ~}}
            builder.UseSetting("Messaging:Queue", "unused");
{{~ else if project["backend.topology"] == "services" && project["backend.bus.transport"] == "azure-service-bus" ~}}
            builder.UseSetting("Messaging:Subscription", "unused");
{{~ else if project["backend.topology"] == "services" && project["backend.bus.transport"] == "kafka" ~}}
            builder.UseSetting("Messaging:ConsumerGroup", "unused");
{{~ end ~}}
            builder.ConfigureServices(services => services.RemoveAll<IHostedService>());
        }
    }
}
