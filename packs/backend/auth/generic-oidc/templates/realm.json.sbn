{{~ roles = project["backend.authorization"] | array.contains "roles" ~}}
{{~ staff = cross_tenant_reads ~}}
{{~ claims = project["backend.authorization"] | array.contains "claims" ~}}
{
  "realm": "{{ name }}",
  "enabled": true,
  "registrationAllowed": false,
{{~ if roles ~}}
  "roles": {
    "realm": [
      { "name": "manager", "description": "Sample role: each module's sample policy <module>.manage requires it." }{{ if staff }},
      { "name": "{{ cross_tenant_role }}", "description": "Reads every tenant's rows on an endpoint mapped with AcrossTenants(); each module's policy <module>.read-all-tenants requires it." }{{ end }}
    ]
  },
{{~ end ~}}
{{~ if project["backend.tenancy"] != "none" ~}}
  "groups": [
    { "name": "tenant-a" },
    { "name": "tenant-b" }
  ],
{{~ end ~}}
{{~ if claims ~}}
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"department\",\"displayName\":\"Department\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"]
        }
      }
    ]
  },
{{~ end ~}}
  "clients": [
    {
      "clientId": "{{ name }}-api",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "{{ name }}-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "{{ name }}-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
{{~ if project["backend.tenancy"] != "none" ~}}
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "tenant",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
{{~ end ~}}
{{~ if claims ~}}
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
{{~ end ~}}
{{~ if roles ~}}
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
{{~ end ~}}
        }
      ]
    }
  ],
{{~
  tenancy = project["backend.tenancy"] != "none"
  developers_department = null
  if claims
    developers_department = "finance"
  end
  users = [{ name: "developer", last: "Developer", roles: roles ? ["manager"] : [], department: developers_department, tenant: "tenant-a" }]
  if tenancy
    users = users | array.add { name: "developer-b", last: "Developer B", roles: roles ? ["manager"] : [], department: developers_department, tenant: "tenant-b" }
  end
  # A second user of the first tenant: without roles or claims, the one dashboards show they are their owner's alone.
  dashboards = object.has_key(project, "frontend.dashboards") && array.size(project["frontend.dashboards"]) > 0
  if roles || claims || dashboards
    users = users | array.add { name: "visitor", last: "Visitor", roles: [], department: null, tenant: "tenant-a" }
  end
  if claims
    users = users | array.add { name: "clerk", last: "Clerk", roles: roles ? ["manager"] : [], department: "sales", tenant: "tenant-a" }
    users = users | array.add { name: "analyst", last: "Analyst", roles: [], department: "finance", tenant: "tenant-a" }
  end
  # Staff belong to no tenant: they read every tenant's rows on endpoints that opt in, and nothing elsewhere.
  if staff
    users = users | array.add { name: cross_tenant_role, last: "Staff", roles: [cross_tenant_role], department: null, tenant: null }
  end
~}}
  "users": [
{{~ for user in users ~}}
    {
      "username": "{{ user.name }}",
      "enabled": true,
      "email": "{{ user.name }}@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "{{ user.last }}",
      "credentials": [{ "type": "password", "value": "{{ user.name }}", "temporary": false }]{{ if user.roles.size > 0 }},
      "realmRoles": [{{ for role in user.roles }}"{{ role }}"{{ if !for.last }}, {{ end }}{{ end }}]{{ end }}{{ if user.department }},
      "attributes": { "department": ["{{ user.department }}"] }{{ end }}{{ if tenancy && user.tenant }},
      "groups": ["/{{ user.tenant }}"]{{ end }}
    }{{ if !for.last }},{{ end }}
{{~ end ~}}
  ]
}
