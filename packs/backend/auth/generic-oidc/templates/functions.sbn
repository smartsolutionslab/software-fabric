  ret "http://localhost:8080/realms/" + name
end
func id_token_roles(roles)
  ret "roles: [" + roles + "]"
end
func id_token_has_role(profile, role)
  ret `const roles = ` + profile + `.roles;
return Array.isArray(roles) && roles.includes(` + role + `);`
end
