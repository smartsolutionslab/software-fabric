func test_user_token(app, user)
  ret `using var identity = new HttpClient();
var provider = await identity.GetFromJsonAsync<ProviderMetadata>(new Uri(` + app + `.GetEndpoint("identity", "http"), "/realms/` + name + `/.well-known/openid-configuration"))
    ?? throw new InvalidOperationException("The provider published no metadata.");
using var form = new FormUrlEncodedContent(new Dictionary<string, string>
{
    ["grant_type"] = "password",
    ["client_id"] = "` + name + `-web",
    ["username"] = ` + user + `,
    ["password"] = ` + user + `,
});
using var response = await identity.PostAsync(provider.TokenEndpoint, form);
response.EnsureSuccessStatusCode();
var token = await response.Content.ReadFromJsonAsync<TokenResponse>()
    ?? throw new InvalidOperationException("The provider returned no token.");`
end
func test_user_token_types
  ret `private sealed record ProviderMetadata([property: JsonPropertyName("token_endpoint")] Uri TokenEndpoint);

private sealed record TokenResponse([property: JsonPropertyName("access_token")] string AccessToken);`
end
func short_lived_test_user_token(app, user, lifespan)
  ret `const string ShortLivedClient = "` + name + `-short-lived";
using var identity = new HttpClient { BaseAddress = ` + app + `.GetEndpoint("identity", "http") };
identity.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", await AdminTokenAsync(identity, cancellationToken));

var clients = await identity.GetFromJsonAsync<JsonArray>(new Uri("/admin/realms/` + name + `/clients?clientId=` + name + `-web", UriKind.Relative), cancellationToken);
var client = clients?.Single()?.AsObject() ?? throw new InvalidOperationException("The realm has no web client.");
client.Remove("id");
client["clientId"] = ShortLivedClient;
client["attributes"] = new JsonObject { ["access.token.lifespan"] = ` + lifespan + `.ToString(System.Globalization.CultureInfo.InvariantCulture) };
foreach (var mapper in client["protocolMappers"]?.AsArray() ?? [])
{
    mapper?.AsObject().Remove("id");
}

using var created = await identity.PostAsJsonAsync(new Uri("/admin/realms/` + name + `/clients", UriKind.Relative), client, cancellationToken);
if (created.StatusCode != HttpStatusCode.Conflict)
{
    created.EnsureSuccessStatusCode();
}

using var form = new FormUrlEncodedContent(new Dictionary<string, string>
{
    ["grant_type"] = "password",
    ["client_id"] = ShortLivedClient,
    ["username"] = ` + user + `,
    ["password"] = ` + user + `,
});
using var response = await identity.PostAsync(new Uri("/realms/` + name + `/protocol/openid-connect/token", UriKind.Relative), form, cancellationToken);
response.EnsureSuccessStatusCode();
var token = await response.Content.ReadFromJsonAsync<Token>(cancellationToken)
    ?? throw new InvalidOperationException("The realm returned no token.");`
end
func short_lived_test_user_token_members(app)
  if project["backend.test.integration"] == "testcontainers"
    ret `/// <summary>A token of the master realm's administrator, as the fixture's Keycloak container starts with.</summary>
private static async Task<string> AdminTokenAsync(HttpClient identity, CancellationToken cancellationToken)
{
    using var form = new FormUrlEncodedContent(new Dictionary<string, string>
    {
        ["grant_type"] = "password",
        ["client_id"] = "admin-cli",
        ["username"] = "admin",
        ["password"] = "admin",
    });
    using var response = await identity.PostAsync(new Uri("/realms/master/protocol/openid-connect/token", UriKind.Relative), form, cancellationToken);
    response.EnsureSuccessStatusCode();
    var token = await response.Content.ReadFromJsonAsync<Token>(cancellationToken);
    return token?.AccessToken ?? throw new InvalidOperationException("The master realm returned no token.");
}`
  end
  ret `/// <summary>A token of the master realm's administrator; Aspire names it "admin" unless the AppHost passes a user name.</summary>
private async Task<string> AdminTokenAsync(HttpClient identity, CancellationToken cancellationToken)
{
    var keycloak = ` + app + `.Services.GetRequiredService<DistributedApplicationModel>().Resources.OfType<KeycloakResource>().Single();
    using var form = new FormUrlEncodedContent(new Dictionary<string, string>
    {
        ["grant_type"] = "password",
        ["client_id"] = "admin-cli",
        ["username"] = keycloak.AdminUserNameParameter is { } name ? await name.GetValueAsync(cancellationToken) ?? string.Empty : "admin",
        ["password"] = await keycloak.AdminPasswordParameter.GetValueAsync(cancellationToken) ?? string.Empty,
    });
    using var response = await identity.PostAsync(new Uri("/realms/master/protocol/openid-connect/token", UriKind.Relative), form, cancellationToken);
    response.EnsureSuccessStatusCode();
    var token = await response.Content.ReadFromJsonAsync<Token>(cancellationToken);
    return token?.AccessToken ?? throw new InvalidOperationException("The master realm returned no token.");
}`
end
