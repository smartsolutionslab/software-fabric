func accept_query_token(services, path)
  ret services + `.PostConfigure<JwtBearerOptions>(JwtBearerDefaults.AuthenticationScheme, options =>
{
    options.Events ??= new JwtBearerEvents();
    var received = options.Events.OnMessageReceived;
    options.Events.OnMessageReceived = async context =>
    {
        await received(context);
        if (context.Token is null
            && context.HttpContext.Request.Path.StartsWithSegments(` + path + `, StringComparison.Ordinal)
            && context.Request.Query["access_token"] is [{ Length: > 0 } token])
        {
            context.Token = token;
        }
    };
})`
end
func accept_query_token_namespaces
  ret "Microsoft.AspNetCore.Authentication.JwtBearer"
end
