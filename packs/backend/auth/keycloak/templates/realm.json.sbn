{
  "realm": "{{ name }}",
  "enabled": true,
  "registrationAllowed": false,
{{~ if project["backend.tenancy"] != "none" ~}}
  "groups": [
    { "name": "tenants", "subGroups": [ { "name": "tenant-a" }, { "name": "tenant-b" } ] }
  ],
{{~ end ~}}
  "clients": [
    {
      "clientId": "{{ name }}-api",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "{{ name }}-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "{{ name }}-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
{{~ if project["backend.tenancy"] != "none" ~}}
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
{{~ end ~}}
        }
      ]
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "email": "developer@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer",
      "credentials": [{ "type": "password", "value": "developer", "temporary": false }]{{ if project["backend.tenancy"] != "none" }},
      "groups": ["/tenants/tenant-a"]
    },
    {
      "username": "developer-b",
      "enabled": true,
      "email": "developer-b@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer B",
      "credentials": [{ "type": "password", "value": "developer-b", "temporary": false }],
      "groups": ["/tenants/tenant-b"]{{ end }}
    }
  ]
}
