using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Syntax;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// The host's <see cref="IChatClient"/> is the Ollama server's, with the endpoint and model the AppHost supplies, behind
/// the logging and OpenTelemetry every model call gets; and a host started without the endpoint says where it comes
/// from. The client is resolved and inspected, never called, so no Ollama server is needed. The host's
/// <c>Program.cs</c> is parsed, not run, to find the registration: module tests register a stand-in model, so without
/// it a use case that takes <see cref="IChatClient"/> would pass its tests and fail in the host.
/// </summary>
public sealed class OllamaIsTheProjectsModel : IArchitectureRule
{
    private const string Model = "llama3.2:1b";

    /// <summary>An endpoint nothing listens on: the client is never called.</summary>
    private const string Endpoint = "http://localhost:9/";

    private const string Registration = "AddOllamaChatClient";

    private const string HostProgram = "src/Host/Program.cs";

    public string Description => "The host calls AddOllamaChatClient, which registers the Ollama server behind logging and OpenTelemetry, with the AppHost's endpoint and model; a missing endpoint fails naming its AppHost resource.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        List<string> violations = [];
        if (!HostRegistersTheClient())
        {
            violations.Add($"{HostProgram} never calls {Registration}: the host has no IChatClient, and a use case that takes one fails to resolve.");
        }

        using (var services = Services(new() { ["Ollama:Endpoint"] = Endpoint, ["Ollama:Model"] = Model }))
        {
            var client = services.GetRequiredService<IChatClient>();
            var metadata = client.GetService<ChatClientMetadata>();
            if (metadata is not { ProviderName: "ollama", DefaultModelId: Model } || metadata.ProviderUri?.ToString() != Endpoint)
            {
                violations.Add($"The registered IChatClient is '{metadata?.ProviderName} {metadata?.DefaultModelId}' at '{metadata?.ProviderUri}', not 'ollama {Model}' at '{Endpoint}' from Ollama:Model and Ollama:Endpoint.");
            }

            if (client.GetService<LoggingChatClient>() is null || client.GetService<OpenTelemetryChatClient>() is null)
            {
                violations.Add("The registered IChatClient is not wrapped with UseLogging and UseOpenTelemetry; register it through AddModelChatClient.");
            }
        }

        using (var services = Services(new() { ["Ollama:Model"] = Model }))
        {
            try
            {
                services.GetRequiredService<IChatClient>();
                violations.Add("Without Ollama:Endpoint the IChatClient still resolved; it must fail, naming the AppHost resource 'ollama'.");
            }
            catch (InvalidOperationException exception) when (exception.Message.Contains("'ollama'", StringComparison.Ordinal))
            {
            }
        }

        return violations;
    }

    private static bool HostRegistersTheClient()
    {
        var program = Path.Combine(RepositoryRoot(), HostProgram);
        return File.Exists(program)
            && CSharpSyntaxTree.ParseText(File.ReadAllText(program)).GetRoot().DescendantNodes()
                .OfType<InvocationExpressionSyntax>()
                .Any(call => call.Expression is MemberAccessExpressionSyntax { Name.Identifier.ValueText: Registration });
    }

    /// <summary>The project root: the directory above the test output that holds build.proj.</summary>
    private static string RepositoryRoot()
    {
        var directory = new DirectoryInfo(AppContext.BaseDirectory);
        while (directory is not null && !File.Exists(Path.Combine(directory.FullName, "build.proj")))
        {
            directory = directory.Parent;
        }

        return directory?.FullName ?? throw new InvalidOperationException("build.proj not found above the test output directory.");
    }

    private static ServiceProvider Services(Dictionary<string, string?> settings)
    {
        var configuration = new ConfigurationBuilder().AddInMemoryCollection(settings).Build();
        var services = new ServiceCollection().AddLogging();
        services.AddOllamaChatClient(configuration);
        return services.BuildServiceProvider();
    }
}
