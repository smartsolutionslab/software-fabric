using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Syntax;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// The host's <see cref="IChatClient"/> is Claude, with the model the AppHost supplies, behind the logging and
/// OpenTelemetry every model call gets; and a host started without the key says which parameter is missing. The client
/// is resolved and inspected, never called. The host's <c>Program.cs</c> is parsed, not run, to find the registration:
/// module tests register a stand-in model, so without it a use case that takes <see cref="IChatClient"/> would pass
/// its tests and fail in the host.
/// </summary>
public sealed class AnthropicIsTheProjectsModel : IArchitectureRule
{
    private const string Model = "claude-haiku-5-5";

    private const string Registration = "AddAnthropicChatClient";

{{~ if project["backend.topology"] == "services" ~}}
    private const string ServiceHosts = "src/Services/";
{{~ else ~}}
    private const string HostProgram = "src/Host/Program.cs";
{{~ end ~}}

    public string Description => "{{ if project["backend.topology"] == "services" }}Every service host calls{{ else }}The host calls{{ end }} AddAnthropicChatClient, which registers Claude behind logging and OpenTelemetry, with the AppHost's key and model; a missing key fails naming its parameter.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

{{~ if project["backend.topology"] == "services" ~}}
        List<string> violations = [.. ServiceHostsWithoutTheClient()
            .Select(program => $"{program} never calls {Registration}: the service host has no IChatClient, and a use case that takes one fails to resolve.")];
{{~ else ~}}
        List<string> violations = [];
        if (!HostRegistersTheClient())
        {
            violations.Add($"{HostProgram} never calls {Registration}: the host has no IChatClient, and a use case that takes one fails to resolve.");
        }
{{~ end ~}}

        using (var services = Services(new() { ["Anthropic:ApiKey"] = "not-a-real-key", ["Anthropic:Model"] = Model }))
        {
            var client = services.GetRequiredService<IChatClient>();
            var metadata = client.GetService<ChatClientMetadata>();
            if (metadata is not { ProviderName: "anthropic", DefaultModelId: Model })
            {
                violations.Add($"The registered IChatClient is '{metadata?.ProviderName} {metadata?.DefaultModelId}', not 'anthropic {Model}' from Anthropic:Model.");
            }

            if (client.GetService<LoggingChatClient>() is null || client.GetService<OpenTelemetryChatClient>() is null)
            {
                violations.Add("The registered IChatClient is not wrapped with UseLogging and UseOpenTelemetry; register it through AddModelChatClient.");
            }
        }

        using (var services = Services(new() { ["Anthropic:Model"] = Model }))
        {
            try
            {
                services.GetRequiredService<IChatClient>();
                violations.Add("Without Anthropic:ApiKey the IChatClient still resolved; it must fail, naming the parameter anthropic-api-key.");
            }
            catch (InvalidOperationException exception) when (exception.Message.Contains("anthropic-api-key", StringComparison.Ordinal))
            {
            }
        }

        return violations;
    }

{{~ if project["backend.topology"] == "services" ~}}
    /// <summary>The Program.cs of every service host, src/Services/&lt;Module&gt;/Host, that never calls the registration.</summary>
    private static List<string> ServiceHostsWithoutTheClient()
    {
        var root = RepositoryRoot();
        var services = Path.Combine(root, ServiceHosts);
        if (!Directory.Exists(services))
        {
            return [];
        }

        return [.. Directory.EnumerateDirectories(services)
            .Where(service => File.Exists(Path.Combine(service, "Host", "Host.csproj")))
            .Select(service => $"{ServiceHosts}{Path.GetFileName(service)}/Host/Program.cs")
            .Where(program => !Registers(Path.Combine(root, program)))
            .Order(StringComparer.Ordinal)];
    }

    private static bool Registers(string program) =>
        File.Exists(program)
        && CSharpSyntaxTree.ParseText(File.ReadAllText(program)).GetRoot().DescendantNodes()
            .OfType<InvocationExpressionSyntax>()
            .Any(call => call.Expression is MemberAccessExpressionSyntax { Name.Identifier.ValueText: Registration });
{{~ else ~}}
    private static bool HostRegistersTheClient()
    {
        var program = Path.Combine(RepositoryRoot(), HostProgram);
        return File.Exists(program)
            && CSharpSyntaxTree.ParseText(File.ReadAllText(program)).GetRoot().DescendantNodes()
                .OfType<InvocationExpressionSyntax>()
                .Any(call => call.Expression is MemberAccessExpressionSyntax { Name.Identifier.ValueText: Registration });
    }
{{~ end ~}}

    /// <summary>The project root: the directory above the test output that holds build.proj.</summary>
    private static string RepositoryRoot()
    {
        var directory = new DirectoryInfo(AppContext.BaseDirectory);
        while (directory is not null && !File.Exists(Path.Combine(directory.FullName, "build.proj")))
        {
            directory = directory.Parent;
        }

        return directory?.FullName ?? throw new InvalidOperationException("build.proj not found above the test output directory.");
    }

    private static ServiceProvider Services(Dictionary<string, string?> settings)
    {
        var configuration = new ConfigurationBuilder().AddInMemoryCollection(settings).Build();
        var services = new ServiceCollection().AddLogging();
        services.AddAnthropicChatClient(configuration);
        return services.BuildServiceProvider();
    }
}
