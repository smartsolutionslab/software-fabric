using System.Globalization;
using {{ namespace }}.BuildingBlocks.Persistence;
using {{ namespace }}.BuildingBlocks.Tenancy;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.DependencyInjection;
using Npgsql;
using Pgvector;

namespace {{ namespace }}.BuildingBlocks.Rag;

/// <summary>
/// One module's records shared by all tenants (types configured with <c>SharedByAllTenants()</c>): the
/// <c>shared_embeddings</c> table in the schema of the module's own DbContext, <typeparamref name="TContext"/>, which the
/// MigrationRunner creates beside the tenants' <c>embeddings</c> table. Only work inside <c>WritesSharedRecords()</c>
/// indexes or removes a record; every tenant, staff and work without a tenant search them. A search never returns a
/// tenant's records: <see cref="ModuleVectorIndex{TContext}"/> searches the current tenant's own, and a use case that
/// wants both runs both searches. Every index and every search sends its text to the embeddings provider. A module uses
/// this only with its own DbContext.
/// </summary>
/// <typeparam name="TContext">The module's DbContext, whose <c>Schema</c> holds the table.</typeparam>
public sealed class SharedVectorIndex<TContext>(
    [FromKeyedServices(VectorTables.DataSourceKey)] NpgsqlDataSource dataSource,
    IEmbeddingGenerator<string, Embedding<float>> generator,
    ITenantContext tenants)
    where TContext : ModuleDbContext
{
    /// <summary>pgvector's bounds for hnsw.ef_search; its default is the lower one.</summary>
    private const int MinimumBreadth = 40;

    private const int MaximumBreadth = 1000;

    private static readonly string Table = VectorTables.SharedTable(VectorTables.SchemaOf(typeof(TContext)));

    /// <summary>Embeds the text and stores it under the key, replacing what the key held before; only inside <c>WritesSharedRecords()</c>.</summary>
    public async Task IndexAsync(string key, string text, CancellationToken cancellationToken)
    {
        {{ not_blank "key" }}
        {{ not_blank "text" }}

        RefuseOutsideTheScope("index", key);
        var embedding = await EmbedAsync(text, cancellationToken);
        await using var command = dataSource.CreateCommand(
            $"INSERT INTO {Table} (key, content, embedding) VALUES ($1, $2, $3) " +
            "ON CONFLICT (key) DO UPDATE SET content = excluded.content, embedding = excluded.embedding");
        command.Parameters.Add(new NpgsqlParameter { Value = key });
        command.Parameters.Add(new NpgsqlParameter { Value = text });
        command.Parameters.Add(new NpgsqlParameter { Value = embedding });
        await command.ExecuteNonQueryAsync(cancellationToken);
    }

    /// <summary>Removes the record stored under the key, if there is one; only inside <c>WritesSharedRecords()</c>.</summary>
    public async Task RemoveAsync(string key, CancellationToken cancellationToken)
    {
        {{ not_blank "key" }}

        RefuseOutsideTheScope("remove", key);
        await using var command = dataSource.CreateCommand($"DELETE FROM {Table} WHERE key = $1");
        command.Parameters.Add(new NpgsqlParameter { Value = key });
        await command.ExecuteNonQueryAsync(cancellationToken);
    }

    /// <summary>
    /// The <paramref name="count"/> shared records nearest to the query, nearest first, for any tenant or none. Their
    /// text is untrusted: whoever wrote a record wrote it, so it reaches a model as data in a delimited user message,
    /// never as instructions.
    /// </summary>
    public async Task<IReadOnlyList<RetrievedPassage>> SearchAsync(string query, int count, CancellationToken cancellationToken)
    {
        {{ not_blank "query" }}

        var embedding = await EmbedAsync(query, cancellationToken);
        await using var connection = await dataSource.OpenConnectionAsync(cancellationToken);
        await using var transaction = await connection.BeginTransactionAsync(cancellationToken);

        // An HNSW scan stops after hnsw.ef_search candidates (40 by default), so a wider search would come back short:
        // widen it to the count, and let the scan go on in order (pgvector's iterative scan) when that is not enough.
        await using (var breadth = new NpgsqlCommand("SELECT set_config('hnsw.ef_search', $1, true), set_config('hnsw.iterative_scan', 'strict_order', true)", connection, transaction))
        {
            breadth.Parameters.Add(new NpgsqlParameter { Value = Math.Clamp(count, MinimumBreadth, MaximumBreadth).ToString(CultureInfo.InvariantCulture) });
            await breadth.ExecuteNonQueryAsync(cancellationToken);
        }

        List<RetrievedPassage> passages = [];
        await using (var search = new NpgsqlCommand($"SELECT key, content, embedding <=> $1 FROM {Table} ORDER BY embedding <=> $1 LIMIT $2", connection, transaction))
        {
            search.Parameters.Add(new NpgsqlParameter { Value = embedding });
            search.Parameters.Add(new NpgsqlParameter { Value = count });
            await using var reader = await search.ExecuteReaderAsync(cancellationToken);
            while (await reader.ReadAsync(cancellationToken))
            {
                passages.Add(new RetrievedPassage(reader.GetString(0), reader.GetString(1), reader.GetDouble(2)));
            }
        }

        // The HNSW index is approximate: its scan stops after hnsw.max_scan_tuples, and a record no other links to in its
        // graph (as with records at equal distances from one another) is found at no breadth, so it can come back short.
        // Then every shared record is ranked exactly; the materialized set keeps the HNSW index out of that ranking.
        if (passages.Count < count)
        {
            passages.Clear();
            await using var exact = new NpgsqlCommand(
                $"WITH records AS MATERIALIZED (SELECT key, content, embedding FROM {Table}) " +
                "SELECT key, content, embedding <=> $1 FROM records ORDER BY embedding <=> $1, key LIMIT $2",
                connection,
                transaction);
            exact.Parameters.Add(new NpgsqlParameter { Value = embedding });
            exact.Parameters.Add(new NpgsqlParameter { Value = count });
            await using var reader = await exact.ExecuteReaderAsync(cancellationToken);
            while (await reader.ReadAsync(cancellationToken))
            {
                passages.Add(new RetrievedPassage(reader.GetString(0), reader.GetString(1), reader.GetDouble(2)));
            }
        }

        await transaction.CommitAsync(cancellationToken);
        return passages;
    }

    /// <summary>A shared record is every tenant's, so only staff write it, on an endpoint mapped with <c>WritesSharedRecords()</c>.</summary>
    private void RefuseOutsideTheScope(string action, string key)
    {
        if (!tenants.WritesSharedRecords)
        {
            throw new InvalidOperationException($"Cannot {action} the shared record '{key}' outside WritesSharedRecords(): records shared by all tenants are written only on an endpoint mapped with it.");
        }
    }

    private async Task<Vector> EmbedAsync(string text, CancellationToken cancellationToken) =>
        new(await generator.GenerateVectorAsync(text, cancellationToken: cancellationToken));
}
