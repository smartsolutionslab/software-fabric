{{~
  # shared_records is the tenant-column pack's; no other tenancy defines it.
  shared = false
  if project["backend.tenancy"] == "column"
    shared = shared_records
  end
~}}
{{~ schemas = project["backend.tenancy"] == "schema-per-tenant" ~}}
using {{ namespace }}.BuildingBlocks.Rag;
{{~ if schemas ~}}
using {{ namespace }}.BuildingBlocks.Tenancy;
{{~ end ~}}
using Microsoft.Extensions.Configuration;
using Npgsql;

namespace Microsoft.Extensions.DependencyInjection;

public static class VectorIndexRegistration
{
    private const string ConnectionStringName = "database";

    /// <summary>
{{~ if shared ~}}
    /// Registers <see cref="ModuleVectorIndex{TContext}"/> and <see cref="SharedVectorIndex{TContext}"/> for every module,
    /// over a data source of the connection
{{~ else ~}}
    /// Registers <see cref="ModuleVectorIndex{TContext}"/> for every module, over a data source of the connection
{{~ end ~}}
    /// string <c>database</c> that knows the <c>vector</c> type. The connection string is read when an index is first
    /// needed; registering connects to nothing.
{{~ if project["backend.tenancy"] == "column" || schemas ~}}
    /// An index is scoped, as the tenant source it reads is.
{{~ end ~}}
    /// </summary>
    public static IServiceCollection AddModuleVectorIndexes(this IServiceCollection services, IConfiguration configuration)
    {
        {{ not_null "configuration" }}

        return services
            .AddKeyedSingleton(VectorTables.DataSourceKey, (_, _) => VectorTables.DataSource(ConnectionString(configuration)))
{{~ if shared ~}}
            .AddScoped(typeof(ModuleVectorIndex<>))
            .AddScoped(typeof(SharedVectorIndex<>));
{{~ else if project["backend.tenancy"] == "column" || schemas ~}}
            .AddScoped(typeof(ModuleVectorIndex<>));
{{~ else ~}}
            .AddSingleton(typeof(ModuleVectorIndex<>));
{{~ end ~}}
    }

    /// <summary>
{{~ if schemas ~}}
    /// Creates the vector extension and each module's <c>embeddings</c> table in every schema of its DbContext for a
    /// tenant listed in Tenancy:Tenants. A step of the MigrationRunner, after the modules' migrations, so hosts never
    /// create tables.
{{~ else ~}}
{{~ if shared ~}}
    /// Creates the vector extension and each module's <c>embeddings</c> and <c>shared_embeddings</c> tables, in the
    /// schema of its DbContext. A step
{{~ else ~}}
    /// Creates the vector extension and each module's <c>embeddings</c> table, in the schema of its DbContext. A step
{{~ end ~}}
    /// of the MigrationRunner, after the modules' migrations, so hosts never create tables.
{{~ end ~}}
    /// </summary>
    public static Task CreateVectorTablesAsync(this IServiceProvider services, IEnumerable<Type> contexts, CancellationToken cancellationToken = default)
    {
        {{ not_null "contexts" }}
{{~ if schemas ~}}

        var configuration = services.GetRequiredService<IConfiguration>();
        var tenants = TenantSchemas.Listed(configuration);
        return VectorTables.CreateAsync(
            ConnectionString(configuration),
            contexts.Select(VectorTables.SchemaOf).SelectMany(schema => tenants.Select(tenant => TenantSchemas.For(schema, tenant))),
            cancellationToken);
{{~ else ~}}

        return VectorTables.CreateAsync(
            ConnectionString(services.GetRequiredService<IConfiguration>()),
            contexts.Select(VectorTables.SchemaOf),
            cancellationToken);
{{~ end ~}}
    }

    private static string ConnectionString(IConfiguration configuration) =>
        configuration.GetConnectionString(ConnectionStringName)
            ?? throw new InvalidOperationException($"Connection string '{ConnectionStringName}' is missing; Aspire provides it.");
}
