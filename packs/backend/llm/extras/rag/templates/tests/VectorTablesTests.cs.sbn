{{~ column = project["backend.tenancy"] == "column"
schemas = project["backend.tenancy"] == "schema-per-tenant" ~}}
using System.Reflection;
using {{ namespace }}.BuildingBlocks.Persistence;
using {{ namespace }}.BuildingBlocks.Rag;
{{~ if schemas ~}}
using {{ namespace }}.BuildingBlocks.Tenancy;
{{~ end ~}}
using Npgsql;

namespace {{ namespace }}.Rag.Tests;

{{~ if column ~}}
/// <summary>The vector tables the MigrationRunner made: one per module schema, of the embeddings model's size, with an HNSW cosine index and a tenant column its key includes.</summary>
{{~ else if schemas ~}}
/// <summary>The vector tables the MigrationRunner made: one in each listed tenant's schema of every module, of the embeddings model's size, with an HNSW cosine index.</summary>
{{~ else ~}}
/// <summary>The vector tables the MigrationRunner made: one per module schema, of the embeddings model's size, with an HNSW cosine index.</summary>
{{~ end ~}}
{{~ database_fixture_attributes ~}}
public sealed class VectorTablesTests({{ database_fixture }})
{
    {{ test_attribute }}
{{~ if schemas ~}}
    public async Task Every_listed_tenants_schema_of_every_module_has_an_embeddings_table_of_the_models_size_with_an_hnsw_cosine_index()
{{~ else ~}}
    public async Task Every_modules_schema_has_an_embeddings_table_of_the_models_size_with_an_hnsw_cosine_index()
{{~ end ~}}
    {
        var schemas = Directory.EnumerateFiles(AppContext.BaseDirectory, "{{ namespace }}.Modules.*.Infrastructure.dll")
            .Order(StringComparer.Ordinal)
            .Select(Assembly.LoadFrom)
            .SelectMany(assembly => assembly.GetTypes())
            .Where(type => type is { IsClass: true, IsAbstract: false } && typeof(ModuleDbContext).IsAssignableFrom(type))
            .Select(VectorTables.SchemaOf)
{{~ if schemas ~}}
            // The AppHost's tenants, which it gives the MigrationRunner as Tenancy:Tenants.
            .SelectMany(schema => ((string[])["tenant-a", "tenant-b"]).Select(tenant => TenantSchemas.For(schema, tenant)))
{{~ end ~}}
            .ToList();

        List<string> missing = [];
        foreach (var schema in schemas)
        {
            missing.AddRange(await ProblemsAsync(schema));
        }

        {{ `missing` | should_be_empty }};
    }

    {{ test_attribute }}
    public async Task Creating_the_tables_again_keeps_the_table_and_its_records()
    {
        var cancellationToken = {{ test_cancellation_token }};
        const string Schema = "rag_tests_again";
        await VectorTables.CreateAsync({{ database_connection_string }}, [Schema], cancellationToken);
        await ExecuteAsync($"INSERT INTO {VectorTables.Table(Schema)} ({{ if column }}tenant_id, {{ end }}key, content, embedding) VALUES ({{ if column }}'tenant-a', {{ end }}'kept', 'kept', array_fill(1, ARRAY[{VectorTables.Dimensions}])::vector)");

        await VectorTables.CreateAsync({{ database_connection_string }}, [Schema], cancellationToken);

        {{ `(await ProblemsAsync(Schema))` | should_be_empty }};
        {{ `(await ScalarAsync($"SELECT count(*)::text FROM {VectorTables.Table(Schema)}"))` | should_be `"1"` }};
    }

    private async Task<List<string>> ProblemsAsync(string schema)
    {
        List<string> problems = [];
        var column = await ScalarAsync($"SELECT format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = to_regclass('{VectorTables.Table(schema).Replace("'", "''", StringComparison.Ordinal)}') AND attname = 'embedding'");
        if (column != $"vector({VectorTables.Dimensions})")
        {
            problems.Add($"{schema}.embeddings has no embedding column of vector({VectorTables.Dimensions}) but '{column}'.");
        }

        var index = await ScalarAsync($"SELECT string_agg(indexdef, '; ') FROM pg_indexes WHERE schemaname = '{schema.Replace("'", "''", StringComparison.Ordinal)}' AND tablename = 'embeddings'");
        if (index?.Contains("USING hnsw (embedding vector_cosine_ops)", StringComparison.Ordinal) != true)
        {
            problems.Add($"{schema}.embeddings has no HNSW cosine index: '{index}'.");
        }
{{~ if column ~}}

        var tenant = await ScalarAsync($"SELECT format_type(atttypid, atttypmod) || CASE WHEN attnotnull THEN ' not null' ELSE '' END FROM pg_attribute WHERE attrelid = to_regclass('{VectorTables.Table(schema).Replace("'", "''", StringComparison.Ordinal)}') AND attname = 'tenant_id'");
        if (tenant != "text not null")
        {
            problems.Add($"{schema}.embeddings has no tenant_id column of text not null but '{tenant}'.");
        }

        if (index?.Contains("USING btree (tenant_id, key)", StringComparison.Ordinal) != true)
        {
            problems.Add($"{schema}.embeddings has no index on (tenant_id, key): '{index}'.");
        }
{{~ end ~}}

        return problems;
    }

    private async Task<string?> ScalarAsync(string sql)
    {
        await using var connection = new NpgsqlConnection({{ database_connection_string }});
        await connection.OpenAsync({{ test_cancellation_token }});
        await using var command = new NpgsqlCommand(sql, connection);
        return await command.ExecuteScalarAsync({{ test_cancellation_token }}) as string;
    }

    private async Task ExecuteAsync(string sql)
    {
        await using var connection = new NpgsqlConnection({{ database_connection_string }});
        await connection.OpenAsync({{ test_cancellation_token }});
        await using var command = new NpgsqlCommand(sql, connection);
        await command.ExecuteNonQueryAsync({{ test_cancellation_token }});
    }
}
