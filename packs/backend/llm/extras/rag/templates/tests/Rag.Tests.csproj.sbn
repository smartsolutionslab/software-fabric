<Project Sdk="Microsoft.NET.Sdk">

  <!-- The vector indexes against the AppHost's database alone (the pgvector image), after the MigrationRunner: no host, no model. -->
  <PropertyGroup>
    <RootNamespace>{{ namespace }}.Rag.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    {{ database_fixture_package_references }}
  </ItemGroup>

  <ItemGroup>
    {{ database_fixture_project_references }}
    <ProjectReference Include="../../src/BuildingBlocks/BuildingBlocks.csproj" />
    <ProjectReference Include="../../src/Modules/*/*.Infrastructure/*.Infrastructure.csproj" />
    <Compile Include="../Fakes/*.cs" Link="Fakes/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
