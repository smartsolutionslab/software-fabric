{{~ schemas = project["backend.tenancy"] == "schema-per-tenant"
tenant_argument = ""
if project["backend.tenancy"] == "column"
  tenant_argument = ", tenant"
else if schemas
  tenant_argument = ", Services"
end
func in_tenant(schema)
  if schemas
    ret "InTenant(" + schema + ")"
  end
  ret schema
end ~}}
using {{ namespace }}.BuildingBlocks.Rag;
{{~ if schemas ~}}
using {{ namespace }}.BuildingBlocks.Tenancy;
{{~ end ~}}
using {{ namespace }}.Tests.Fakes;
{{~ if schemas ~}}
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
{{~ end ~}}

namespace {{ namespace }}.Rag.Tests;

/// <summary>
/// A module's index in the AppHost's database: records indexed with a stand-in embeddings model come back from a
/// search nearest first. No test calls a real model.
/// </summary>
{{~ database_fixture_attributes ~}}
public sealed class VectorIndexTests({{ database_fixture }}) : {{ test_lifetime }}
{
{{~ if schemas ~}}
    private const string Tenant = "tenant-a";

{{~ end ~}}
    private readonly FakeEmbeddingGenerator generator = new(VectorTables.Dimensions);
{{~ if project["backend.tenancy"] == "column" ~}}

    private readonly OneTenant tenant = new("tenant-a");
{{~ end ~}}

    private Npgsql.NpgsqlDataSource? dataSource;
{{~ if schemas ~}}

    private ServiceProvider? services;
{{~ end ~}}

    private Npgsql.NpgsqlDataSource DataSource => dataSource ?? throw new InvalidOperationException("The data source has not been created.");
{{~ if schemas ~}}

    /// <summary>The tenant source fixed to one listed tenant, for the tests that are not about tenants.</summary>
    private ServiceProvider Services => services ?? throw new InvalidOperationException("The services have not been built.");
{{~ end ~}}

    {{ test_setup }}
    {
{{~ if project["backend.tenancy"] == "column" ~}}
        await VectorTables.CreateAsync({{ database_connection_string }}, [SampleNotesDbContext.Schema, SampleDraftsDbContext.Schema, SampleShelfDbContext.Schema], {{ test_cancellation_token }});
{{~ else if schemas ~}}
        var configuration = new ConfigurationBuilder()
            .AddInMemoryCollection(new Dictionary<string, string?> { [$"{TenantSchemas.Tenants}:0"] = Tenant })
            .Build();
        services = new ServiceCollection()
            .AddSingleton<IConfiguration>(configuration)
            .AddSingleton<ITenantContext>(new OneTenant(Tenant))
            .BuildServiceProvider();
        await VectorTables.CreateAsync({{ database_connection_string }}, [InTenant(SampleNotesDbContext.Schema), InTenant(SampleDraftsDbContext.Schema), InTenant(SampleShelfDbContext.Schema), InTenant(SampleLibraryDbContext.Schema)], {{ test_cancellation_token }});
{{~ else ~}}
        await VectorTables.CreateAsync({{ database_connection_string }}, [SampleNotesDbContext.Schema, SampleDraftsDbContext.Schema, SampleShelfDbContext.Schema, SampleLibraryDbContext.Schema], {{ test_cancellation_token }});
{{~ end ~}}
        dataSource = VectorTables.DataSource({{ database_connection_string }});
    }

    {{ test_attribute }}
    public async Task A_search_returns_the_nearest_records_first_with_their_text()
    {
        var cancellationToken = {{ test_cancellation_token }};
        var notes = new ModuleVectorIndex<SampleNotesDbContext>(DataSource, generator{{ tenant_argument }});
        await notes.IndexAsync("note-3", "team lunch on friday", cancellationToken);
        await notes.IndexAsync("invoice-1", "unpaid invoice for office chairs", cancellationToken);
        await notes.IndexAsync("invoice-2", "paid invoice for office desks", cancellationToken);

        var passages = await notes.SearchAsync("unpaid invoice for chairs", 3, cancellationToken);

        {{ `passages.Select(passage => passage.Key)` | should_be `["invoice-1", "invoice-2", "note-3"]` }};
        {{ `passages[0].Text` | should_be `"unpaid invoice for office chairs"` }};
        {{ `passages.Select(passage => passage.Distance)` | should_be_in_order }};
        {{ `(await notes.SearchAsync("unpaid invoice for chairs", 1, cancellationToken)).Select(passage => passage.Key)` | should_be `["invoice-1"]` }};
    }

    {{ test_attribute }}
    public async Task Indexing_a_key_again_replaces_its_record_and_removing_it_leaves_none()
    {
        var cancellationToken = {{ test_cancellation_token }};
        var drafts = new ModuleVectorIndex<SampleDraftsDbContext>(DataSource, generator{{ tenant_argument }});
        await drafts.IndexAsync("draft-1", "first draft about chairs", cancellationToken);

        await drafts.IndexAsync("draft-1", "second draft about desks", cancellationToken);

        var replaced = await drafts.SearchAsync("desks", 5, cancellationToken);
        {{ `replaced.Select(passage => (passage.Key, passage.Text))` | should_be `[("draft-1", "second draft about desks")]` }};

        await drafts.RemoveAsync("draft-1", cancellationToken);

        {{ `(await drafts.SearchAsync("desks", 5, cancellationToken))` | should_be_empty }};
    }

    {{ test_attribute }}
    public async Task A_search_the_hnsw_index_answers_returns_as_many_records_as_asked_beyond_its_default_breadth_of_40()
    {
        var cancellationToken = {{ test_cancellation_token }};
        var indexOnly = new Npgsql.NpgsqlConnectionStringBuilder({{ database_connection_string }}) { Options = "-c enable_seqscan=off" };
        await using var indexed = VectorTables.DataSource(indexOnly.ConnectionString);
        var shelf = new ModuleVectorIndex<SampleShelfDbContext>(indexed, generator{{ tenant_argument }});
        // Each record shares a word with the next. Records that shared only "book" would all lie at the same distance
        // from one another; HNSW keeps a neighbour of a record only when it lies nearer to the record than to the
        // neighbours already kept, so it would link each record to one other and, at random, leave some unreachable:
        // the search would come back short whatever its breadth.
        for (var number = 0; number < 60; number++)
        {
            await shelf.IndexAsync($"book-{number}", $"book {number} {number + 1}", cancellationToken);
        }

        var passages = await shelf.SearchAsync("book", 50, cancellationToken);

        {{ `passages.Count` | should_be `50` }};
        {{ `passages.Select(passage => passage.Distance)` | should_be_in_order }};
    }
{{~ if project["backend.tenancy"] != "column" ~}}

    {{ test_attribute }}
    public async Task A_search_the_hnsw_index_answers_short_ranks_every_record_exactly_and_returns_as_many_as_asked()
    {
        var cancellationToken = {{ test_cancellation_token }};
        var indexOnly = new Npgsql.NpgsqlConnectionStringBuilder({{ database_connection_string }}) { Options = "-c enable_seqscan=off" };
        await using var indexed = VectorTables.DataSource(indexOnly.ConnectionString);
        var library = new ModuleVectorIndex<SampleLibraryDbContext>(indexed, generator{{ tenant_argument }});
        await library.IndexAsync("novel", "a book of stories", cancellationToken);
        await library.IndexAsync("atlas", "a book of maps", cancellationToken);
        await library.IndexAsync("lunch", "team lunch on friday", cancellationToken);

        // Two records the HNSW index cannot reach, so it answers short. Records at equal distances from one another leave
        // some unreachable at random; a vector of no length is the certain case, as pgvector's cosine index leaves it out.
        await using (var unreachable = indexed.CreateCommand($"INSERT INTO {VectorTables.Table({{ in_tenant "SampleLibraryDbContext.Schema" }})} (key, content, embedding) SELECT 'blank-' || number, 'blank', $1 FROM generate_series(1, 2) number"))
        {
            unreachable.Parameters.Add(new Npgsql.NpgsqlParameter { Value = new Pgvector.Vector(new float[VectorTables.Dimensions]) });
            await unreachable.ExecuteNonQueryAsync(cancellationToken);
        }

        var passages = await library.SearchAsync("book", 5, cancellationToken);

        {{ `passages.Select(passage => passage.Key)` | should_be `["atlas", "novel", "lunch", "blank-1", "blank-2"]` }};
    }
{{~ end ~}}

    {{ test_teardown }}
    {
        generator.Dispose();
        if (dataSource is not null)
        {
            await dataSource.DisposeAsync();
        }
{{~ if schemas ~}}

        if (services is not null)
        {
            await services.DisposeAsync();
        }
{{~ end ~}}
    }
{{~ if schemas ~}}

    private static string InTenant(string schema) => TenantSchemas.For(schema, Tenant);
{{~ end ~}}
}
