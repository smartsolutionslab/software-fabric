{{~ if project["backend.test.assertions"] != "shouldly" ~}}
#error The rag pack's tests assert with Shouldly only so far (docs/adr/0006 of the generator).
{{~ end ~}}
{{~ tenant_argument = ""
if project["backend.tenancy"] == "column"
  tenant_argument = ", tenant"
end ~}}
using {{ namespace }}.BuildingBlocks.Rag;
using {{ namespace }}.Tests.Fakes;

namespace {{ namespace }}.Rag.Tests;

/// <summary>
/// A module's index in the AppHost's database: records indexed with a stand-in embeddings model come back from a
/// search nearest first. No test calls a real model.
/// </summary>
public sealed class VectorIndexTests(AspireDatabase database) : IAsyncLifetime
{
    private readonly FakeEmbeddingGenerator generator = new(VectorTables.Dimensions);
{{~ if project["backend.tenancy"] == "column" ~}}

    private readonly OneTenant tenant = new("tenant-a");
{{~ end ~}}

    private Npgsql.NpgsqlDataSource? dataSource;

    private Npgsql.NpgsqlDataSource DataSource => dataSource ?? throw new InvalidOperationException("The data source has not been created.");

    public async ValueTask InitializeAsync()
    {
{{~ if project["backend.tenancy"] == "column" ~}}
        await VectorTables.CreateAsync(database.ConnectionString, [SampleNotesDbContext.Schema, SampleDraftsDbContext.Schema, SampleShelfDbContext.Schema], TestContext.Current.CancellationToken);
{{~ else ~}}
        await VectorTables.CreateAsync(database.ConnectionString, [SampleNotesDbContext.Schema, SampleDraftsDbContext.Schema, SampleShelfDbContext.Schema, SampleLibraryDbContext.Schema], TestContext.Current.CancellationToken);
{{~ end ~}}
        dataSource = VectorTables.DataSource(database.ConnectionString);
    }

    [Fact]
    public async Task A_search_returns_the_nearest_records_first_with_their_text()
    {
        var cancellationToken = TestContext.Current.CancellationToken;
        var notes = new ModuleVectorIndex<SampleNotesDbContext>(DataSource, generator{{ tenant_argument }});
        await notes.IndexAsync("note-3", "team lunch on friday", cancellationToken);
        await notes.IndexAsync("invoice-1", "unpaid invoice for office chairs", cancellationToken);
        await notes.IndexAsync("invoice-2", "paid invoice for office desks", cancellationToken);

        var passages = await notes.SearchAsync("unpaid invoice for chairs", 3, cancellationToken);

        passages.Select(passage => passage.Key).ShouldBe(["invoice-1", "invoice-2", "note-3"]);
        passages[0].Text.ShouldBe("unpaid invoice for office chairs");
        passages.Select(passage => passage.Distance).ShouldBeInOrder();
        (await notes.SearchAsync("unpaid invoice for chairs", 1, cancellationToken)).Select(passage => passage.Key).ShouldBe(["invoice-1"]);
    }

    [Fact]
    public async Task Indexing_a_key_again_replaces_its_record_and_removing_it_leaves_none()
    {
        var cancellationToken = TestContext.Current.CancellationToken;
        var drafts = new ModuleVectorIndex<SampleDraftsDbContext>(DataSource, generator{{ tenant_argument }});
        await drafts.IndexAsync("draft-1", "first draft about chairs", cancellationToken);

        await drafts.IndexAsync("draft-1", "second draft about desks", cancellationToken);

        var replaced = await drafts.SearchAsync("desks", 5, cancellationToken);
        replaced.Select(passage => (passage.Key, passage.Text)).ShouldBe([("draft-1", "second draft about desks")]);

        await drafts.RemoveAsync("draft-1", cancellationToken);

        (await drafts.SearchAsync("desks", 5, cancellationToken)).ShouldBeEmpty();
    }

    [Fact]
    public async Task A_search_the_hnsw_index_answers_returns_as_many_records_as_asked_beyond_its_default_breadth_of_40()
    {
        var cancellationToken = TestContext.Current.CancellationToken;
        var indexOnly = new Npgsql.NpgsqlConnectionStringBuilder(database.ConnectionString) { Options = "-c enable_seqscan=off" };
        await using var indexed = VectorTables.DataSource(indexOnly.ConnectionString);
        var shelf = new ModuleVectorIndex<SampleShelfDbContext>(indexed, generator{{ tenant_argument }});
        // Each record shares a word with the next. Records that shared only "book" would all lie at the same distance
        // from one another; HNSW keeps a neighbour of a record only when it lies nearer to the record than to the
        // neighbours already kept, so it would link each record to one other and, at random, leave some unreachable:
        // the search would come back short whatever its breadth.
        for (var number = 0; number < 60; number++)
        {
            await shelf.IndexAsync($"book-{number}", $"book {number} {number + 1}", cancellationToken);
        }

        var passages = await shelf.SearchAsync("book", 50, cancellationToken);

        passages.Count.ShouldBe(50);
        passages.Select(passage => passage.Distance).ShouldBeInOrder();
    }
{{~ if project["backend.tenancy"] != "column" ~}}

    [Fact]
    public async Task A_search_the_hnsw_index_answers_short_ranks_every_record_exactly_and_returns_as_many_as_asked()
    {
        var cancellationToken = TestContext.Current.CancellationToken;

        // The HNSW scan stops once it has visited hnsw.max_scan_tuples (20,000 by default, 100 here) beyond its first
        // hnsw.ef_search candidates, and the index widens that breadth to 1000 at most, so a search for 1,100 of 1,200
        // records comes back short through the index. Records it cannot reach at all (equidistant ties) do the same.
        var scanLimited = new Npgsql.NpgsqlConnectionStringBuilder(database.ConnectionString) { Options = "-c enable_seqscan=off -c hnsw.max_scan_tuples=100" };
        await using var indexed = VectorTables.DataSource(scanLimited.ConnectionString);
        var library = new ModuleVectorIndex<SampleLibraryDbContext>(indexed, generator);
        for (var number = 0; number < 1200; number++)
        {
            await library.IndexAsync($"book-{number}", $"book {number} {number + 1}", cancellationToken);
        }

        var passages = await library.SearchAsync("book", 1100, cancellationToken);

        passages.Count.ShouldBe(1100);
        passages.Select(passage => passage.Key).ShouldBeUnique();
        passages.Select(passage => passage.Distance).ShouldBeInOrder();
    }
{{~ end ~}}

    public async ValueTask DisposeAsync()
    {
        generator.Dispose();
        if (dataSource is not null)
        {
            await dataSource.DisposeAsync();
        }
    }
}
