using Microsoft.Extensions.AI;

namespace {{ namespace }}.Evals;

/// <summary>
/// The use cases the evals score, each with its examples. The sample stands in for a module's: add a module's use case
/// by referencing its Application project and answering through its handler, with inputs that cover what it is for.
/// </summary>
public static class UseCases
{
    public static IReadOnlyList<EvalUseCase> All { get; } =
    [
        new(
            "ask-the-model",
            (model, example, cancellationToken) => model.GetResponseAsync(Messages(example), cancellationToken: cancellationToken),
            [
                new("In one sentence: what does an invoice record?"),
                new(
                    "When is invoice 2026-001 due?",
                    "Invoice 2026-001 was issued on 1 March 2026 for 1,200 EUR and is due 30 days after it was issued, on 31 March 2026."),
            ]),
    ];

    /// <summary>The sample's request: the question, after the records to answer from when the example has them.</summary>
    private static List<ChatMessage> Messages(EvalExample example)
    {
        List<ChatMessage> messages = [];
        if (example.GroundingContext is { } context)
        {
            messages.Add(new ChatMessage(ChatRole.System, $"Answer from these records only:\n{context}"));
        }

        messages.Add(new ChatMessage(ChatRole.User, example.Input));
        return messages;
    }
}
