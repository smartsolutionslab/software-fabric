using System.Reflection;
using System.Reflection.Emit;
using {{ namespace }}.BuildingBlocks.Agents;
using Microsoft.Extensions.AI;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// An agent's tool is one of its module's commands or queries, made with <see cref="DispatcherTool"/> and sent through
/// <c>IDispatcher</c>, so the handler's validation, and everything the dispatcher does around it, applies to a model's
/// call as to an endpoint's. A module that makes a tool any other way is found: a type of its own that derives from
/// <see cref="AITool"/>, a constructor of one called with <c>new</c>, or a method returning one that the BuildingBlocks
/// do not declare (<c>AIFunctionFactory.Create</c>, an agent's <c>AsAIFunction</c>), including in lambdas, closures and
/// async state machines. It cannot see a tool made by reflection, or what a tool made with
/// <see cref="DispatcherTool"/> is described as.
/// </summary>
public sealed class AgentToolsGoThroughTheDispatcher : IArchitectureRule
{
    private const BindingFlags Declared = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly;

    private static readonly Assembly BuildingBlocks = typeof(DispatcherTool).Assembly;

    private static readonly Dictionary<short, OpCode> OpCodesByValue = typeof(OpCodes)
        .GetFields(BindingFlags.Public | BindingFlags.Static)
        .Select(field => (OpCode)field.GetValue(null)!)
        .ToDictionary(code => code.Value);

    public string Description => "Every tool a module gives an agent is a command or query made with DispatcherTool.For<TRequest>, sent through IDispatcher; a module makes no AITool of its own.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        List<string> violations = [];
        foreach (var type in model.ModuleAssemblies.SelectMany(assembly => assembly.GetTypes()))
        {
            if (typeof(AITool).IsAssignableFrom(type))
            {
                violations.Add($"{Outermost(type).FullName} is a tool of its own (it derives from {type.BaseType!.Name}), not DispatcherTool.For<TRequest>: an agent's tool is a command or query of its module, sent through IDispatcher.");
            }

            foreach (var maker in type.GetMethods(Declared).Cast<MethodBase>().Concat(type.GetConstructors(Declared)).SelectMany(ToolsMade))
            {
                violations.Add($"{Outermost(type).FullName} makes a tool with {maker}, not DispatcherTool.For<TRequest>: an agent's tool is a command or query of its module, sent through IDispatcher.");
            }
        }

        return violations.Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal);
    }

    /// <summary>The type a lambda's closure or an async state machine was written in.</summary>
    private static Type Outermost(Type type) => type.DeclaringType is { } declaring ? Outermost(declaring) : type;

    /// <summary>
    /// How a method body makes a tool: <c>new</c> on an <see cref="AITool"/>, or a call to a method returning one that is
    /// not the BuildingBlocks', as <c>AIFunctionFactory.Create</c>.
    /// </summary>
    private static IEnumerable<string> ToolsMade(MethodBase method)
    {
        var il = method.GetMethodBody()?.GetILAsByteArray() ?? [];
        var typeArguments = method.DeclaringType is { IsGenericType: true } declaring ? declaring.GetGenericArguments() : null;
        var methodArguments = method is MethodInfo { IsGenericMethod: true } ? method.GetGenericArguments() : null;

        var position = 0;
        while (position < il.Length)
        {
            var twoBytes = il[position] == 0xFE;
            var code = OpCodesByValue[twoBytes ? unchecked((short)(0xFE00 | il[position + 1])) : il[position]];
            position += twoBytes ? 2 : 1;

            if (code == OpCodes.Newobj || code == OpCodes.Call || code == OpCodes.Callvirt)
            {
                var member = method.Module.ResolveMember(BitConverter.ToInt32(il, position), typeArguments, methodArguments);
                if (member is ConstructorInfo constructor && typeof(AITool).IsAssignableFrom(constructor.DeclaringType))
                {
                    yield return $"new {constructor.DeclaringType!.Name}(...)";
                }
                else if (member is MethodInfo called && typeof(AITool).IsAssignableFrom(called.ReturnType) && called.DeclaringType?.Assembly != BuildingBlocks)
                {
                    yield return $"{called.DeclaringType?.Name}.{called.Name}";
                }
            }

            position += OperandSize(code, il, position);
        }
    }

    private static int OperandSize(OpCode code, byte[] il, int position) => code.OperandType switch
    {
        OperandType.InlineNone => 0,
        OperandType.ShortInlineBrTarget or OperandType.ShortInlineI or OperandType.ShortInlineVar => 1,
        OperandType.InlineVar => 2,
        OperandType.InlineI8 or OperandType.InlineR => 8,
        OperandType.InlineSwitch => 4 + (4 * BitConverter.ToInt32(il, position)),
        _ => 4,
    };
}
