using System.Reflection;
using {{ namespace }}.BuildingBlocks.Agents;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.AspNetCore.Routing;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Microsoft.Extensions.Hosting;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// An agent's tool requires of its caller what the endpoints that send its request require, so every request a module
/// makes a tool of with <see cref="DispatcherTool"/><c>.For&lt;TRequest&gt;</c> needs an endpoint marked
/// <c>.Sends&lt;TRequest&gt;()</c>: without one the tool is refused at every call. It reads the host's own endpoint table
/// once in Development and once in Production, and counts an endpoint mapped in either.
/// </summary>
public sealed class EveryAgentToolRequestHasAnEndpoint : IArchitectureRule
{
    public string Description => "Every command or query a module makes an agent's tool of is sent by an endpoint marked .Sends<TRequest>(), whose authorization the tool then requires.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        var requests = model.ModuleAssemblies
            .SelectMany(assembly => assembly.GetTypes())
            .SelectMany(type => type.GetMethods(EveryAgentToolRequestIsValid.Declared).Cast<MethodBase>().Concat(type.GetConstructors(EveryAgentToolRequestIsValid.Declared)))
            .SelectMany(EveryAgentToolRequestIsValid.ToolRequests)
            .ToHashSet();
        if (requests.Count == 0)
        {
            return [];
        }

        var sent = Sent(Environments.Development).Concat(Sent(Environments.Production)).ToHashSet();
        return [.. requests
            .Where(request => !sent.Contains(request))
            .Select(request => $"{request.FullName} is an agent's tool, but no endpoint sends it: mark the endpoint that sends it with .Sends<{request.Name}>(), whose authorization the tool then requires of its caller.")
            .Order(StringComparer.Ordinal)];
    }

    private static List<Type> Sent(string environment)
    {
        using var host = new MappedHost(environment);
        return [.. host.Services.GetRequiredService<EndpointDataSource>().Endpoints
            .SelectMany(endpoint => endpoint.Metadata.GetOrderedMetadata<SendsRequest>())
            .Select(sends => sends.Request)];
    }

    /// <summary>
    /// The host with every endpoint mapped but nothing started: no hosted service runs, so the configuration Aspire
    /// would provide only has to be present, never reachable.
    /// </summary>
    private sealed class MappedHost(string environment) : WebApplicationFactory<Program>
    {
        protected override void ConfigureWebHost(IWebHostBuilder builder)
        {
            builder.UseEnvironment(environment);
            builder.UseSetting("ConnectionStrings:database", "Host=localhost;Database=unused");
{{~ if project["backend.bus.transport"] == "kafka" ~}}
            builder.UseSetting("ConnectionStrings:messaging", "localhost:9092");
{{~ else if project["backend.bus.transport"] != "none" ~}}
            builder.UseSetting("ConnectionStrings:messaging", "amqp://localhost");
{{~ end ~}}
{{~ if project["backend.auth"] != "none" ~}}
            {{ unstarted_host_settings }}
{{~ end ~}}
            builder.ConfigureServices(services => services.RemoveAll<IHostedService>());
        }
    }
}
