using System.ClientModel;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Configuration;
using OpenAI;

namespace Microsoft.Extensions.DependencyInjection;

public static class AzureOpenAIChatClient
{
    /// <summary>
    /// Registers a model deployed in an Azure OpenAI resource as the project's <see cref="IChatClient"/>, through the
    /// official <c>OpenAI</c> package and Microsoft's adapter (<c>Microsoft.Extensions.AI.OpenAI</c>) calling the
    /// resource's OpenAI v1 endpoint, <c>&lt;endpoint&gt;/openai/v1/</c>. The endpoint, the deployment and the key come
    /// from the AppHost's parameters <c>azure-openai-endpoint</c>, <c>azure-openai-deployment</c> and
    /// <c>azure-openai-api-key</c> (<c>AzureOpenAI:Endpoint</c>, <c>AzureOpenAI:Deployment</c>, <c>AzureOpenAI:ApiKey</c>).
    /// They are read when the client is first needed, and a missing one fails there, naming its parameter; registering
    /// sends nothing.
    /// </summary>
    public static ChatClientBuilder AddAzureOpenAIChatClient(this IServiceCollection services, IConfiguration configuration)
    {
        {{ not_null "configuration" }}

        return services.AddModelChatClient(_ =>
        {
            var endpoint = new Uri(Required(configuration, "AzureOpenAI:Endpoint", "azure-openai-endpoint").TrimEnd('/') + "/openai/v1/");
            return new OpenAIClient(
                    new ApiKeyCredential(Required(configuration, "AzureOpenAI:ApiKey", "azure-openai-api-key")),
                    new OpenAIClientOptions { Endpoint = endpoint })
                .GetChatClient(Required(configuration, "AzureOpenAI:Deployment", "azure-openai-deployment"))
                .AsIChatClient();
        });
    }

    private static string Required(IConfiguration configuration, string key, string parameter) =>
        configuration[key] is { Length: > 0 } value
            ? value
            : throw new InvalidOperationException($"{key} is not set. The AppHost supplies it from its parameter '{parameter}': set that with dotnet user-secrets (Parameters:{parameter}) or in the deployment's secret store.");
}
