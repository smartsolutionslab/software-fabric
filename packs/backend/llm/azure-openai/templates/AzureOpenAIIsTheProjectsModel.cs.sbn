using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Syntax;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// The host's <see cref="IChatClient"/> is the Azure OpenAI deployment the AppHost names, called through the resource's
/// OpenAI v1 endpoint, or through an OpenAI-compatible endpoint used as is when it already ends in <c>/v1</c>, behind the
/// logging and OpenTelemetry every model call gets; and a host started without the endpoint or the key says which
/// parameter is missing. The client is resolved and inspected, never called. The host's <c>Program.cs</c> is parsed, not
/// run, to find the registration: module tests register a stand-in model, so without it a use case that takes
/// <see cref="IChatClient"/> would pass its tests and fail in the host.
/// </summary>
public sealed class AzureOpenAIIsTheProjectsModel : IArchitectureRule
{
    private const string Deployment = "gpt-5-mini";

    private const string Endpoint = "https://not-a-real-resource.openai.azure.com";

    private const string CompatibleEndpoint = "https://api.openai.com/v1";

    private const string Registration = "AddAzureOpenAIChatClient";

    private const string HostProgram = "src/Host/Program.cs";

    public string Description => "The host calls AddAzureOpenAIChatClient, which registers the AppHost's Azure OpenAI deployment behind logging and OpenTelemetry, against <endpoint>/openai/v1/, or against an endpoint ending in /v1 as is; a missing endpoint or key fails naming its parameter.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        List<string> violations = [];
        if (!HostRegistersTheClient())
        {
            violations.Add($"{HostProgram} never calls {Registration}: the host has no IChatClient, and a use case that takes one fails to resolve.");
        }

        foreach (var (endpoint, expected) in new[] { (Endpoint, new Uri($"{Endpoint}/openai/v1/")), (CompatibleEndpoint, new Uri(CompatibleEndpoint)) })
        {
            using var services = Services(new() { ["AzureOpenAI:Endpoint"] = endpoint, ["AzureOpenAI:Deployment"] = Deployment, ["AzureOpenAI:ApiKey"] = "not-a-real-key" });
            var client = services.GetRequiredService<IChatClient>();
            var metadata = client.GetService<ChatClientMetadata>();
            if (metadata is not { DefaultModelId: Deployment } || metadata.ProviderUri != expected)
            {
                violations.Add($"With AzureOpenAI:Endpoint '{endpoint}' the registered IChatClient calls '{metadata?.DefaultModelId}' at '{metadata?.ProviderUri}', not the deployment '{Deployment}' from AzureOpenAI:Deployment at '{expected}'.");
            }

            if (client.GetService<LoggingChatClient>() is null || client.GetService<OpenTelemetryChatClient>() is null)
            {
                violations.Add("The registered IChatClient is not wrapped with UseLogging and UseOpenTelemetry; register it through AddModelChatClient.");
            }
        }

        foreach (var (missing, parameter) in new[] { ("AzureOpenAI:Endpoint", "azure-openai-endpoint"), ("AzureOpenAI:ApiKey", "azure-openai-api-key") })
        {
            Dictionary<string, string?> settings = new() { ["AzureOpenAI:Endpoint"] = Endpoint, ["AzureOpenAI:Deployment"] = Deployment, ["AzureOpenAI:ApiKey"] = "not-a-real-key" };
            settings.Remove(missing);
            using var services = Services(settings);
            try
            {
                services.GetRequiredService<IChatClient>();
                violations.Add($"Without {missing} the IChatClient still resolved; it must fail, naming the parameter {parameter}.");
            }
            catch (InvalidOperationException exception) when (exception.Message.Contains(parameter, StringComparison.Ordinal))
            {
            }
        }

        return violations;
    }

    private static bool HostRegistersTheClient()
    {
        var program = Path.Combine(RepositoryRoot(), HostProgram);
        return File.Exists(program)
            && CSharpSyntaxTree.ParseText(File.ReadAllText(program)).GetRoot().DescendantNodes()
                .OfType<InvocationExpressionSyntax>()
                .Any(call => call.Expression is MemberAccessExpressionSyntax { Name.Identifier.ValueText: Registration });
    }

    /// <summary>The project root: the directory above the test output that holds build.proj.</summary>
    private static string RepositoryRoot()
    {
        var directory = new DirectoryInfo(AppContext.BaseDirectory);
        while (directory is not null && !File.Exists(Path.Combine(directory.FullName, "build.proj")))
        {
            directory = directory.Parent;
        }

        return directory?.FullName ?? throw new InvalidOperationException("build.proj not found above the test output directory.");
    }

    private static ServiceProvider Services(Dictionary<string, string?> settings)
    {
        var configuration = new ConfigurationBuilder().AddInMemoryCollection(settings).Build();
        var services = new ServiceCollection().AddLogging();
        services.AddAzureOpenAIChatClient(configuration);
        return services.BuildServiceProvider();
    }
}
