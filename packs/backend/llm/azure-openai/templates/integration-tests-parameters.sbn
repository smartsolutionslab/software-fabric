{{~ stand_in = false
if object.has_key(project, "backend.llm.extras") && (array.contains project["backend.llm.extras"] "rag")
  stand_in = project["backend.llm.embeddings"] == "azure-openai"
end ~}}
{{~ if stand_in ~}}
        // A key-shaped value Azure does not accept: the integration tests never call the model. The endpoint is the fixture's
        // embeddings stand-in, given below, which answers chat requests with a 404.
{{~ else ~}}
        // A resource that does not exist and a key-shaped value Azure does not accept: the integration tests never call the model.
        builder.Configuration["Parameters:azure-openai-endpoint"] = "https://not-a-real-resource.openai.azure.com";
{{~ end ~}}
        builder.Configuration["Parameters:azure-openai-api-key"] = "not-a-real-key";