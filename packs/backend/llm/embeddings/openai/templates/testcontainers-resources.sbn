{{ if project["backend.llm"] == "openai" ~}}
        // Embeddings use the chat model's key, given its value above; the AppHost's default embedding model, against the
        // fixture's stand-in.
{{~ else ~}}
        // A key-shaped value OpenAI does not accept, and the AppHost's default embedding model: the host embeds against the
        // fixture's stand-in, never OpenAI.
        settings["OpenAI:ApiKey"] = "not-a-real-key";
{{~ end }}
        settings["OpenAI:EmbeddingModel"] = "text-embedding-3-small";
        settings["OpenAI:EmbeddingEndpoint"] = embeddings.Endpoint;
