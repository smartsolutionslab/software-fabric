using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Syntax;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// The host's <see cref="IEmbeddingGenerator{TInput, TEmbedding}"/> is OpenAI's, with the embedding model the AppHost
/// supplies, behind the logging and OpenTelemetry every model call gets; and a host started without the key says which
/// parameter is missing. The generator is resolved and inspected, never called. The host's <c>Program.cs</c> is parsed,
/// not run, to find the registration: tests stand in for the generator, so without it code that takes one would pass
/// its tests and fail in the host.
/// </summary>
public sealed class OpenAIGeneratesTheProjectsEmbeddings : IArchitectureRule
{
    private const string Model = "text-embedding-3-small";

    private const string Registration = "AddOpenAIEmbeddingGenerator";

{{~ if project["backend.topology"] == "services" ~}}
    private const string ServiceHosts = "src/Services/";
{{~ else ~}}
    private const string HostProgram = "src/Host/Program.cs";
{{~ end ~}}

    public string Description => "{{ if project["backend.topology"] == "services" }}Every service host calls{{ else }}The host calls{{ end }} AddOpenAIEmbeddingGenerator, which registers OpenAI's embeddings behind logging and OpenTelemetry, with the AppHost's key and embedding model; a missing key fails naming its parameter.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

{{~ if project["backend.topology"] == "services" ~}}
        List<string> violations = [.. ServiceHostsWithoutTheGenerator()
            .Select(program => $"{program} never calls {Registration}: the service host has no IEmbeddingGenerator, and code that takes one fails to resolve.")];
{{~ else ~}}
        List<string> violations = [];
        if (!HostRegistersTheGenerator())
        {
            violations.Add($"{HostProgram} never calls {Registration}: the host has no IEmbeddingGenerator, and code that takes one fails to resolve.");
        }
{{~ end ~}}

        using (var services = Services(new() { ["OpenAI:ApiKey"] = "not-a-real-key", ["OpenAI:EmbeddingModel"] = Model }))
        {
            var generator = services.GetRequiredService<IEmbeddingGenerator<string, Embedding<float>>>();
            var metadata = generator.GetService<EmbeddingGeneratorMetadata>();
            if (metadata is not { ProviderName: "openai", DefaultModelId: Model })
            {
                violations.Add($"The registered IEmbeddingGenerator is '{metadata?.ProviderName} {metadata?.DefaultModelId}', not 'openai {Model}' from OpenAI:EmbeddingModel.");
            }

            if (generator.GetService<LoggingEmbeddingGenerator<string, Embedding<float>>>() is null
                || generator.GetService<OpenTelemetryEmbeddingGenerator<string, Embedding<float>>>() is null)
            {
                violations.Add("The registered IEmbeddingGenerator is not wrapped with UseLogging and UseOpenTelemetry.");
            }
        }

        using (var services = Services(new() { ["OpenAI:EmbeddingModel"] = Model }))
        {
            try
            {
                services.GetRequiredService<IEmbeddingGenerator<string, Embedding<float>>>();
                violations.Add("Without OpenAI:ApiKey the IEmbeddingGenerator still resolved; it must fail, naming the parameter openai-api-key.");
            }
            catch (InvalidOperationException exception) when (exception.Message.Contains("openai-api-key", StringComparison.Ordinal))
            {
            }
        }

        return violations;
    }

{{~ if project["backend.topology"] == "services" ~}}
    /// <summary>The Program.cs of every service host, src/Services/&lt;Module&gt;/Host, that never calls the registration.</summary>
    private static List<string> ServiceHostsWithoutTheGenerator()
    {
        var root = RepositoryRoot();
        var services = Path.Combine(root, ServiceHosts);
        if (!Directory.Exists(services))
        {
            return [];
        }

        return [.. Directory.EnumerateDirectories(services)
            .Where(service => File.Exists(Path.Combine(service, "Host", "Host.csproj")))
            .Select(service => $"{ServiceHosts}{Path.GetFileName(service)}/Host/Program.cs")
            .Where(program => !Registers(Path.Combine(root, program)))
            .Order(StringComparer.Ordinal)];
    }

    private static bool Registers(string program) =>
        File.Exists(program)
        && CSharpSyntaxTree.ParseText(File.ReadAllText(program)).GetRoot().DescendantNodes()
            .OfType<InvocationExpressionSyntax>()
            .Any(call => call.Expression is MemberAccessExpressionSyntax { Name.Identifier.ValueText: Registration });
{{~ else ~}}
    private static bool HostRegistersTheGenerator()
    {
        var program = Path.Combine(RepositoryRoot(), HostProgram);
        return File.Exists(program)
            && CSharpSyntaxTree.ParseText(File.ReadAllText(program)).GetRoot().DescendantNodes()
                .OfType<InvocationExpressionSyntax>()
                .Any(call => call.Expression is MemberAccessExpressionSyntax { Name.Identifier.ValueText: Registration });
    }
{{~ end ~}}

    /// <summary>The project root: the directory above the test output that holds build.proj.</summary>
    private static string RepositoryRoot()
    {
        var directory = new DirectoryInfo(AppContext.BaseDirectory);
        while (directory is not null && !File.Exists(Path.Combine(directory.FullName, "build.proj")))
        {
            directory = directory.Parent;
        }

        return directory?.FullName ?? throw new InvalidOperationException("build.proj not found above the test output directory.");
    }

    private static ServiceProvider Services(Dictionary<string, string?> settings)
    {
        var configuration = new ConfigurationBuilder().AddInMemoryCollection(settings).Build();
        var services = new ServiceCollection().AddLogging();
        services.AddOpenAIEmbeddingGenerator(configuration);
        return services.BuildServiceProvider();
    }
}
