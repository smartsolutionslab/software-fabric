using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Syntax;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// The host's <see cref="IEmbeddingGenerator{TInput, TEmbedding}"/> is the Azure OpenAI embedding deployment the AppHost
/// names, called through the resource's OpenAI v1 endpoint, or through an OpenAI-compatible endpoint used as is when it
/// already ends in <c>/v1</c>, behind the logging and OpenTelemetry every model call gets;
/// and a host started without the endpoint or the key says which parameter is missing. The generator is resolved and
/// inspected, never called. The host's <c>Program.cs</c> is parsed, not run, to find the registration: tests stand in
/// for the generator, so without it code that takes one would pass its tests and fail in the host.
/// </summary>
public sealed class AzureOpenAIGeneratesTheProjectsEmbeddings : IArchitectureRule
{
    private const string Deployment = "text-embedding-3-small";

    private const string Endpoint = "https://not-a-real-resource.openai.azure.com";

    private const string CompatibleEndpoint = "https://api.openai.com/v1";

    private const string Registration = "AddAzureOpenAIEmbeddingGenerator";

    private const string HostProgram = "src/Host/Program.cs";

    public string Description => "The host calls AddAzureOpenAIEmbeddingGenerator, which registers the AppHost's Azure OpenAI embedding deployment behind logging and OpenTelemetry, against <endpoint>/openai/v1/, or against an endpoint ending in /v1 as is; a missing endpoint or key fails naming its parameter.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        List<string> violations = [];
        if (!HostRegistersTheGenerator())
        {
            violations.Add($"{HostProgram} never calls {Registration}: the host has no IEmbeddingGenerator, and code that takes one fails to resolve.");
        }

        foreach (var (endpoint, expected) in new[] { (Endpoint, new Uri($"{Endpoint}/openai/v1/")), (CompatibleEndpoint, new Uri(CompatibleEndpoint)) })
        {
            var settings = Settings();
            settings["AzureOpenAI:Endpoint"] = endpoint;
            using var services = Services(settings);
            var generator = services.GetRequiredService<IEmbeddingGenerator<string, Embedding<float>>>();
            var metadata = generator.GetService<EmbeddingGeneratorMetadata>();
            if (metadata is not { DefaultModelId: Deployment } || metadata.ProviderUri != expected)
            {
                violations.Add($"With AzureOpenAI:Endpoint '{endpoint}' the registered IEmbeddingGenerator calls '{metadata?.DefaultModelId}' at '{metadata?.ProviderUri}', not the deployment '{Deployment}' from AzureOpenAI:EmbeddingDeployment at '{expected}'.");
            }

            if (generator.GetService<LoggingEmbeddingGenerator<string, Embedding<float>>>() is null
                || generator.GetService<OpenTelemetryEmbeddingGenerator<string, Embedding<float>>>() is null)
            {
                violations.Add("The registered IEmbeddingGenerator is not wrapped with UseLogging and UseOpenTelemetry.");
            }
        }

        foreach (var (missing, parameter) in new[] { ("AzureOpenAI:Endpoint", "azure-openai-endpoint"), ("AzureOpenAI:ApiKey", "azure-openai-api-key") })
        {
            var settings = Settings();
            settings.Remove(missing);
            using var services = Services(settings);
            try
            {
                services.GetRequiredService<IEmbeddingGenerator<string, Embedding<float>>>();
                violations.Add($"Without {missing} the IEmbeddingGenerator still resolved; it must fail, naming the parameter {parameter}.");
            }
            catch (InvalidOperationException exception) when (exception.Message.Contains(parameter, StringComparison.Ordinal))
            {
            }
        }

        return violations;
    }

    private static Dictionary<string, string?> Settings() =>
        new() { ["AzureOpenAI:Endpoint"] = Endpoint, ["AzureOpenAI:EmbeddingDeployment"] = Deployment, ["AzureOpenAI:ApiKey"] = "not-a-real-key" };

    private static bool HostRegistersTheGenerator()
    {
        var program = Path.Combine(RepositoryRoot(), HostProgram);
        return File.Exists(program)
            && CSharpSyntaxTree.ParseText(File.ReadAllText(program)).GetRoot().DescendantNodes()
                .OfType<InvocationExpressionSyntax>()
                .Any(call => call.Expression is MemberAccessExpressionSyntax { Name.Identifier.ValueText: Registration });
    }

    /// <summary>The project root: the directory above the test output that holds build.proj.</summary>
    private static string RepositoryRoot()
    {
        var directory = new DirectoryInfo(AppContext.BaseDirectory);
        while (directory is not null && !File.Exists(Path.Combine(directory.FullName, "build.proj")))
        {
            directory = directory.Parent;
        }

        return directory?.FullName ?? throw new InvalidOperationException("build.proj not found above the test output directory.");
    }

    private static ServiceProvider Services(Dictionary<string, string?> settings)
    {
        var configuration = new ConfigurationBuilder().AddInMemoryCollection(settings).Build();
        var services = new ServiceCollection().AddLogging();
        services.AddAzureOpenAIEmbeddingGenerator(configuration);
        return services.BuildServiceProvider();
    }
}
