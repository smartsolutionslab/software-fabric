func integration_fixture
  ret "AspireFixture aspire"
end
func host_client
  ret "aspire.CreateHostClient()"
end
func signed_in_host_client(user)
  ret "aspire.CreateHostClientAsync(" + user + ")"
end
func running_application
  ret "aspire.App"
end
func integration_fixture_attributes
  ret test_takes_run_fixture "AspireFixture"
end
func database_fixture
  ret "ApplicationDatabase database"
end
func database_fixture_attributes
  ret test_takes_run_fixture "ApplicationDatabase"
end
func database_connection_string
  ret "database.ConnectionString"
end
func database_fixture_package_references
  ret `<PackageReference Include="Aspire.Hosting.Testing" />`
end
func database_fixture_project_references
  ret `<ProjectReference Include="../../src/AppHost/AppHost.csproj" />`
end
func database_fixture_file(space)
  $rag = object.has_key(project, "backend.llm.extras") && (array.contains project["backend.llm.extras"] "rag")
  if project["backend.topology"] == "services"
    if project["backend.database"] == "sqlserver"
      $resources = `var sqlServer = builder.Resources.OfType<SqlServerServerResource>().Single();
        builder.CreateResourceBuilder(sqlServer).AddDatabase("database");
        HashSet<IResource> database =
        [
            sqlServer,
            sqlServer.PasswordParameter,
            .. builder.Resources.OfType<SqlServerDatabaseResource>().Where(resource => resource.Name == "database"),
        ];`
    else if $rag
      $resources = `var postgres = builder.Resources.OfType<PostgresServerResource>().Single();
        builder.CreateResourceBuilder(postgres).AddDatabase("database");
        var migrationRuns = builder.Resources.OfType<ProjectResource>()
            .Where(resource => resource.Name.EndsWith(MigrationRun, StringComparison.Ordinal))
            .Select(resource => resource.Name)
            .ToList();
        HashSet<IResource> database =
        [
            postgres,
            postgres.PasswordParameter,
            .. builder.Resources.OfType<PostgresDatabaseResource>(),
            .. builder.Resources.Where(resource => migrationRuns.Contains(resource.Name)),
        ];
        if (postgres.UserNameParameter is { } user)
        {
            database.Add(user);
        }`
    else
      $resources = `var postgres = builder.Resources.OfType<PostgresServerResource>().Single();
        builder.CreateResourceBuilder(postgres).AddDatabase("database");
        HashSet<IResource> database =
        [
            postgres,
            postgres.PasswordParameter,
            .. builder.Resources.OfType<PostgresDatabaseResource>().Where(resource => resource.Name == "database"),
        ];
        if (postgres.UserNameParameter is { } user)
        {
            database.Add(user);
        }`
    end
    if $rag
      $summary = `The AppHost's database server alone, on an empty container, started once per test run, with a database of the tests'
/// own on it and every service's database, migrated by the service's own MigrationRunner run as before the service starts,
/// so every module's vector table exists in its service's database. Nothing else runs: no service, no model.`
      $members = `
    private const string MigrationRun = "-migrations";
`
      $service_databases = `
    private readonly Dictionary<string, string> serviceDatabases = [];
`
      $service_databases_property = `

    /// <summary>Each service's own database by its module's name, as the AppHost names it.</summary>
    public IReadOnlyDictionary<string, string> ServiceDatabases => serviceDatabases;`
      $wait = `
        foreach (var migrationRun in migrationRuns)
        {
            var finished = await app.ResourceNotifications.WaitForResourceAsync(
                migrationRun,
                resourceEvent => KnownResourceStates.TerminalStates.Contains(resourceEvent.Snapshot.State?.Text),
                timeout.Token);
            if (finished.Snapshot.ExitCode != 0)
            {
                throw new InvalidOperationException($"The MigrationRunner run {migrationRun} ended {finished.Snapshot.State?.Text} with exit code {finished.Snapshot.ExitCode}.");
            }

            var module = migrationRun[..^MigrationRun.Length];
            serviceDatabases[module] = await app.GetConnectionStringAsync($"{module}-database", timeout.Token)
                ?? throw new InvalidOperationException($"The database of the service {module} has no connection string.");
        }
`
    else
      $summary = `The AppHost's database server alone, on an empty container, started once per test run, with a database of the tests'
/// own on it: every service has a database of its own, which only its module's migration run changes, so none is the
/// application's. Nothing else runs: no service, no migrations.`
      $members = ""
      $service_databases = ""
      $service_databases_property = ""
      $wait = ""
    end
    ret `using Aspire.Hosting;
using Aspire.Hosting.ApplicationModel;
using Aspire.Hosting.Testing;

` + (test_run_fixture (space + ".ApplicationDatabase")) + `

namespace ` + space + `;

/// <summary>
/// ` + $summary + `
/// </summary>
public sealed class ApplicationDatabase : ` + test_lifetime + `
{` + $members + `
    private static readonly TimeSpan StartupTimeout = TimeSpan.FromMinutes(5);
` + $service_databases + `
    private DistributedApplication? app;

    private string? connectionString;

    public string ConnectionString => connectionString ?? throw new InvalidOperationException("The database has not started.");` + $service_databases_property + `

    ` + (test_setup | string.replace "\n" "\n    ") + `
    {
        using var timeout = new CancellationTokenSource(StartupTimeout);
        var builder = await DistributedApplicationTestingBuilder.CreateAsync<Projects.AppHost>(timeout.Token);

        ` + $resources + `

        foreach (var resource in builder.Resources.Where(resource => !database.Contains(resource)).ToList())
        {
            builder.Resources.Remove(resource);
        }

        // Tests start from an empty container: never a developer's data, never a password a volume remembers.
        foreach (var resource in builder.Resources)
        {
            foreach (var volume in resource.Annotations.OfType<ContainerMountAnnotation>().Where(mount => mount.Type == ContainerMountType.Volume).ToList())
            {
                resource.Annotations.Remove(volume);
            }
        }

        app = await builder.BuildAsync(timeout.Token);
        await app.StartAsync(timeout.Token);
        await app.ResourceNotifications.WaitForResourceHealthyAsync("database", timeout.Token);` + $wait + `
        connectionString = await app.GetConnectionStringAsync("database", timeout.Token)
            ?? throw new InvalidOperationException("The tests' database has no connection string.");
    }

    ` + (test_teardown | string.replace "\n" "\n    ") + `
    {
        if (app is not null)
        {
            await app.DisposeAsync();
        }
    }
}`
  end
  if project["backend.database"] == "sqlserver"
    $summary = `The AppHost's database alone, on an empty container, started once per test run: SQL Server, migrated by the
/// MigrationRunner as before the host starts, so every module's schema exists. Nothing else runs: no host, no model.`
    $resources = `var sqlServer = builder.Resources.OfType<SqlServerServerResource>().Single();
        HashSet<IResource> database =
        [
            sqlServer,
            sqlServer.PasswordParameter,
            .. builder.Resources.OfType<SqlServerDatabaseResource>(),
            .. builder.Resources.Where(resource => resource.Name == MigrationRunner),
        ];`
  else
    if object.has_key(project, "backend.llm.extras") && (array.contains project["backend.llm.extras"] "rag")
      $summary = `The AppHost's database alone, on an empty container, started once per test run: the pgvector image, migrated by the
/// MigrationRunner as before the host starts, so every module's vector table exists. Nothing else runs: no host, no
/// model.`
    else
      $summary = `The AppHost's database alone, on an empty container, started once per test run and migrated by the MigrationRunner
/// as before the host starts. Nothing else runs: no host.`
    end
    $resources = `var postgres = builder.Resources.OfType<PostgresServerResource>().Single();
        HashSet<IResource> database =
        [
            postgres,
            postgres.PasswordParameter,
            .. builder.Resources.OfType<PostgresDatabaseResource>(),
            .. builder.Resources.Where(resource => resource.Name == MigrationRunner),
        ];
        if (postgres.UserNameParameter is { } user)
        {
            database.Add(user);
        }`
  end
  ret `using Aspire.Hosting;
using Aspire.Hosting.ApplicationModel;
using Aspire.Hosting.Testing;

` + (test_run_fixture (space + ".ApplicationDatabase")) + `

namespace ` + space + `;

/// <summary>
/// ` + $summary + `
/// </summary>
public sealed class ApplicationDatabase : ` + test_lifetime + `
{
    private const string MigrationRunner = "migrations";

    private static readonly TimeSpan StartupTimeout = TimeSpan.FromMinutes(5);

    private DistributedApplication? app;

    private string? connectionString;

    public string ConnectionString => connectionString ?? throw new InvalidOperationException("The database has not started.");

    ` + (test_setup | string.replace "\n" "\n    ") + `
    {
        using var timeout = new CancellationTokenSource(StartupTimeout);
        var builder = await DistributedApplicationTestingBuilder.CreateAsync<Projects.AppHost>(timeout.Token);

        ` + $resources + `

        foreach (var resource in builder.Resources.Where(resource => !database.Contains(resource)).ToList())
        {
            builder.Resources.Remove(resource);
        }

        // Tests start from an empty container: never a developer's data, never a password a volume remembers.
        foreach (var resource in builder.Resources)
        {
            foreach (var volume in resource.Annotations.OfType<ContainerMountAnnotation>().Where(mount => mount.Type == ContainerMountType.Volume).ToList())
            {
                resource.Annotations.Remove(volume);
            }
        }

        app = await builder.BuildAsync(timeout.Token);
        await app.StartAsync(timeout.Token);
        var finished = await app.ResourceNotifications.WaitForResourceAsync(
            MigrationRunner,
            resourceEvent => KnownResourceStates.TerminalStates.Contains(resourceEvent.Snapshot.State?.Text),
            timeout.Token);
        if (finished.Snapshot.ExitCode != 0)
        {
            throw new InvalidOperationException($"The MigrationRunner ended {finished.Snapshot.State?.Text} with exit code {finished.Snapshot.ExitCode}.");
        }

        connectionString = await app.GetConnectionStringAsync("database", timeout.Token)
            ?? throw new InvalidOperationException("The AppHost's database has no connection string.");
    }

    ` + (test_teardown | string.replace "\n" "\n    ") + `
    {
        if (app is not null)
        {
            await app.DisposeAsync();
        }
    }
}`
end
