        return client;
    }
{{~ end ~}}

    {{ test_teardown }}
    {
        if (app is not null)
        {
            await app.DisposeAsync();
        }
    }
{{~ if project["backend.auth"] != "none" ~}}

    {{ test_user_token_types }}
{{~ end ~}}
}
