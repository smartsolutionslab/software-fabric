{{~ tenants = project["backend.tenancy"] == "schema-per-tenant" ~}}
using System.Text.Json;
using {{ namespace }}.Contracts;
{{~ if tenants ~}}
using {{ namespace }}.BuildingBlocks.Tenancy;
{{~ end ~}}
using Microsoft.EntityFrameworkCore;
{{~ if tenants ~}}
using Microsoft.Extensions.Configuration;
{{~ end ~}}
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;

namespace {{ namespace }}.BuildingBlocks.Messaging;

/// <summary>
{{~ if tenants ~}}
/// Delivers committed integration events in-process: reads the outbox table of each module in each tenant's schema, for
/// every tenant in Tenancy:Tenants, hands every message to its consumers in that tenant's <see cref="TenantScope"/> and
/// marks it delivered. Woken by <see cref="OutboxSignal"/> after a commit, and polls in case a wake was missed.
{{~ else ~}}
/// Delivers committed integration events in-process: reads each module's outbox table, hands every message to its
/// consumers and marks it delivered. Woken by <see cref="OutboxSignal"/> after a commit, and polls in case a wake was missed.
{{~ end ~}}
/// </summary>
public sealed partial class OutboxDispatcher(
    IServiceScopeFactory scopes,
    OutboxContexts contexts,
    IntegrationEventConsumers consumers,
    OutboxSignal signal,
{{~ if tenants ~}}
    IConfiguration configuration,
{{~ end ~}}
    ILogger<OutboxDispatcher> logger) : BackgroundService
{
    private const int BatchSize = 20;

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1);

    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
    {
{{~ if tenants ~}}
        // The module's own schema holds no tenant's rows and has no outbox; each listed tenant's schema has one.
        var tenants = TenantSchemas.Listed(configuration);
{{~ end ~}}
        while (!stoppingToken.IsCancellationRequested)
        {
            var delivered = 0;
{{~ if tenants ~}}
            foreach (var (tenant, type) in tenants.SelectMany(tenant => contexts.Types.Select(type => (tenant, type))))
{{~ else ~}}
            foreach (var type in contexts.Types)
{{~ end ~}}
            {
                try
                {
{{~ if tenants ~}}
                    // Its consumers run in the tenant too, so their contexts work in the tenant's schemas.
                    using var tenantScope = TenantScope.Begin(tenant);
{{~ end ~}}
                    delivered += await DeliverPendingAsync(type, stoppingToken);
                }
#pragma warning disable CA1031 // The database may be away for a moment; the messages wait in their table until it is back.
                // Only the host stopping ends the loop; any other cancellation (a timed-out call) is a failure like the rest.
                catch (Exception exception) when (!stoppingToken.IsCancellationRequested)
#pragma warning restore CA1031
                {
                    LogReadFailed(logger, exception, type.Name{{ if tenants }}, tenant{{ end }});
                }
            }

            if (delivered == 0)
            {
                await signal.WaitAsync(PollInterval, stoppingToken);
            }
        }
    }

    private async Task<int> DeliverPendingAsync(Type contextType, CancellationToken cancellationToken)
    {
        await using var scope = scopes.CreateAsyncScope();
        var context = (DbContext)scope.ServiceProvider.GetRequiredService(contextType);
        await using var transaction = await context.Database.BeginTransactionAsync(cancellationToken);

        var messages = await Outbox.LockPendingAsync(context, BatchSize, cancellationToken);
        var delivered = 0;
        foreach (var message in messages)
        {
            try
            {
                var type = Type.GetType(message.Type, throwOnError: true)!;
                var integrationEvent = (IIntegrationEvent)JsonSerializer.Deserialize(message.Payload, type)!;
                await consumers.DeliverAsync(integrationEvent, scopes, cancellationToken);
                await Outbox.MarkDeliveredAsync(context, message.Id, cancellationToken);
                delivered++;
            }
#pragma warning disable CA1031 // A failing consumer must not stop delivery of other messages; the error is kept with the message.
            // A consumer's own cancellation (an HTTP timeout) is a failed delivery; only the host stopping is not.
            catch (Exception exception) when (!cancellationToken.IsCancellationRequested)
#pragma warning restore CA1031
            {
                LogDeliveryFailed(logger, exception, message.Id, message.Type);
                await Outbox.MarkFailedAsync(context, message.Id, exception.ToString(), cancellationToken);
            }
        }

        await transaction.CommitAsync(cancellationToken);
        return delivered;
    }

    [LoggerMessage(Level = LogLevel.Error, Message = "Delivering outbox message {MessageId} ({MessageType}) failed; it is retried later.")]
    private static partial void LogDeliveryFailed(ILogger logger, Exception exception, Guid messageId, string messageType);

{{~ if tenants ~}}
    [LoggerMessage(Level = LogLevel.Error, Message = "Reading the outbox of {Context} for tenant {Tenant} failed; it is read again on the next poll.")]
    private static partial void LogReadFailed(ILogger logger, Exception exception, string context, string tenant);
{{~ else ~}}
    [LoggerMessage(Level = LogLevel.Error, Message = "Reading the outbox of {Context} failed; it is read again on the next poll.")]
    private static partial void LogReadFailed(ILogger logger, Exception exception, string context);
{{~ end ~}}
}
