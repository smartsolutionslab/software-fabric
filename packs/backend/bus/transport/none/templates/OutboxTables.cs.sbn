{{~ tenants = project["backend.tenancy"] == "schema-per-tenant" ~}}
using System.Reflection;
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.BuildingBlocks.Persistence;
{{~ if tenants ~}}
using {{ namespace }}.BuildingBlocks.Tenancy;
{{~ end ~}}
using Microsoft.EntityFrameworkCore;
{{~ if tenants ~}}
using Microsoft.Extensions.Configuration;
{{~ end ~}}

namespace Microsoft.Extensions.DependencyInjection;

public static class OutboxTables
{
    /// <summary>
{{~ if tenants ~}}
    /// Creates every module's outbox table in each schema of it for a tenant listed in Tenancy:Tenants; the module's own
    /// schema, which holds no tenant's rows, gets none. A step of the MigrationRunner, after the modules' migrations: the
    /// runner has each module's DbContext registered, and it runs once before any host starts, so hosts never create tables.
{{~ else ~}}
    /// Creates every module's outbox table. A step of the MigrationRunner, after the modules' migrations: the runner has
    /// each module's DbContext registered, and it runs once before any host starts, so hosts never create tables.
{{~ end ~}}
    /// </summary>
    public static async Task CreateOutboxTablesAsync(this IServiceProvider services, CancellationToken cancellationToken = default)
    {
        {{ not_null "services" }}

        var contexts = Directory.EnumerateFiles(AppContext.BaseDirectory, "{{ namespace }}.Modules.*.Infrastructure.dll")
            .Order(StringComparer.Ordinal)
            .Select(Assembly.LoadFrom)
            .SelectMany(assembly => assembly.GetTypes())
{{~ if tenants ~}}
            .Where(type => type is { IsClass: true, IsAbstract: false } && typeof(ModuleDbContext).IsAssignableFrom(type))
            .ToList();

        foreach (var tenant in TenantSchemas.Listed(services.GetRequiredService<IConfiguration>()))
        {
            // A module's context chooses its tenant's schema at its first use, inside this scope.
            using var tenantScope = TenantScope.Begin(tenant);
            foreach (var context in contexts)
            {
                await using var scope = services.CreateAsyncScope();
                await Outbox.CreateTableAsync((DbContext)scope.ServiceProvider.GetRequiredService(context), cancellationToken);
            }
        }
{{~ else ~}}
            .Where(type => type is { IsClass: true, IsAbstract: false } && typeof(ModuleDbContext).IsAssignableFrom(type));

        foreach (var context in contexts)
        {
            await using var scope = services.CreateAsyncScope();
            await Outbox.CreateTableAsync((DbContext)scope.ServiceProvider.GetRequiredService(context), cancellationToken);
        }
{{~ end ~}}
    }
}
