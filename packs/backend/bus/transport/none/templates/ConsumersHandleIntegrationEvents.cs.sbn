using System.Reflection;
using {{ namespace }}.BuildingBlocks.Messaging;

namespace {{ namespace }}.Architecture.Tests.Rules;

public sealed class ConsumersHandleIntegrationEvents : IArchitectureRule
{
    public string Description => "Every consumer's Handle method is one the dispatcher delivers to (IntegrationEventConsumers.Problem): a public class in an Application project, not generic, taking a sealed integration event first, returning void (never async void) or Task.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        var consumers = model.ModuleAssemblies
            .SelectMany(assembly => assembly.GetTypes())
            .Where(type => type.IsClass && type.Name.EndsWith("Consumer", StringComparison.Ordinal));

        foreach (var consumer in consumers)
        {
            var methods = consumer.GetMethods(BindingFlags.Public | BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly)
                .Where(method => method.Name.StartsWith("Handle", StringComparison.Ordinal) || method.Name.StartsWith("Consume", StringComparison.Ordinal))
                .ToList();
            if (methods.Count == 0)
            {
                yield return $"{consumer.FullName} has no public Handle method.";
            }

            // The dispatcher's own definition, so the gate accepts nothing discovery would skip or fail on.
            foreach (var problem in methods.Select(method => method.Name == "Handle"
                ? IntegrationEventConsumers.Problem(method)
                : $"{consumer.FullName}.{method.Name} does not handle an integration event.").OfType<string>().Distinct(StringComparer.Ordinal))
            {
                yield return problem;
            }
        }
    }
}
