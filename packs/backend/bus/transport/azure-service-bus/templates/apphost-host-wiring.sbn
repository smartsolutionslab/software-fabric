
    .WithReference(messaging)
    .WaitFor(messaging)
    .WithEnvironment(context =>
    {
        if (messagingManagement is not null)
        {
            context.EnvironmentVariables["ConnectionStrings__messaging-management"] = messagingManagement;
        }
    }){{ if project["backend.topology"] == "services" }}
    .WithEnvironment("Messaging__Subscription", module){{ end }}