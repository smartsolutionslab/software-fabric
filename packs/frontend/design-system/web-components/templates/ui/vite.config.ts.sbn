import { playwright } from '@vitest/browser-playwright';
import { defineConfig } from 'vitest/config';

// Storybook builds with this configuration too. The tests run in Chromium: only a browser computes the colours the
// tokens' variables resolve to inside shadow DOM.
export default defineConfig({
  test: {
    include: ['src/**/*.test.ts'],
    setupFiles: ['./src/test-setup.ts'],
    browser: {
      enabled: true,
      provider: playwright(),
      headless: true,
      instances: [{ browser: 'chromium' }],
      screenshotFailures: false,
    },
  },
});
