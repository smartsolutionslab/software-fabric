{
  "name": "@{{ name }}/ui",
  "private": true,
{{- if slots["web.ui-package-fields"] != "" }}
{{ slots["web.ui-package-fields"] }},{{ end }}
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b && storybook build --quiet",
    "storybook": "pnpm --filter @{{ name }}/tokens build && storybook dev --port 6006",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@{{ name }}/tokens": "workspace:*",
    "@eslint/js": "10.0.1",
    "@storybook/web-components-vite": "10.6.5",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "storybook": "10.6.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
