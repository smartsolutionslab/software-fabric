import '@{{ name }}/tokens/tokens.css';
import { expect, test } from 'vitest';
import './Badge';
import type { BadgeTone } from './Badge';

// The tokens each tone shows: its background and its text.
const tones: Record<BadgeTone, { background: string; text: string }> = {
  accent: { background: '--ds-color-accent', text: '--ds-color-accent-foreground' },
  primary: { background: '--ds-color-primary', text: '--ds-color-primary-foreground' },
};

// The browser computes every colour to a colour function (rgb(...), oklch(...)), whatever the stylesheet wrote; a
// shadow, a gradient or a filter may carry several.
const coloursIn = (value: string) => value.match(/\b(rgba?|hsla?|hwb|lab|lch|oklab|oklch|color)\([^()]*\)/g) ?? [];

// Every colour in every property the browser computes, so a colour cannot hide in one a list would leave out.
const coloursOf = (style: CSSStyleDeclaration) =>
  [...style]
    .filter((property) => !property.startsWith('--'))
    .flatMap((property) => coloursIn(style.getPropertyValue(property)).map((colour) => ({ property, colour })));

const colourTokens = () =>
  [...document.styleSheets]
    .flatMap((sheet) => [...sheet.cssRules])
    .filter((rule): rule is CSSStyleRule => rule instanceof CSSStyleRule && rule.selectorText === ':root')
    .flatMap((rule) => [...rule.style])
    .filter((property) => property.startsWith('--ds-color-'));

// What a colour token resolves to, computed by the browser the way it computes the badge's colours.
const resolve = (token: string) => {
  const probe = document.createElement('i');
  probe.style.color = `var(${token})`;
  document.body.append(probe);
  const colour = getComputedStyle(probe).color;
  probe.remove();
  return colour;
};

// Every colour property the component does not set starts from this colour instead of the browser's default, so a
// colour of its own cannot pass for a default it happens to equal (fill: black).
const unset = 'rgb(1, 2, 3)';

const unsetSheet = () => {
  const plain = document.createElement('span');
  document.body.append(plain);
  const style = getComputedStyle(plain);
  const declarations = [...style]
    .filter((property) => !property.startsWith('--') && coloursIn(style.getPropertyValue(property)).length > 0)
    .map((property) => `${property}: ${unset};`)
    .join(' ');
  plain.remove();
  // Ahead of the component's sheets and with no specificity of its own, so any rule of the component wins over it.
  const sheet = new CSSStyleSheet();
  for (const selector of [':host', ':host::before', ':host::after', '*', '*::before', '*::after', '::slotted(*)']) {
    sheet.insertRule(`${selector} { ${declarations} }`, sheet.cssRules.length);
  }
  return sheet;
};

// Every declaration block in the component's styles, as the browser parsed them: each rule, whatever its selector or
// state (:hover, :focus), each rule inside @media, @supports or a nested rule, and each keyframe.
const blocksOf = (rules: CSSRuleList): CSSStyleDeclaration[] =>
  [...rules].flatMap((rule) => [
    ...('style' in rule && rule.style instanceof CSSStyleDeclaration ? [rule.style] : []),
    ...('cssRules' in rule && rule.cssRules instanceof CSSRuleList ? blocksOf(rule.cssRules) : []),
  ]);

// Each colour the badge paints, where, for one tone: on its host, its label and its shadow elements as rendered, and on
// an element inside it given each of the component's declaration blocks, so a state the test does not render counts.
const paintedColours = async (tone: BadgeTone) => {
  const badge = document.createElement('ds-badge');
  badge.tone = tone;
  // The label is an element, so styles for slotted content apply to it.
  const label = document.createElement('span');
  label.textContent = 'New';
  badge.append(label);
  document.body.append(badge);
  await badge.updateComplete;
  const root = badge.shadowRoot;
  const span = root?.querySelector('span');
  if (!root || !span) {
    throw new Error('ds-badge renders no span in a shadow root');
  }
  const own = [...root.adoptedStyleSheets, ...root.styleSheets];
  root.adoptedStyleSheets = [unsetSheet(), ...root.adoptedStyleSheets];

  const rendered = [badge, label, ...root.querySelectorAll('*')].flatMap((element) =>
    [null, '::before', '::after'].flatMap((pseudo) => {
      const style = getComputedStyle(element, pseudo);
      // A ::before or ::after without content is not generated, and paints nothing.
      if (pseudo && style.content === 'none') {
        return [];
      }
      return coloursOf(style).map(({ property, colour }) => ({
        where: `${element.localName}${pseudo ?? ''} ${property}`,
        colour,
      }));
    }),
  );
  const declared = own
    .flatMap((sheet) => blocksOf(sheet.cssRules))
    .flatMap((block) => {
      const probe = document.createElement('i');
      probe.style.cssText = block.cssText;
      span.append(probe);
      // A custom property of its own is a colour when a colour property can take it.
      const custom = [...block]
        .filter((property) => property.startsWith('--'))
        .map((property) => {
          const user = document.createElement('i');
          user.style.color = `var(${property})`;
          probe.append(user);
          return { where: `{ ${block.cssText} } ${property}`, colour: getComputedStyle(user).color };
        });
      const colours = coloursOf(getComputedStyle(probe)).map(({ property, colour }) => ({
        where: `{ ${block.cssText} } ${property}`,
        colour,
      }));
      probe.remove();
      return [...colours, ...custom];
    });
  const shown = getComputedStyle(span);
  return { painted: [...rendered, ...declared], background: shown.backgroundColor, text: shown.color };
};

const expectOnlyTokens = async () => {
  const tokens = colourTokens();
  expect(tokens).toContain('--ds-color-primary');
  const allowed = [...tokens.map(resolve), unset];
  for (const tone of Object.keys(tones) as BadgeTone[]) {
    const { painted, background, text } = await paintedColours(tone);
    expect(background, `${tone} background`).toBe(resolve(tones[tone].background));
    expect(text, `${tone} text`).toBe(resolve(tones[tone].text));
    for (const { where, colour } of painted) {
      expect(allowed, `${tone}: ${where}: ${colour}`).toContain(colour);
    }
    document.body.replaceChildren();
  }
};

test('a badge shows its label in the tone it is given', async () => {
  const badge = document.createElement('ds-badge');
  badge.tone = 'primary';
  badge.textContent = 'New';
  document.body.append(badge);
  await badge.updateComplete;

  expect(badge.getAttribute('tone')).toBe('primary');
  expect(badge.shadowRoot?.querySelector('span')?.className).toBe('primary');
  expect(badge.textContent).toBe('New');
});

// Each colour the badge paints is a --ds-color-* token's, as the tokens are built and again when every token changes:
// a colour of its own would not follow (a literal, a named colour, transparent, a variable that is not a token).
test('a badge is styled only through the design tokens', async () => {
  const root = document.documentElement;
  await expectOnlyTokens();

  colourTokens().forEach((token, index) => root.style.setProperty(token, `rgb(${index + 10}, 20, 30)`));
  try {
    await expectOnlyTokens();
  } finally {
    root.removeAttribute('style');
  }
});
