import type { DetailedHTMLProps, HTMLAttributes } from 'react';
import type { Badge, BadgeTone } from '@{{ name }}/ui';

// The design system's elements as JSX tags: one entry per element, with the properties it takes.
type Element<T extends HTMLElement, Properties> = DetailedHTMLProps<HTMLAttributes<T>, T> & Partial<Properties>;

declare module 'react' {
  namespace JSX {
    interface IntrinsicElements {
      'ds-badge': Element<Badge, { tone: BadgeTone }>;
    }
  }
}
