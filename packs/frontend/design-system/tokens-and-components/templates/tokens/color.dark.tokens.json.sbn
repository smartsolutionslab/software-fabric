{
  "color": {
    "$type": "color",
    "primary": { "$value": "{color.brand.400}" },
    "primary-foreground": { "$value": "{color.ink.900}" },
    "accent": { "$value": "{color.signal.500}" },
    "accent-foreground": { "$value": "{color.ink.900}" },
    "surface": { "$value": "{color.ink.900}" },
    "border": { "$value": "#ffffff1a" },
    "muted-foreground": { "$value": "{color.ink.400}" },
    "destructive": { "$value": "{color.danger.400}" }
  }
}
