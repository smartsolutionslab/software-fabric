{{~ if project["backend.tenancy"] != "none" && project["backend.auth"] == "none" ~}}
#error frontend.realtime signalr with backend.tenancy {{ project["backend.tenancy"] }} needs an identity provider: a browser's tenant comes from its user's token, and backend.auth none signs nobody in (docs/adr/0009 of the generator).
{{~ end ~}}
{{~ tenanted = project["backend.tenancy"] != "none"
   signed_in = project["backend.auth"] != "none"
   usings = ["System.Collections.Concurrent", "System.Net.Http.Json", "Microsoft.AspNetCore.SignalR.Client"]
   if signed_in
     usings = array.concat (usings | array.add "System.Net" | array.add "System.Net.Http.Headers") (short_lived_test_user_token_namespaces | string.split " ")
   end
   system = []
   others = []
   for name_space in usings | array.uniq
     if name_space | string.starts_with "System"
       system = system | array.add name_space
     else
       others = others | array.add name_space
     end
   end ~}}
{{~ for name_space in array.concat (system | array.sort) (others | array.sort) ~}}
using {{ name_space }};
{{~ end ~}}

namespace {{ namespace }}.Integration.Tests;

/// <summary>The host's event hub (/hubs/events) seen from a browser's side: what it receives, and who may connect.</summary>
public class ServerEventsTests({{ integration_fixture }})
{
{{~ if signed_in ~}}
    private const int ShortLifespan = 10;

{{~ end ~}}
    private static readonly TimeSpan Patience = TimeSpan.FromSeconds(30);
{{~ if tenanted ~}}

    {{ test_attribute }}
    public async Task A_test_event_reaches_the_browsers_of_the_senders_tenant_only()
    {
        var cancellationToken = {{ test_cancellation_token }};
        using var first = await {{ signed_in_host_client `"developer"` }};
        using var second = await {{ signed_in_host_client `"developer-b"` }};
        await using var firstBrowser = await Browser.ConnectAsync(first, cancellationToken);
        await using var secondBrowser = await Browser.ConnectAsync(second, cancellationToken);

        // Each browser first receives an event of its own tenant, so both are known to listen before either is checked.
        var secondText = await SendUntilReceivedAsync(second, secondBrowser, cancellationToken);
        var firstText = await SendUntilReceivedAsync(first, firstBrowser, cancellationToken);

        {{ `firstBrowser.Received` | should_not_contain `secondText` }};
        {{ `secondBrowser.Received` | should_not_contain `firstText` }};
    }
{{~ else ~}}

    {{ test_attribute }}
    public async Task A_test_event_reaches_every_connected_browser()
    {
        var cancellationToken = {{ test_cancellation_token }};
{{~ if signed_in ~}}
        using var sender = await {{ signed_in_host_client `"developer"` }};
{{~ else ~}}
        using var sender = {{ host_client }};
{{~ end ~}}
        await using var browser = await Browser.ConnectAsync(sender, cancellationToken);

        var text = await SendUntilReceivedAsync(sender, browser, cancellationToken);

        {{ `browser.Received` | should_contain `text` }};
    }
{{~ end ~}}
{{~ if signed_in ~}}

    {{ test_attribute }}
    public async Task An_anonymous_connection_is_refused()
    {
        using var anonymous = {{ host_client }};

        var refusal = await {{ should_throw_async `HttpRequestException` (`Browser.ConnectAsync(anonymous, ` + test_cancellation_token + `)`) }};

        {{ `refusal.StatusCode` | should_be `HttpStatusCode.Unauthorized` }};
    }
{{~ end ~}}
{{~ if signed_in ~}}

    {{ test_attribute }}
    public async Task A_connection_is_closed_once_its_access_token_expires()
    {
        var cancellationToken = {{ test_cancellation_token }};
        using var caller = await ShortLivedCallerAsync("developer", cancellationToken);
        await using var browser = await Browser.ConnectAsync(caller, cancellationToken);

        var closed = await browser.ClosesWithinAsync(TimeSpan.FromMinutes(1), cancellationToken);

        {{ `closed` | should_be_true `"a connection whose token expired must close, so that reconnecting checks the user and their tenant again"` }};
    }
{{~ end ~}}

    /// <summary>
    /// Sends test events until the browser has received one, and returns its text: a connection joins its group only
    /// once it has started, so an event sent at once may reach nobody.
    /// </summary>
    private static async Task<string> SendUntilReceivedAsync(HttpClient sender, Browser browser, CancellationToken cancellationToken)
    {
        var text = $"test event {Guid.CreateVersion7()}";
        using var patience = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        patience.CancelAfter(Patience);
        while (!browser.Received.Contains(text))
        {
            using var sent = await sender.PostAsJsonAsync(new Uri("/hubs/events/test", UriKind.Relative), new { text }, patience.Token);
            sent.EnsureSuccessStatusCode();
            await Task.Delay(TimeSpan.FromMilliseconds(200), patience.Token);
        }

        return text;
    }

{{~ if signed_in ~}}
    /// <summary>
    /// A client calling the host as a realm user with a token that lives ShortLifespan seconds: the realm gets a copy of
    /// the web client (its mappers included) whose tokens expire that soon, so other tests' tokens are untouched.
    /// </summary>
    private async Task<HttpClient> ShortLivedCallerAsync(string user, CancellationToken cancellationToken)
    {
        {{ short_lived_test_user_token running_application "user" "ShortLifespan" }}

        var caller = {{ host_client }};
        caller.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token.AccessToken);
        return caller;
    }

    {{ short_lived_test_user_token_members running_application }}

{{~ end ~}}
    /// <summary>A browser's connection to the hub, as the host's caller (and with its token, if it has one).</summary>
    private sealed class Browser : IAsyncDisposable
    {
        private readonly ConcurrentQueue<string> received = new();
        private readonly TaskCompletionSource closed = new(TaskCreationOptions.RunContinuationsAsynchronously);
        private readonly HubConnection connection;

        private Browser(HttpClient caller)
        {
            var host = caller.BaseAddress ?? throw new InvalidOperationException("The host's client has no address.");
            var token = caller.DefaultRequestHeaders.Authorization?.Parameter;
            connection = new HubConnectionBuilder()
                .WithUrl(new Uri(host, "/hubs/events"), options => options.AccessTokenProvider = () => Task.FromResult(token))
                .Build();
            connection.On<TestEventReceived>("TestEvent", testEvent => received.Enqueue(testEvent.Text));
            connection.Closed += _ =>
            {
                closed.TrySetResult();
                return Task.CompletedTask;
            };
        }

        public IReadOnlyCollection<string> Received => received;

        public static async Task<Browser> ConnectAsync(HttpClient caller, CancellationToken cancellationToken)
        {
            var browser = new Browser(caller);
            try
            {
                await browser.connection.StartAsync(cancellationToken);
                return browser;
            }
            catch
            {
                await browser.DisposeAsync();
                throw;
            }
        }

        /// <summary>Whether the host closes the connection within the time given.</summary>
        public async Task<bool> ClosesWithinAsync(TimeSpan time, CancellationToken cancellationToken)
        {
            try
            {
                await closed.Task.WaitAsync(time, cancellationToken);
                return true;
            }
            catch (TimeoutException)
            {
                return false;
            }
        }

        public ValueTask DisposeAsync() => connection.DisposeAsync();
    }

    private sealed record TestEventReceived(string Text);
{{~ if signed_in ~}}

    {{ short_lived_test_user_token_types }}
{{~ end ~}}
}
