{{~ if project["frontend.framework"] != "react" && project["frontend.framework"] != "vue" ~}}
throw new Error('The signalr pack has a React and a Vue client only so far (docs/adr/0006 of the generator).');
{{~ end ~}}
{{~ if object.has_key(project, "frontend.auth-client") && project["frontend.auth-client"] != "oidc-client-ts" ~}}
throw new Error('The signalr pack takes the token from oidc-client-ts only so far (docs/adr/0006 of the generator).');
{{~ end ~}}
import { HubConnectionBuilder, LogLevel } from '@microsoft/signalr';
{{~ if object.has_key(project, "frontend.auth-client") ~}}
import { accessToken } from '@/auth/accessToken';
{{~ end ~}}

/** A connection to the host's event hub, through /api like every other call; not started yet. */
export const connectServerEvents = () =>
  new HubConnectionBuilder()
{{~ if object.has_key(project, "frontend.auth-client") ~}}
    .withUrl('/api/hubs/events', { accessTokenFactory: () => accessToken() ?? '' })
{{~ else ~}}
    .withUrl('/api/hubs/events')
{{~ end ~}}
    .withAutomaticReconnect()
    .configureLogging(LogLevel.Warning)
    .build();
