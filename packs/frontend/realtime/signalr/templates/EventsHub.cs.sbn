using {{ namespace }}.BuildingBlocks.Tenancy;
using Microsoft.AspNetCore.SignalR;

namespace {{ namespace }}.Host.Realtime;

/// <summary>
/// The browsers' push channel at /hubs/events. Browsers only listen; the host sends through
/// <see cref="HubBrowserEvents"/>. A connection joins its user's tenant group, so it receives that tenant's events only.
/// </summary>
public sealed class EventsHub(ITenantContext tenant) : Hub
{
    public override async Task OnConnectedAsync()
    {
        if (tenant.TenantId is { } tenantId)
        {
            await Groups.AddToGroupAsync(Context.ConnectionId, HubBrowserEvents.TenantGroup(tenantId), Context.ConnectionAborted);
        }

        await base.OnConnectedAsync();
    }
}
{{~ end ~}}
