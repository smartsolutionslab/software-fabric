import { type App, type Component, h } from 'vue';
import ServerEvents from '@/realtime/ServerEvents.vue';

/** Renders the app inside ServerEvents, which holds the app's one connection to the host's event hub. */
export const withServerEvents = (_app: App, root: Component): Component => ({
  render: () => h(ServerEvents, null, { default: () => h(root) }),
});
