using {{ namespace }}.BuildingBlocks.Realtime;
using {{ namespace }}.Host.Realtime;
{{~ if project["backend.auth"] != "none" ~}}
{{~ for name_space in accept_query_token_namespaces | string.split " " ~}}
using {{ name_space }};
{{~ end ~}}
{{~ end ~}}

namespace Microsoft.Extensions.DependencyInjection;

public static class ServerEventsRegistration
{
{{~ if project["backend.auth"] == "none" ~}}
    /// <summary>SignalR and <see cref="IBrowserEvents"/>, which sends through the hub at /hubs/events.</summary>
    public static IServiceCollection AddServerEvents(this IServiceCollection services)
    {
        services.AddSignalR();
        return services.AddScoped<IBrowserEvents, HubBrowserEvents>();
    }
{{~ else ~}}
    /// <summary>
    /// SignalR and <see cref="IBrowserEvents"/>, which sends through the hub at /hubs/events. A browser cannot put a
    /// header on a WebSocket or an EventSource, so SignalR's client sends the access token as the access_token query
    /// parameter there; the bearer handler reads it for the hub's path only.
    /// </summary>
    public static IServiceCollection AddServerEvents(this IServiceCollection services)
    {
        services.AddSignalR();
        services.AddScoped<IBrowserEvents, HubBrowserEvents>();
        return {{ accept_query_token "services" `"/hubs/events"` | string.replace "\n" "\n        " }};
    }
{{~ end ~}}
}
