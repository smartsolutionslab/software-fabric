    private async Task<HttpClient> ShortLivedCallerAsync(string user, CancellationToken cancellationToken)
    {
        {{ short_lived_test_user_token running_application "user" "ShortLifespan" }}

        var caller = {{ host_client }};
        caller.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token.AccessToken);
        return caller;
