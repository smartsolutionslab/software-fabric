    {{ short_lived_test_user_token_members running_application }}

{{~ end ~}}
    /// <summary>
    /// A browser's EventSource on the stream. It sends no header, as a browser's cannot: the caller's access token, if it
    /// has one, goes in the access_token query parameter.
    /// </summary>
    private sealed class Browser : IAsyncDisposable
    {
        private readonly ConcurrentQueue<string> received = new();
        private readonly CancellationTokenSource stop = new();
        private readonly HttpClient client;
        private readonly HttpResponseMessage stream;
        private Task reading = Task.CompletedTask;

        private Browser(HttpClient client, HttpResponseMessage stream)
        {
            this.client = client;
            this.stream = stream;
        }

        public IReadOnlyCollection<string> Received => received;

        /// <summary>Opens the stream on a client of its own, which it disposes, with the caller's token.</summary>
        public static async Task<Browser> OpenAsync(HttpClient client, HttpClient caller, CancellationToken cancellationToken)
        {
            var token = caller.DefaultRequestHeaders.Authorization?.Parameter;
            var path = token is null ? "/server-events" : $"/server-events?access_token={Uri.EscapeDataString(token)}";
            HttpResponseMessage? stream = null;
            try
            {
                stream = await client.GetAsync(new Uri(path, UriKind.Relative), HttpCompletionOption.ResponseHeadersRead, cancellationToken);
                stream.EnsureSuccessStatusCode();
                var browser = new Browser(client, stream);
                browser.reading = browser.ReadAsync();
                return browser;
            }
            catch
            {
                stream?.Dispose();
                client.Dispose();
                throw;
            }
        }

        /// <summary>Whether the host ends the stream within the time given.</summary>
        public async Task<bool> ClosesWithinAsync(TimeSpan time, CancellationToken cancellationToken)
        {
            try
            {
                await reading.WaitAsync(time, cancellationToken);
                return true;
            }
            catch (TimeoutException)
            {
                return false;
            }
        }

        public async ValueTask DisposeAsync()
        {
            await stop.CancelAsync();
            try
            {
                await reading;
            }
            catch (OperationCanceledException)
            {
                // Stopped by this disposal.
            }

            stream.Dispose();
            client.Dispose();
            stop.Dispose();
        }

        private async Task ReadAsync()
        {
            await using var body = await stream.Content.ReadAsStreamAsync(stop.Token);
            await foreach (var item in SseParser.Create(body).EnumerateAsync(stop.Token))
            {
                if (item.EventType == "TestEvent" && JsonSerializer.Deserialize<TestEventReceived>(item.Data, JsonSerializerOptions.Web) is { } testEvent)
                {
                    received.Enqueue(testEvent.Text);
                }
            }
        }
    }

    private sealed record TestEventReceived(string Text);
{{~ if signed_in ~}}

    {{ short_lived_test_user_token_types }}
{{~ end ~}}
}
