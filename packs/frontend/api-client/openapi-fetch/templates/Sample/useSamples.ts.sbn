{{~ ns = module.namespace ~}}
{{~ # Prettier prints a statement on one line when it fits the web app's printWidth (120) and breaks it when it does not, so
    # every line the module's name lengthens is written the way Prettier prints it at that length. ~}}
{{~ func fits(indent, line)
  ret indent + (line | string.size) <= 120
end ~}}
{{~ func schema(declaration, name)
  line = declaration + " = components['schemas']['" + name + "'];"
  if fits(0, line)
    ret line
  end
  ret declaration + " =\n  components['schemas']['" + name + "'];"
end ~}}
{{~ func call(indent, shift, method, options, option)
  pad = "" | string.pad_left indent
  head = "const { data } = await api." + method + "('/" + module.name + "/samples', "
  if fits(indent + shift, head + options + ");")
    ret pad + head + options + ");"
  end
  ret pad + head + "{\n" + pad + "  " + option + ",\n" + pad + "});"
end ~}}
{{~ func samples_get(indent, shift)
  ret call(indent, shift, "GET", "{ params: { query: samplesPage } }", "params: { query: samplesPage }")
end ~}}
{{~ func samples_post(indent)
  ret call(indent, 0, "POST", "{ body: { name } }", "body: { name }")
end ~}}
{{~ if project["frontend.framework"] == "react" ~}}
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { api } from '@/api/baseApi';
import type { components } from '@/api/generated';

/** One of the module's samples, as the host lists it. */
{{ schema ("export type " + ns + "SampleDto") (ns + "SampleDto") }}

{{ schema "type SamplesPage" ("PagedResultOf" + ns + "SampleDto") }}

/** The page of samples the module's page lists: the first, as many as the host gives by default. */
export const samplesPage = { page: 1, pageSize: 20 };

const samplesKey = ['/{{ module.name }}/samples', samplesPage];

let pending = 0;

/** The cached page with the new sample in it, by name as the host lists them, until the host's own answer replaces it. */
function withPending(page: SamplesPage, name: string): SamplesPage {
  pending += 1;
  const items = [...page.items, { id: `pending-${pending}`, name }].sort((first, second) =>
    first.name < second.name ? -1 : first.name > second.name ? 1 : 0,
  );
  return { ...page, items, totalCount: Number(page.totalCount) + 1 };
}

/** The module's samples, a page at a time, and the page they are of: undefined until the host answers. */
export function use{{ ns }}Samples() {
  const { data, isLoading, isError } = useQuery({
    queryKey: samplesKey,
    queryFn: async () => {
{{ samples_get 6 0 }}
      return data;
    },
  });
  return { samples: data?.items, page: data, isLoading, isError };
}

/**
 * Creates a sample; resolves to whether the host created it. The sample shows in the list at once: it is put into the
 * cached page as the request leaves, and the page as it was put back when the host refuses it. Either way the page is
 * asked for again, with the id the host gave a created one.
 */
export function useCreate{{ ns }}Sample() {
  const client = useQueryClient();
  const { mutateAsync, isPending } = useMutation({
    mutationFn: async (name: string) => {
{{ samples_post 6 }}
      return data;
    },
    onMutate: async (name) => {
      await client.cancelQueries({ queryKey: samplesKey });
      const before = client.getQueryData<SamplesPage>(samplesKey);
      if (before !== undefined) {
        client.setQueryData(samplesKey, withPending(before, name));
      }
      return { before };
    },
    onError: (_error, _name, saved) => {
      if (saved?.before !== undefined) {
        client.setQueryData(samplesKey, saved.before);
      }
    },
    onSettled: () => client.invalidateQueries({ queryKey: samplesKey }),
  });
  const create = async (name: string) => {
    try {
      await mutateAsync(name);
      return true;
    } catch {
      return false;
    }
  };
  return { create, isSaving: isPending };
}
{{~ else if project["frontend.state"] == "pinia" ~}}
import { defineStore } from 'pinia';
import { computed, onMounted, ref } from 'vue';
import { api } from '@/api/baseApi';
import type { components } from '@/api/generated';

/** One of the module's samples, as the host lists it. */
{{ schema ("export type " + ns + "SampleDto") (ns + "SampleDto") }}

{{ schema "type SamplesPage" ("PagedResultOf" + ns + "SampleDto") }}

/** The page of samples the module's page lists: the first, as many as the host gives by default. */
export const samplesPage = { page: 1, pageSize: 20 };

let pending = 0;

/** The page with the new sample in it, by name as the host lists them, until the host's own answer replaces it. */
function withPending(page: SamplesPage, name: string): SamplesPage {
  pending += 1;
  const items = [...page.items, { id: `pending-${pending}`, name }].sort((first, second) =>
    first.name < second.name ? -1 : first.name > second.name ? 1 : 0,
  );
  return { ...page, items, totalCount: Number(page.totalCount) + 1 };
}

/**
 * The module's samples, a page at a time, and creating one. A new sample shows in the page at once, and the page as it
 * was comes back when the host refuses it; a created one is asked for again, with the id the host gave it.
 */
{{~ store_head = "export const use" + ns + "SamplesStore = defineStore('" + module.name + "-samples', () => {" ~}}
{{~ shift = 2 ~}}
{{~ if fits(0, store_head)
  shift = 0
end ~}}
{{~ capture store ~}}
  const page = ref<SamplesPage>();
  const failed = ref(false);
  const saving = ref(false);

  async function load() {
    try {
{{ samples_get 6 shift }}
      page.value = data;
      failed.value = false;
    } catch {
      failed.value = true;
    }
  }

  async function create(name: string) {
    const before = page.value;
    if (before !== undefined) {
      page.value = withPending(before, name);
    }
    saving.value = true;
    try {
      await api.POST('/{{ module.name }}/samples', { body: { name } });
    } catch {
      page.value = before;
      return false;
    } finally {
      saving.value = false;
    }
    await load();
    return true;
  }

  return { page, failed, saving, load, create };
{{~ end ~}}
{{~ if shift == 0 ~}}
{{ store_head }}
{{ store | string.rstrip }}
});
{{~ else ~}}
export const use{{ ns }}SamplesStore = defineStore(
  '{{ module.name }}-samples',
  () => {
{{ regex.replace (store | string.rstrip) "(?m)^(?=.)" "  " }}
  },
);
{{~ end ~}}

/** The module's samples, asked for once the page is mounted: undefined until the host answers. */
export function use{{ ns }}Samples() {
  const store = use{{ ns }}SamplesStore();
  onMounted(() => void store.load());
  return {
    samples: computed(() => store.page?.items),
    page: computed(() => store.page),
    isLoading: computed(() => store.page === undefined && !store.failed),
    isError: computed(() => store.failed),
  };
}

/** Creates a sample; resolves to whether the host created it. */
export function useCreate{{ ns }}Sample() {
  const store = use{{ ns }}SamplesStore();
  return { create: store.create, isSaving: computed(() => store.saving) };
}
{{~ else ~}}
