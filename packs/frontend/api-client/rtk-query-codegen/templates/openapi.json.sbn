{{~ # The document the host serves for the generated endpoints; OpenApiDocumentTests keeps it current from then on. ~}}
{{~ if project["backend.auth"] != "keycloak" ~}}
{
  "openapi": "3.1.1",
  "info": {
    "title": "Host | v1",
    "version": "1.0.0"
  },
  "paths": {}
}
{{~ else ~}}
{
  "openapi": "3.1.1",
  "info": {
    "title": "Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/me": {
      "get": {
        "tags": [
          "Host"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    }{{ if project["backend.tenancy"] != "none" }},
    "/me/tenant": {
      "get": {
        "tags": [
          "Host"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentTenant"
                }
              }
            }
          }
        }
      }
    }{{ end }}{{ if slots["web.openapi-paths"] != "" }},
{{ slots["web.openapi-paths"] }}{{ end }}
  },
  "components": {
    "schemas": {
{{~
  # The host's schemas and every contributed one, sorted by name as the host serves them.
  schemas = []
  if project["backend.tenancy"] != "none"
    capture tenant_schema
~}}
      "CurrentTenant": {
        "required": [
          "tenantId"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
{{~
    end
    schemas = schemas | array.add (tenant_schema | string.rstrip)
  end
  capture user_schema
~}}
      "CurrentUser": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
{{~
  end
  schemas = schemas | array.add (user_schema | string.rstrip)
  if slots["web.openapi-schemas"] != ""
    for contributed in slots["web.openapi-schemas"] | string.split "\n\n"
      schemas = schemas | array.add (contributed | string.rstrip)
    end
  end
~}}
{{ schemas | array.sort | array.join ",\n" }}
    }
  },
  "tags": [
    {
      "name": "Host"
    }
  ]
}
{{~ end ~}}
