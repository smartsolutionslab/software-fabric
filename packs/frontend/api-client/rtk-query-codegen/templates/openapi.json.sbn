{{~ # The document the host serves for the generated endpoints; OpenApiDocumentTests keeps it current from then on. ~}}
{{~ if project["backend.auth"] != "keycloak" ~}}
{
  "openapi": "3.1.1",
  "info": {
    "title": "Host | v1",
    "version": "1.0.0"
  },
  "paths": { }
}
{{~ else ~}}
{
  "openapi": "3.1.1",
  "info": {
    "title": "Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/me": {
      "get": {
        "tags": [
          "Host"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    }{{ if project["backend.tenancy"] != "none" }},
    "/me/tenant": {
      "get": {
        "tags": [
          "Host"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentTenant"
                }
              }
            }
          }
        }
      }
    }{{ end }}
  },
  "components": {
    "schemas": {
{{ if project["backend.tenancy"] != "none" }}      "CurrentTenant": {
        "required": [
          "tenantId"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
{{ end }}      "CurrentUser": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Host"
    }
  ]
}
{{~ end ~}}
