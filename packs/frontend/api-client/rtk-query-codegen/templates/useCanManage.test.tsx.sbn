import { cleanup, renderHook } from '@testing-library/react';
import { afterEach, expect, test, vi } from 'vitest';
import { useCanManage } from './useCanManage';

// RTK Query builds a Request from /api/..., which Node cannot parse without the browser's origin, so the generated hook
// stands in here and answers as RTK Query does: an HTTP error is { status, data }, and a request that never reached the
// host is { status: 'FETCH_ERROR', error }.
const probe = vi.hoisted(() => ({ answer: {} as Record<string, unknown> }));
vi.mock('@/api/generated', () => ({ useGet{{ module.namespace }}PermissionsManageQuery: () => probe.answer }));

// Without Vitest's globals, Testing Library does not unmount between tests by itself.
afterEach(cleanup);

function permission(answer: Record<string, unknown>) {
  probe.answer = answer;
  return renderHook(() => useCanManage()).result.current;
}

test('while the probe has not answered, Manage is still being checked', () => {
  expect(permission({ isLoading: true, isSuccess: false, isError: false })).toBe('checking');
});

test('a 200 from the probe grants Manage', () => {
  expect(permission({ data: { name: '{{ module.name }}.manage' }, isSuccess: true, isError: false })).toBe('granted');
});

test('a 403 from the probe refuses Manage, which is no failure', () => {
  expect(permission({ error: { status: 403, data: '' }, isSuccess: false, isError: true })).toBe('refused');
});

test('a 500 from the probe is a failure the page shows, not a refusal', () => {
  expect(permission({ error: { status: 500, data: 'boom' }, isSuccess: false, isError: true })).toBe('failed');
});

test('a probe that never reaches the host is a failure the page shows, not a refusal', () => {
  const unreachable = { status: 'FETCH_ERROR', error: 'TypeError: Failed to fetch' };
  expect(permission({ error: unreachable, isSuccess: false, isError: true })).toBe('failed');
});
