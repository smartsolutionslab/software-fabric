{{~ ns = module.namespace ~}}
{{~ # Prettier prints a statement on one line when it fits the web app's printWidth (120) and breaks it when it does not, so
    # every line the module's name lengthens is written the way Prettier prints it at that length. ~}}
{{~ func fits(indent, line)
  ret indent + (line | string.size) <= 120
end ~}}
{{~ func imports(names, from)
  line = "import { " + (names | array.join ", ") + " } from '" + from + "';"
  if fits(0, line)
    ret line
  end
  ret "import {\n  " + (names | array.join ",\n  ") + ",\n} from '" + from + "';"
end ~}}
{{~ func braces(indent, before, entries, after)
  line = before + "{ " + (entries | array.join ", ") + " }" + after
  if fits(indent, line)
    ret line
  end
  pad = "  "
  ret before + "{\n" + pad + (entries | array.join (",\n" + pad)) + ",\n}" + after
end ~}}
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { act, cleanup, renderHook, waitFor } from '@testing-library/react';
import type { ReactNode } from 'react';
import { afterEach, expect, test, vi } from 'vitest';
{{ imports ["useCreate" + ns + "Sample", "use" + ns + "Samples"] ("./use" + ns + "Samples") }}

// The host, as GET and POST /{{ module.name }}/samples reach it through the generated client.
const host = vi.fn<(input: RequestInfo | URL, init?: RequestInit) => Promise<Response>>();
vi.stubGlobal('fetch', host);
afterEach(() => host.mockReset());
// Without Vitest's globals, Testing Library does not unmount between tests by itself.
afterEach(cleanup);

const ada = { id: '0198c1a0-0000-7000-8000-000000000001', name: 'Ada' };
const bea = { id: '0198c1a0-0000-7000-8000-000000000002', name: 'Bea' };

function page(items: (typeof ada)[]) {
  return Response.json({ items, totalCount: items.length, page: 1, pageSize: 20 });
}

// A query client of its own per test, so no answer is cached from the test before; it does not retry, so a failure
// shows at once.
function renderSamples() {
  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
  const wrapper = ({ children }: { children: ReactNode }) => (
    <QueryClientProvider client={client}>{children}</QueryClientProvider>
  );
  {{ braces 2 "const useListAndCreation = () => (" ["list: use" + ns + "Samples()", "creation: useCreate" + ns + "Sample()"] ");" }}
  return renderHook(useListAndCreation, { wrapper }).result;
}

const names = (samples: { name: string }[] | undefined) => samples?.map((sample) => sample.name);

test('a created sample is in the list before the server answers and stays once it is created', async () => {
  let answer: (response: Response) => void = () => undefined;
  let created = false;
  host.mockImplementation(async (_input, init) => {
    if (init?.method === 'POST') {
      return new Promise<Response>((resolve) => {
        answer = resolve;
      });
    }
    return page(created ? [ada, bea] : [ada]);
  });
  const samples = renderSamples();
  await waitFor(() => expect(names(samples.current.list.samples)).toEqual(['Ada']));

  let creating: Promise<boolean> = Promise.resolve(false);
  act(() => {
    creating = samples.current.creation.create('Bea');
  });

  await waitFor(() => expect(names(samples.current.list.samples)).toEqual(['Ada', 'Bea']));
  created = true;
  answer(Response.json(bea.id, { status: 201 }));
  await expect(creating).resolves.toBe(true);
  await waitFor(() => expect(samples.current.list.samples?.map((sample) => sample.id)).toEqual([ada.id, bea.id]));
});

test('a sample the server refuses is taken out of the list again', async () => {
  host.mockImplementation(async (_input, init) =>
    init?.method === 'POST' ? Response.json({ title: 'No.' }, { status: 500 }) : page([ada]),
  );
  const samples = renderSamples();
  await waitFor(() => expect(names(samples.current.list.samples)).toEqual(['Ada']));

  let creating: Promise<boolean> = Promise.resolve(true);
  act(() => {
    creating = samples.current.creation.create('Bea');
  });

  await expect(creating).resolves.toBe(false);
  await waitFor(() => expect(names(samples.current.list.samples)).toEqual(['Ada']));
});
