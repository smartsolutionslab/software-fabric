{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "{{ if slots["web.prepare"] != "" }}{{ slots["web.prepare"] }} && {{ end }}vite",
    "build": "{{ if slots["web.prepare"] != "" }}{{ slots["web.prepare"] }} && {{ end }}vue-tsc -b && node check-declarations.mjs && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "{{ if slots["web.prepare"] != "" }}{{ slots["web.prepare"] }} && {{ end }}vitest run",
    "e2e": "playwright test"{{ if slots["web.scripts"] != "" }},
{{ slots["web.scripts"] }}{{ end }}
  },
  "dependencies": {
    "vue": "3.5.44"{{ if slots["web.dependencies"] != "" }},
{{ slots["web.dependencies"] }}{{ end }}
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"{{ if slots["web.dev-dependencies"] != "" }},
{{ slots["web.dev-dependencies"] }}{{ end }}
  }
}
