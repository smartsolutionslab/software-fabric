// skipLibCheck skips every declaration file, this package's own as well as those under node_modules. When the package
// includes one, this checks it again, by vue-tsc with skipLibCheck off, and fails only on errors outside node_modules,
// so theirs stay skipped. Each package runs it in its own build, which a workspace's cache keys on that package alone.
import { spawnSync } from 'node:child_process';
import { createRequire } from 'node:module';
import process from 'node:process';
import ts from 'typescript';

const { config } = ts.readConfigFile('tsconfig.json', ts.sys.readFile);
const { fileNames } = ts.parseJsonConfigFileContent(config, ts.sys, process.cwd());
if (fileNames.some((file) => ts.isDeclarationFileName(file))) {
  const checker = createRequire(import.meta.url).resolve('vue-tsc/bin/vue-tsc.js');
  const arguments_ = ['--project', 'tsconfig.json', '--skipLibCheck', 'false', '--noEmit', '--pretty', 'false'];
  const { status, stdout, stderr } = spawnSync(process.execPath, [checker, ...arguments_], { encoding: 'utf8' });
  // One error per line, with its details indented beneath it; the file it is in comes first.
  const errors = stdout.split(/\n(?=\S)/).filter((error) => /error TS\d+/.test(error));
  const own = errors.filter((error) => !error.slice(0, error.indexOf('(')).includes('node_modules/'));
  if (own.length > 0 || (status !== 0 && errors.length === 0)) {
    process.stderr.write(own.length > 0 ? `${own.join('\n')}\n` : stdout + stderr);
    process.exitCode = 1;
  }
}
