{{~ func class_of(tailwind, module)
  if project["frontend.styling"] == "css-modules"
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
<script setup lang="ts">
import { watchEffect } from 'vue';
import { useAuth } from '@/auth/useAuth';
{{~ if project["frontend.styling"] == "css-modules" ~}}
import styles from './SignedIn.module.css';
{{~ end ~}}

/** Renders its default slot for a signed-in user and sends everyone else to the identity provider. */
const { account, isAuthenticated, isLoading, error, activeNavigator, loginRedirect, logoutRedirect } = useAuth();

watchEffect(() => {
  if (!isAuthenticated.value && !isLoading.value && !error.value && !activeNavigator.value) {
    void loginRedirect();
  }
});
</script>

<template>
  <p v-if="error" role="alert">Sign-in failed: {{ "{{" }} error.message {{ "}}" }}</p>
  <p v-else-if="activeNavigator === 'logoutRedirect'">Signing out…</p>
  <p v-else-if="!isAuthenticated">Signing in…</p>
  <template v-else>
    <div {{ class_of "flex items-center justify-end gap-3 p-2 text-sm" "signedIn" }}>
      <span>Signed in as {{ "{{" }} account?.username {{ "}}" }}</span>
      <button type="button" @click="logoutRedirect()">Sign out</button>
    </div>
    <slot />
  </template>
</template>
