{{~ vuetify = project["frontend.ui-library"] == "vuetify" ~}}
{{~ func class_of(tailwind, module, material)
  if vuetify
    ret 'class="' + material + '"'
  end
  if project["frontend.styling"] == "css-modules"
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
<script setup lang="ts">
import { watchEffect } from 'vue';
{{~ if vuetify ~}}
import { VBtn } from 'vuetify/components';
{{~ end ~}}
import { useAuth } from '@/auth/useAuth';
{{~ if project["frontend.styling"] == "css-modules" && !vuetify ~}}
import styles from './SignedIn.module.css';
{{~ end ~}}

/** Renders its default slot for a signed-in user and sends everyone else to the identity provider. */
const { user, isAuthenticated, isLoading, error, activeNavigator, signinRedirect, signoutRedirect } = useAuth();

watchEffect(() => {
  if (!isAuthenticated.value && !isLoading.value && !error.value && !activeNavigator.value) {
    void signinRedirect();
  }
});
</script>

<template>
  <p v-if="error" role="alert">Sign-in failed: {{ "{{" }} error.message {{ "}}" }}</p>
  <p v-else-if="activeNavigator === 'signoutRedirect'">Signing out…</p>
  <p v-else-if="!isAuthenticated">Signing in…</p>
  <template v-else>
    <div {{ class_of "flex items-center justify-end gap-3 p-2 text-sm" "signedIn" "d-flex align-center justify-end ga-3 pa-2 text-body-medium" }}>
      <span>Signed in as {{ "{{" }} user?.profile.preferred_username {{ "}}" }}</span>
{{~ if vuetify ~}}
      <VBtn type="button" variant="text" size="small" @click="signoutRedirect()">Sign out</VBtn>
{{~ else ~}}
      <button type="button" @click="signoutRedirect()">Sign out</button>
{{~ end ~}}
    </div>
    <slot />
  </template>
</template>
