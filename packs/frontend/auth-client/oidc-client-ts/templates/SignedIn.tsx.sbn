{{~ func class_of(tailwind, module)
  if project["frontend.styling"] == "css-modules"
    ret 'className={styles.' + module + '}'
  end
  ret 'className="' + tailwind + '"'
end ~}}
import { type ReactNode, useEffect } from 'react';
import { hasAuthParams, useAuth } from 'react-oidc-context';
{{~ if project["frontend.styling"] == "css-modules" ~}}
import styles from './SignedIn.module.css';
{{~ end ~}}

/** Renders its children for a signed-in user and sends everyone else to the identity provider. */
export function SignedIn({ children }: { children: ReactNode }) {
  const auth = useAuth();
  const mustSignIn =
    !auth.isAuthenticated && !auth.isLoading && !auth.activeNavigator && !auth.error && !hasAuthParams();

  useEffect(() => {
    if (mustSignIn) {
      void auth.signinRedirect();
    }
  }, [mustSignIn, auth]);

  if (auth.error) {
    return <p role="alert">Sign-in failed: {auth.error.message}</p>;
  }
  if (!auth.isAuthenticated) {
    return <p>Signing in…</p>;
  }

  return (
    <>
      <div {{ class_of "flex items-center justify-end gap-3 p-2 text-sm" "signedIn" }}>
        <span>Signed in as {auth.user?.profile.preferred_username}</span>
        <button type="button" onClick={() => void auth.signoutRedirect()}>
          Sign out
        </button>
      </div>
      {children}
    </>
  );
}
