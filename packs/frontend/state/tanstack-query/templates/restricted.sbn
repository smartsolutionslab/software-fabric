{{~ if project["frontend.framework"] == "vue" ~}}
            {
              group: ['pinia', 'pinia-*', '@pinia/*', 'vuex', 'mobx', 'mobx-*', 'swrv', '@apollo/*', '@vue/apollo-*'],
