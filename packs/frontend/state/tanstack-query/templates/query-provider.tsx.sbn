{{~ if project["frontend.framework"] != "react" ~}}
throw new Error('The tanstack-query pack provides the React client only so far (docs/adr/0006 of the generator).');
{{~ end ~}}
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import type { ReactNode } from 'react';

/** The one cache of server data; the generated hooks (src/api/generated.ts) read and invalidate it. */
const queryClient = new QueryClient();

export const withQueryClient = (children: ReactNode) => (
  <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>
);
