{{~ option = project["backend.absence"] == "option" ~}}
{{~ func none
  if option
    ret "Option<string>.None"
  end
  ret "null"
end ~}}
{{~ func some(value)
  if option
    ret "Option<string>.Some(" + value + ")"
  end
  ret value
end ~}}
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.Dashboards.Application.DTOs;
using {{ namespace }}.Modules.Dashboards.Application.Queries.ProposeWidget;
using {{ namespace }}.Tests.Fakes;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Modules.Dashboards.Tests.Queries;

/// <summary>The dashboards agent's proposal, through the dispatcher: a declared widget as a fitting visual, never saved.</summary>
public class ProposeWidgetTests
{
    {{ test_attribute }}
    public async Task A_declared_chart_is_proposed_with_its_declared_title()
    {
        var result = await ProposeAsync(new ProposeWidget("dashboards.widget-counts", "line", {{ none }}));

        {{ `result.IsSuccess` | should_be_true }};
        {{ `result.Value.Source` | should_be `"dashboards.widget-counts"` }};
        {{ `result.Value.Title` | should_be `"Widgets per dashboard"` }};
        {{ `result.Value.Visual` | should_be `"line"` }};
        {{ `result.Value.Replaces` | should_be_null }};
    }

    {{ test_attribute }}
    public async Task A_proposal_names_the_draft_widget_it_replaces()
    {
        var result = await ProposeAsync(new ProposeWidget("dashboards.my-dashboards", "table", {{ some "\"w-1\"" }}));

        {{ `result.IsSuccess` | should_be_true }};
        {{ `result.Value.Replaces` | should_be `"w-1"` }};
    }

    {{ test_attribute }}
    public async Task A_widget_the_modules_do_not_declare_is_refused_with_its_code()
    {
        var result = await ProposeAsync(new ProposeWidget("billing.everything", "bar", {{ none }}));

        {{ `result.IsSuccess` | should_be_false }};
        {{ `result.Error.Code` | should_be `"dashboards.unknown-widget"` }};
    }

    {{ test_cases_attribute }}
    {{ test_case_attribute `"dashboards.my-dashboards", "bar"` }}
    {{ test_case_attribute `"dashboards.widget-counts", "table"` }}
    {{ test_case_attribute `"dashboards.widget-counts", "radar"` }}
    public async Task A_visual_that_does_not_fit_the_widget_is_refused_with_its_code(string source, string visual)
    {
        var result = await ProposeAsync(new ProposeWidget(source, visual, {{ none }}));

        {{ `result.IsSuccess` | should_be_false }};
        {{ `result.Error.Code` | should_be `"dashboards.invalid-widget"` }};
    }

    {{ test_cases_attribute }}
    {{ test_case_attribute `""` }}
    {{ test_case_attribute `" "` }}
    {{ test_case_attribute `"an-identifier-of-sixty-five-characters-is-one-more-than-a-key-has"` }}
    public async Task A_replaced_key_must_be_one_a_dashboard_can_hold(string key)
    {
        var result = await ProposeAsync(new ProposeWidget("dashboards.widget-counts", "bar", {{ some "key" }}));

        {{ `result.IsSuccess` | should_be_false }};
        {{ `result.Error.Code` | should_be `"dashboards.invalid-widget"` }};
    }

    private static async Task<Result<WidgetProposalDto, ApiError>> ProposeAsync(ProposeWidget query)
    {
        using var model = new FakeChatClient("unused");
        await using var services = DashboardServices.Build(model);
        await using var scope = services.CreateAsyncScope();
        return await scope.ServiceProvider.GetRequiredService<IDispatcher>().QueryAsync(query, {{ test_cancellation_token }});
    }
}
