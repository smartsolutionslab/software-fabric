using System.Net;
using System.Net.Http.Json;
using System.Text;
using System.Text.Json.Nodes;

namespace {{ namespace }}.Integration.Tests;

/// <summary>
/// The dashboards agent through the running application, POST /agents/dashboards: it proposes only a declared widget,
/// as a fitting visual, and saves nothing; the user accepts a proposal in the browser and saves it as any edit. The host
/// answers with its stand-in model, which calls the tool a message names with the JSON arguments the message gives.
/// The visitor asks: no other test saves a dashboard of theirs, so their count shows that nothing was saved.
/// </summary>
{{~ integration_fixture_attributes ~}}
public class GenerativeDashboardsTests({{ integration_fixture }})
{
    {{ test_attribute }}
    public async Task A_declared_widget_is_proposed_with_its_declared_title_and_nothing_is_saved()
    {
        var cancellationToken = {{ test_cancellation_token }};
        using var visitor = await {{ signed_in_host_client `"visitor"` }};
        var before = await CountAsync(visitor, cancellationToken);

        var events = await RunAsync(visitor, """propose_widget {"source":"dashboards.widget-counts","visual":"bar","replaces":null}""", null, cancellationToken);

        {{ `events.Single(agUiEvent => Type(agUiEvent) == "TOOL_CALL_START")["toolCallName"]!.GetValue<string>()` | should_be `"propose_widget"` }};
        var proposal = JsonNode.Parse(Result(events))!;
        {{ `proposal["source"]!.GetValue<string>()` | should_be `"dashboards.widget-counts"` }};
        {{ `proposal["title"]!.GetValue<string>()` | should_be `"Widgets per dashboard"` }};
        {{ `proposal["visual"]!.GetValue<string>()` | should_be `"bar"` }};
        {{ `proposal["replaces"]` | should_be_null }};
        {{ `(await CountAsync(visitor, cancellationToken))` | should_be `before` }};
    }

    {{ test_attribute }}
    public async Task A_proposal_may_replace_a_widget_of_the_open_draft()
    {
        var cancellationToken = {{ test_cancellation_token }};
        using var visitor = await {{ signed_in_host_client `"visitor"` }};
        const string Draft = """{ "widgets": [{ "key": "w-1", "source": "dashboards.widget-counts", "visual": "bar" }] }""";

        var events = await RunAsync(visitor, """propose_widget {"source":"dashboards.widget-counts","visual":"pie","replaces":"w-1"}""", Draft, cancellationToken);

        var proposal = JsonNode.Parse(Result(events))!;
        {{ `proposal["visual"]!.GetValue<string>()` | should_be `"pie"` }};
        {{ `proposal["replaces"]!.GetValue<string>()` | should_be `"w-1"` }};
    }

    {{ test_attribute }}
    public async Task A_widget_the_modules_do_not_declare_is_refused()
    {
        var cancellationToken = {{ test_cancellation_token }};
        using var visitor = await {{ signed_in_host_client `"visitor"` }};

        var events = await RunAsync(visitor, """propose_widget {"source":"billing.everything","visual":"bar","replaces":null}""", null, cancellationToken);

        {{ `Result(events)` | should_start_with `"Failed: dashboards.unknown-widget"` }};
    }

    {{ test_attribute }}
    public async Task A_table_proposed_as_a_chart_is_refused()
    {
        var cancellationToken = {{ test_cancellation_token }};
        using var visitor = await {{ signed_in_host_client `"visitor"` }};

        var events = await RunAsync(visitor, """propose_widget {"source":"dashboards.my-dashboards","visual":"bar","replaces":null}""", null, cancellationToken);

        {{ `Result(events)` | should_start_with `"Failed: dashboards.invalid-widget"` }};
    }

    {{ test_attribute }}
    public async Task The_agent_can_list_the_declared_widgets_a_page_at_a_time()
    {
        var cancellationToken = {{ test_cancellation_token }};
        using var visitor = await {{ signed_in_host_client `"visitor"` }};

        var events = await RunAsync(visitor, """list_widgets {"page":1,"pageSize":20}""", null, cancellationToken);

        var page = JsonNode.Parse(Result(events))!;
        {{ `page["items"]!.AsArray().Select(widget => widget!["id"]!.GetValue<string>())` | should_contain `"dashboards.widget-counts"` }};
    }

    {{ test_attribute }}
    public async Task A_draft_that_is_not_a_list_of_widgets_is_refused()
    {
        var cancellationToken = {{ test_cancellation_token }};
        using var visitor = await {{ signed_in_host_client `"visitor"` }};

        using var response = await PostAsync(visitor, "Show me something.", """{ "widgets": "all of them" }""", cancellationToken);

        {{ `response.StatusCode` | should_be `HttpStatusCode.BadRequest` }};
        {{ `(await response.Content.ReadAsStringAsync(cancellationToken))` | should_contain `"dashboards.invalid-draft"` }};
    }

    private static async Task<List<JsonObject>> RunAsync(HttpClient caller, string message, string? draft, CancellationToken cancellationToken)
    {
        using var response = await PostAsync(caller, message, draft, cancellationToken);
        var stream = await response.Content.ReadAsStringAsync(cancellationToken);
        {{ `response.StatusCode` | should_be `HttpStatusCode.OK` `stream` }};
        return
        [
            .. stream.Split('\n')
                .Where(line => line.StartsWith("data:", StringComparison.Ordinal))
                .Select(line => JsonNode.Parse(line["data:".Length..])!.AsObject()),
        ];
    }

    private static async Task<HttpResponseMessage> PostAsync(HttpClient caller, string message, string? draft, CancellationToken cancellationToken)
    {
        var run = new JsonObject
        {
            ["threadId"] = "thread-1",
            ["runId"] = "run-1",
            ["state"] = JsonNode.Parse(draft ?? "{}"),
            ["messages"] = new JsonArray(new JsonObject { ["id"] = "message-1", ["role"] = "user", ["content"] = message }),
            ["tools"] = new JsonArray(),
            ["context"] = new JsonArray(),
            ["forwardedProps"] = new JsonObject(),
        };
        using var content = new StringContent(run.ToJsonString(), Encoding.UTF8, "application/json");
        return await caller.PostAsync(new Uri("/agents/dashboards", UriKind.Relative), content, cancellationToken);
    }

    private static async Task<int> CountAsync(HttpClient caller, CancellationToken cancellationToken)
    {
        var page = await caller.GetFromJsonAsync<JsonObject>("/dashboards?page=1&pageSize=100", cancellationToken);
        return page!["totalCount"]!.GetValue<int>();
    }

    /// <summary>The one tool result of the run, as the browser receives it.</summary>
    private static string Result(List<JsonObject> events) =>
        events.Single(agUiEvent => Type(agUiEvent) == "TOOL_CALL_RESULT")["content"]!.GetValue<string>();

    private static string Type(JsonObject agUiEvent) => agUiEvent["type"]!.GetValue<string>();
}
