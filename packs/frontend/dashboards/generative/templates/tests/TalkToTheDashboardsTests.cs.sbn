{{~ end ~}}
using System.Text.Json;
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.Dashboards.Application.Queries.TalkToTheDashboards;
using {{ namespace }}.Tests.Fakes;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Modules.Dashboards.Tests.Queries;

/// <summary>
/// The dashboards agent, run through its query and the dispatcher as the host's POST /agents/dashboards runs it: its
/// tools are the widget catalogue and the proposal, and the open draft reaches the model as context, never saved.
/// </summary>
public class TalkToTheDashboardsTests
{
    [Fact]
    public async Task The_agent_proposes_a_declared_widget_through_the_dispatcher_and_is_offered_only_its_two_tools()
    {
        using var model = new ToolCallingChatClient("propose_widget", new Dictionary<string, object?> { ["source"] = "dashboards.widget-counts", ["visual"] = "bar", ["replaces"] = null });

        var updates = await RunAsync(model, null);

        model.Offered[0].ShouldBe(["list_widgets", "propose_widget"]);
        var proposal = JsonDocument.Parse(updates.SelectMany(update => update.Contents).OfType<FunctionResultContent>().Single().Result!.ToString()!).RootElement;
        proposal.GetProperty("title").GetString().ShouldBe("Widgets per dashboard");
        proposal.GetProperty("visual").GetString().ShouldBe("bar");
    }

    [Fact]
    public async Task The_open_draft_reaches_the_model_before_the_conversation_with_the_declared_titles_and_without_undeclared_widgets()
    {
        using var model = new RecordingChatClient();
        const string Draft = """
            { "widgets": [
              { "key": "w-1", "source": "dashboards.widget-counts", "visual": "bar" },
              { "key": "w-2", "source": "billing.gone", "visual": "bar" }
            ] }
            """;

        await RunAsync(model, JsonDocument.Parse(Draft).RootElement);

        var messages = model.Requests[0].Where(message => message.Role == ChatRole.User).ToList();
        messages.Count.ShouldBe(2);
        messages[0].Text.ShouldContain("\"key\":\"w-1\"");
        messages[0].Text.ShouldContain("\"title\":\"Widgets per dashboard\"");
        messages[0].Text.ShouldNotContain("billing.gone");
        messages[1].Text.ShouldBe("Make the chart a pie.");
    }

    [Fact]
    public async Task Without_a_draft_the_model_gets_the_conversation_alone()
    {
        using var model = new RecordingChatClient();

        await RunAsync(model, JsonDocument.Parse("{}").RootElement);

        model.Requests[0].Where(message => message.Role == ChatRole.User).Select(message => message.Text).ShouldBe(["Make the chart a pie."]);
    }

    [Theory]
    [InlineData("""{ "widgets": "all of them" }""")]
    [InlineData("""{ "widgets": [{ "key": "w-1", "source": 7, "visual": "bar" }] }""")]
    [InlineData("""{ "widgets": [{ "key": "", "source": "dashboards.widget-counts", "visual": "bar" }] }""")]
    [InlineData("""[]""")]
    public async Task A_draft_that_is_not_a_list_of_widgets_is_refused_with_its_code(string draft)
    {
        using var model = new RecordingChatClient();
        await using var services = DashboardServices.Build(model);
        await using var scope = services.CreateAsyncScope();

        var result = await scope.ServiceProvider.GetRequiredService<IDispatcher>().QueryAsync(
            TalkToTheDashboards.Start([new ChatMessage(ChatRole.User, "Make the chart a pie.")], JsonDocument.Parse(draft).RootElement),
            TestContext.Current.CancellationToken);

        result.IsSuccess.ShouldBeFalse();
        result.Error.Code.ShouldBe("dashboards.invalid-draft");
    }

    [Fact]
    public async Task A_draft_with_more_widgets_than_a_dashboard_holds_is_refused_with_its_code()
    {
        var widgets = string.Join(',', Enumerable.Range(1, 51).Select(index => "{ \"key\": \"w-" + index + "\", \"source\": \"dashboards.widget-counts\", \"visual\": \"bar\" }"));
        using var model = new RecordingChatClient();
        await using var services = DashboardServices.Build(model);
        await using var scope = services.CreateAsyncScope();

        var result = await scope.ServiceProvider.GetRequiredService<IDispatcher>().QueryAsync(
            TalkToTheDashboards.Start([new ChatMessage(ChatRole.User, "Make the chart a pie.")], JsonDocument.Parse("{ \"widgets\": [" + widgets + "] }").RootElement),
            TestContext.Current.CancellationToken);

        result.Error.Code.ShouldBe("dashboards.invalid-draft");
    }

    private static async Task<List<ChatResponseUpdate>> RunAsync(IChatClient model, JsonElement? draft)
    {
        var cancellationToken = TestContext.Current.CancellationToken;
        await using var services = DashboardServices.Build(model);
        await using var scope = services.CreateAsyncScope();

        var result = await scope.ServiceProvider.GetRequiredService<IDispatcher>().QueryAsync(
            TalkToTheDashboards.Start([new ChatMessage(ChatRole.User, "Make the chart a pie.")], draft),
            cancellationToken);

        result.IsSuccess.ShouldBeTrue();
        List<ChatResponseUpdate> updates = [];
        await foreach (var update in result.Value.WithCancellation(cancellationToken))
        {
            updates.Add(update);
        }

        return updates;
    }
}
