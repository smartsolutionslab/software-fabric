{{~ wolverine = project["backend.mediator"] == "wolverine" ~}}
{{~ policies = object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
{{~ if wolverine ~}}
using {{ namespace }}.BuildingBlocks.Modules;
{{~ end ~}}
using {{ namespace }}.Modules.Dashboards.Api;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
{{~ if wolverine ~}}
using Microsoft.Extensions.Hosting;
using Wolverine;
using Wolverine.Runtime;
{{~ end ~}}

namespace {{ namespace }}.Modules.Dashboards.Tests.Queries;

/// <summary>The dashboards module with what the host provides: the dispatcher, the model and the module's own widgets.</summary>
internal static class DashboardServices
{
    public static ServiceProvider Build(IChatClient model)
    {
        var services = new ServiceCollection().AddLogging();
        var configuration = new ConfigurationBuilder()
            .AddInMemoryCollection(new Dictionary<string, string?> { ["ConnectionStrings:database"] = "Host=localhost" })
            .Build();
        services.AddDispatcher();
        services.AddSingleton(model);
        services.AddDashboardWidgets([new DashboardsModule()]);
        new DashboardsModule().AddServices(services, configuration);
{{~ if wolverine ~}}
        services.AddWolverine(options =>
        {
            options.Durability.Mode = DurabilityMode.MediatorOnly;
            options.Discovery.DisableConventionalDiscovery();
            options.Discovery.IncludeAssembly(ModuleAssemblies.Of<DashboardsModule>("Application"));
            options.DiscoverRequestHandlers();
{{~ if policies ~}}
            options.ResolveWidgetAccessFromScope();
{{~ end ~}}
        });
        var provider = services.BuildServiceProvider();

        // Wolverine's runtime is the hosted service a host would start.
        ((IHostedService)provider.GetRequiredService<IWolverineRuntime>()).StartAsync(CancellationToken.None).GetAwaiter().GetResult();
        return provider;
{{~ else ~}}
        return services.BuildServiceProvider();
{{~ end ~}}
    }
}
