{{~ ui = project["frontend.ui-library"] ~}}
{{~ css_modules = project["frontend.styling"] == "css-modules" ~}}
{{~ if ui == "reka-ui"
  button = "BaseButton"
  button_import = "import BaseButton from '@/components/ui/BaseButton.vue';"
  secondary = "outline"
else
  button = "Button"
  button_import = "import { Button } from '@/components/ui/button';"
  secondary = "secondary"
end ~}}
{{~ func class_of(tailwind, module)
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
{{~ func themed(shadcn, palette, module)
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  if ui == "reka-ui"
    ret 'class="' + palette + '"'
  end
  ret 'class="' + shadcn + '"'
end ~}}
{{~ valibot = project["frontend.validation"] == "valibot" ~}}
{{~ if (ui != "shadcn-vue" && ui != "reka-ui") || project["frontend.forms"] != "vee-validate" || (project["frontend.validation"] != "zod" && project["frontend.validation"] != "valibot") ~}}
<script lang="ts">
throw new Error('The generative dashboards pack builds the Vue assistant from shadcn-vue or reka-ui with vee-validate and zod or valibot only so far; frontend.ui-library is {{ project["frontend.ui-library"] }}, frontend.forms is {{ project["frontend.forms"] }}, frontend.validation is {{ project["frontend.validation"] }} (docs/adr/0006 of the generator).');
</script>

{{~ end ~}}
{%{<script setup lang="ts">
import { contentToText } from '@ag-ui/client';
}%}{{~ if valibot ~}}
import * as v from 'valibot';
import { useForm } from 'vee-validate';
import { computed, useId, watch } from 'vue';
{{~ else ~}}
import { useForm } from 'vee-validate';
import { computed, useId, watch } from 'vue';
import { z } from 'zod';
{{~ end ~}}
{%{import { useAgent } from '@/agents/useAgent';
}%}{{ button_import }}{%{
import { toTypedSchema } from '@/forms/toTypedSchema';
import type { Placement } from './layout';
import { draftState, type PendingProposal, proposalsOf, toolOutcome, toolResults } from './proposal';
}%}{{~ if css_modules ~}}
import styles from './DashboardAssistant.module.css';
{{~ end ~}}
{%{
/** What the conversation shows of one message, as text: the user's, the agent's, and what each of its tools did. */
type Entry = { kind: 'user' | 'answer' | 'tool-call'; key: string; text: string };

interface DashboardAssistantProps {
  /** The open draft's widgets, which every run sends the agent as context. */
  widgets: readonly Placement[];
}

/**
 * A conversation with the dashboards agent (POST /api/agents/dashboards) about the open dashboard: the user asks for a
 * widget, and each widget it proposes goes to the canvas, which shows it pending. The agent saves nothing.
 */
const { widgets } = defineProps<DashboardAssistantProps>();
/** Emitted once for each widget the agent proposes, which the canvas shows pending until the user decides on it. */
const emit = defineEmits<{ proposal: [pending: PendingProposal] }>();

}%}{{~ if valibot ~}}
const questionSchema = v.object({ question: v.pipe(v.string(), v.trim(), v.minLength(1, 'Ask for a widget first.')) });
{{~ else ~}}
const questionSchema = z.object({ question: z.string().trim().min(1, 'Ask for a widget first.') });
{{~ end ~}}
{%{
const { messages, running, failure, send } = useAgent('dashboards', () => draftState(widgets));
const { defineField, errors, handleSubmit, resetForm } = useForm({
  validationSchema: toTypedSchema(questionSchema),
  initialValues: { question: '' },
});
const [question, questionAttributes] = defineField('question');
const field = useId();

const submit = handleSubmit(async (values) => {
  resetForm();
  await send(values.question);
});

const results = computed(() => toolResults(messages.value));

// Each proposal goes to the canvas once, in the order the agent made them: a decided one does not come back when the
// conversation goes on.
const reported = new Set<string>();
watch(
  () => proposalsOf(messages.value, results.value),
  (proposals) => {
    for (const proposal of proposals) {
      if (!reported.has(proposal.call)) {
        reported.add(proposal.call);
        emit('proposal', proposal);
      }
    }
  },
);

const entries = computed(() =>
  messages.value.flatMap((each): Entry[] => {
    if (each.role === 'user') {
      return [{ kind: 'user', key: each.id, text: contentToText(each.content) }];
    }

    if (each.role !== 'assistant') {
      return [];
    }

    const text = contentToText(each.content);
    return [
      ...(text ? [{ kind: 'answer', key: each.id, text } as const] : []),
      ...(each.toolCalls ?? []).map((call) => ({
        kind: 'tool-call' as const,
        key: call.id,
        text: toolOutcome(call.function.name, results.value.get(call.id)),
      })),
    ];
  }),
);
</script>

<template>
  <section aria-label="Dashboard assistant" }%}{{ class_of "flex flex-col gap-2 rounded border p-2" "assistant" }}{%{>
    <h2 }%}{{ class_of "text-sm font-medium" "heading" }}{%{>Assistant</h2>
    <ol aria-label="Conversation" }%}{{ class_of "flex flex-col gap-2 text-sm" "conversation" }}{%{>
      <template v-for="entry in entries" :key="entry.key">
        <li v-if="entry.kind === 'user'" }%}{{ themed "self-end rounded-md bg-primary px-3 py-2 text-primary-foreground" "self-end rounded-md bg-slate-900 px-3 py-2 text-white" "user" }}{%{>
          <p }%}{{ class_of "text-xs font-medium" "speaker" }}{%{>You</p>
          <p }%}{{ class_of "whitespace-pre-wrap" "text" }}{%{>{{ entry.text }}</p>
        </li>
        <li v-else-if="entry.kind === 'answer'" }%}{{ themed "rounded-md bg-muted px-3 py-2" "rounded-md bg-slate-100 px-3 py-2" "answer" }}{%{>
          <p }%}{{ themed "text-xs font-medium text-muted-foreground" "text-xs font-medium text-slate-500" "answerSpeaker" }}{%{>Assistant</p>
          <p }%}{{ class_of "whitespace-pre-wrap" "text" }}{%{>{{ entry.text }}</p>
        </li>
        <li v-else }%}{{ class_of "rounded-md border px-3 py-2" "toolCall" }}{%{>{{ entry.text }}</li>
      </template>
    </ol>
    <p aria-live="polite" }%}{{ themed "text-sm text-muted-foreground" "text-sm text-slate-500" "status" }}{%{>{{ running ? 'Answering…' : '' }}</p>
    <p v-if="failure" role="alert" }%}{{ themed "text-sm text-destructive" "text-sm text-red-600" "error" }}{%{>The assistant could not answer: {{ failure }}</p>
    <form novalidate }%}{{ class_of "flex flex-col gap-2" "form" }}{%{ @submit="submit">
      <label :for="field" }%}{{ class_of "text-sm font-medium" "heading" }}{%{>Ask the assistant</label>
      <textarea
        :id="field"
        v-model="question"
        v-bind="questionAttributes"
        rows="2"
        :aria-invalid="errors.question ? true : undefined"
        :aria-describedby="errors.question ? `${field}-error` : undefined"
        }%}{{ themed "flex field-sizing-content min-h-12 w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:ring-destructive/40" "flex field-sizing-content min-h-12 w-full rounded-md border border-slate-300 bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-slate-500 focus-visible:border-slate-400 focus-visible:ring-[3px] focus-visible:ring-slate-400/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-red-600 aria-invalid:ring-red-600/20 md:text-sm" "input" }}{%{
      />
      <p v-if="errors.question" :id="`${field}-error`" role="alert" }%}{{ themed "text-sm text-destructive" "text-sm text-red-600" "error" }}{%{>
        {{ errors.question }}
      </p>
      <}%}{{ button }}{%{ type="submit" variant="}%}{{ secondary }}{%{" :disabled="running" }%}{{ class_of "self-end" "ask" }}{%{>Ask</}%}{{ button }}{%{>
    </form>
  </section>
</template>
}%}