{{~ ui = project["frontend.ui-library"] ~}}
{{~ vuetify = ui == "vuetify" ~}}
{{~ css_modules = project["frontend.styling"] == "css-modules" && !vuetify ~}}
{{~ if ui == "reka-ui"
  button = "BaseButton"
  button_import = "import BaseButton from '@/components/ui/BaseButton.vue';"
  secondary = "outline"
else if vuetify
  button = "VBtn"
  button_import = "import { VBtn } from 'vuetify/components';"
  secondary = "tonal"
else
  button = "Button"
  button_import = "import { Button } from '@/components/ui/button';"
  secondary = "secondary"
end ~}}
{{~ if vuetify
  primary = ' color="primary"'
  ghost = 'variant="text"'
  small = 'size="small"'
else
  primary = ""
  ghost = 'variant="ghost"'
  small = 'size="sm"'
end ~}}
{{~ func class_of(tailwind, module, material)
  if vuetify
    ret 'class="' + material + '"'
  end
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
{{~ # The palette's colours under the tokens' semantic names (docs/slots.md of the generator), with the tokens.
func palette_of(palette)
  if project["frontend.design-system"] != "tokens"
    ret palette
  end
  ret palette | string.replace "bg-slate-900" "bg-primary" | string.replace "text-white" "text-primary-foreground" | string.replace "bg-slate-100" "bg-surface" | string.replace "bg-white" "bg-surface" | string.replace "border-slate-300" "border-border" | string.replace "border-slate-400" "border-primary" | string.replace "border-slate-900" "border-primary" | string.replace "ring-slate-400" "ring-primary" | string.replace "text-slate-500" "text-muted-foreground" | string.replace "text-slate-600" "text-muted-foreground" | string.replace "border-red-600" "border-destructive" | string.replace "ring-red-600" "ring-destructive" | string.replace "text-red-600" "text-destructive"
end ~}}
{{~ func themed(shadcn, palette, module, material)
  if vuetify
    ret 'class="' + material + '"'
  end
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  if ui == "reka-ui"
    ret 'class="' + palette_of(palette) + '"'
  end
  ret 'class="' + shadcn + '"'
end ~}}
{%{<script setup lang="ts">
}%}{{ button_import }}{%{
import type { WidgetProposal } from './proposal';
import WidgetView from './WidgetView.vue';
}%}{{~ if css_modules ~}}
import styles from './PendingWidget.module.css';
{{~ end ~}}
{%{
interface PendingWidgetProps {
  proposal: WidgetProposal;
  height: number;
  /** Whether it takes the place of a widget on the draft rather than adding one. */
  replacing: boolean;
  /** Whether the draft has room for it: a replacement always has. */
  canAccept: boolean;
  /** Goes up with every save of the dashboard, so the widget's data is read again, as a placed widget's is. */
  refresh: number;
}

/**
 * A widget the dashboards agent proposed, on the grid with its live data until the user decides. Accept puts it on the
 * draft and Discard drops it; neither saves anything.
 */
const { proposal, height, replacing, canAccept, refresh } = defineProps<PendingWidgetProps>();
const emit = defineEmits<{ accept: []; discard: [] }>();
</script>

<template>
}%}{{~ if css_modules ~}}
  <section :aria-label="`Proposed: ${proposal.title}`" :class="styles.pending">
{{~ else ~}}
  <section
    :aria-label="`Proposed: ${proposal.title}`"
    {{ themed "flex h-full flex-col overflow-hidden rounded border border-dashed border-primary bg-card p-2" "flex h-full flex-col overflow-hidden rounded border border-dashed border-slate-900 bg-white p-2" "pending" "d-flex h-100 flex-column overflow-hidden rounded border border-dashed border-primary bg-surface pa-2" }}
  >
{{~ end ~}}
{%{    <header }%}{{ class_of "flex flex-wrap items-center justify-between gap-2" "header" "d-flex flex-wrap align-center justify-space-between ga-2" }}{%{>
      <h2 }%}{{ class_of "text-sm font-medium" "title" "text-title-small" }}{%{>Proposed: {{ proposal.title }}</h2>
      <div }%}{{ class_of "flex gap-1" "actions" "d-flex ga-1" }}{%{>
        <}%}{{ button }}{{ primary }}{%{ type="button" }%}{{ small }}{%{ :disabled="!canAccept" @click="emit('accept')">Accept</}%}{{ button }}{%{>
        <}%}{{ button }}{%{ type="button" }%}{{ ghost }} {{ small }}{%{ @click="emit('discard')">Discard</}%}{{ button }}{%{>
      </div>
    </header>
    <p v-if="replacing" }%}{{ themed "text-xs text-muted-foreground" "text-xs text-slate-500" "note" "text-body-small text-medium-emphasis" }}{%{>Replaces a widget on this dashboard.</p>
    <div }%}{{ class_of "min-h-0 flex-1 overflow-auto" "body" "flex-1-1 overflow-auto" }}{%{>
      <WidgetView
        :source="proposal.source"
        :visual="proposal.visual"
        :title="proposal.title"
        :height="height"
        :refresh="refresh"
      />
    </div>
  </section>
</template>
}%}