{{~ ui = project["frontend.ui-library"] ~}}
{{~ css_modules = project["frontend.styling"] == "css-modules" ~}}
{{~ if ui == "reka-ui"
  button = "BaseButton"
  button_import = "import BaseButton from '@/components/ui/BaseButton.vue';"
  secondary = "outline"
else
  button = "Button"
  button_import = "import { Button } from '@/components/ui/button';"
  secondary = "secondary"
end ~}}
{{~ func class_of(tailwind, module)
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
{{~ func themed(shadcn, palette, module)
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  if ui == "reka-ui"
    ret 'class="' + palette + '"'
  end
  ret 'class="' + shadcn + '"'
end ~}}
{%{<script setup lang="ts">
}%}{{ button_import }}{%{
import type { WidgetProposal } from './proposal';
import WidgetView from './WidgetView.vue';
}%}{{~ if css_modules ~}}
import styles from './PendingWidget.module.css';
{{~ end ~}}
{%{
interface PendingWidgetProps {
  proposal: WidgetProposal;
  height: number;
  /** Whether it takes the place of a widget on the draft rather than adding one. */
  replacing: boolean;
  /** Whether the draft has room for it: a replacement always has. */
  canAccept: boolean;
  /** Goes up with every save of the dashboard, so the widget's data is read again, as a placed widget's is. */
  refresh: number;
}

/**
 * A widget the dashboards agent proposed, on the grid with its live data until the user decides. Accept puts it on the
 * draft and Discard drops it; neither saves anything.
 */
const { proposal, height, replacing, canAccept, refresh } = defineProps<PendingWidgetProps>();
const emit = defineEmits<{ accept: []; discard: [] }>();
</script>

<template>
}%}{{~ if css_modules ~}}
  <section :aria-label="`Proposed: ${proposal.title}`" :class="styles.pending">
{{~ else ~}}
  <section
    :aria-label="`Proposed: ${proposal.title}`"
    {{ themed "flex h-full flex-col overflow-hidden rounded border border-dashed border-primary bg-card p-2" "flex h-full flex-col overflow-hidden rounded border border-dashed border-slate-900 bg-white p-2" "pending" }}
  >
{{~ end ~}}
{%{    <header }%}{{ class_of "flex flex-wrap items-center justify-between gap-2" "header" }}{%{>
      <h2 }%}{{ class_of "text-sm font-medium" "title" }}{%{>Proposed: {{ proposal.title }}</h2>
      <div }%}{{ class_of "flex gap-1" "actions" }}{%{>
        <}%}{{ button }}{%{ type="button" size="sm" :disabled="!canAccept" @click="emit('accept')">Accept</}%}{{ button }}{%{>
        <}%}{{ button }}{%{ type="button" variant="ghost" size="sm" @click="emit('discard')">Discard</}%}{{ button }}{%{>
      </div>
    </header>
    <p v-if="replacing" }%}{{ themed "text-xs text-muted-foreground" "text-xs text-slate-500" "note" }}{%{>Replaces a widget on this dashboard.</p>
    <div }%}{{ class_of "min-h-0 flex-1 overflow-auto" "body" }}{%{>
      <WidgetView
        :source="proposal.source"
        :visual="proposal.visual"
        :title="proposal.title"
        :height="height"
        :refresh="refresh"
      />
    </div>
  </section>
</template>
}%}