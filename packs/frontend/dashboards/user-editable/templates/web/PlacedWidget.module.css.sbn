{{~ tokens = project["frontend.design-system"] == "tokens" ~}}
{{~ func colour(token, value)
  if tokens
    ret "var(--ds-color-" + token + ")"
  end
  ret value
end ~}}
.widget {
  display: flex;
  height: 100%;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid {{ colour "border" "#e2e8f0" }};
  border-radius: 0.25rem;
  background-color: {{ colour "surface" "#fff" }};
  padding: 0.5rem;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.title {
  font-size: 0.875rem;
  line-height: 1.25rem;
  font-weight: 500;
}

.body {
  min-height: 0;
  flex: 1;
  overflow: auto;
}
