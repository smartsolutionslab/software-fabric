{{~ tokens = project["frontend.design-system"] == "tokens" ~}}
{{~ func colour(token, value)
  if tokens
    ret "var(--ds-color-" + token + ")"
  end
  ret value
end ~}}
.canvas {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.form {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 0.5rem;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  font-size: 0.875rem;
  line-height: 1.25rem;
}

.input {
  border: 1px solid {{ colour "border" "#cbd5e1" }};
  border-radius: 0.25rem;
  padding: 0.25rem 0.5rem;
  font: inherit;
}
