import { render, screen } from '@testing-library/vue';
import { expect, test } from 'vitest';
import Pager from './Pager.vue';

test('a total not known yet, as while a page loads, moves to no page and counts no pages', () => {
  const { emitted } = render(Pager, { props: { label: 'widgets', page: 2, pageSize: 100, total: undefined } });

  expect(emitted('page')).toBeUndefined();
  expect(screen.queryByText(/^Page /)).not.toBeInTheDocument();
});

test('a known total below the current page moves to the last page there is', () => {
  const { emitted } = render(Pager, { props: { label: 'widgets', page: 3, pageSize: 100, total: 150 } });

  expect(emitted('page')).toEqual([[2]]);
});
