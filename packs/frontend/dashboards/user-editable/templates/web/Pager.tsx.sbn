import { Button } from '@/components/ui/button';

interface PagerProps {
  /** What is paged, for the buttons' names: "Next page of {label}". */
  label: string;
  page: number;
  pageSize: number;
  total: number | string;
  onPage: (page: number) => void;
}

/** Previous and next page of a paged list; nothing while everything fits on one page. */
export function Pager({ label, page, pageSize, total, onPage }: PagerProps) {
  const pages = Math.max(1, Math.ceil(Number(total) / pageSize));
  if (pages <= 1) {
    return null;
  }

  return (
    <div className="flex items-center gap-2 text-sm">
      <Button
        type="button"
        variant="outline"
        size="sm"
        aria-label={`Previous page of ${label}`}
        disabled={page <= 1}
        onClick={() => onPage(page - 1)}
      >
        Previous
      </Button>
      <span>
        Page {page} of {pages}
      </span>
      <Button
        type="button"
        variant="outline"
        size="sm"
        aria-label={`Next page of ${label}`}
        disabled={page >= pages}
        onClick={() => onPage(page + 1)}
      >
        Next
      </Button>
    </div>
  );
}
