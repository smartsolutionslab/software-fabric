{{~ generative = array.contains project["frontend.dashboards"] "generative" ~}}
{{~ valibot = project["frontend.validation"] == "valibot" ~}}
{{~ tanstack = project["frontend.forms"] == "tanstack-form" ~}}
{{~ mui = project["frontend.ui-library"] == "mui" ~}}
{{~ if mui ~}}
import { Box, Button, Stack, Typography } from '@mui/material';
{{~ end ~}}
{{~ if tanstack ~}}
import { revalidateLogic, useForm, useStore } from '@tanstack/react-form';
import { useMemo, useState } from 'react';
import ReactGridLayout, { useContainerWidth } from 'react-grid-layout';
{{~ if valibot ~}}
import * as v from 'valibot';
{{~ else ~}}
import { z } from 'zod';
{{~ end ~}}
{{~ else if valibot ~}}
import { valibotResolver } from '@hookform/resolvers/valibot';
import { useMemo, useState } from 'react';
import ReactGridLayout, { useContainerWidth } from 'react-grid-layout';
import { useForm, useWatch } from 'react-hook-form';
import * as v from 'valibot';
{{~ else ~}}
import { zodResolver } from '@hookform/resolvers/zod';
import { useMemo, useState } from 'react';
import ReactGridLayout, { useContainerWidth } from 'react-grid-layout';
import { useForm, useWatch } from 'react-hook-form';
import { z } from 'zod';
{{~ end ~}}
{%{import { useGetDashboardsWidgetsQuery, usePutDashboardsByIdMutation, type WidgetDescriptionDto } from '@/api/generated';
}%}{{~ if !mui ~}}
import { Button } from '@/components/ui/button';
{{~ end ~}}
{%{import { Failure } from './Failure';
import { applyLayout, columns, hasRoom, lowest, nextPlacement, type Placement, toLayout, withinReach } from './layout';
import { Pager } from './Pager';
import { PlacedWidget } from './PlacedWidget';
}%}{{~ if generative ~}}
import { DashboardAssistant } from './DashboardAssistant';
import { PendingWidget } from './PendingWidget';
import { acceptProposal, type PendingProposal, pendingOnGrid, replacedBy } from './proposal';
{{~ end ~}}
{%{import { uuidV7 } from './uuidV7';
import { checkChoice, visuals } from './widgetChoice';

const rowHeight = 40;
/** The host refuses a dashboard with more widgets than this. */
const maximumWidgets = 50;
const catalogPageSize = 100;
const noWidgets: WidgetDescriptionDto[] = [];

}%}{{~ if valibot ~}}
const nameSchema = v.object({
  name: v.pipe(
    v.string(),
    v.trim(),
    v.minLength(1, 'A dashboard needs a name of 1 to 100 characters.'),
    v.maxLength(100, 'A dashboard needs a name of 1 to 100 characters.'),
  ),
});

const widgetSchema = v.object({
  source: v.pipe(v.string(), v.minLength(1, 'Choose a widget.')),
  visual: v.pipe(v.string(), v.minLength(1, 'Choose how to show it.')),
});
{{~ else ~}}
const nameSchema = z.object({
  name: z
    .string()
    .trim()
    .min(1, 'A dashboard needs a name of 1 to 100 characters.')
    .max(100, 'A dashboard needs a name of 1 to 100 characters.'),
});

const widgetSchema = z.object({
  source: z.string().min(1, 'Choose a widget.'),
  visual: z.string().min(1, 'Choose how to show it.'),
});
{{~ end ~}}
{%{
export interface DraftDashboard {
  id: string;
  name: string;
  widgets: Placement[];
}

interface DashboardCanvasProps {
  dashboard: DraftDashboard;
  onSaved: () => void;
}

/**
 * One dashboard being edited: its name, the declared widgets on a 12-column grid that the user moves and resizes, and
 * Save, which PUTs the whole dashboard to its id, so saving twice saves it once.
 */
export function DashboardCanvas({ dashboard, onSaved }: DashboardCanvasProps) {
  const [placements, setPlacements] = useState<Placement[]>(dashboard.widgets);
  // Counts the draft's changes; the notice says Saved only while the saved revision is still the current one, so a
  // save that ends after a later edit does not call that edit saved.
  const [revision, setRevision] = useState(0);
  const [savedRevision, setSavedRevision] = useState<number | undefined>();
  const [failed, setFailed] = useState(false);
  const [catalogPage, setCatalogPage] = useState(1);
  const widgets = useGetDashboardsWidgetsQuery({ page: catalogPage, pageSize: catalogPageSize });
  const [save, { isLoading: saving }] = usePutDashboardsByIdMutation();
  const { width, containerRef } = useContainerWidth();
  // Only the page asked for: RTK Query's data keeps the page before while the next one loads, and a widget chosen from
  // it would be added from a page no longer on screen.
  const catalog = widgets.currentData?.items ?? noWidgets;
  const loading = widgets.isFetching;
  const listed = useMemo(() => new Map(catalog.map((widget) => [widget.id, widget] as const)), [catalog]);

  const [saves, setSaves] = useState(0);
  const [tooLow, setTooLow] = useState(false);
  const full = placements.length >= maximumWidgets;
  const roomLeft = hasRoom(placements);
}%}{{~ if generative ~}}
  // The widgets the dashboards agent proposed: on the grid, outside the draft, until the user accepts or discards each.
  const [pending, setPending] = useState<PendingProposal[]>([]);
  const proposed = pendingOnGrid(placements, pending);
{{~ end ~}}
{%{
  const edited = () => {
    setRevision((current) => current + 1);
    setFailed(false);
  };

  /** Every change to the draft: a notice that it was saved no longer holds. */
  const change = (next: (current: Placement[]) => Placement[]) => {
    setPlacements(next);
    edited();
  };
}%}{{~ if generative ~}}

  const propose = (proposal: PendingProposal) => setPending((current) => [...current, proposal]);
  const decide = (call: string) => setPending((current) => current.filter((other) => other.call !== call));

  /** Accept only changes the draft, adding the widget or replacing the one it names; Save persists it as any edit. */
  const accept = ({ call, proposal }: PendingProposal) => {
    const key = uuidV7();
    change((current) => acceptProposal(current, proposal, key));
    decide(call);
  };
{{~ end ~}}

{{~ if tanstack ~}}
  const naming = useForm({
    defaultValues: { name: dashboard.name },
    validationLogic: revalidateLogic(),
    validators: { onDynamic: nameSchema },
    onSubmit: async ({ value }) => {
      const { name } = {{ if valibot }}v.parse(nameSchema, value){{ else }}nameSchema.parse(value){{ end }};
      const submitted = revision;
      try {
        await save({ id: dashboard.id, saveDashboardRequest: { name, widgets: placements } }).unwrap();
        setSavedRevision(submitted);
        setFailed(false);
        setSaves((count) => count + 1);
        onSaved();
      } catch {
        setFailed(true);
      }
    },
  });
  const adding = useForm({
    defaultValues: { source: '', visual: '' },
    validationLogic: revalidateLogic(),
    validators: { onDynamic: widgetSchema },
    onSubmit: ({ value: { source, visual }, formApi }) => {
      const choice = checkChoice(catalog, source, visual);
      if (!choice.ok) {
        formApi.setFieldMeta(choice.field, (meta) => ({
          ...meta,
          errorMap: { ...meta.errorMap, onSubmit: [{ message: choice.message }] },
        }));
        return;
      }

      change((current) => [...current, nextPlacement(current, uuidV7(), source, visual)]);
      formApi.reset();
    },
  });
  const chosen = listed.get(useStore(adding.store, (state) => state.values.source));
{{~ else if valibot ~}}
  const naming = useForm({ resolver: valibotResolver(nameSchema), defaultValues: { name: dashboard.name } });
  const adding = useForm({ resolver: valibotResolver(widgetSchema), defaultValues: { source: '', visual: '' } });
{{~ else ~}}
  const naming = useForm({ resolver: zodResolver(nameSchema), defaultValues: { name: dashboard.name } });
  const adding = useForm({ resolver: zodResolver(widgetSchema), defaultValues: { source: '', visual: '' } });
{{~ end ~}}
{{~ if !tanstack ~}}
{%{  const chosen = listed.get(useWatch({ control: adding.control, name: 'source' }));
}%}{{~ end ~}}
{%{
  // Another page of the picker lists other widgets: a choice from this one would be added with the next page's visual.
  const pickerPage = (page: number) => {
    setCatalogPage(page);
    adding.reset();
  };

}%}{{~ if !tanstack ~}}
{%{  const add = adding.handleSubmit(({ source, visual }) => {
    const choice = checkChoice(catalog, source, visual);
    if (!choice.ok) {
      adding.setError(choice.field, { message: choice.message });
      return;
    }

    change((current) => [...current, nextPlacement(current, uuidV7(), source, visual)]);
    adding.reset();
  });

  const submit = naming.handleSubmit(async ({ name }) => {
    const submitted = revision;
    try {
      await save({ id: dashboard.id, saveDashboardRequest: { name, widgets: placements } }).unwrap();
      setSavedRevision(submitted);
      setFailed(false);
      setSaves((count) => count + 1);
      onSaved();
    } catch {
      setFailed(true);
    }
  });

}%}{{~ end ~}}
{{~ if mui ~}}
{%{  return (
    <Stack component="section" aria-label="Dashboard" spacing={2}>
}%}{{~ if tanstack ~}}
{%{      <Stack
        component="form"
        onSubmit={(event) => {
          event.preventDefault();
          void naming.handleSubmit();
        }}
        direction="row"
        spacing={1}
        useFlexGap
        sx={{ flexWrap: 'wrap', alignItems: 'flex-end' }}
      >
        <Stack component="label" spacing={0.5} sx={{ typography: 'body2' }}>
          Dashboard name
          <naming.Field name="name" listeners={{ onChange: edited }}>
            {({ name, state, handleBlur, handleChange }) => (
              <Box
                component="input"
                sx={nativeControl}
                name={name}
                value={state.value}
                onBlur={handleBlur}
                onChange={(event) => handleChange(event.target.value)}
              />
            )}
          </naming.Field>
        </Stack>
        <Button type="submit" variant="contained" disabled={saving}>
          Save dashboard
        </Button>
        <naming.Subscribe selector={(state) => state.fieldMeta.name?.errors[0]?.message}>
          {(message) =>
            message && (
              <Typography role="alert" variant="body2" color="error">
                {message}
              </Typography>
            )
          }
        </naming.Subscribe>
        {savedRevision === revision && (
          <Typography role="status" variant="body2">
            Saved.
          </Typography>
        )}
        {failed && (
          <Typography role="alert" variant="body2" color="error">
            The dashboard could not be saved.
          </Typography>
        )}
      </Stack>

      <Stack
        component="form"
        onSubmit={(event) => {
          event.preventDefault();
          void adding.handleSubmit();
        }}
        direction="row"
        spacing={1}
        useFlexGap
        sx={{ flexWrap: 'wrap', alignItems: 'flex-end' }}
      >
        <Stack component="label" spacing={0.5} sx={{ typography: 'body2' }}>
          Widget
          <adding.Field
            name="source"
            listeners={{
              onChange: ({ value }) =>
                adding.setFieldValue('visual', visuals[listed.get(value)?.kind ?? 'Chart'][0].value),
            }}
          >
            {({ name, state, handleBlur, handleChange }) => (
              <Box
                component="select"
                sx={nativeControl}
                disabled={loading}
                name={name}
                value={state.value}
                onBlur={handleBlur}
                onChange={(event) => handleChange(event.target.value)}
              >
                <option value="">Choose a widget</option>
                {catalog.map((widget) => (
                  <option key={widget.id} value={widget.id}>
                    {widget.title}
                  </option>
                ))}
              </Box>
            )}
          </adding.Field>
        </Stack>
        <Stack component="label" spacing={0.5} sx={{ typography: 'body2' }}>
          Shown as
          <adding.Field name="visual">
            {({ name, state, handleBlur, handleChange }) => (
              <Box
                component="select"
                sx={nativeControl}
                disabled={loading}
                name={name}
                value={state.value}
                onBlur={handleBlur}
                onChange={(event) => handleChange(event.target.value)}
              >
                {visuals[chosen?.kind ?? 'Chart'].map((visual) => (
                  <option key={visual.value} value={visual.value}>
                    {visual.label}
                  </option>
                ))}
              </Box>
            )}
          </adding.Field>
        </Stack>
        <Button type="submit" variant="outlined" disabled={loading || full || !roomLeft}>
          Add widget
        </Button>
        {full && <Typography variant="body2">A dashboard holds at most {maximumWidgets} widgets.</Typography>}
        {!full && !roomLeft && (
          <Typography variant="body2">
            There is no room for another widget: a dashboard reaches down to row {lowest}.
          </Typography>
        )}
        <adding.Subscribe selector={(state) => state.fieldMeta.source?.errors[0]?.message}>
          {(message) =>
            message && (
              <Typography role="alert" variant="body2" color="error">
                {message}
              </Typography>
            )
          }
        </adding.Subscribe>
        <adding.Subscribe selector={(state) => state.fieldMeta.visual?.errors[0]?.message}>
          {(message) =>
            message && (
              <Typography role="alert" variant="body2" color="error">
                {message}
              </Typography>
            )
          }
        </adding.Subscribe>
        <Pager
          label="widgets"
          page={catalogPage}
          pageSize={catalogPageSize}
          total={loading ? undefined : widgets.currentData?.totalCount}
          onPage={pickerPage}
        />
      </Stack>
}%}{{~ else ~}}
{%{      <Stack
        component="form"
        onSubmit={submit}
        direction="row"
        spacing={1}
        useFlexGap
        sx={{ flexWrap: 'wrap', alignItems: 'flex-end' }}
      >
        <Stack component="label" spacing={0.5} sx={{ typography: 'body2' }}>
          Dashboard name
          <Box component="input" sx={nativeControl} {...naming.register('name', { onChange: edited })} />
        </Stack>
        <Button type="submit" variant="contained" disabled={saving}>
          Save dashboard
        </Button>
        {naming.formState.errors.name && (
          <Typography role="alert" variant="body2" color="error">
            {naming.formState.errors.name.message}
          </Typography>
        )}
        {savedRevision === revision && (
          <Typography role="status" variant="body2">
            Saved.
          </Typography>
        )}
        {failed && (
          <Typography role="alert" variant="body2" color="error">
            The dashboard could not be saved.
          </Typography>
        )}
      </Stack>

      <Stack
        component="form"
        onSubmit={add}
        direction="row"
        spacing={1}
        useFlexGap
        sx={{ flexWrap: 'wrap', alignItems: 'flex-end' }}
      >
        <Stack component="label" spacing={0.5} sx={{ typography: 'body2' }}>
          Widget
          <Box
            component="select"
            sx={nativeControl}
            disabled={loading}
            {...adding.register('source', {
              onChange: (event: { target: { value: string } }) =>
                adding.setValue('visual', visuals[listed.get(event.target.value)?.kind ?? 'Chart'][0].value),
            })}
          >
            <option value="">Choose a widget</option>
            {catalog.map((widget) => (
              <option key={widget.id} value={widget.id}>
                {widget.title}
              </option>
            ))}
          </Box>
        </Stack>
        <Stack component="label" spacing={0.5} sx={{ typography: 'body2' }}>
          Shown as
          <Box component="select" sx={nativeControl} disabled={loading} {...adding.register('visual')}>
            {visuals[chosen?.kind ?? 'Chart'].map((visual) => (
              <option key={visual.value} value={visual.value}>
                {visual.label}
              </option>
            ))}
          </Box>
        </Stack>
        <Button type="submit" variant="outlined" disabled={loading || full || !roomLeft}>
          Add widget
        </Button>
        {full && <Typography variant="body2">A dashboard holds at most {maximumWidgets} widgets.</Typography>}
        {!full && !roomLeft && (
          <Typography variant="body2">
            There is no room for another widget: a dashboard reaches down to row {lowest}.
          </Typography>
        )}
        {adding.formState.errors.source && (
          <Typography role="alert" variant="body2" color="error">
            {adding.formState.errors.source.message}
          </Typography>
        )}
        {adding.formState.errors.visual && (
          <Typography role="alert" variant="body2" color="error">
            {adding.formState.errors.visual.message}
          </Typography>
        )}
        <Pager
          label="widgets"
          page={catalogPage}
          pageSize={catalogPageSize}
          total={loading ? undefined : widgets.currentData?.totalCount}
          onPage={pickerPage}
        />
      </Stack>
}%}{{~ end ~}}
{%{      {widgets.isError && (
        <Failure
          message="The widgets could not be loaded."
          retry="Try loading the widgets again"
          onRetry={widgets.refetch}
        />
      )}

      {tooLow && (
        <Typography role="alert" variant="body2" color="error">
          A widget cannot start below row {lowest}; it went back where it was.
        </Typography>
      )}
      <div ref={containerRef}>
        <ReactGridLayout
          width={width}
}%}{{~ if generative ~}}
          layout={[...toLayout(placements), ...proposed.map(({ item }) => item)]}
{{~ else ~}}
          layout={toLayout(placements)}
{{~ end ~}}
{%{          gridConfig={{ cols: columns, rowHeight }}
          dragConfig={{ cancel: 'button, select, input, table' }}
          onLayoutChange={(layout) => {
            const moved = applyLayout(placements, layout);
            if (samePlaces(moved, placements)) {
              return;
            }

            // A widget moved or grown below the lowest row snaps back: the grid is drawn from the placements.
            if (!withinReach(moved)) {
              setTooLow(true);
              setPlacements((current) => [...current]);
              return;
            }

            setTooLow(false);
            change(() => moved);
          }}
        >
          {placements.map((placement) => (
            <div key={placement.key}>
              <PlacedWidget
                placement={placement}
                rowHeight={rowHeight}
                refresh={saves}
                onRemove={() => change((current) => current.filter((other) => other.key !== placement.key))}
              />
            </div>
          ))}
}%}{{~ if generative ~}}
          {proposed.map(({ proposed: proposal, item }) => {
            const replacing = replacedBy(placements, proposal.proposal) !== undefined;
            return (
              <div key={item.i}>
                <PendingWidget
                  proposal={proposal.proposal}
                  rows={item.h}
                  rowHeight={rowHeight}
                  replacing={replacing}
                  canAccept={replacing || (!full && roomLeft)}
                  refresh={saves}
                  onAccept={() => accept(proposal)}
                  onDiscard={() => decide(proposal.call)}
                />
              </div>
            );
          })}
{{~ end ~}}
{%{        </ReactGridLayout>
      </div>
}%}{{~ if generative ~}}
      <DashboardAssistant widgets={placements} onProposal={propose} />
{{~ end ~}}
{%{    </Stack>
  );
}

/** The look of the forms' native controls, from the theme: they stay native so the form library registers them as they are. */
const nativeControl = { px: 1, py: 0.5, border: 1, borderColor: 'divider', borderRadius: 1, font: 'inherit' } as const;
}%}{{~ else ~}}
