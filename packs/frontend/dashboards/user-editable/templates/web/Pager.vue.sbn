{{~ ui = project["frontend.ui-library"] ~}}
{{~ css_modules = project["frontend.styling"] == "css-modules" ~}}
{{~ if ui == "reka-ui"
  button = "BaseButton"
  button_import = "import BaseButton from '@/components/ui/BaseButton.vue';"
  secondary = "outline"
else
  button = "Button"
  button_import = "import { Button } from '@/components/ui/button';"
  secondary = "secondary"
end ~}}
{{~ func class_of(tailwind, module)
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
{%{<script setup lang="ts">
import { computed, watch } from 'vue';
}%}{{ button_import }}{%{
}%}{{~ if css_modules ~}}
import styles from './Pager.module.css';
{{~ end ~}}
{%{
interface PagerProps {
  /** What is paged, for the buttons' names: "Next page of {label}". */
  label: string;
  page: number;
  pageSize: number;
  /** Undefined while the total is not known yet, as while a page loads: a missing total is not one page. */
  total?: number | string;
}

// Named in one word beside the page's other files; lint wants a component's name in two.
defineOptions({ name: 'DashboardPager' });

/**
 * Previous and next page of a paged list; nothing while everything fits on one page or the total is not known yet.
 * A known total that shrinks below the current page moves to the last page, which would otherwise be empty and
 * unreachable.
 */
const { label, page, pageSize, total } = defineProps<PagerProps>();
const emit = defineEmits<{ page: [page: number] }>();

const pages = computed(() => (total === undefined ? undefined : Math.max(1, Math.ceil(Number(total) / pageSize))));
watch(
  [() => page, pages],
  ([current, count]) => {
    if (count !== undefined && current > count) {
      emit('page', count);
    }
  },
  { immediate: true },
);
</script>

<template>
  <div v-if="pages !== undefined && pages > 1" }%}{{ class_of "flex items-center gap-2 text-sm" "pager" }}{%{>
    <}%}{{ button }}{%{
      type="button"
      variant="outline"
      size="sm"
      :aria-label="`Previous page of ${label}`"
      :disabled="page <= 1"
      @click="emit('page', page - 1)"
    >
      Previous
    </}%}{{ button }}{%{>
    <span>Page {{ page }} of {{ pages }}</span>
    <}%}{{ button }}{%{
      type="button"
      variant="outline"
      size="sm"
      :aria-label="`Next page of ${label}`"
      :disabled="page >= pages"
      @click="emit('page', page + 1)"
    >
      Next
    </}%}{{ button }}{%{>
  </div>
</template>
}%}