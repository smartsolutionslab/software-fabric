{{~ ui = project["frontend.ui-library"] ~}}
{{~ css_modules = project["frontend.styling"] == "css-modules" ~}}
{{~ if ui == "reka-ui"
  button = "BaseButton"
  button_import = "import BaseButton from '@/components/ui/BaseButton.vue';"
  secondary = "outline"
else
  button = "Button"
  button_import = "import { Button } from '@/components/ui/button';"
  secondary = "secondary"
end ~}}
{{~ func class_of(tailwind, module)
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
{{~ generative = array.contains project["frontend.dashboards"] "generative" ~}}
{{~ valibot = project["frontend.validation"] == "valibot" ~}}
{{~ tanstack = project["frontend.forms"] == "tanstack-form" ~}}
{{~ if !((ui == "shadcn-vue" && (project["frontend.forms"] == "vee-validate" || project["frontend.forms"] == "tanstack-form")) || (ui == "reka-ui" && project["frontend.forms"] == "vee-validate")) || (project["frontend.validation"] != "zod" && project["frontend.validation"] != "valibot") ~}}
<script lang="ts">
throw new Error('The dashboards pack builds the Vue dashboard page from shadcn-vue with vee-validate or TanStack Form, or reka-ui with vee-validate, and zod or valibot only so far; frontend.ui-library is {{ project["frontend.ui-library"] }}, frontend.forms is {{ project["frontend.forms"] }}, frontend.validation is {{ project["frontend.validation"] }} (docs/adr/0006 of the generator).');
</script>

{{~ end ~}}
{%{<script setup lang="ts">
import { GridItem, GridLayout, type Layout } from 'grid-layout-plus';
}%}{{~ if tanstack ~}}
import { revalidateLogic, useForm } from '@tanstack/vue-form';
{{~ if valibot ~}}
import * as v from 'valibot';
import { computed, ref, watch } from 'vue';
{{~ else ~}}
import { computed, ref, watch } from 'vue';
import { z } from 'zod';
{{~ end ~}}
{{~ else if valibot ~}}
import * as v from 'valibot';
import { useForm } from 'vee-validate';
import { computed, ref, watch } from 'vue';
{{~ else ~}}
import { useForm } from 'vee-validate';
import { computed, ref, watch } from 'vue';
import { z } from 'zod';
{{~ end ~}}
{%{import { useGetDashboardsWidgets, usePutDashboardsId, type WidgetDescriptionDto } from '@/api/generated';
}%}{{ button_import }}
{{~ if !tanstack ~}}
import { toTypedSchema } from '@/forms/toTypedSchema';
{{~ end ~}}
{%{import Failure from './Failure.vue';
import {
  applyLayout,
  columns,
  type GridItem as Item,
  hasRoom,
  lowest,
  nextPlacement,
  type Placement,
  toLayout,
  withinReach,
} from './layout';
import Pager from './Pager.vue';
import PlacedWidget from './PlacedWidget.vue';
}%}{{~ if css_modules ~}}
import styles from './DashboardCanvas.module.css';
{{~ end ~}}
{%{}%}{{~ if generative ~}}
import DashboardAssistant from './DashboardAssistant.vue';
import PendingWidget from './PendingWidget.vue';
import { acceptProposal, type PendingProposal, pendingOnGrid, replacedBy } from './proposal';
{{~ end ~}}
{%{import { uuidV7 } from './uuidV7';
import { checkChoice, visuals } from './widgetChoice';

const rowHeight = 40;
/** The host refuses a dashboard with more widgets than this. */
const maximumWidgets = 50;
const catalogPageSize = 100;
const noWidgets: WidgetDescriptionDto[] = [];

}%}{{~ if valibot ~}}
const nameSchema = v.object({
  name: v.pipe(
    v.string(),
    v.trim(),
    v.minLength(1, 'A dashboard needs a name of 1 to 100 characters.'),
    v.maxLength(100, 'A dashboard needs a name of 1 to 100 characters.'),
  ),
});

const widgetSchema = v.object({
  source: v.pipe(v.string(), v.minLength(1, 'Choose a widget.')),
  visual: v.pipe(v.string(), v.minLength(1, 'Choose how to show it.')),
});
{{~ else ~}}
const nameSchema = z.object({
  name: z
    .string()
    .trim()
    .min(1, 'A dashboard needs a name of 1 to 100 characters.')
    .max(100, 'A dashboard needs a name of 1 to 100 characters.'),
});

const widgetSchema = z.object({
  source: z.string().min(1, 'Choose a widget.'),
  visual: z.string().min(1, 'Choose how to show it.'),
});
{{~ end ~}}
{%{
interface DashboardCanvasProps {
  dashboard: { id: string; name: string; widgets: Placement[] };
}

/**
 * One dashboard being edited: its name, the declared widgets on a 12-column grid that the user moves and resizes, and
 * Save, which PUTs the whole dashboard to its id, so saving twice saves it once.
 */
const { dashboard } = defineProps<DashboardCanvasProps>();
const emit = defineEmits<{ saved: [] }>();

const placements = ref<Placement[]>(dashboard.widgets);
// What the grid draws, rebuilt from the placements whenever they change; the grid moves its items in place.
const layout = ref<Item[]>(toLayout(placements.value));
watch(placements, (current) => (layout.value = toLayout(current)), { flush: 'sync' });
}%}{{~ if generative ~}}
// The widgets the dashboards agent proposed: on the grid, outside the draft, until the user accepts or discards each.
const pending = ref<PendingProposal[]>([]);
const proposed = computed(() => pendingOnGrid(placements.value, pending.value));
/** What the grid draws: the draft's widgets, and the pending proposals below them. */
const drawn = () => [...toLayout(placements.value), ...proposed.value.map(({ item }) => item)];
watch([placements, pending], () => (layout.value = drawn()), { flush: 'sync' });
{{~ end ~}}
{%{// Counts the draft's changes; the notice says Saved only while the saved revision is still the current one, so a
// save that ends after a later edit does not call that edit saved.
const revision = ref(0);
const savedRevision = ref<number>();
const failed = ref(false);
const saves = ref(0);
const tooLow = ref(false);
const catalogPage = ref(1);
// Only the page asked for: while the next page loads there is no data, so nothing from the page before is offered.
const {
  data: widgets,
  isFetching: loading,
  isError: catalogFailed,
  refetch: refetchCatalog,
} = useGetDashboardsWidgets(computed(() => ({ page: catalogPage.value, pageSize: catalogPageSize })));
const { mutateAsync: save, isPending: saving } = usePutDashboardsId();
const catalog = computed(() => widgets.value?.items ?? noWidgets);
const listed = computed(() => new Map(catalog.value.map((widget) => [widget.id, widget] as const)));
const full = computed(() => placements.value.length >= maximumWidgets);
const roomLeft = computed(() => hasRoom(placements.value));

const edited = () => {
  revision.value += 1;
  failed.value = false;
};

/** Every change to the draft: a notice that it was saved no longer holds. */
const change = (next: (current: Placement[]) => Placement[]) => {
  placements.value = next(placements.value);
  edited();
};

}%}{{~ if tanstack ~}}
{%{const naming = useForm({
  defaultValues: { name: dashboard.name },
  validationLogic: revalidateLogic(),
  validators: { onDynamic: nameSchema },
  onSubmit: async ({ value }) => {
    const { name } = }%}{{ if valibot }}v.parse(nameSchema, value){{ else }}nameSchema.parse(value){{ end }}{%{;
    const submitted = revision.value;
    try {
      await save({ id: dashboard.id, data: { name, widgets: placements.value } });
      savedRevision.value = submitted;
      failed.value = false;
      saves.value += 1;
      emit('saved');
    } catch {
      failed.value = true;
    }
  },
});
const nameErrors = naming.useStore((state) => ({ name: state.fieldMeta.name?.errors[0]?.message }));

const adding = useForm({
  defaultValues: { source: '', visual: '' },
  validationLogic: revalidateLogic(),
  validators: { onDynamic: widgetSchema },
  onSubmit: ({ value: { source: chosenSource, visual: chosenVisual }, formApi }) => {
    const choice = checkChoice(catalog.value, chosenSource, chosenVisual);
    if (!choice.ok) {
      formApi.setFieldMeta(choice.field, (meta) => ({
        ...meta,
        errorMap: { ...meta.errorMap, onSubmit: [{ message: choice.message }] },
      }));
      return;
    }

    change((current) => [...current, nextPlacement(current, uuidV7(), chosenSource, chosenVisual)]);
    formApi.reset();
  },
});
const widgetErrors = adding.useStore((state) => ({
  source: state.fieldMeta.source?.errors[0]?.message,
  visual: state.fieldMeta.visual?.errors[0]?.message,
}));
const source = adding.useStore((state) => state.values.source);
const chosen = computed(() => listed.value.get(source.value));

/** A widget chosen: show it the first way its kind can be shown. */
const choose = ({ value }: { value: string }) =>
  adding.setFieldValue('visual', visuals[listed.value.get(value)?.kind ?? 'Chart'][0].value);

// Another page of the picker lists other widgets: a choice from this one would be added with the next page's visual.
const pickerPage = (page: number) => {
  catalogPage.value = page;
  adding.reset();
};

function add(event: Event) {
  event.preventDefault();
  void adding.handleSubmit();
}

function submit(event: Event) {
  event.preventDefault();
  void naming.handleSubmit();
}
}%}{{~ else ~}}
{%{const {
  defineField: nameField,
  errors: nameErrors,
  handleSubmit: handleSave,
} = useForm({ validationSchema: toTypedSchema(nameSchema), initialValues: { name: dashboard.name } });
const [name, nameAttributes] = nameField('name');

const {
  defineField: widgetField,
  errors: widgetErrors,
  handleSubmit: handleAdd,
  resetForm: resetWidget,
  setFieldError: refuseWidget,
  setFieldValue: setWidgetValue,
} = useForm({ validationSchema: toTypedSchema(widgetSchema), initialValues: { source: '', visual: '' } });
const [source, sourceAttributes] = widgetField('source');
const [visual, visualAttributes] = widgetField('visual');
const chosen = computed(() => listed.value.get(source.value ?? ''));

/** A widget chosen: show it the first way its kind can be shown. */
const choose = (event: Event) =>
  setWidgetValue(
    'visual',
    visuals[listed.value.get((event.target as HTMLSelectElement).value)?.kind ?? 'Chart'][0].value,
  );

// Another page of the picker lists other widgets: a choice from this one would be added with the next page's visual.
const pickerPage = (page: number) => {
  catalogPage.value = page;
  resetWidget();
};

const add = handleAdd(({ source: chosenSource, visual: chosenVisual }) => {
  const choice = checkChoice(catalog.value, chosenSource, chosenVisual);
  if (!choice.ok) {
    refuseWidget(choice.field, choice.message);
    return;
  }

  change((current) => [...current, nextPlacement(current, uuidV7(), chosenSource, chosenVisual)]);
  resetWidget();
});

const submit = handleSave(async (values) => {
  const submitted = revision.value;
  try {
    await save({ id: dashboard.id, data: { name: values.name, widgets: placements.value } });
    savedRevision.value = submitted;
    failed.value = false;
    saves.value += 1;
    emit('saved');
  } catch {
    failed.value = true;
  }
});
}%}{{~ end ~}}
{%{
/** The grid reports its layout after every change, its own compaction included; only real moves change the draft. */
function placed(reported: Layout) {
  const moved = applyLayout(
    placements.value,
    reported.map(({ i, x, y, w, h }) => ({ i: String(i), x, y, w, h })),
  );
  if (samePlaces(moved, placements.value)) {
    return;
  }

  // A widget moved or grown below the lowest row snaps back: the grid is drawn from the placements.
  if (!withinReach(moved)) {
    tooLow.value = true;
}%}{{~ if generative ~}}
    layout.value = drawn();
{{~ else ~}}
    layout.value = toLayout(placements.value);
{{~ end ~}}
{%{    return;
  }

  tooLow.value = false;
  change(() => moved);
}

/** Whether the grid only re-reported the places the widgets already have, as it does after every change. */
function samePlaces(left: readonly Placement[], right: readonly Placement[]) {
  return (
    left.length === right.length &&
    left.every((placement, index) => {
      const other = right[index];
      return (
        other !== undefined &&
        placement.x === other.x &&
        placement.y === other.y &&
        placement.width === other.width &&
        placement.height === other.height
      );
    })
  );
}

const remove = (key: string) => change((current) => current.filter((other) => other.key !== key));
}%}{{~ if generative ~}}

const propose = (proposal: PendingProposal) => (pending.value = [...pending.value, proposal]);
const decide = (call: string) => (pending.value = pending.value.filter((other) => other.call !== call));

/** Accept only changes the draft, adding the widget or replacing the one it names; Save persists it as any edit. */
const accept = ({ call, proposal }: PendingProposal) => {
  const key = uuidV7();
  change((current) => acceptProposal(current, proposal, key));
  decide(call);
};

/** Each pending proposal on the grid with its place, as the grid has it. */
const pendingTiles = computed(() =>
  layout.value.flatMap((item) => {
    const waiting = proposed.value.find((each) => each.item.i === item.i);
    return waiting
      ? [
          {
            item,
            proposal: waiting.proposed,
            replacing: replacedBy(placements.value, waiting.proposed.proposal) !== undefined,
          },
        ]
      : [];
  }),
);
{{~ end ~}}
{%{
/** Each widget on the grid with its place, as the grid has it. */
const tiles = computed(() =>
  layout.value.flatMap((item) => {
    const placement = placements.value.find((each) => each.key === item.i);
    return placement ? [{ item, placement }] : [];
  }),
);
</script>

<template>
  <section aria-label="Dashboard" }%}{{ class_of "flex flex-col gap-4" "canvas" }}{%{>
    <form novalidate }%}{{ class_of "flex flex-wrap items-end gap-2" "form" }}{%{ @submit="submit">
      <label }%}{{ class_of "flex flex-col gap-1 text-sm" "field" }}{%{>
        Dashboard name
}%}{{~ if tanstack ~}}
{%{        <naming.Field v-slot="{ field }" name="name" :listeners="{ onChange: edited }">
          <input
            :name="field.name"
            :value="field.state.value"
            class="rounded border px-2 py-1"
            @blur="field.handleBlur"
            @input="field.handleChange(($event.target as HTMLInputElement).value)"
          />
        </naming.Field>
}%}{{~ else ~}}
{%{        <input v-model="name" v-bind="nameAttributes" }%}{{ class_of "rounded border px-2 py-1" "input" }}{%{ @input="edited" />
}%}{{~ end ~}}
{%{      </label>
      <}%}{{ button }}{%{ type="submit" :disabled="saving">Save dashboard</}%}{{ button }}{%{>
      <p v-if="nameErrors.name" role="alert">{{ nameErrors.name }}</p>
      <p v-if="savedRevision === revision" role="status">Saved.</p>
      <p v-if="failed" role="alert">The dashboard could not be saved.</p>
    </form>

    <form novalidate }%}{{ class_of "flex flex-wrap items-end gap-2" "form" }}{%{ @submit="add">
      <label }%}{{ class_of "flex flex-col gap-1 text-sm" "field" }}{%{>
        Widget
}%}{{~ if tanstack ~}}
{%{        <adding.Field v-slot="{ field }" name="source" :listeners="{ onChange: choose }">
          <select
            :name="field.name"
            :value="field.state.value"
            class="rounded border px-2 py-1"
            :disabled="loading"
            @blur="field.handleBlur"
            @change="field.handleChange(($event.target as HTMLSelectElement).value)"
          >
            <option value="">Choose a widget</option>
            <option v-for="widget in catalog" :key="widget.id" :value="widget.id">{{ widget.title }}</option>
          </select>
        </adding.Field>
      </label>
      <label class="flex flex-col gap-1 text-sm">
        Shown as
        <adding.Field v-slot="{ field }" name="visual">
          <select
            :name="field.name"
            :value="field.state.value"
            class="rounded border px-2 py-1"
            :disabled="loading"
            @blur="field.handleBlur"
            @change="field.handleChange(($event.target as HTMLSelectElement).value)"
          >
            <option v-for="shown in visuals[chosen?.kind ?? 'Chart']" :key="shown.value" :value="shown.value">
              {{ shown.label }}
            </option>
          </select>
        </adding.Field>
}%}{{~ else if css_modules ~}}
        <select v-model="source" v-bind="sourceAttributes" :class="styles.input" :disabled="loading" @change="choose">
{%{          <option value="">Choose a widget</option>
          <option v-for="widget in catalog" :key="widget.id" :value="widget.id">{{ widget.title }}</option>
        </select>
      </label>
      <label }%}{{ class_of "flex flex-col gap-1 text-sm" "field" }}{%{>
        Shown as
        <select v-model="visual" v-bind="visualAttributes" }%}{{ class_of "rounded border px-2 py-1" "input" }}{%{ :disabled="loading">
          <option v-for="shown in visuals[chosen?.kind ?? 'Chart']" :key="shown.value" :value="shown.value">
            {{ shown.label }}
          </option>
        </select>
}%}{{~ else ~}}
{%{        <select
          v-model="source"
          v-bind="sourceAttributes"
          class="rounded border px-2 py-1"
          :disabled="loading"
          @change="choose"
        >
          <option value="">Choose a widget</option>
          <option v-for="widget in catalog" :key="widget.id" :value="widget.id">{{ widget.title }}</option>
        </select>
      </label>
      <label }%}{{ class_of "flex flex-col gap-1 text-sm" "field" }}{%{>
        Shown as
        <select v-model="visual" v-bind="visualAttributes" }%}{{ class_of "rounded border px-2 py-1" "input" }}{%{ :disabled="loading">
          <option v-for="shown in visuals[chosen?.kind ?? 'Chart']" :key="shown.value" :value="shown.value">
            {{ shown.label }}
          </option>
        </select>
}%}{{~ end ~}}
{%{      </label>
      <}%}{{ button }}{%{ type="submit" variant="}%}{{ secondary }}{%{" :disabled="loading || full || !roomLeft">Add widget</}%}{{ button }}{%{>
      <p v-if="full">A dashboard holds at most {{ maximumWidgets }} widgets.</p>
      <p v-if="!full && !roomLeft">
        There is no room for another widget: a dashboard reaches down to row {{ lowest }}.
      </p>
      <p v-if="widgetErrors.source" role="alert">{{ widgetErrors.source }}</p>
      <p v-if="widgetErrors.visual" role="alert">{{ widgetErrors.visual }}</p>
      <Pager
        label="widgets"
        :page="catalogPage"
        :page-size="catalogPageSize"
        :total="loading ? undefined : widgets?.totalCount"
        @page="pickerPage"
      />
    </form>
    <Failure
      v-if="catalogFailed"
      message="The widgets could not be loaded."
      retry="Try loading the widgets again"
      @retry="refetchCatalog()"
    />

    <p v-if="tooLow" role="alert">A widget cannot start below row {{ lowest }}; it went back where it was.</p>
    <GridLayout :layout="layout" :col-num="columns" :row-height="rowHeight" @layout-updated="placed">
      <GridItem
        v-for="{ item, placement } in tiles"
        :key="item.i"
        :i="item.i"
        :x="item.x"
        :y="item.y"
        :w="item.w"
        :h="item.h"
        :max-h="item.maxH"
        drag-ignore-from="button, select, input, table"
      >
        <PlacedWidget
          :placement="placement"
          :height="Math.max(120, item.h * rowHeight - 60)"
          :refresh="saves"
          @remove="remove(placement.key)"
        />
      </GridItem>
}%}{{~ if generative ~}}
      <GridItem
        v-for="{ item, proposal, replacing } in pendingTiles"
        :key="item.i"
        :i="item.i"
        :x="item.x"
        :y="item.y"
        :w="item.w"
        :h="item.h"
        static
      >
        <PendingWidget
          :proposal="proposal.proposal"
          :height="Math.max(120, item.h * rowHeight - 60)"
          :replacing="replacing"
          :can-accept="replacing || (!full && roomLeft)"
          :refresh="saves"
          @accept="accept(proposal)"
          @discard="decide(proposal.call)"
        />
      </GridItem>
{{~ end ~}}
{%{    </GridLayout>
}%}{{~ if generative ~}}
    <DashboardAssistant :widgets="placements" @proposal="propose" />
{{~ end ~}}
{%{  </section>
</template>
}%}