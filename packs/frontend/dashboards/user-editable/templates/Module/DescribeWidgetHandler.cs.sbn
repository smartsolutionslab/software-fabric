{{~ typed = project["backend.result-style"] == "typed-outcomes" ~}}
{{~ option = project["backend.absence"] == "option" ~}}
{{~ func ok(type, value)
  if typed
    ret "Success(" + value + ")"
  end
  ret "Result<" + type + ", ApiError>.Success(" + value + ")"
end ~}}
{{~ func fail(type, error)
  if typed
    ret "Failure(" + error + ")"
  end
  ret "Result<" + type + ", ApiError>.Failure(" + error + ")"
end ~}}
using {{ namespace }}.BuildingBlocks.Dashboards;
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.Dashboards.Application.DTOs;

namespace {{ namespace }}.Modules.Dashboards.Application.Queries.DescribeWidget;

/// <summary>A widget is described to the callers it is listed and run for, and to no one else: anything else is not found.</summary>
public sealed class DescribeWidgetHandler(WidgetCatalog catalog, IWidgetAccess access) : IQueryHandler<DescribeWidget, Result<WidgetDescriptionDto, ApiError>>
{
    public async Task<Result<WidgetDescriptionDto, ApiError>> HandleAsync(DescribeWidget query, CancellationToken cancellationToken)
    {
        {{ not_null "query" }}

        if (!catalog.TryFind(query.Id, out var widget) || !await access.AllowsAsync(widget, cancellationToken))
        {
            return {{ fail "WidgetDescriptionDto" "DashboardsFailures.WidgetNotFound(query.Id)" }};
        }

        return {{ ok "WidgetDescriptionDto" "widget.ToDto()" }};
    }
}
