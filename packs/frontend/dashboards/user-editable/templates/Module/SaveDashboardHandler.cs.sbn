using {{ namespace }}.BuildingBlocks.Dashboards;
using {{ namespace }}.BuildingBlocks.Identity;
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.Dashboards.Domain.Dashboards;

namespace {{ namespace }}.Modules.Dashboards.Application.Commands.SaveDashboard;

/// <summary>
/// Saves the caller's dashboard. Whether a widget is one the modules declare for the caller, and whether its visual
/// suits it, is asked here, of the widget catalogue; everything else a dashboard must be is the dashboard's own rule.
/// </summary>
public sealed class SaveDashboardHandler(
    IDashboardStore dashboards,
    IDashboardsUnitOfWork unitOfWork,
    WidgetCatalog catalog,
    IWidgetAccess access,
    ICurrentUser user)
    : ICommandHandler<SaveDashboard, Result<Guid, ApiError>>
{
    /// <summary>How many widgets a dashboard holds; the dashboard's rule (<see cref="Dashboard.MaximumWidgets"/>).</summary>
    public const int MaximumWidgets = Dashboard.MaximumWidgets;

    private static readonly string[] ChartVisuals = ["bar", "line", "pie"];

    public async Task<Result<Guid, ApiError>> HandleAsync(SaveDashboard command, CancellationToken cancellationToken)
    {
        {{ not_null "command" }}

        if (user.Subject is not { } subject)
        {
            return {{ fail "Guid" "DashboardsFailures.NotSignedIn()" }};
        }

        var problem = await ProblemAsync(command.Widgets, cancellationToken);
        if (problem is not null)
        {
            return {{ fail "Guid" "problem" }};
        }

        var owner = DashboardOwner.From(subject);
{{~ if option ~}}
        var found = await dashboards.FindAsync(command.Id, owner, cancellationToken);
        if (found.HasValue)
        {
            var rearranged = found.Value.Rearrange(command.Name, command.Widgets);
            if (!rearranged.IsSuccess)
            {
                return {{ fail "Guid" "DashboardsFailures.From(rearranged.Error)" }};
            }
        }
{{~ else ~}}
        var dashboard = await dashboards.FindAsync(command.Id, owner, cancellationToken);
        if (dashboard is not null)
        {
            var rearranged = dashboard.Rearrange(command.Name, command.Widgets);
            if (!rearranged.IsSuccess)
            {
                return {{ fail "Guid" "DashboardsFailures.From(rearranged.Error)" }};
            }
        }
{{~ end ~}}
        else
        {
            var created = Dashboard.Create(command.Id, owner, command.Name, command.Widgets);
            if (!created.IsSuccess)
            {
                return {{ fail "Guid" "DashboardsFailures.From(created.Error)" }};
            }

            dashboards.Add(created.Value);
        }

        // A dashboard with this id that belongs to someone else is not found above; inserting it then fails on the
        // primary key and answers 409 already-exists, so no one replaces another user's dashboard.
        await unitOfWork.CommitAsync(cancellationToken);
        return {{ ok "Guid" "command.Id.Value" }};
    }

    /// <summary>The first widget that is not one the modules declare for the caller, or shows what it cannot, or null.</summary>
    private async Task<ApiError?> ProblemAsync(IReadOnlyList<DashboardWidget> widgets, CancellationToken cancellationToken)
    {
        // A missing widget, or one without a key, is the dashboard's to refuse.
        foreach (var placed in widgets.Where(widget => widget is not null && !string.IsNullOrWhiteSpace(widget.Key)))
        {
            if (placed.Source is null || !catalog.TryFind(placed.Source, out var widget) || !await access.AllowsAsync(widget, cancellationToken))
            {
                return DashboardsFailures.UnknownWidget(placed.Source ?? string.Empty);
            }

            var fits = widget.Kind == WidgetKind.Chart ? ChartVisuals.Contains(placed.Visual, StringComparer.Ordinal) : placed.Visual == "table";
            if (!fits)
            {
                return DashboardsFailures.InvalidWidget(placed.Key, widget.Kind == WidgetKind.Chart ? "shows a chart: bar, line or pie." : "shows a table: table.");
            }
        }

        return null;
    }
}
