{{~ typed = project["backend.result-style"] == "typed-outcomes" ~}}
{{~ option = project["backend.absence"] == "option" ~}}
{{~ func ok(type, value)
  if typed
    ret "Success(" + value + ")"
  end
  ret "Result<" + type + ", ApiError>.Success(" + value + ")"
end ~}}
{{~ func fail(type, error)
  if typed
    ret "Failure(" + error + ")"
  end
  ret "Result<" + type + ", ApiError>.Failure(" + error + ")"
end ~}}
using {{ namespace }}.BuildingBlocks.Identity;
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.Dashboards.Application.DTOs;

namespace {{ namespace }}.Modules.Dashboards.Application.Queries.ListDashboards;

public sealed class ListDashboardsHandler(IDashboardStore dashboards, ICurrentUser user)
    : IQueryHandler<ListDashboards, Result<PagedResult<DashboardSummaryDto>, ApiError>>
{
    public async Task<Result<PagedResult<DashboardSummaryDto>, ApiError>> HandleAsync(ListDashboards query, CancellationToken cancellationToken)
    {
        {{ not_null "query" }}

        if (user.Subject is not { } owner)
        {
            return {{ fail "PagedResult<DashboardSummaryDto>" "DashboardsFailures.NotSignedIn()" }};
        }

        var page = await dashboards.ListAsync(owner, query.Page, query.PageSize, cancellationToken);
        return {{ ok "PagedResult<DashboardSummaryDto>" "new PagedResult<DashboardSummaryDto>([.. page.Items.Select(dashboard => dashboard.ToDashboardSummaryDto())], page.TotalCount, page.Page, page.PageSize)" }};
    }
}
