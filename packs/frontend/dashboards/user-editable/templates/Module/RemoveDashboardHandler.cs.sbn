using {{ namespace }}.BuildingBlocks.Identity;
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.Dashboards.Domain.Dashboards;

namespace {{ namespace }}.Modules.Dashboards.Application.Commands.RemoveDashboard;

/// <summary>Removes the caller's dashboard: its event first, then its row in the dashboards table.</summary>
public sealed class RemoveDashboardHandler(
    IDashboardsAggregateStore aggregates,
    IDashboardStore dashboards,
    IDashboardsUnitOfWork unitOfWork,
    ICurrentUser user)
    : ICommandHandler<RemoveDashboard, Result<Unit, ApiError>>
{
    public async Task<Result<Unit, ApiError>> HandleAsync(RemoveDashboard command, CancellationToken cancellationToken)
    {
        {{ not_null "command" }}

        if (user.Subject is not { } subject)
        {
            return {{ fail "Unit" "DashboardsFailures.NotSignedIn()" }};
        }

{{~ if option ~}}
        var found = await aggregates.LoadAsync<Dashboard>(command.Id, cancellationToken);
        if (!found.HasValue || found.Value.IsRemoved() || found.Value.Owner != DashboardOwner.From(subject))
        {
            return {{ fail "Unit" "DashboardsFailures.NotFound(command.Id.Value)" }};
        }

        var dashboard = found.Value;
{{~ else ~}}
        var dashboard = await aggregates.LoadAsync<Dashboard>(command.Id, cancellationToken);
        if (dashboard is null || dashboard.IsRemoved() || dashboard.Owner != DashboardOwner.From(subject))
        {
            return {{ fail "Unit" "DashboardsFailures.NotFound(command.Id.Value)" }};
        }
{{~ end ~}}
        dashboard.Remove();

        await aggregates.SaveAsync(dashboard, cancellationToken);
        await dashboards.RecordAsync(dashboard, cancellationToken);
        await unitOfWork.CommitAsync(cancellationToken);
        return {{ ok "Unit" "Unit.Value" }};
    }
}
{{ end ~}}
