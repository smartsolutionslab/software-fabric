using {{ namespace }}.BuildingBlocks.Identity;
using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.Dashboards.Domain.Dashboards;

namespace {{ namespace }}.Modules.Dashboards.Application.Commands.RemoveDashboard;

public sealed class RemoveDashboardHandler(IDashboardStore dashboards, IDashboardsUnitOfWork unitOfWork, ICurrentUser user)
    : ICommandHandler<RemoveDashboard, Result<Unit, ApiError>>
{
    public async Task<Result<Unit, ApiError>> HandleAsync(RemoveDashboard command, CancellationToken cancellationToken)
    {
        {{ not_null "command" }}

        if (user.Subject is not { } subject)
        {
            return {{ fail "Unit" "DashboardsFailures.NotSignedIn()" }};
        }

{{~ if option ~}}
        var found = await dashboards.FindAsync(command.Id, DashboardOwner.From(subject), cancellationToken);
        if (!found.HasValue)
        {
            return {{ fail "Unit" "DashboardsFailures.NotFound(command.Id.Value)" }};
        }

        dashboards.Remove(found.Value);
{{~ else ~}}
        var dashboard = await dashboards.FindAsync(command.Id, DashboardOwner.From(subject), cancellationToken);
        if (dashboard is null)
        {
            return {{ fail "Unit" "DashboardsFailures.NotFound(command.Id.Value)" }};
        }

        dashboards.Remove(dashboard);
{{~ end ~}}
        await unitOfWork.CommitAsync(cancellationToken);
        return {{ ok "Unit" "Unit.Value" }};
    }
}
{{ else ~}}
