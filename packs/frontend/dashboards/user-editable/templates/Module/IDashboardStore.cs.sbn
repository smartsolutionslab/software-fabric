{{~ if module.values["module.style"] == "crud" ~}}
{{~ option = project["backend.absence"] == "option" ~}}
using {{ namespace }}.Modules.Dashboards.Domain;

namespace {{ namespace }}.Modules.Dashboards.Application;

/// <summary>The dashboards table, one owner's rows at a time; implemented in the module's Infrastructure project.</summary>
public interface IDashboardStore
{
    /// <summary>The owner's dashboard, tracked so that <see cref="SaveAsync"/> saves what a command changes.</summary>
    Task<{{ if option }}Option<Dashboard>{{ else }}Dashboard?{{ end }}> FindAsync(Guid id, string owner, CancellationToken cancellationToken);

    /// <summary>The owner's dashboard as it is stored, for a query: nothing that changes it is saved.</summary>
    Task<{{ if option }}Option<Dashboard>{{ else }}Dashboard?{{ end }}> ReadAsync(Guid id, string owner, CancellationToken cancellationToken);

    /// <summary>One page of the owner's dashboards, by name, for a query.</summary>
    Task<PagedResult<Dashboard>> ListAsync(string owner, Page page, PageSize pageSize, CancellationToken cancellationToken);

    /// <summary>Every one of the owner's dashboards, by name, for a query that sums up all of them.</summary>
    Task<IReadOnlyList<Dashboard>> AllAsync(string owner, CancellationToken cancellationToken);

    void Add(Dashboard dashboard);

    void Remove(Dashboard dashboard);

    Task SaveAsync(CancellationToken cancellationToken);
}
{{ else if module.values["module.style"] == "ddd" ~}}
{{~ option = project["backend.absence"] == "option" ~}}
using {{ namespace }}.Modules.Dashboards.Domain.Dashboards;

namespace {{ namespace }}.Modules.Dashboards.Application;

/// <summary>
/// The owner's dashboards, one owner's at a time; implemented in the module's Infrastructure project. What a command
/// adds, removes or changes is saved when it commits the module's unit of work.
/// </summary>
public interface IDashboardStore
{
    /// <summary>The owner's dashboard, tracked so that committing the unit of work saves what a command changes.</summary>
    Task<{{ if option }}Option<Dashboard>{{ else }}Dashboard?{{ end }}> FindAsync(DashboardId id, DashboardOwner owner, CancellationToken cancellationToken);

    /// <summary>The owner's dashboard as it is stored, for a query: nothing that changes it is saved.</summary>
    Task<{{ if option }}Option<Dashboard>{{ else }}Dashboard?{{ end }}> ReadAsync(DashboardId id, DashboardOwner owner, CancellationToken cancellationToken);

    /// <summary>One page of the owner's dashboards, by name, for a query.</summary>
    Task<PagedResult<Dashboard>> ListAsync(DashboardOwner owner, Page page, PageSize pageSize, CancellationToken cancellationToken);

    /// <summary>Every one of the owner's dashboards, by name, for a query that sums up all of them.</summary>
    Task<IReadOnlyList<Dashboard>> AllAsync(DashboardOwner owner, CancellationToken cancellationToken);

    void Add(Dashboard dashboard);

    void Remove(Dashboard dashboard);
}
{{ else ~}}
using {{ namespace }}.Modules.Dashboards.Application.ReadModels;
using {{ namespace }}.Modules.Dashboards.Domain.Dashboards;

namespace {{ namespace }}.Modules.Dashboards.Application;

/// <summary>
/// The dashboards table, the module's read model of its dashboards, one owner's rows at a time; implemented in the
/// module's Infrastructure project. A dashboard itself is its event stream (<see cref="IDashboardsAggregateStore"/>).
/// </summary>
public interface IDashboardStore
{
    /// <summary>One page of the owner's dashboards, by name, for a query.</summary>
    Task<PagedResult<DashboardRow>> ListAsync(DashboardOwner owner, Page page, PageSize pageSize, CancellationToken cancellationToken);

    /// <summary>Every one of the owner's dashboards, by name, for a query that sums up all of them.</summary>
    Task<IReadOnlyList<DashboardRow>> AllAsync(DashboardOwner owner, CancellationToken cancellationToken);

    /// <summary>
    /// Writes the dashboard's row as its stored events leave it, or deletes the row of a removed one. Call it right after
    /// saving the dashboard's events; committing the module's unit of work saves the row.
    /// </summary>
    Task RecordAsync(Dashboard dashboard, CancellationToken cancellationToken);
}
{{ end ~}}
