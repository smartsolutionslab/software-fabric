{{~ typed = project["backend.result-style"] == "typed-outcomes" ~}}
{{~ option = project["backend.absence"] == "option" ~}}
{{~ func ok(type, value)
  if typed
    ret "Success(" + value + ")"
  end
  ret "Result<" + type + ", ApiError>.Success(" + value + ")"
end ~}}
{{~ func fail(type, error)
  if typed
    ret "Failure(" + error + ")"
  end
  ret "Result<" + type + ", ApiError>.Failure(" + error + ")"
end ~}}
using {{ namespace }}.BuildingBlocks.Dashboards;
using {{ namespace }}.BuildingBlocks.Identity;
using {{ namespace }}.BuildingBlocks.Messaging;

namespace {{ namespace }}.Modules.Dashboards.Application.Queries.CountWidgets;

public sealed class CountWidgetsHandler(IDashboardStore dashboards, ICurrentUser user) : IQueryHandler<CountWidgets, Result<ChartSeries, ApiError>>
{
    public async Task<Result<ChartSeries, ApiError>> HandleAsync(CountWidgets query, CancellationToken cancellationToken)
    {
        {{ not_null "query" }}

        if (user.Subject is not { } owner)
        {
            return {{ fail "ChartSeries" "DashboardsFailures.NotSignedIn()" }};
        }

        var page = await dashboards.ListAsync(owner, Page.First, PageSize.Default, cancellationToken);
        return {{ ok "ChartSeries" "new ChartSeries([.. page.Items.Select(dashboard => dashboard.Name)], [new ChartValues(\"Widgets\", [.. page.Items.Select(dashboard => (decimal)dashboard.Widgets.Count)])])" }};
    }
}
