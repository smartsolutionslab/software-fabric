using {{ namespace }}.Modules.Dashboards.Application;
using {{ namespace }}.Modules.Dashboards.Application.ReadModels;
using {{ namespace }}.Modules.Dashboards.Domain.Dashboards;
using {{ namespace }}.Modules.Dashboards.Infrastructure.Persistence;
using Microsoft.EntityFrameworkCore;

namespace {{ namespace }}.Modules.Dashboards.Infrastructure;

/// <summary>Every read filters by owner here: a user lists only their own dashboards. The module's unit of work saves what is recorded.</summary>
public sealed class DashboardStore(DashboardsDbContext context) : IDashboardStore
{
    public async Task<PagedResult<DashboardRow>> ListAsync(DashboardOwner owner, Page page, PageSize pageSize, CancellationToken cancellationToken)
    {
        {{ not_null "owner" }}
        {{ not_null "page" }}
        {{ not_null "pageSize" }}

        var owned = context.Set<DashboardRow>().AsNoTracking().Where(row => row.Owner == owner.Value);
        var total = await owned.CountAsync(cancellationToken);
        var items = await owned
            .OrderBy(row => row.Name)
            .ThenBy(row => row.Id)
            .Skip(page.Skip(pageSize))
            .Take(pageSize.Value)
            .ToListAsync(cancellationToken);
        return new PagedResult<DashboardRow>(items, total, page.Value, pageSize.Value);
    }

    public async Task<IReadOnlyList<DashboardRow>> AllAsync(DashboardOwner owner, CancellationToken cancellationToken)
    {
        {{ not_null "owner" }}

        return await context.Set<DashboardRow>().AsNoTracking()
            .Where(row => row.Owner == owner.Value)
            .OrderBy(row => row.Name)
            .ThenBy(row => row.Id)
            .ToListAsync(cancellationToken);
    }

    public async Task RecordAsync(Dashboard dashboard, CancellationToken cancellationToken)
    {
        {{ not_null "dashboard" }}

        var row = await context.Set<DashboardRow>().SingleOrDefaultAsync(row => row.Id == dashboard.Id.Value, cancellationToken);
        if (dashboard.IsRemoved())
        {
            if (row is not null)
            {
                context.Remove(row);
            }

            return;
        }

        if (row is null)
        {
            row = new DashboardRow { Id = dashboard.Id.Value };
            context.Add(row);
        }

        row.Owner = dashboard.Owner.Value;
        row.Name = dashboard.Name.Value;
        row.Widgets = [.. dashboard.Widgets.Select(widget => new DashboardRowWidget
        {
            Key = widget.Key{{ value }},
            Source = widget.Source{{ value }},
            Visual = widget.Visual{{ value }},
            X = widget.X{{ value }},
            Y = widget.Y{{ value }},
            Width = widget.Width{{ value }},
            Height = widget.Height{{ value }},
        })];
    }
}
{{ end ~}}
