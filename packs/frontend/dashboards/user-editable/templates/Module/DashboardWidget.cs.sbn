namespace {{ namespace }}.Modules.Dashboards.Domain;

/// <summary>A widget placed on a dashboard's grid: which declared widget it shows, how, and where.</summary>
public sealed class DashboardWidget
{
    /// <summary>Tells the widgets of one dashboard apart, as the grid does.</summary>
    public string Key { get; set; } = string.Empty;

    /// <summary>The id of the declared widget whose query it runs, e.g. <c>billing.monthly-revenue</c>.</summary>
    public string Source { get; set; } = string.Empty;

    /// <summary><c>bar</c>, <c>line</c> or <c>pie</c> for a chart; <c>table</c> for a table.</summary>
    public string Visual { get; set; } = string.Empty;

    public int X { get; set; }

    public int Y { get; set; }

    public int Width { get; set; }

    public int Height { get; set; }
}
