{{~ ddd = module.values["module.style"] == "ddd" ~}}
using {{ namespace }}.Modules.Dashboards.Domain{{ if ddd }}.Dashboards{{ end }};

namespace {{ namespace }}.Modules.Dashboards.Application.DTOs;

public static class DashboardMappings
{
    public static DashboardDto ToDashboardDto(this Dashboard dashboard)
    {
        {{ not_null "dashboard" }}
        return new DashboardDto(dashboard.Id{{ if ddd }}.Value{{ end }}, dashboard.Name{{ if ddd }}.Value{{ end }}, [.. dashboard.Widgets.Select(widget => widget.ToDto())]);
    }

    public static DashboardSummaryDto ToDashboardSummaryDto(this Dashboard dashboard)
    {
        {{ not_null "dashboard" }}
        return new DashboardSummaryDto(dashboard.Id{{ if ddd }}.Value{{ end }}, dashboard.Name{{ if ddd }}.Value{{ end }}, dashboard.Widgets.Count);
    }
}
