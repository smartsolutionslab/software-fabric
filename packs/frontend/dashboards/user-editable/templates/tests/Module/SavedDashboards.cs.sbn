using {{ namespace }}.Modules.Dashboards.Application.Commands.SaveDashboard;

namespace {{ namespace }}.Modules.Dashboards.Tests;

/// <summary>Dashboards saved through the module beforehand, by the user it is set up for.</summary>
internal static class SavedDashboards
{
    public static async Task<Guid> SaveAsync(DashboardsModuleUnderTest module, string name, int widgets, CancellationToken cancellationToken)
    {
        var id = Guid.CreateVersion7();
        WidgetPlacement[] placements = [.. Enumerable.Range(0, widgets).Select(index => new WidgetPlacement($"w-{index}", "dashboards.widget-counts", "bar", 0, index, 1, 1))];
        var saved = await module.SendAsync(new SaveDashboard(id, name, placements), cancellationToken);
        return saved.Value;
    }
}
