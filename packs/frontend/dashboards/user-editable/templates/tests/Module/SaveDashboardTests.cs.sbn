{{~ style = module.values["module.style"] ~}}
{{~ # Under ddd and event-sourced a command carries the module's value objects; the store holds aggregates under ddd only, rows otherwise. ~}}
{{~ ddd = style != "crud" ~}}
{{~ aggregates = style == "ddd" ~}}
{{~ if ddd ~}}
using {{ namespace }}.Modules.Dashboards.Api.Endpoints;
{{~ end ~}}
{{~ if ddd ~}}
using {{ namespace }}.Modules.Dashboards.Application.Commands.RemoveDashboard;
{{~ end ~}}
using {{ namespace }}.Modules.Dashboards.Application.Commands.SaveDashboard;
using {{ namespace }}.Modules.Dashboards.Application.Queries.GetDashboard;
{{~ if ddd ~}}
using {{ namespace }}.Modules.Dashboards.Domain.Dashboards;
{{~ end ~}}

namespace {{ namespace }}.Modules.Dashboards.Tests.Commands;

/// <summary>Saving the caller's dashboard through the dispatcher: what it keeps, and everything it refuses unsaved.</summary>
public class SaveDashboardTests
{
    private static readonly Guid Id = Guid.CreateVersion7();

    {{ test_attribute }}
    public async Task A_saved_dashboard_reads_back_with_its_name_and_each_widget_where_it_was_placed()
    {
        await using var module = new DashboardsModuleUnderTest();

        var saved = await module.SendAsync(Save(" Sales ", new WidgetPlacement("w-1", "dashboards.widget-counts", "pie", 2, 3, 4, 5), new WidgetPlacement("w-2", "dashboards.my-dashboards", "table", 0, 8, 12, 6)), {{ test_cancellation_token }});
        var read = await module.QueryAsync(new GetDashboard(Id), {{ test_cancellation_token }});

        {{ `saved.Value` | should_be `Id` }};
        {{ `read.Value.Id` | should_be `Id` }};
        {{ `read.Value.Name` | should_be `"Sales"` }};
        {{ `read.Value.Widgets.Select(widget => $"{widget.Key} {widget.Source} {widget.Visual} {widget.X},{widget.Y} {widget.Width}x{widget.Height}")` | should_be `["w-1 dashboards.widget-counts pie 2,3 4x5", "w-2 dashboards.my-dashboards table 0,8 12x6"]` }};
        {{ (aggregates ? `module.Store.Stored.Single().Owner.Value` : `module.Store.Stored.Single().Owner`) | should_be `DashboardsModuleUnderTest.Owner` }};
    }

    {{ test_attribute }}
    public async Task Saving_the_same_id_again_replaces_the_name_and_the_widgets_of_the_one_dashboard()
    {
        await using var module = new DashboardsModuleUnderTest();
        await module.SendAsync(Save("Sales", new WidgetPlacement("w-1", "dashboards.widget-counts", "bar", 0, 0, 6, 4)), {{ test_cancellation_token }});

        await module.SendAsync(Save("Costs", new WidgetPlacement("w-2", "dashboards.widget-counts", "line", 6, 0, 6, 4)), {{ test_cancellation_token }});

        var dashboard = module.Store.Stored.Single();
        {{ (aggregates ? `dashboard.Name.Value` : `dashboard.Name`) | should_be `"Costs"` }};
        {{ `dashboard.Widgets.Select(widget => widget.Key)` | should_be `["w-2"]` }};
    }

{{~ if ddd ~}}
    {{ test_attribute }}
    public async Task The_owner_saves_a_removed_dashboards_id_again()
    {
        await using var module = new DashboardsModuleUnderTest();
        await module.SendAsync(Save("Before", new WidgetPlacement("w-1", "dashboards.widget-counts", "bar", 0, 0, 6, 4)), {{ test_cancellation_token }});
        await module.SendAsync(new RemoveDashboard(DashboardId.From(Id)), {{ test_cancellation_token }});

        var saved = await module.SendAsync(Save("After", new WidgetPlacement("w-2", "dashboards.widget-counts", "pie", 6, 0, 6, 4)), {{ test_cancellation_token }});
        var read = await module.QueryAsync(new GetDashboard(Id), {{ test_cancellation_token }});

        {{ `saved.Value` | should_be `Id` }};
        {{ `read.Value.Name` | should_be `"After"` }};
        {{ `read.Value.Widgets.Select(widget => widget.Key)` | should_be `["w-2"]` }};
        {{ (aggregates ? `module.Store.Stored.Single().Name.Value` : `module.Store.Stored.Single().Name`) | should_be `"After"` }};
    }
{{~ end ~}}
{{~ if style == "event-sourced" ~}}

    {{ test_attribute }}
    public async Task Another_users_dashboard_id_is_refused_and_their_dashboard_stays()
    {
        await using var module = new DashboardsModuleUnderTest();
        await using var other = module.SignedInAs(DashboardsModuleUnderTest.OtherOwner);
        await other.SendAsync(Save("Theirs", new WidgetPlacement("w-1", "dashboards.widget-counts", "bar", 0, 0, 6, 4)), {{ test_cancellation_token }});

        var result = await module.SendAsync(Save("Mine", new WidgetPlacement("w-1", "dashboards.widget-counts", "pie", 0, 0, 6, 4)), {{ test_cancellation_token }});

        {{ `result.Error.Code` | should_be `"dashboards.already-exists"` }};
        {{ `module.Store.Stored.Single().Owner` | should_be `DashboardsModuleUnderTest.OtherOwner` }};
        {{ `module.Store.Stored.Single().Name` | should_be `"Theirs"` }};
    }

    {{ test_attribute }}
    public async Task Another_users_removed_dashboard_id_is_still_refused()
    {
        await using var module = new DashboardsModuleUnderTest();
        await using var other = module.SignedInAs(DashboardsModuleUnderTest.OtherOwner);
        await other.SendAsync(Save("Theirs", new WidgetPlacement("w-1", "dashboards.widget-counts", "bar", 0, 0, 6, 4)), {{ test_cancellation_token }});
        await other.SendAsync(new RemoveDashboard(DashboardId.From(Id)), {{ test_cancellation_token }});

        var result = await module.SendAsync(Save("Mine", new WidgetPlacement("w-1", "dashboards.widget-counts", "pie", 0, 0, 6, 4)), {{ test_cancellation_token }});

        {{ `result.Error.Code` | should_be `"dashboards.already-exists"` }};
        {{ `module.Store.Stored` | should_be_empty }};
    }
{{~ end ~}}
{{~ if ddd ~}}

{{~ end ~}}
    {{ test_attribute }}
    public async Task Without_a_signed_in_user_nothing_is_saved()
    {
        await using var module = new DashboardsModuleUnderTest(null);

        var result = await module.SendAsync(Save("Sales"), {{ test_cancellation_token }});

        {{ `result.Error.Code` | should_be `"dashboards.not-signed-in"` }};
        {{ `module.Store.Saves` | should_be `0` }};
    }

    {{ test_attribute }}
    public async Task The_empty_id_is_refused()
    {
        await using var module = new DashboardsModuleUnderTest();

{{~ if ddd ~}}
        {{ should_throw (project["backend.guards"] == "ensure-that" ? "GuardException" : "ArgumentException") `() => new SaveDashboardRequest("Sales", []).ToCommand(Guid.Empty)` }};
{{~ else ~}}
        var result = await module.SendAsync(new SaveDashboard(Guid.Empty, "Sales", []), {{ test_cancellation_token }});

        {{ `result.Error.Code` | should_be `"dashboards.invalid-id"` }};
{{~ end ~}}
        {{ `module.Store.Saves` | should_be `0` }};
    }

    {{ test_cases_attribute }}
    {{ test_case_attribute `""` }}
    {{ test_case_attribute `"  "` }}
    {{ test_case_attribute `"A name of more than one hundred characters is longer than a dashboard's name may be, so saving it is refused."` }}
    public async Task A_name_that_is_blank_or_too_long_is_refused(string name)
    {
        await using var module = new DashboardsModuleUnderTest();

        var result = await module.SendAsync(Save(name), {{ test_cancellation_token }});

        {{ `result.Error.Code` | should_be `"dashboards.invalid-name"` }};
        {{ `module.Store.Saves` | should_be `0` }};
    }

    {{ test_attribute }}
    public async Task More_widgets_than_a_dashboard_holds_are_refused()
    {
        await using var module = new DashboardsModuleUnderTest();
        WidgetPlacement[] widgets = [.. Enumerable.Range(0, SaveDashboardHandler.MaximumWidgets + 1).Select(index => new WidgetPlacement($"w-{index}", "dashboards.widget-counts", "bar", 0, index, 1, 1))];

        var result = await module.SendAsync(Save("Sales", widgets), {{ test_cancellation_token }});

        {{ `result.Error.Code` | should_be `"dashboards.too-many-widgets"` }};
    }
{{~ if ddd ~}}

    {{ test_attribute }}
    public async Task A_widget_without_a_source_is_refused_as_unknown_and_one_without_a_key_or_visual_as_invalid()
    {
        await using var module = new DashboardsModuleUnderTest();

        var noSource = await module.SendAsync(Save("Sales", new WidgetPlacement("w-1", null!, "bar", 0, 0, 1, 1)), {{ test_cancellation_token }});
        var noKey = await module.SendAsync(Save("Sales", new WidgetPlacement(null!, "dashboards.widget-counts", "bar", 0, 0, 1, 1)), {{ test_cancellation_token }});
        var noVisual = await module.SendAsync(Save("Sales", new WidgetPlacement("w-1", "dashboards.widget-counts", null!, 0, 0, 1, 1)), {{ test_cancellation_token }});

        {{ `noSource.Error.Code` | should_be `"dashboards.unknown-widget"` }};
        {{ `noKey.Error.Code` | should_be `"dashboards.invalid-widget"` }};
        {{ `noVisual.Error.Code` | should_be `"dashboards.invalid-widget"` }};
        {{ `module.Store.Saves` | should_be `0` }};
    }

    {{ test_attribute }}
    public async Task A_request_without_a_widget_list_is_refused_and_keeps_the_saved_widgets()
    {
        await using var module = new DashboardsModuleUnderTest();
        await module.SendAsync(Save("Sales", new WidgetPlacement("w-1", "dashboards.widget-counts", "bar", 0, 0, 6, 4)), {{ test_cancellation_token }});

        var result = await module.SendAsync(new SaveDashboardRequest("Sales", null!).ToCommand(Id), {{ test_cancellation_token }});

        {{ `result.Error.Code` | should_be `"dashboards.too-many-widgets"` }};
        {{ `module.Store.Saves` | should_be `1` }};
        {{ `module.Store.Stored.Single().Widgets.Select(widget => widget.Key)` | should_be `["w-1"]` }};
    }
{{~ end ~}}

    {{ test_cases_attribute }}
