{{~ if ddd ~}}
    private static SaveDashboard Save(string name, params WidgetPlacement[] widgets) => new SaveDashboardRequest(name, widgets).ToCommand(Id);
{{~ else ~}}
    private static SaveDashboard Save(string name, params WidgetPlacement[] widgets) => new(Id, name, widgets);
