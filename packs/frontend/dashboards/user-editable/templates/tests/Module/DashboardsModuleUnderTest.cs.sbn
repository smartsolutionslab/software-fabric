{{~ wolverine = project["backend.mediator"] == "wolverine" ~}}
using {{ namespace }}.BuildingBlocks.Dashboards;
using {{ namespace }}.BuildingBlocks.Identity;
using {{ namespace }}.BuildingBlocks.Messaging;
{{~ if wolverine ~}}
using {{ namespace }}.BuildingBlocks.Modules;
{{~ end ~}}
using {{ namespace }}.Modules.Dashboards.Api;
using {{ namespace }}.Modules.Dashboards.Application;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
{{~ if wolverine ~}}
using Microsoft.Extensions.Hosting;
using Wolverine;
using Wolverine.Runtime;
{{~ end ~}}

namespace {{ namespace }}.Modules.Dashboards.Tests;

/// <summary>
/// The dashboards module with what the host provides, its widget catalogue and dispatcher, for one caller; the table
/// is <see cref="Store"/>, which <see cref="SignedInAs"/> shares with another caller. Each request runs through the
/// dispatcher in a scope of its own, as an endpoint's does.
/// </summary>
internal sealed class DashboardsModuleUnderTest : IAsyncDisposable
{
    public const string Owner = "user-a";

    public const string OtherOwner = "user-b";

    private readonly ServiceProvider services;

    public DashboardsModuleUnderTest(string? subject = Owner, params string[] hiddenWidgets)
        : this(new InMemoryDashboardStore(), subject, hiddenWidgets)
    {
    }

    private DashboardsModuleUnderTest(InMemoryDashboardStore store, string? subject, string[] hiddenWidgets)
    {
        Store = store;
        var collection = new ServiceCollection().AddLogging();
        var configuration = new ConfigurationBuilder()
            .AddInMemoryCollection(new Dictionary<string, string?> { ["ConnectionStrings:database"] = "Host=localhost" })
            .Build();
        collection.AddDispatcher();
        collection.AddDashboardWidgets([new DashboardsModule()]);
        new DashboardsModule().AddServices(collection, configuration);
        collection
            .AddSingleton<IDashboardStore>(Store)
            .AddSingleton<ICurrentUser>(new SignedInUser(subject))
            .AddSingleton<IWidgetAccess>(new HiddenWidgets(hiddenWidgets));
{{~ if wolverine ~}}
        collection.AddWolverine(options =>
        {
            options.Durability.Mode = DurabilityMode.MediatorOnly;
            options.Discovery.DisableConventionalDiscovery();
            options.Discovery.IncludeAssembly(ModuleAssemblies.Of<DashboardsModule>("Application"));
            options.DiscoverRequestHandlers();
        });
        services = collection.BuildServiceProvider();

        // Wolverine's runtime is the hosted service a host would start.
        ((IHostedService)services.GetRequiredService<IWolverineRuntime>()).StartAsync(CancellationToken.None).GetAwaiter().GetResult();
{{~ else ~}}
        services = collection.BuildServiceProvider();
{{~ end ~}}
    }

    public InMemoryDashboardStore Store { get; }

    /// <summary>The same module and table for another caller, so one user's dashboards sit beside another's.</summary>
    public DashboardsModuleUnderTest SignedInAs(string subject) => new(Store, subject, []);

    public async Task<TResult> SendAsync<TResult>(ICommand<TResult> command, CancellationToken cancellationToken)
    {
        await using var scope = services.CreateAsyncScope();
        return await scope.ServiceProvider.GetRequiredService<IDispatcher>().SendAsync(command, cancellationToken);
    }

    public async Task<TResult> QueryAsync<TResult>(IQuery<TResult> query, CancellationToken cancellationToken)
    {
        await using var scope = services.CreateAsyncScope();
        return await scope.ServiceProvider.GetRequiredService<IDispatcher>().QueryAsync(query, cancellationToken);
    }

    public ValueTask DisposeAsync() => services.DisposeAsync();
}
