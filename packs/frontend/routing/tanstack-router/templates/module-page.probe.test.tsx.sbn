{{~ sample_page = project["frontend.architecture"] == "spa" && object.has_key(project, "frontend.ui-library") && (project["frontend.ui-library"] == "shadcn" || project["frontend.ui-library"] == "shadcn-vue") && object.has_key(project, "frontend.api-client") && (project["frontend.api-client"] == "rtk-query-codegen" || project["frontend.api-client"] == "orval" || project["frontend.api-client"] == "openapi-fetch") && module.name != "dashboards" && module.name != "assistant" ~}}
{{~ remote = project["frontend.architecture"] == "micro-frontends" ~}}
{{~ assistant = module.name == "assistant" && object.has_key(project, "frontend.agent-ui") && project["frontend.agent-ui"] == "ag-ui" ~}}
{{~ if remote ~}}
import { render, within } from '@testing-library/react';
import { expect, test, vi } from 'vitest';
import { {{ module.namespace }}Page } from './{{ module.namespace }}Page';
import type { ManagePermission } from './useCanManage';

// The module's remote is loaded at run time; here it stands in, so this test checks the page around it.
vi.mock('@/remotes/Remote', () => ({ Remote: ({ module }: { module: string }) => <h1>The {module} remote</h1> }));

// A remote has no API client of its own, so the shell's page asks the module's permission probe; here the answer is the test's.
const probe = vi.hoisted(() => ({ permission: 'granted' as ManagePermission }));
vi.mock('./useCanManage', () => ({ useCanManage: () => probe.permission }));

test('the {{ module.namespace }} page mounts its remote and offers Manage when the probe answers 200', () => {
  probe.permission = 'granted';
  const page = within(render(<{{ module.namespace }}Page />).container);

  expect(page.getByRole('heading', { name: 'The {{ module.name }} remote' })).toBeInTheDocument();
  expect(page.getByRole('heading', { name: 'Manage' })).toBeInTheDocument();
});

test('the {{ module.namespace }} page offers no Manage when the probe refuses', () => {
  probe.permission = 'refused';
  const page = within(render(<{{ module.namespace }}Page />).container);

  expect(page.getByRole('heading', { name: 'The {{ module.name }} remote' })).toBeInTheDocument();
  expect(page.queryByRole('heading', { name: 'Manage' })).not.toBeInTheDocument();
  expect(page.queryByText('Permissions for {{ module.name }} could not be loaded.')).not.toBeInTheDocument();
});

test('the {{ module.namespace }} page shows that its probe failed, not a refusal', () => {
  probe.permission = 'failed';
  const page = within(render(<{{ module.namespace }}Page />).container);

  expect(page.getByRole('heading', { name: 'The {{ module.name }} remote' })).toBeInTheDocument();
  expect(page.getByText('Permissions for {{ module.name }} could not be loaded.')).toHaveAttribute('role', 'alert');
  expect(page.queryByRole('heading', { name: 'Manage' })).not.toBeInTheDocument();
});
{{~ else ~}}
import { render, within } from '@testing-library/react';
import { expect, test, vi } from 'vitest';
import { {{ module.namespace }}Page } from './{{ module.namespace }}Page';
import type { ManagePermission } from './useCanManage';
{{~ if assistant ~}}

// The agent panel has its own test; here it stands in, so this test checks the page around it.
vi.mock('@/agents/AgentPanel', () => ({ AgentPanel: () => <p>The agent panel</p> }));
{{~ end ~}}
{{~ if sample_page ~}}

// The page's samples come through use{{ module.namespace }}Samples, which the page's own test reads; here they are still loading.
vi.mock('./use{{ module.namespace }}Samples', () => ({
  use{{ module.namespace }}Samples: () => ({ samples: undefined, isLoading: true, isError: false }),
  useCreate{{ module.namespace }}Sample: () => ({ create: () => Promise.resolve(false), isSaving: false }),
}));
{{~ end ~}}

// The page asks the module's permission probe, whose own test, useCanManage.test.tsx, reads a 200, a 403 and a failure;
// here the answer is the test's. The page's axe check asks nothing of this, so a project that rewrites the page owns
// this test with it.
const probe = vi.hoisted(() => ({ permission: 'granted' as ManagePermission }));
vi.mock('./useCanManage', () => ({ useCanManage: () => probe.permission }));

test('the {{ module.namespace }} page offers Manage when the probe answers 200', () => {
  probe.permission = 'granted';
  const page = within(render(<{{ module.namespace }}Page />).container);

  expect(page.getByRole('heading', { name: 'Manage' })).toBeInTheDocument();
  expect(page.queryByText('Permissions for {{ module.name }} could not be loaded.')).not.toBeInTheDocument();
});

test('the {{ module.namespace }} page offers no Manage when the probe refuses', () => {
  probe.permission = 'refused';
  const page = within(render(<{{ module.namespace }}Page />).container);

  expect(page.queryByRole('heading', { name: 'Manage' })).not.toBeInTheDocument();
  expect(page.queryByText('Permissions for {{ module.name }} could not be loaded.')).not.toBeInTheDocument();
});

test('the {{ module.namespace }} page shows that its probe failed, not a refusal', () => {
  probe.permission = 'failed';
  const page = within(render(<{{ module.namespace }}Page />).container);

  expect(page.getByText('Permissions for {{ module.name }} could not be loaded.')).toHaveAttribute('role', 'alert');
  expect(page.queryByRole('heading', { name: 'Manage' })).not.toBeInTheDocument();
});
{{~ end ~}}
