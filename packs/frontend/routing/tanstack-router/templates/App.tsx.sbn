{{~ func class_of(tailwind, module)
  if project["frontend.styling"] == "css-modules"
    ret 'className={styles.' + module + '}'
  end
  ret 'className="' + tailwind + '"'
end ~}}
{{~ if project["frontend.ui-library"] == "shadcn" && project["frontend.architecture"] == "spa" ~}}
import { Link, Outlet, useMatchRoute } from '@tanstack/react-router';
import { Separator } from '@/components/ui/separator';
import {
  Sidebar,
  SidebarContent,
  SidebarFooter,
  SidebarGroup,
  SidebarGroupContent,
  SidebarGroupLabel,
  SidebarHeader,
  SidebarInset,
  SidebarMenu,
  SidebarMenuButton,
  SidebarMenuItem,
  SidebarProvider,
  SidebarRail,
  SidebarTrigger,
} from '@/components/ui/sidebar';
import { Toaster } from '@/components/ui/sonner';
import { moduleRoutes } from '@/modules';
import { Breadcrumbs } from '@/shell/Breadcrumbs';
import { CommandPalette } from '@/shell/CommandPalette';
{{- if slots["web.shell-imports"] != "" }}
{{ slots["web.shell-imports"] }}{{ end }}

/**
 * The root route's page, the app shell: a sidebar with the start page and every module's route (each module's
 * routes.tsx adds its own), the breadcrumbs and the command palette above the matched route's page, and the toasts.
 */
export function App() {
  const matchRoute = useMatchRoute();
  return (
    <SidebarProvider>
      <Sidebar>
        <SidebarHeader>
          <p className="px-2 py-1 font-semibold">{{ name }}</p>
        </SidebarHeader>
        <SidebarContent>
          <SidebarGroup>
            <SidebarGroupLabel>Modules</SidebarGroupLabel>
            <SidebarGroupContent>
              <nav aria-label="Modules">
                <SidebarMenu>
                  <SidebarMenuItem>
                    <SidebarMenuButton asChild isActive={matchRoute({ to: '/' }) !== false}>
                      <Link to="/" {%{activeOptions={{ exact: true }}}%}>
                        Home
                      </Link>
                    </SidebarMenuButton>
                  </SidebarMenuItem>
                  {moduleRoutes.map((route) => (
                    <SidebarMenuItem key={route.id}>
                      <SidebarMenuButton asChild isActive={matchRoute({ to: route.fullPath, fuzzy: true }) !== false}>
                        <Link to={route.fullPath}>{route.options.staticData?.title}</Link>
                      </SidebarMenuButton>
                    </SidebarMenuItem>
                  ))}
                </SidebarMenu>
              </nav>
            </SidebarGroupContent>
          </SidebarGroup>
        </SidebarContent>
{{- if slots["web.shell-actions"] != "" }}
        <SidebarFooter>
  {{ slots["web.shell-actions"] }}
        </SidebarFooter>{{ end }}
        <SidebarRail />
      </Sidebar>
      <SidebarInset>
        <header className="flex h-12 shrink-0 items-center gap-2 border-b px-4">
          <SidebarTrigger className="-ml-1" />
          <Separator orientation="vertical" className="mr-2 data-[orientation=vertical]:h-4" />
          <Breadcrumbs />
          <CommandPalette routes={moduleRoutes} />
        </header>
        <Outlet />
      </SidebarInset>
      <Toaster />
    </SidebarProvider>
  );
}
{{~ else if project["frontend.ui-library"] == "mui" ~}}
{%{import { Link as MuiLink, Stack } from '@mui/material';
import { createLink, Outlet } from '@tanstack/react-router';
import { moduleRoutes } from '@/modules';}%}{{- if slots["web.shell-imports"] != "" }}
{{ slots["web.shell-imports"] }}{{ end }}
{%{
/** A router link drawn as MUI's Link, so it takes its colours from the theme. */
const Link = createLink(MuiLink);

/** The root route's page: the navigation, then the matched route's page. */
export function App() {
  return (
    <div>
      <Stack component="nav" aria-label="Modules" direction="row" spacing={2} sx={{ p: 1 }}>
        <Link to="/">Home</Link>
        {moduleRoutes.map((route) => (
          <Link key={route.id} to={route.fullPath}>
            {route.options.staticData?.title}
          </Link>
        ))}}%}{{- if slots["web.shell-actions"] != "" }}
{{ slots["web.shell-actions"] }}{{ end }}
{%{      </Stack>
      <Outlet />
    </div>
  );
}
}%}{{~ else ~}}
import { Link, Outlet } from '@tanstack/react-router';
import { moduleRoutes } from '@/modules';
{{- if slots["web.shell-imports"] != "" }}
{{ slots["web.shell-imports"] }}{{ end }}
{{~ if project["frontend.styling"] == "css-modules" ~}}
import styles from './App.module.css';
{{~ end ~}}

/** The root route's page: the navigation, then the matched route's page. */
export function App() {
  return (
    <div>
      <nav aria-label="Modules" {{ class_of "flex gap-4 p-2" "navigation" }}>
        <Link to="/">Home</Link>
        {moduleRoutes.map((route) => (
          <Link key={route.id} to={route.fullPath}>
            {route.options.staticData?.title}
          </Link>
        ))}
{{- if slots["web.shell-actions"] != "" }}
{{ slots["web.shell-actions"] }}{{ end }}
      </nav>
      <Outlet />
    </div>
  );
}
{{~ end ~}}
