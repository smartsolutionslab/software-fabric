import { render, within } from '@testing-library/react';
import { expect, test, vi } from 'vitest';
import { {{ module.namespace }}Page } from './{{ module.namespace }}Page';

// The module's remote is loaded at run time; here it stands in, so this test checks the page around it.
vi.mock('@/remotes/Remote', () => ({ Remote: ({ module }: { module: string }) => <h1>The {module} remote</h1> }));

// A remote has no API client of its own, so the shell's page asks the module's permission probe; here the answer is the test's.
const probe = vi.hoisted(() => ({ canManage: true }));
vi.mock('./useCanManage', () => ({ useCanManage: () => probe.canManage }));

test('the {{ module.namespace }} page mounts its remote and offers Manage when the probe answers 200', () => {
  probe.canManage = true;
  const page = within(render(<{{ module.namespace }}Page />).container);

  expect(page.getByRole('heading', { name: 'The {{ module.name }} remote' })).toBeInTheDocument();
  expect(page.getByRole('heading', { name: 'Manage' })).toBeInTheDocument();
});

test('the {{ module.namespace }} page offers no Manage when the probe refuses', () => {
  probe.canManage = false;
  const page = within(render(<{{ module.namespace }}Page />).container);

  expect(page.getByRole('heading', { name: 'The {{ module.name }} remote' })).toBeInTheDocument();
  expect(page.queryByRole('heading', { name: 'Manage' })).not.toBeInTheDocument();
});
