{{~ probe = object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
{{~ if project["frontend.architecture"] == "micro-frontends" && probe ~}}
import { Remote } from '@/remotes/Remote';
import { useCanManage } from './useCanManage';

/**
 * The module's screens live in its own remote, web/modules/{{ module.name }}; the shell mounts it here (docs/adr). A remote has
 * no API client of its own, so the shell asks the module's permission probe: "Manage" shows only on a 200, and any failure
 * but a 403 shows as an alert.
 */
export function {{ module.namespace }}Page() {
  const permission = useCanManage();
  return (
    <>
      <Remote module="{{ module.name }}" />
      {permission === 'granted' && (
        <section aria-label="Manage {{ module.name }}">
          <h2>Manage</h2>
        </section>
      )}
      {permission === 'failed' && <p role="alert">Permissions for {{ module.name }} could not be loaded.</p>}
    </>
  );
}
{{~ else if project["frontend.architecture"] == "micro-frontends" ~}}
import { Remote } from '@/remotes/Remote';

/** The module's screens live in its own remote, web/modules/{{ module.name }}; the shell mounts it here (docs/adr). */
export function {{ module.namespace }}Page() {
  return <Remote module="{{ module.name }}" />;
}
{{~ else if module.name == "dashboards" && object.has_key(project, "frontend.dashboards") && array.contains project["frontend.dashboards"] "user-editable" && project["frontend.api-client"] == "rtk-query-codegen" && project["frontend.architecture"] == "spa" ~}}
import { DashboardEditor } from '@/dashboards/DashboardEditor';

/** The module the dashboards choice brings; its screen is that choice's dashboard editor (docs/adr). */
export function {{ module.namespace }}Page() {
  return <DashboardEditor />;
}
{{~ else if module.name == "assistant" && object.has_key(project, "frontend.agent-ui") && project["frontend.agent-ui"] == "ag-ui" ~}}
import { AgentPanel } from '@/agents/AgentPanel';
{{~ if probe ~}}
import { useCanManage } from './useCanManage';
{{~ end ~}}

/** The module the agent panel choice brings; its screen is a conversation with its agent (docs/adr). */
export function {{ module.namespace }}Page() {
{{~ if probe ~}}
  const permission = useCanManage();
{{~ end ~}}
  return (
    <main>
      <h1>{{ module.namespace }}</h1>
{{~ if probe ~}}
      {permission === 'granted' && <h2>Manage</h2>}
      {permission === 'failed' && <p role="alert">Permissions for {{ module.name }} could not be loaded.</p>}
{{~ end ~}}
      <AgentPanel agent="assistant" />
    </main>
  );
}
{{~ else if probe ~}}
import { useCanManage } from './useCanManage';

/** The module's screens; "Manage" shows only to a caller its permission probe answers with 200, and any failure but a 403 shows as an alert. */
export function {{ module.namespace }}Page() {
  const permission = useCanManage();
  return (
    <main>
      <h1>{{ module.namespace }}</h1>
      {permission === 'granted' && <h2>Manage</h2>}
      {permission === 'failed' && <p role="alert">Permissions for {{ module.name }} could not be loaded.</p>}
    </main>
  );
}
{{~ else ~}}
export function {{ module.namespace }}Page() {
  return (
    <main>
      <h1>{{ module.namespace }}</h1>
    </main>
  );
}
{{~ end ~}}
