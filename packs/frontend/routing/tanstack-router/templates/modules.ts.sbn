import type { rootRoute } from '@/rootRoute';

/**
 * Every module's route, by module name. Each src/modules/<module>/routes.tsx adds its own entry
 * (`declare module '@/modules'`), so the router's types know every module path without a list to edit.
 */
// eslint-disable-next-line @typescript-eslint/no-empty-object-type -- filled by each module's declaration merging
export interface ModuleRoutes {}

/**
 * What src/modules/<module>/routes.tsx exports as `route`: a child of the root route, with routes below it as its
 * children. Until the first module exists the list is empty and its type is the root route's, which adds no path.
 */
export type ModuleRoute = [keyof ModuleRoutes] extends [never] ? typeof rootRoute : ModuleRoutes[keyof ModuleRoutes];

export const moduleRoutes = Object.values(
  import.meta.glob<ModuleRoute>('./*/routes.tsx', { eager: true, import: 'route' }),
);
