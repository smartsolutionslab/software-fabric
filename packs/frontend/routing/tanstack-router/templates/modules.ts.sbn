import type { RouteComponent } from '@tanstack/react-router';

/** What src/modules/<module>/routes.tsx exports as `route`; the app finds every module's file by itself (no list to edit). */
export interface ModuleRoute {
  path: string;
  title: string;
  component: RouteComponent;
}

export const moduleRoutes = Object.values(
  import.meta.glob<ModuleRoute>('./*/routes.tsx', { eager: true, import: 'route' }),
);
