{{~ user_menu = object.has_key(project, "frontend.auth-client") && project["frontend.auth-client"] == "oidc-client-ts" ~}}
import { cleanup, render, screen, within } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { MemoryRouter, Route, Routes } from 'react-router';
import { afterEach, expect, test{{ if user_menu }}, vi{{ end }} } from 'vitest';
import { App } from '@/App';
import type { ModuleRoute } from '@/modules';
import { Breadcrumbs } from './Breadcrumbs';
import { CommandPalette } from './CommandPalette';

{{~ if user_menu ~}}
// The user menu has its own test; here it stands in, so this test checks the shell around it.
vi.mock('@/auth/UserMenu', () => ({ UserMenu: () => <p>The user menu</p> }));
{{~ end ~}}

// The modules the app finds, as the shell finds them: every src/modules/<module>/routes.tsx.
const modules = Object.values(
  import.meta.glob<ModuleRoute>('../modules/*/routes.tsx', { eager: true, import: 'route' }),
);

// A module of the tests' own, for what the shell does on a module's page: a real module's page may need the app's
// store, query client or host, which these tests do not render.
const reports: ModuleRoute = { path: 'reports', title: 'Reports', element: <h1>Reports</h1> };

// Without Vitest's globals, Testing Library does not unmount between tests by itself.
afterEach(cleanup);

function renderAt(path: string) {
  render(
    <MemoryRouter initialEntries={[path]}>
      <App />
    </MemoryRouter>,
  );
}

// The file's first test also pays for warming up jsdom, React and the shell's components.
test('the sidebar lists the start page and every module from its routes', { timeout: 20_000 }, () => {
  renderAt('/');

  const navigation = within(screen.getByRole('navigation', { name: 'Modules' }));
  expect(navigation.getAllByRole('link').map((link) => link.textContent)).toEqual([
    'Home',
    ...modules.map((module) => module.title),
  ]);
  expect(navigation.getByRole('link', { name: 'Home' })).toHaveAttribute('aria-current', 'page');
});

test('the sidebar collapses from its trigger and opens again', async () => {
  const user = userEvent.setup();
  renderAt('/');
  const sidebar = () => document.querySelector('[data-slot="sidebar"]');
  expect(sidebar()).toHaveAttribute('data-state', 'expanded');

  await user.click(within(screen.getByRole('banner')).getByRole('button', { name: 'Toggle Sidebar' }));
  expect(sidebar()).toHaveAttribute('data-state', 'collapsed');

  await user.click(within(screen.getByRole('banner')).getByRole('button', { name: 'Toggle Sidebar' }));
  expect(sidebar()).toHaveAttribute('data-state', 'expanded');
});

test('on the start page the breadcrumbs name only it', () => {
  renderAt('/');

  const breadcrumbs = within(screen.getByRole('navigation', { name: 'breadcrumb' }));
  expect(breadcrumbs.getByText('Home')).toHaveAttribute('aria-current', 'page');
  expect(breadcrumbs.getByText('Home')).not.toHaveAttribute('href');
});

// The current page is text, not a disabled link: the sidebar's link to it stays the only link of that name.
test('the page the user is on is text in the breadcrumbs, not a second link to it', () => {
  render(
    <MemoryRouter initialEntries={['/reports']}>
      <Breadcrumbs routes={[reports]} />
    </MemoryRouter>,
  );

  const breadcrumbs = within(screen.getByRole('navigation', { name: 'breadcrumb' }));
  expect(breadcrumbs.queryByRole('link', { name: 'Reports' })).not.toBeInTheDocument();
  expect(breadcrumbs.getByText('Reports')).toHaveAttribute('aria-current', 'page');
});

test("the breadcrumbs lead from the start page to a module's page and below it", () => {
  render(
    <MemoryRouter initialEntries={['/reports/details']}>
      <Breadcrumbs routes={[reports]} />
    </MemoryRouter>,
  );

  const breadcrumbs = within(screen.getByRole('navigation', { name: 'breadcrumb' }));
  expect(breadcrumbs.getByRole('link', { name: 'Home' })).toHaveAttribute('href', '/');
  expect(breadcrumbs.getByRole('link', { name: 'Reports' })).toHaveAttribute('href', '/reports');
  expect(breadcrumbs.getByText('details')).toHaveAttribute('aria-current', 'page');
});

test.each([
  ['Ctrl+K', '{Control>}k{/Control}'],
  ['Cmd+K', '{Meta>}k{/Meta}'],
])('%s opens the command palette and Escape closes it', async (_, keys) => {
  const user = userEvent.setup();
  renderAt('/');

  await user.keyboard(keys);
  const palette = await screen.findByRole('dialog', { name: 'Go to' });
  expect(within(palette).getByRole('combobox', { name: 'Go to' })).toHaveFocus();
  expect(
    within(palette)
      .getAllByRole('option')
      .map((option) => option.textContent),
  ).toEqual(['Home', ...modules.map((module) => module.title)]);

  await user.keyboard('{Escape}');
  expect(screen.queryByRole('dialog')).not.toBeInTheDocument();
});

test('the keyboard alone goes to a page from the command palette', async () => {
  const user = userEvent.setup();
  render(
    <MemoryRouter>
      <CommandPalette routes={[reports]} />
      <Routes>
        <Route path="/" element={<h1>Start</h1>} />
        <Route path="/reports" element={reports.element} />
      </Routes>
    </MemoryRouter>,
  );

  await user.keyboard('{Control>}k{/Control}');
  await screen.findByRole('dialog', { name: 'Go to' });
  await user.keyboard('{ArrowDown}');
  expect(screen.getByRole('option', { name: 'Reports' })).toHaveAttribute('aria-selected', 'true');
  await user.keyboard('{Enter}');

  expect(screen.queryByRole('dialog')).not.toBeInTheDocument();
  expect(screen.getByRole('heading', { name: 'Reports' })).toBeInTheDocument();
});

test('typing narrows the command palette to the pages that match', async () => {
  const user = userEvent.setup();
  renderAt('/');

  await user.keyboard('{Control>}k{/Control}');
  await screen.findByRole('dialog', { name: 'Go to' });
  await user.keyboard('no such page');

  expect(screen.queryAllByRole('option')).toHaveLength(0);
  expect(screen.getByText('No page matches.')).toBeInTheDocument();
});
