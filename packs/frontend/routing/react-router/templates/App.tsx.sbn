{{~ func class_of(tailwind, module)
  if project["frontend.styling"] == "css-modules"
    ret 'className={styles.' + module + '}'
  end
  ret 'className="' + tailwind + '"'
end ~}}
{{~ if project["frontend.ui-library"] == "mui" ~}}
{%{import { Link, Stack } from '@mui/material';
import { NavLink, Route, Routes } from 'react-router';
import type { ModuleRoute } from '@/modules';
import { Home } from '@/pages/Home';

const moduleRoutes = Object.values(
  import.meta.glob<ModuleRoute>('./modules/*/routes.tsx', { eager: true, import: 'route' }),
);

export function App() {
  return (
    <div>
      <Stack component="nav" aria-label="Modules" direction="row" spacing={2} sx={{ p: 1 }}>
        <Link component={NavLink} to="/">
          Home
        </Link>
        {moduleRoutes.map((route) => (
          <Link key={route.path} component={NavLink} to={route.path}>
            {route.title}
          </Link>
        ))}
      </Stack>
      <Routes>
        <Route path="/" element={<Home />} />
        {moduleRoutes.map((route) => (
          <Route key={route.path} path={`${route.path}/*`} element={route.element} />
        ))}
      </Routes>
    </div>
  );
}
}%}{{~ else ~}}
import { NavLink, Route, Routes } from 'react-router';
import type { ModuleRoute } from '@/modules';
import { Home } from '@/pages/Home';
{{~ if project["frontend.styling"] == "css-modules" ~}}
import styles from './App.module.css';
{{~ end ~}}

const moduleRoutes = Object.values(
  import.meta.glob<ModuleRoute>('./modules/*/routes.tsx', { eager: true, import: 'route' }),
);

export function App() {
  return (
    <div>
      <nav aria-label="Modules" {{ class_of "flex gap-4 p-2" "navigation" }}>
        <NavLink to="/">Home</NavLink>
        {moduleRoutes.map((route) => (
          <NavLink key={route.path} to={route.path}>
            {route.title}
          </NavLink>
        ))}
      </nav>
      <Routes>
        <Route path="/" element={<Home />} />
        {moduleRoutes.map((route) => (
          <Route key={route.path} path={`${route.path}/*`} element={route.element} />
        ))}
      </Routes>
    </div>
  );
}
{{~ end ~}}
