{{~ vuetify = project["frontend.ui-library"] == "vuetify" ~}}
{{~ func class_of(tailwind, module, material)
  if vuetify
    ret 'class="' + material + '"'
  end
  if project["frontend.styling"] == "css-modules"
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
{{~ if project["frontend.ui-library"] == "shadcn-vue" && project["frontend.architecture"] == "spa" ~}}
<script setup lang="ts">
import { RouterLink, RouterView, useRoute } from 'vue-router';
import { Separator } from '@/components/ui/separator';
import {
  Sidebar,
  SidebarContent,
  SidebarFooter,
  SidebarGroup,
  SidebarGroupContent,
  SidebarGroupLabel,
  SidebarHeader,
  SidebarInset,
  SidebarMenu,
  SidebarMenuButton,
  SidebarMenuItem,
  SidebarProvider,
  SidebarRail,
  SidebarTrigger,
} from '@/components/ui/sidebar';
import { Toaster } from '@/components/ui/sonner';
import { moduleRoutes } from '@/modules';
import Breadcrumbs from '@/shell/Breadcrumbs.vue';
import CommandPalette from '@/shell/CommandPalette.vue';
{{~ if slots["web.shell-imports"] != "" ~}}
{{ slots["web.shell-imports"] }}
{{~ end ~}}

// The app shell: a sidebar with every module's page (each module's routes.ts adds its own), the breadcrumbs and the
// command palette above the page, and the toasts.
const route = useRoute();

/** Whether the address is the page's or below it. */
const isAt = (path: string) => route.path === path || route.path.startsWith(`${path}/`);
</script>

<template>
  <SidebarProvider>
    <Sidebar>
      <SidebarHeader>
        <p class="px-2 py-1 font-semibold">{{ name }}</p>
      </SidebarHeader>
      <SidebarContent>
        <SidebarGroup>
          <SidebarGroupLabel>Modules</SidebarGroupLabel>
          <SidebarGroupContent>
            <nav aria-label="Modules">
              <SidebarMenu>
                <SidebarMenuItem>
                  <SidebarMenuButton as-child :is-active="route.path === '/'">
                    <RouterLink to="/">Home</RouterLink>
                  </SidebarMenuButton>
                </SidebarMenuItem>
                <SidebarMenuItem v-for="module in moduleRoutes" :key="module.path">
                  <SidebarMenuButton as-child :is-active="isAt(`/${module.path}`)">
                    <RouterLink :to="`/${module.path}`">{{ "{{" }} module.title {{ "}}" }}</RouterLink>
                  </SidebarMenuButton>
                </SidebarMenuItem>
              </SidebarMenu>
            </nav>
          </SidebarGroupContent>
        </SidebarGroup>
      </SidebarContent>
{{~ if slots["web.shell-actions"] != "" ~}}
      <SidebarFooter>
  {{ slots["web.shell-actions"] }}
      </SidebarFooter>
{{~ end ~}}
      <SidebarRail />
    </Sidebar>
    <SidebarInset>
      <header class="flex h-12 shrink-0 items-center gap-2 border-b bg-glass px-4 backdrop-blur-md">
        <SidebarTrigger class="-ml-1" />
        <Separator orientation="vertical" class="mr-2 data-[orientation=vertical]:h-4" />
        <Breadcrumbs />
        <CommandPalette />
      </header>
      <RouterView />
    </SidebarInset>
    <Toaster />
  </SidebarProvider>
</template>
{{~ else ~}}
<script setup lang="ts">
{{~ if vuetify ~}}
import { RouterView } from 'vue-router';
import { VBtn } from 'vuetify/components';
import { moduleRoutes } from '@/modules';
{{~ else ~}}
import { RouterLink, RouterView } from 'vue-router';
import { moduleRoutes } from '@/modules';
{{~ end ~}}
{{~ if slots["web.shell-imports"] != "" ~}}
{{ slots["web.shell-imports"] }}
{{~ end ~}}
{{~ if project["frontend.styling"] == "css-modules" && !vuetify ~}}
import styles from './App.module.css';
{{~ end ~}}
</script>

<template>
  <div>
    <nav aria-label="Modules" {{ class_of "flex gap-4 p-2" "navigation" "d-flex ga-4 pa-2" }}>
{{~ if vuetify ~}}
      <VBtn to="/" variant="text" color="primary">Home</VBtn>
      <VBtn v-for="route in moduleRoutes" :key="route.path" :to="`/${route.path}`" variant="text" color="primary">
        {{ "{{" }} route.title {{ "}}" }}
      </VBtn>
{{~ else ~}}
      <RouterLink to="/">Home</RouterLink>
      <RouterLink v-for="route in moduleRoutes" :key="route.path" :to="`/${route.path}`">
        {{ "{{" }} route.title {{ "}}" }}
      </RouterLink>
{{~ end ~}}
{{~ if slots["web.shell-actions"] != "" ~}}
{{ slots["web.shell-actions"] }}
{{~ end ~}}
    </nav>
    <RouterView />
  </div>
</template>
{{~ end ~}}
