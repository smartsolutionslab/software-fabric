{{~ probe = object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
{{~ if project["frontend.architecture"] == "micro-frontends" && probe ~}}
<script setup lang="ts">
// The module's screens live in its own remote, web/modules/{{ module.name }}; the shell mounts it here (docs/adr). A remote
// has no API client of its own, so the shell asks the module's permission probe: "Manage" shows only on a 200.
import Remote from '@/remotes/Remote.vue';
import { useCanManage } from './useCanManage';

const canManage = useCanManage();
</script>

<template>
  <Remote module="{{ module.name }}" />
  <section v-if="canManage" aria-label="Manage {{ module.name }}">
    <h2>Manage</h2>
  </section>
</template>
{{~ else if project["frontend.architecture"] == "micro-frontends" ~}}
<script setup lang="ts">
// The module's screens live in its own remote, web/modules/{{ module.name }}; the shell mounts it here (docs/adr).
import Remote from '@/remotes/Remote.vue';
</script>

<template>
  <Remote module="{{ module.name }}" />
</template>
{{~ else if module.name == "dashboards" && object.has_key(project, "frontend.dashboards") && array.contains project["frontend.dashboards"] "user-editable" && project["frontend.api-client"] == "orval" && (!object.has_key(project, "frontend.state") || project["frontend.state"] != "pinia") && project["frontend.architecture"] == "spa" ~}}
<script setup lang="ts">
// The module the dashboards choice brings; its screen is that choice's dashboard editor (docs/adr).
import DashboardEditor from '@/dashboards/DashboardEditor.vue';
</script>

<template>
  <DashboardEditor />
</template>
{{~ else if module.name == "assistant" && object.has_key(project, "frontend.agent-ui") && project["frontend.agent-ui"] == "ag-ui" ~}}
<script setup lang="ts">
// The module the agent panel choice brings; its screen is a conversation with its agent (docs/adr).
import AgentPanel from '@/agents/AgentPanel.vue';
{{~ if probe ~}}
import { useCanManage } from './useCanManage';

const canManage = useCanManage();
{{~ end ~}}
</script>

<template>
  <main>
    <h1>{{ module.namespace }}</h1>
{{~ if probe ~}}
    <h2 v-if="canManage">Manage</h2>
{{~ end ~}}
    <AgentPanel agent="assistant" />
  </main>
</template>
{{~ else if probe ~}}
<script setup lang="ts">
// "Manage" shows only to a caller the module's permission probe answers with 200.
import { useCanManage } from './useCanManage';

const canManage = useCanManage();
</script>

<template>
  <main>
    <h1>{{ module.namespace }}</h1>
    <h2 v-if="canManage">Manage</h2>
  </main>
</template>
{{~ else ~}}
<template>
  <main>
    <h1>{{ module.namespace }}</h1>
  </main>
</template>
{{~ end ~}}
