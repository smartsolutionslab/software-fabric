{{~ probe = object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
{{~ # The module's sample (#734): its list and create form, in a single-page app with shadcn-vue and a cached client. ~}}
{{~ sample_page = project["frontend.architecture"] == "spa" && object.has_key(project, "frontend.ui-library") && (project["frontend.ui-library"] == "shadcn" || project["frontend.ui-library"] == "shadcn-vue") && object.has_key(project, "frontend.api-client") && (project["frontend.api-client"] == "rtk-query-codegen" || project["frontend.api-client"] == "orval" || project["frontend.api-client"] == "openapi-fetch") && module.name != "dashboards" && module.name != "assistant" ~}}
{{~ if project["frontend.architecture"] == "micro-frontends" && probe ~}}
<script setup lang="ts">
// The module's screens live in its own remote, web/modules/{{ module.name }}; the shell mounts it here (docs/adr). A remote
// has no API client of its own, so the shell asks the module's permission probe: "Manage" shows only on a 200, and any
// failure but a 403 shows as an alert.
import Remote from '@/remotes/Remote.vue';
import { useCanManage } from './useCanManage';

const permission = useCanManage();
</script>

<template>
  <Remote module="{{ module.name }}" />
  <section v-if="permission === 'granted'" aria-label="Manage {{ module.name }}">
    <h2>Manage</h2>
  </section>
  <p v-if="permission === 'failed'" role="alert">Permissions for {{ module.name }} could not be loaded.</p>
</template>
{{~ else if project["frontend.architecture"] == "micro-frontends" ~}}
<script setup lang="ts">
// The module's screens live in its own remote, web/modules/{{ module.name }}; the shell mounts it here (docs/adr).
import Remote from '@/remotes/Remote.vue';
</script>

<template>
  <Remote module="{{ module.name }}" />
</template>
{{~ else if module.name == "dashboards" && object.has_key(project, "frontend.dashboards") && array.contains project["frontend.dashboards"] "user-editable" && project["frontend.api-client"] == "orval" && (!object.has_key(project, "frontend.state") || project["frontend.state"] != "pinia") && project["frontend.architecture"] == "spa" ~}}
<script setup lang="ts">
// The module the dashboards choice brings; its screen is that choice's dashboard editor (docs/adr).
import DashboardEditor from '@/dashboards/DashboardEditor.vue';
</script>

<template>
  <DashboardEditor />
</template>
{{~ else if module.name == "assistant" && object.has_key(project, "frontend.agent-ui") && project["frontend.agent-ui"] == "ag-ui" ~}}
<script setup lang="ts">
// The module the agent panel choice brings; its screen is a conversation with its agent (docs/adr).
import AgentPanel from '@/agents/AgentPanel.vue';
{{~ if probe ~}}
import { useCanManage } from './useCanManage';

const permission = useCanManage();
{{~ end ~}}
</script>

<template>
  <main>
    <h1>{{ module.namespace }}</h1>
{{~ if probe ~}}
    <h2 v-if="permission === 'granted'">Manage</h2>
    <p v-if="permission === 'failed'" role="alert">Permissions for {{ module.name }} could not be loaded.</p>
{{~ end ~}}
    <AgentPanel agent="assistant" />
  </main>
</template>
{{~ else if sample_page ~}}
{{~ ns = module.namespace ~}}
{{~ # TanStack Table's DataTable draws its own loading and empty states (#696); beside AG Grid the page draws them. ~}}
{{~ table = project["frontend.data-grid"] == "tanstack-table" ~}}
{{~ # openapi-fetch's generated file holds the document's types, not named ones: the composable names the sample's. ~}}
{{~ fetch = project["frontend.api-client"] == "openapi-fetch" ~}}
<script setup lang="ts">
import { Inbox } from '@lucide/vue';
import { useTemplateRef } from 'vue';
{{~ if !fetch ~}}
import type { {{ ns }}SampleDto } from '@/api/generated';
{{~ end ~}}
import { Button } from '@/components/ui/button';
import DataTable from '@/components/ui/DataTable.vue';
import { columnsOf } from '@/components/ui/data-table-columns';
import { EmptyState } from '@/components/ui/empty-state';
{{~ if !table ~}}
import { Skeleton } from '@/components/ui/skeleton';
{{~ end ~}}
import { notify } from '@/lib/notify';
import Create{{ ns }}SampleForm from './Create{{ ns }}SampleForm.vue';
{{~ if probe ~}}
import { useCanManage } from './useCanManage';
{{~ end ~}}
{{~ if fetch ~}}
import { type {{ ns }}SampleDto, useCreate{{ ns }}Sample, use{{ ns }}Samples } from './use{{ ns }}Samples';
{{~ else ~}}
import { useCreate{{ ns }}Sample, use{{ ns }}Samples } from './use{{ ns }}Samples';
{{~ end ~}}

// The module's screen, starting from its sample (AGENTS.md): the samples in a table, by name, and a form that creates
// one, shown in the table at once and taken out again if the host refuses it; the result is a toast.{{ if probe }} "Manage"
// shows only to a caller its permission probe answers with 200, and any failure but a 403 shows as an alert.{{ end }}
const samples = columnsOf<{{ ns }}SampleDto>();
const columns = samples.columns([samples.accessor('name', { header: 'Name' })]);
{{~ if table ~}}
const none: {{ ns }}SampleDto[] = [];
{{~ else ~}}
const skeletonRows = ['first', 'second', 'third'];
{{~ end ~}}

const { samples: rows, isLoading, isError } = use{{ ns }}Samples();
const { create, isSaving } = useCreate{{ ns }}Sample();
{{~ if probe ~}}
const permission = useCanManage();
{{~ end ~}}
const form = useTemplateRef('form');

async function onCreate(name: string) {
  const created = await create(name);
  if (created) {
    notify.success(`The sample ${name} was created.`);
  } else {
    notify.failure(`The sample ${name} could not be created.`);
  }
  return created;
}
</script>

<template>
  <main class="flex flex-col gap-6">
    <h1>{{ ns }}</h1>
{{~ if probe ~}}
    <h2 v-if="permission === 'granted'">Manage</h2>
    <p v-if="permission === 'failed'" role="alert">Permissions for {{ module.name }} could not be loaded.</p>
{{~ end ~}}
    <section aria-labelledby="{{ module.name }}-samples" class="flex flex-col gap-4">
      <h2 id="{{ module.name }}-samples">Samples</h2>
      <Create{{ ns }}SampleForm ref="form" :on-create="onCreate" :saving="isSaving" />
      <p v-if="isError" role="alert">The samples could not be loaded.</p>
{{~ if table ~}}
      <DataTable v-else :columns="columns" :data="rows ?? none" :loading="isLoading">
        <template #empty>
          <EmptyState>
            <template #icon><Inbox /></template>
            No samples yet.
            <template #action>
              <Button type="button" variant="outline" @click="form?.focus()">Create a sample</Button>
            </template>
          </EmptyState>
        </template>
      </DataTable>
{{~ else ~}}
      <div v-else-if="isLoading" aria-busy="true" class="flex flex-col gap-2">
        <span class="sr-only">Loading…</span>
        <Skeleton v-for="row in skeletonRows" :key="row" class="h-8 w-full" />
      </div>
      <EmptyState v-else-if="rows?.length === 0">
        <template #icon><Inbox /></template>
        No samples yet.
        <template #action>
          <Button type="button" variant="outline" @click="form?.focus()">Create a sample</Button>
        </template>
      </EmptyState>
      <DataTable v-else-if="rows !== undefined" :columns="columns" :data="rows" />
{{~ end ~}}
    </section>
  </main>
</template>
{{~ else if probe ~}}
<script setup lang="ts">
// "Manage" shows only to a caller the module's permission probe answers with 200, and any failure but a 403 shows as
// an alert.
import { useCanManage } from './useCanManage';

const permission = useCanManage();
</script>

<template>
  <main>
    <h1>{{ module.namespace }}</h1>
    <h2 v-if="permission === 'granted'">Manage</h2>
    <p v-if="permission === 'failed'" role="alert">Permissions for {{ module.name }} could not be loaded.</p>
  </main>
</template>
{{~ else ~}}
<template>
  <main>
    <h1>{{ module.namespace }}</h1>
  </main>
</template>
{{~ end ~}}
