import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { Button } from '@mui/material';
import { ThemeProvider } from '@mui/material/styles';
import { cleanup, render, screen } from '@testing-library/react';
import ts from 'typescript';
import { afterEach, expect, test } from 'vitest';
import { theme } from './theme';

// Vitest runs without globals, so Testing Library cannot register its own cleanup.
afterEach(cleanup);

// Vitest runs in web/app; the components are under src.
const source = join(process.cwd(), 'src');

/** A colour written out: #hex, or a CSS colour function. */
const colour = /#[0-9a-f]{3,8}\b|\b(?:rgba?|hsla?|hwb|lab|lch|oklab|oklch)\(/i;

/** The props a component styles itself with: sx, style, css, and the colour props (color, bgcolor, borderColor, fill). */
const stylingProp = /^(?:sx|style|styles|css|fill|stroke|\w*colou?r)$/i;

/** The calls that style a component: styled(...), styled.div`...`, css`...`, keyframes`...`. */
const stylingCalls = new Set(['styled', 'css', 'keyframes']);

/** The function a call or tagged template starts from: styled for styled('div')({...}) and styled.div`...`. */
function called(node: ts.Expression): string {
  if (ts.isCallExpression(node) || ts.isPropertyAccessExpression(node)) {
    return called(node.expression);
  }
  if (ts.isTaggedTemplateExpression(node)) {
    return called(node.tag);
  }
  return ts.isIdentifier(node) ? node.text : '';
}

/**
 * Whether a component writes a colour in a styling value: a styling prop (given directly or in a spread), or a styling
 * call, with what they name in the same file, resolved by the compiler in its scope (sx={alarm} reads that alarm, and
 * sx={entry.sx} only entry's sx). Text, comments, links and other props are content, not styling, even when they look
 * like a colour (Issue #393, href="#add").
 */
function writesColour(file: ts.SourceFile, checker: ts.TypeChecker): boolean {
  const read = new Set<ts.Node>();
  /** What a name refers to, when it is declared in this file: the value it was given. */
  const declared = (symbol: ts.Symbol | undefined): ts.Node[] =>
    (symbol?.declarations ?? [])
      .filter((declaration) => declaration.getSourceFile() === file)
      .map((declaration): ts.Node | undefined =>
        ts.isVariableDeclaration(declaration) || ts.isPropertyAssignment(declaration)
          ? declaration.initializer
          : declaration,
      )
      .filter((value): value is ts.Node => value !== undefined);
  const anyColoured = (nodes: ts.Node[]): boolean => nodes.some((node) => coloured(node));
  const coloured = (node: ts.Node): boolean => {
    if (read.has(node)) {
      return false;
    }
    read.add(node);
    if (ts.isStringLiteralLike(node) || ts.isTemplateLiteralToken(node)) {
      return colour.test(node.text);
    }
    if (ts.isIdentifier(node)) {
      return anyColoured(declared(checker.getSymbolAtLocation(node)));
    }
    if (ts.isShorthandPropertyAssignment(node)) {
      return anyColoured(declared(checker.getShorthandAssignmentValueSymbol(node)));
    }
    if (ts.isPropertyAssignment(node)) {
      return coloured(node.initializer) || (ts.isComputedPropertyName(node.name) && coloured(node.name));
    }
    if (ts.isPropertyAccessExpression(node) || ts.isElementAccessExpression(node)) {
      const member = ts.isPropertyAccessExpression(node) ? node.name : node.argumentExpression;
      const symbol = checker.getSymbolAtLocation(member);
      // A member the compiler cannot find is read whole; one declared elsewhere (theme.palette) is not this file's.
      return symbol === undefined ? ts.forEachChild(node, coloured) === true : anyColoured(declared(symbol));
    }
    if (ts.isJsxSpreadAttribute(node)) {
      const props = checker.getTypeAtLocation(node.expression).getProperties();
      return anyColoured(props.filter((prop) => stylingProp.test(prop.name)).flatMap(declared));
    }
    return ts.forEachChild(node, coloured) === true;
  };
  const styling = (node: ts.Node): boolean => {
    if (ts.isJsxAttribute(node) && stylingProp.test(node.name.getText(file))) {
      return node.initializer !== undefined && coloured(node.initializer);
    }
    if (ts.isJsxSpreadAttribute(node)) {
      return coloured(node);
    }
    if ((ts.isCallExpression(node) || ts.isTaggedTemplateExpression(node)) && stylingCalls.has(called(node))) {
      return coloured(node);
    }
    return ts.forEachChild(node, styling) === true;
  };
  return styling(file);
}

/** A value as the browser paints it: MUI sets some through its own custom properties (var(--variant-containedBg)). */
function resolve(style: CSSStyleDeclaration, value: string): string {
  const custom = /^var\((--[\w-]+)\)$/.exec(value)?.[1];
  return custom === undefined ? value : resolve(style, style.getPropertyValue(custom).trim());
}

test("MUI's components take their colours from the theme", () => {
  render(
    <ThemeProvider theme={theme}>
      <Button variant="contained">Save</Button>
    </ThemeProvider>,
  );

  const style = getComputedStyle(screen.getByRole('button', { name: 'Save' }));
  expect(resolve(style, style.backgroundColor)).toBe(theme.palette.primary.main);
});

test('no component writes a colour of its own', () => {
  // Colours are the theme's, in src/theme.ts: a component names them through it (color="error", bgcolor: 'primary.main').
  const components = readdirSync(source, { recursive: true, encoding: 'utf8' }).filter(
    (path) => path.endsWith('.tsx') && !path.endsWith('.test.tsx'),
  );
  // One program for every component, without the libraries: names and members are resolved within the source alone.
  const program = ts.createProgram(
    components.map((path) => join(source, path)),
    { noLib: true, noResolve: true, jsx: ts.JsxEmit.Preserve },
  );
  const checker = program.getTypeChecker();
  const coloured = components.filter((path) => {
    const file = program.getSourceFile(join(source, path));
    return file !== undefined && writesColour(file, checker);
  });

  expect(coloured, 'components that write a colour instead of taking it from src/theme.ts').toEqual([]);
});
