{{~ if project["frontend.ui-library"] != "mui" ~}}
throw new Error('The library-theme pack builds the theme for MUI only so far; frontend.ui-library is {{ project["frontend.ui-library"] }} (docs/adr/0006 of the generator).');
{{~ else if project["frontend.design-system"] == "tokens" || project["frontend.design-system"] == "web-components" ~}}
import { createTheme } from '@mui/material/styles';
import { tokens } from '@{{ name }}/tokens';

const spacingTokens: Partial<Record<string, string>> = tokens.spacing;

/**
 * The app's look in one place: every MUI component takes its colours, shape and spacing from this theme, and the
 * theme takes them from the design tokens (web/packages/tokens/src, docs/adr). Change a value in its token, never here
 * or per component; a screen names the theme's values (`color="text.secondary"`, `bgcolor: 'primary.main'`, `p: 4`).
 */
export const theme = createTheme({
  palette: {
    mode: 'light',
    primary: { main: tokens.color.primary, contrastText: tokens.color['primary-foreground'] },
    secondary: { main: tokens.color.accent, contrastText: tokens.color['accent-foreground'] },
    background: { default: tokens.color.surface },
    divider: tokens.color.border,
  },
  shape: { borderRadius: tokens.radius.md },
  // p: 4 takes the spacing.4 token, as Tailwind's p-4 does; a step the tokens do not define is a multiple of spacing.1.
  spacing: (step: number) => spacingTokens[String(step)] ?? `calc(${step} * ${tokens.spacing[1]})`,
});
{{~ else ~}}
import { createTheme } from '@mui/material/styles';

/**
 * The app's look in one place: the colours, shape and type every MUI component takes (docs/adr). Change them here,
 * never per component; a screen names them through the theme (`color="text.secondary"`, `bgcolor: 'primary.main'` in `sx`).
 */
export const theme = createTheme({
  palette: {
    mode: 'light',
    primary: { main: '#2563eb' },
    secondary: { main: '#7c3aed' },
    error: { main: '#dc2626' },
  },
  shape: { borderRadius: 4 },
});
{{~ end ~}}
