{{~ vuetify = project["frontend.ui-library"] == "vuetify" ~}}
{{~ css_modules = project["frontend.styling"] == "css-modules" && !vuetify ~}}
{{~ func class_of(tailwind, module)
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
{{~ if project["frontend.ui-library"] == "shadcn-vue" ~}}
<script setup lang="ts" generic="TRow extends RowData">
import { type ColumnDef, FlexRender, type RowData, useTable } from '@tanstack/vue-table';
import { computed, toRef } from 'vue';
import { Skeleton } from './skeleton';
import { features, type Features } from './data-table-columns';

/**
 * A plain table over TanStack Table; keep columns stable (module scope). While the query is pending (`loading`), the
 * table is busy and shows skeleton rows in its own shape instead of data; with no rows it shows its `empty` slot, such
 * as an `<EmptyState>`.
 */
const props = defineProps<{
  columns: ColumnDef<Features, TRow, unknown>[];
  data: TRow[];
  loading?: boolean;
}>();

defineSlots<{ empty?: () => unknown }>();

const table = useTable({ features, columns: props.columns, data: toRef(() => props.data) });
const rows = computed(() => table.getRowModel().rows);
const leafColumns = computed(() => table.getAllLeafColumns());
const skeletonRows = ['first', 'second', 'third'];
</script>

<template>
  <table class="w-full text-sm" :aria-busy="loading || undefined">
    <caption v-if="loading" class="sr-only">
      Loading…
    </caption>
    <thead>
      <tr v-for="group in table.getHeaderGroups()" :key="group.id">
        <th v-for="header in group.headers" :key="header.id" class="border-b p-2 text-left font-medium">
          <FlexRender v-if="!header.isPlaceholder" :header="header" />
        </th>
      </tr>
    </thead>
    <tbody>
      <template v-if="loading">
        <tr v-for="row in skeletonRows" :key="row" aria-hidden="true">
          <td v-for="column in leafColumns" :key="column.id" class="border-b p-2">
            <Skeleton class="h-4 w-full" />
          </td>
        </tr>
      </template>
      <template v-else>
        <tr v-for="row in rows" :key="row.id">
          <td v-for="cell in row.getAllCells()" :key="cell.id" class="border-b p-2">
            <FlexRender :cell="cell" />
          </td>
        </tr>
        <tr v-if="rows.length === 0 && $slots.empty">
          <td :colspan="leafColumns.length" class="p-2">
            <slot name="empty" />
          </td>
        </tr>
      </template>
    </tbody>
  </table>
</template>
{{~ else ~}}
<script setup lang="ts" generic="TRow extends RowData">
import { type ColumnDef, FlexRender, type RowData, useTable } from '@tanstack/vue-table';
import { toRef } from 'vue';
{{~ if vuetify ~}}
import { VTable } from 'vuetify/components';
{{~ end ~}}
import { features, type Features } from './data-table-columns';
{{~ if css_modules ~}}
import styles from './DataTable.module.css';
{{~ end ~}}

/** A plain table over TanStack Table; keep columns stable (module scope). */
const props = defineProps<{
  columns: ColumnDef<Features, TRow, unknown>[];
  data: TRow[];
}>();

const table = useTable({ features, columns: props.columns, data: toRef(() => props.data) });
</script>

<template>
{{~ if vuetify ~}}
  <VTable density="compact">
    <thead>
      <tr v-for="group in table.getHeaderGroups()" :key="group.id">
        <th v-for="header in group.headers" :key="header.id" class="text-left font-weight-medium">
          <FlexRender v-if="!header.isPlaceholder" :header="header" />
        </th>
      </tr>
    </thead>
    <tbody>
      <tr v-for="row in table.getRowModel().rows" :key="row.id">
        <td v-for="cell in row.getAllCells()" :key="cell.id">
          <FlexRender :cell="cell" />
        </td>
      </tr>
    </tbody>
  </VTable>
{{~ else ~}}
  <table {{ class_of "w-full text-sm" "table" }}>
    <thead>
      <tr v-for="group in table.getHeaderGroups()" :key="group.id">
        <th v-for="header in group.headers" :key="header.id" {{ class_of "border-b p-2 text-left font-medium" "header" }}>
          <FlexRender v-if="!header.isPlaceholder" :header="header" />
        </th>
      </tr>
    </thead>
    <tbody>
      <tr v-for="row in table.getRowModel().rows" :key="row.id">
        <td v-for="cell in row.getAllCells()" :key="cell.id" {{ class_of "border-b p-2" "cell" }}>
          <FlexRender :cell="cell" />
        </td>
      </tr>
    </tbody>
  </table>
{{~ end ~}}
</template>
{{~ end ~}}
