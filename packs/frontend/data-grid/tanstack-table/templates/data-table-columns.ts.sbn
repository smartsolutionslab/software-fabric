{{~ shadcn = project["frontend.ui-library"] == "shadcn" || project["frontend.ui-library"] == "shadcn-vue" ~}}
{{~ if shadcn ~}}
import { columnVisibilityFeature, createColumnHelper, type RowData, tableFeatures } from '@tanstack/{{ project["frontend.framework"] == "vue" ? "vue" : "react" }}-table';

/** Column visibility, for the table's Columns control; register sorting, filtering or paging here when a screen needs them. */
export const features = tableFeatures({ columnVisibilityFeature });
{{~ else ~}}
import { createColumnHelper, type RowData, tableFeatures } from '@tanstack/{{ project["frontend.framework"] == "vue" ? "vue" : "react" }}-table';

/** Core features only; register sorting, filtering or paging here when a screen needs them. */
export const features = tableFeatures({});
{{~ end ~}}

export type Features = typeof features;

/** The column helper for rows of TRow: `const notes = columnsOf<Note>()`, then `notes.columns([notes.accessor('text', ...)])`. */
export const columnsOf = <TRow extends RowData>() => createColumnHelper<Features, TRow>();
