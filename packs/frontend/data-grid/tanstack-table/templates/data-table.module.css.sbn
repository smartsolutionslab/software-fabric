{{~ tokens = project["frontend.design-system"] == "tokens" ~}}
{{~ func colour(token, value)
  if tokens
    ret "var(--ds-color-" + token + ")"
  end
  ret value
end ~}}
.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
  line-height: 1.25rem;
}

.header,
.cell {
  border-bottom: 1px solid {{ colour "border" "#e2e8f0" }};
  padding: 0.5rem;
}

.header {
  text-align: left;
  font-weight: 500;
}
