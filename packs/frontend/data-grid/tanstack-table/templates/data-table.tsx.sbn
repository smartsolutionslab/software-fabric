{{~ css_modules = project["frontend.styling"] == "css-modules" ~}}
{{~ func class_of(tailwind, module)
  if css_modules
    ret 'className={styles.' + module + '}'
  end
  ret 'className="' + tailwind + '"'
end ~}}
{{~ if project["frontend.ui-library"] == "mui" ~}}
{%{import { Table, TableBody, TableCell, TableHead, TableRow } from '@mui/material';
import { type ColumnDef, type RowData, useTable } from '@tanstack/react-table';
import { features, type Features } from './data-table-columns';

interface DataTableProps<TRow extends RowData> {
  columns: ColumnDef<Features, TRow, unknown>[];
  data: TRow[];
}

/** A plain table over TanStack Table; keep columns and data stable (module scope or memoised). */
export function DataTable<TRow extends RowData>({ columns, data }: DataTableProps<TRow>) {
  const table = useTable({ features, columns, data });

  return (
    <Table size="small">
      <TableHead>
        {table.getHeaderGroups().map((group) => (
          <TableRow key={group.id}>
            {group.headers.map((header) => (
              <TableCell key={header.id}>
                {header.isPlaceholder ? null : <table.FlexRender header={header} />}
              </TableCell>
            ))}
          </TableRow>
        ))}
      </TableHead>
      <TableBody>
        {table.getRowModel().rows.map((row) => (
          <TableRow key={row.id}>
            {row.getAllCells().map((cell) => (
              <TableCell key={cell.id}>
                <table.FlexRender cell={cell} />
              </TableCell>
            ))}
          </TableRow>
        ))}
      </TableBody>
    </Table>
  );
}
}%}{{~ else ~}}
{{~ if project["frontend.ui-library"] == "shadcn" ~}}
import { type KeyboardEvent, type ReactNode, useId, useRef, useState } from 'react';
import { type ColumnDef, type RowData, useTable } from '@tanstack/react-table';
import { cn } from '@/lib/utils';
import { Button } from './button';
import { Skeleton } from './skeleton';
import { features, type Features } from './data-table-columns';

/** Where a page of rows sits in the whole list: a `PagedResult` as the host answers it, whose numbers may be strings. */
interface Paging {
  page: number | string;
  pageSize: number | string;
  totalCount: number | string;
}

interface DataTableProps<TRow extends RowData> {
  columns: ColumnDef<Features, TRow, unknown>[];
  data: TRow[];
  /** While the query is pending: the table is busy and shows skeleton rows in its own shape instead of data. */
  loading?: boolean;
  /** What the table shows in place of rows when it has none, such as an `<EmptyState>`. */
  empty?: ReactNode;
  /** A row's actions, in its last cell, shown while the row is hovered or has focus. */
  actions?: (row: TRow) => ReactNode;
  /** The page these rows are of: the table says below them which rows it shows of how many ("Showing 1–25 of 312"). */
  paging?: Paging;
}

type Density = 'comfortable' | 'compact';

const densities: { value: Density; label: string }[] = [
  { value: 'comfortable', label: 'Comfortable' },
  { value: 'compact', label: 'Compact' },
];
const cellPadding: Record<Density, string> = { comfortable: 'px-2 py-2', compact: 'px-2 py-1' };
const skeletonRows = ['first', 'second', 'third'];

/** "Showing 26–50 of 312", or nothing for a page without rows. */
function showing(paging: Paging, rows: number): string | undefined {
  if (rows === 0) {
    return undefined;
  }

  const first = (Number(paging.page) - 1) * Number(paging.pageSize) + 1;
  return `Showing ${first}–${first + rows - 1} of ${Number(paging.totalCount)}`;
}

/**
 * A table over TanStack Table; keep columns and data stable (module scope or memoised). Its header stays in view while
 * the rows scroll; above them, the reader picks the density and the columns shown.
 */
export function DataTable<TRow extends RowData>({
  columns,
  data,
  loading = false,
  empty,
  actions,
  paging,
}: DataTableProps<TRow>) {
  const table = useTable({ features, columns, data });
  const [density, setDensity] = useState<Density>('comfortable');
  const [choosing, setChoosing] = useState(false);
  const columnsButton = useRef<HTMLButtonElement>(null);
  const id = useId();
  const rows = table.getRowModel().rows;
  const visibleColumns = table.getVisibleLeafColumns();
  const span = visibleColumns.length + (actions ? 1 : 0);
  const summary = loading || paging === undefined ? undefined : showing(paging, rows.length);
  const cell = cn('border-b', cellPadding[density]);

  function closeOnEscape(event: KeyboardEvent) {
    if (event.key === 'Escape') {
      setChoosing(false);
      columnsButton.current?.focus();
    }
  }

  return (
    <div className="flex flex-col gap-2">
      <div className="flex flex-wrap items-center justify-end gap-2">
        <div role="group" aria-label="Density" className="flex gap-1">
          {densities.map(({ value, label }) => (
            <Button
              key={value}
              type="button"
              variant={density === value ? 'secondary' : 'ghost'}
              size="sm"
              aria-pressed={density === value}
              onClick={() => {
                setDensity(value);
              }}
            >
              {label}
            </Button>
          ))}
        </div>
        <div className="relative">
          <Button
            ref={columnsButton}
            type="button"
            variant="outline"
            size="sm"
            aria-expanded={choosing}
            aria-controls={`${id}-columns`}
            onClick={() => {
              setChoosing(!choosing);
            }}
          >
            Columns
          </Button>
          <fieldset
            id={`${id}-columns`}
            hidden={!choosing}
            onKeyDown={closeOnEscape}
            className="bg-popover text-popover-foreground absolute right-0 z-20 mt-1 flex min-w-40 flex-col gap-1 rounded-md border p-2 shadow-md"
          >
            <legend className="sr-only">Visible columns</legend>
            {table.getAllLeafColumns().map((column) => (
              <label key={column.id} className="flex items-center gap-2 text-sm">
                <input
                  type="checkbox"
                  checked={column.getIsVisible()}
                  disabled={column.getIsVisible() && visibleColumns.length === 1}
                  onChange={column.getToggleVisibilityHandler()}
                />
                {typeof column.columnDef.header === 'string' ? column.columnDef.header : column.id}
              </label>
            ))}
          </fieldset>
        </div>
      </div>
      <table
        className="w-full text-sm"
        data-density={density}
        aria-busy={loading || undefined}
        aria-describedby={summary === undefined ? undefined : `${id}-showing`}
      >
        {loading && <caption className="sr-only">Loading…</caption>}
        <thead>
          {table.getHeaderGroups().map((group) => (
            <tr key={group.id}>
              {group.headers.map((header) => (
                <th key={header.id} className={cn('bg-background sticky top-0 z-10 text-left font-medium', cell)}>
                  {header.isPlaceholder ? null : <table.FlexRender header={header} />}
                </th>
              ))}
              {actions && (
                <th className={cn('bg-background sticky top-0 z-10', cell)}>
                  <span className="sr-only">Actions</span>
                </th>
              )}
            </tr>
          ))}
        </thead>
        <tbody>
          {loading &&
            skeletonRows.map((row) => (
              <tr key={row} aria-hidden="true">
                {visibleColumns.map((column) => (
                  <td key={column.id} className={cell}>
                    <Skeleton className="h-4 w-full" />
                  </td>
                ))}
                {actions && <td className={cell} />}
              </tr>
            ))}
          {!loading &&
            rows.map((row) => (
              <tr key={row.id} className="group hover:bg-muted/50">
                {row.getVisibleCells().map((rowCell) => (
                  <td key={rowCell.id} className={cell}>
                    <table.FlexRender cell={rowCell} />
                  </td>
                ))}
                {actions && (
                  <td className={cell}>
                    <div className="flex justify-end gap-1 opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100 pointer-coarse:opacity-100">
                      {actions(row.original)}
                    </div>
                  </td>
                )}
              </tr>
            ))}
          {!loading && rows.length === 0 && empty !== undefined && (
            <tr>
              <td colSpan={span} className="p-2">
                {empty}
              </td>
            </tr>
          )}
        </tbody>
      </table>
      {summary !== undefined && (
        <p id={`${id}-showing`} className="text-muted-foreground text-caption">
          {summary}
        </p>
      )}
    </div>
  );
}
{{~ else ~}}
import { type ColumnDef, type RowData, useTable } from '@tanstack/react-table';
import { features, type Features } from './data-table-columns';
{{~ if css_modules ~}}
import styles from './data-table.module.css';
{{~ end ~}}

interface DataTableProps<TRow extends RowData> {
  columns: ColumnDef<Features, TRow, unknown>[];
  data: TRow[];
}

/** A plain table over TanStack Table; keep columns and data stable (module scope or memoised). */
export function DataTable<TRow extends RowData>({ columns, data }: DataTableProps<TRow>) {
  const table = useTable({ features, columns, data });

  return (
    <table {{ class_of "w-full text-sm" "table" }}>
      <thead>
        {table.getHeaderGroups().map((group) => (
          <tr key={group.id}>
            {group.headers.map((header) => (
              <th key={header.id} {{ class_of "border-b p-2 text-left font-medium" "header" }}>
                {header.isPlaceholder ? null : <table.FlexRender header={header} />}
              </th>
            ))}
          </tr>
        ))}
      </thead>
      <tbody>
        {table.getRowModel().rows.map((row) => (
          <tr key={row.id}>
            {row.getAllCells().map((cell) => (
              <td key={cell.id} {{ class_of "border-b p-2" "cell" }}>
                <table.FlexRender cell={cell} />
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  );
}
{{~ end ~}}
{{~ end ~}}
