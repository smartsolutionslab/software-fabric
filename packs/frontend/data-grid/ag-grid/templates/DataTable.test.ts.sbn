import { render, screen } from '@testing-library/vue';
import { expect, test } from 'vitest';
import DataTable from './DataTable.vue';
import { columnsOf } from './data-table-columns';

interface Person {
  name: string;
}

const people = columnsOf<Person>();
const columns = people.columns([people.accessor('name', { header: 'Name' })]);
const data: Person[] = [{ name: 'first' }, { name: 'second' }];

// The file's first test: one row, but it pays for warming up jsdom, Vue and AG Grid, which under parallel load
// approaches the default 5 s.
test('the table shows a header and one row per item', { timeout: 20_000 }, async () => {
  // A generic component is rendered for one row type, as a template does it from its props.
  render(DataTable<Person>, { props: { columns, data } });

  // AG Grid renders after mounting, so the first query waits for it.
  expect(await screen.findByRole('columnheader', { name: 'Name' })).toBeInTheDocument();
  expect(screen.getAllByRole('row')).toHaveLength(3);
});
