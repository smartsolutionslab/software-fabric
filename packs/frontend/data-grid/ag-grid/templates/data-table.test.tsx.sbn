import { cleanup, render, screen } from '@testing-library/react';
import { afterEach, expect, test } from 'vitest';
import { DataTable } from './data-table';
import { columnsOf } from './data-table-columns';

interface Person {
  name: string;
}

const people = columnsOf<Person>();
const columns = people.columns([people.accessor('name', { header: 'Name' })]);
const data: Person[] = [{ name: 'first' }, { name: 'second' }];

// Vitest runs without globals, so Testing Library cannot register its own cleanup. Unmounting destroys the grid, which
// cancels its timers before jsdom is torn down.
afterEach(cleanup);

// The file's first test: one row, but it pays for warming up jsdom, React and AG Grid, which under parallel load
// approaches the default 5 s.
test('the table shows a header and one row per item', { timeout: 20_000 }, async () => {
  render(<DataTable columns={columns} data={data} />);

  // AG Grid renders after mounting, so the first query waits for it.
  expect(await screen.findByRole('columnheader', { name: 'Name' })).toBeInTheDocument();
  expect(screen.getAllByRole('row')).toHaveLength(3);
});
