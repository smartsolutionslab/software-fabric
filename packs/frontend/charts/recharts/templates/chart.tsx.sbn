{{~ themed = object.has_key(project, "frontend.ui-library") && project["frontend.ui-library"] == "shadcn" ~}}
import type { ReactElement } from 'react';
import { ResponsiveContainer } from 'recharts';

interface ChartProps {
  /** One Recharts chart (BarChart, LineChart, PieChart, …), drawn as wide as the container and as high as height. */
  children: ReactElement;
  label: string;
  height?: number;
}

{{~ if themed ~}}
// Recharts draws its axes, grid and tooltip in fixed colours: these take the theme's, so they follow dark mode too.
const themed = [
  '[&_.recharts-cartesian-axis-tick_text]:fill-muted-foreground',
  '[&_.recharts-cartesian-axis-line]:stroke-border',
  '[&_.recharts-cartesian-grid_line]:stroke-border',
  '[&_.recharts-legend-item-text]:text-foreground!',
  '[&_.recharts-default-tooltip]:border-border! [&_.recharts-default-tooltip]:bg-popover!',
].join(' ');

/** A Recharts chart in the theme's colours, which follows dark mode; label names it for screen readers. */
export function Chart({ children, label, height = 320 }: ChartProps) {
  return (
    <div role="img" aria-label={label} className={themed}>
{{~ else ~}}
/** A Recharts chart; label names it for screen readers. */
export function Chart({ children, label, height = 320 }: ChartProps) {
  return (
    <div role="img" aria-label={label}>
{{~ end ~}}
      <ResponsiveContainer width="100%" height={height}>
        {children}
      </ResponsiveContainer>
    </div>
  );
}
