<script setup lang="ts">
import { type ChartConfiguration, Chart as ChartJs } from 'chart.js/auto';
import { Chart } from 'vue-chartjs';

// A chart fills its container, which is as high as the height it is given, rather than keeping its own aspect ratio.
ChartJs.defaults.maintainAspectRatio = false;

interface ChartProps {
  config: ChartConfiguration;
  label: string;
  height?: number;
}

/** A Chart.js chart; label names it for screen readers. */
const { config, label, height = 320 } = defineProps<ChartProps>();
</script>

<template>
  <!-- vue-chartjs follows a change of data or options, not of type: another type is another chart. -->
  <div :key="config.type" :style="{ height: `${height}px` }">
    <Chart :type="config.type" :data="config.data" :options="config.options" role="img" :aria-label="label" />
  </div>
</template>
