import { render, screen } from '@testing-library/vue';
import type { EChartsOption } from 'echarts';
import { afterEach, beforeEach, expect, test, vi } from 'vitest';
import { defineComponent, h } from 'vue';
import DataChart from './DataChart.vue';

// ECharts draws on a canvas jsdom does not have: the test reads the theme the chart is given instead.
const drawn = vi.hoisted(() => ({ props: undefined as { theme?: unknown; option?: unknown } | undefined }));
vi.mock('vue-echarts', () => ({
  default: defineComponent({
    props: { option: Object, theme: Object, autoresize: Boolean },
    setup(props) {
      drawn.props = props;
      return () => h('div');
    },
  }),
}));

const palettes = `
:root {
  --chart-1: rgb(1, 1, 1);
  --chart-2: rgb(2, 2, 2);
  --chart-3: rgb(3, 3, 3);
  --chart-4: rgb(4, 4, 4);
  --chart-5: rgb(5, 5, 5);
  --foreground: rgb(10, 10, 10);
  --muted-foreground: rgb(100, 100, 100);
  --border: rgb(200, 200, 200);
}
.dark {
  --chart-1: rgb(201, 201, 201);
  --foreground: rgb(250, 250, 250);
  --border: rgb(50, 50, 50);
}`;

const revenue: EChartsOption = { xAxis: { type: 'category', data: ['January'] }, yAxis: {}, series: [{ type: 'bar', data: [3] }] };

let style: HTMLStyleElement;

beforeEach(() => {
  style = document.createElement('style');
  style.textContent = palettes;
  document.head.append(style);
});

afterEach(() => {
  style.remove();
  document.documentElement.removeAttribute('class');
});

test("a chart draws its series in the theme's --chart-1…5 and its text and lines in the theme's colours", () => {
  render(DataChart, { props: { option: revenue, label: 'Revenue per month' } });

  expect(screen.getByRole('img', { name: 'Revenue per month' })).toBeInTheDocument();
  expect(drawn.props?.option).toStrictEqual(revenue);
  expect(drawn.props?.theme).toMatchObject({
    color: ['rgb(1, 1, 1)', 'rgb(2, 2, 2)', 'rgb(3, 3, 3)', 'rgb(4, 4, 4)', 'rgb(5, 5, 5)'],
    backgroundColor: 'transparent',
    textStyle: { color: 'rgb(10, 10, 10)' },
    categoryAxis: { axisLabel: { color: 'rgb(100, 100, 100)' }, splitLine: { lineStyle: { color: ['rgb(200, 200, 200)'] } } },
    valueAxis: { axisLabel: { color: 'rgb(100, 100, 100)' }, splitLine: { lineStyle: { color: ['rgb(200, 200, 200)'] } } },
  });
});

test('a chart follows the theme into dark mode and back', async () => {
  render(DataChart, { props: { option: revenue, label: 'Revenue per month' } });

  document.documentElement.classList.add('dark');
  await vi.waitFor(() => {
    expect(drawn.props?.theme).toMatchObject({ color: ['rgb(201, 201, 201)', 'rgb(2, 2, 2)', 'rgb(3, 3, 3)', 'rgb(4, 4, 4)', 'rgb(5, 5, 5)'], textStyle: { color: 'rgb(250, 250, 250)' } });
  });

  document.documentElement.classList.remove('dark');
  await vi.waitFor(() => {
    expect(drawn.props?.theme).toMatchObject({ color: ['rgb(1, 1, 1)', 'rgb(2, 2, 2)', 'rgb(3, 3, 3)', 'rgb(4, 4, 4)', 'rgb(5, 5, 5)'], textStyle: { color: 'rgb(10, 10, 10)' } });
  });
});
