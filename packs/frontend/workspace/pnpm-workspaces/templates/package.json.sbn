{
  "name": "{{ name }}-web",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test"
  }{{ if slots["web.pnpm-overrides"] != "" }},
  "pnpm": {
    "overrides": {
{{ slots["web.pnpm-overrides"] }}
    }
  }{{ end }}
}
