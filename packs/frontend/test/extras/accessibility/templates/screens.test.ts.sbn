{{~ screen = project["frontend.framework"] == "vue" ? "Page.vue" : "Page.tsx" ~}}
{{~ check = project["frontend.framework"] == "vue" ? "Page.axe.test.ts" : "Page.axe.test.tsx" ~}}
import { expect, test } from 'vitest';

// Every module screen, <Name>{{ screen }}, has its axe check beside it in <Name>{{ check }} (AGENTS.md): add-module
// generates it with a module's page, and a screen written by hand gets one too. An axe assertion in another test does
// not count, since it can be skipped or commented out.
const screens = Object.keys(import.meta.glob('./modules/**/*{{ screen }}'));
const checks = import.meta.glob<string>('./modules/**/*{{ check }}', {
  query: '?raw',
  import: 'default',
  eager: true,
});

test('every module screen has an axe check beside it', () => {
  const unchecked = screens.filter(
    (screen) => !checks[screen.replace(/{{ screen | string.replace "." "\\." }}$/, '{{ check }}')]?.includes('toHaveNoViolations()'),
  );

  expect(unchecked, 'module screens without <Name>{{ check }} checking them with axe').toEqual([]);
});
