{{~ screen = project["frontend.framework"] == "vue" ? "Page.vue" : "Page.tsx" ~}}
{{~ test = project["frontend.framework"] == "vue" ? "Page.test.ts" : "Page.test.tsx" ~}}
import { expect, test } from 'vitest';

// AGENTS.md asks for an axe check in the component test of every new screen; a module's screen, <Name>{{ screen }}, has
// that test beside it, <Name>{{ test }}.
const screens = Object.keys(import.meta.glob('./modules/**/*{{ screen }}'));
const tests = import.meta.glob<string>('./modules/**/*{{ test }}', {
  query: '?raw',
  import: 'default',
  eager: true,
});

test('every module screen has an axe check in the component test beside it', () => {
  const unchecked = screens.filter(
    (screen) => !tests[screen.replace(/{{ screen | string.replace "." "\\." }}$/, '{{ test }}')]?.includes('toHaveNoViolations()'),
  );

  expect(unchecked, 'module screens without <Name>{{ test }} checking them with axe').toEqual([]);
});
