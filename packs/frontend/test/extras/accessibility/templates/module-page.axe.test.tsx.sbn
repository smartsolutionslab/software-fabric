{{~ editor = module.name == "dashboards" && object.has_key(project, "frontend.dashboards") && array.contains(project["frontend.dashboards"], "user-editable") && project["frontend.api-client"] == "rtk-query-codegen" ~}}
{{~ tanstack = project["frontend.routing"] == "tanstack-router" ~}}
{{~ client = object.has_key(project, "frontend.api-client") ? project["frontend.api-client"] : "" ~}}
{{~ stands_in = client == "rtk-query-codegen" || client == "orval" ~}}
import { cleanup, render, screen } from '@testing-library/react';
{{~ if tanstack ~}}
import { createMemoryHistory, RouterProvider } from '@tanstack/react-router';
{{~ else ~}}
import { MemoryRouter } from 'react-router';
{{~ end ~}}
import { afterEach, expect, test, vi } from 'vitest';
import { axe } from 'vitest-axe';
{{~ if tanstack ~}}
import { App } from '@/App';
import { createAppRouter } from '@/router';
{{~ end ~}}
{{~ if stands_in ~}}
import { examples } from './{{ module.namespace }}Page.data';
{{~ end ~}}
{{~ if !tanstack ~}}
import { {{ module.namespace }}Page } from './{{ module.namespace }}Page';
{{~ end ~}}

// The screen's axe check, generated with it. It runs whatever the screen's own component test does, so a check skipped
// or commented out there never leaves the screen unchecked.
{{~ if editor ~}}

// The page is the dashboard editor, which needs the store and the generated client; its own test checks it with axe on
// its data. Here it stands in, so this test checks the page around it.
vi.mock('@/dashboards/DashboardEditor', () => ({ DashboardEditor: () => <p>The dashboard editor</p> }));
{{~ end ~}}
{{~ if stands_in ~}}

// The page renders on its own, without {{ if client == "orval" }}a query client{{ else }}the store{{ end }} or the host. Each hook of the generated client answers
// as if its request were still on its way or, once the page is shown with its data, with its example in the data file.
const shown = vi.hoisted(() => ({ withExamples: false }));
vi.mock('@/api/generated', async (importOriginal) => {
  const { examples } = await import('@/modules/{{ module.name }}/{{ module.namespace }}Page.data');
{{~ if client == "orval" ~}}
  const state = (data: unknown, loading: boolean) => ({
    data,
    error: null,
    isLoading: loading,
    isPending: loading,
    isFetching: loading,
    isSuccess: !loading,
    isError: false,
    status: loading ? 'pending' : 'success',
    refetch: vi.fn(),
    mutate: vi.fn(),
    mutateAsync: vi.fn(),
  });
  const answer = (hook: string) =>
    shown.withExamples && hook in examples ? state(examples[hook], false) : state(undefined, true);
  const generated = await importOriginal<Record<string, unknown>>();
  return Object.fromEntries(
    Object.entries(generated).map(([name, value]) => [name, /^use[A-Z]/.test(name) ? () => answer(name) : value]),
  );
{{~ else ~}}
  const state = (data: unknown, loading: boolean) => ({
    data,
    currentData: data,
    error: undefined,
    isLoading: loading,
    isFetching: loading,
    isSuccess: !loading,
    isError: false,
  });
  const answer = (hook: string) =>
    shown.withExamples && hook in examples ? state(examples[hook], false) : state(undefined, true);
  const generated = await importOriginal<Record<string, unknown>>();
  return Object.fromEntries(
    Object.entries(generated).map(([name, value]) => {
      if (/^use\w*Mutation$/.test(name)) {
        return [name, () => [vi.fn(), state(undefined, true)]];
      }
      if (/^useLazy\w*Query$/.test(name)) {
        return [name, () => [vi.fn(), answer(name)]];
      }
      return [name, /^use\w*Query$/.test(name) ? () => answer(name) : value];
    }),
  );
{{~ end ~}}
});
{{~ end ~}}

// Whatever else asks the host waits for an answer that never comes.
vi.stubGlobal('fetch', () => new Promise<Response>(() => undefined));

// Without Vitest's globals, Testing Library does not unmount between tests by itself.
afterEach(cleanup);

async function renderPage() {
{{~ if tanstack ~}}
  const { container } = render(
    <RouterProvider router={createAppRouter(createMemoryHistory({ initialEntries: ['/{{ module.name }}'] }), <App />)} />,
  );
{{~ else ~}}
  const { container } = render(
    <MemoryRouter>
      <{{ module.namespace }}Page />
    </MemoryRouter>,
  );
{{~ end ~}}
{{~ if editor ~}}
  expect(await screen.findByText('The dashboard editor')).toBeInTheDocument();
{{~ else ~}}
  expect(await screen.findByRole('heading', { name: '{{ module.namespace }}' })).toBeInTheDocument();
{{~ end ~}}
  return container;
}

// Whichever test renders first in a file also pays for warming up jsdom, React and axe, which in a larger project under
// parallel load passes 2.5 s of the default 5 s.
test('the {{ module.namespace }} page has no accessibility violations axe can find', { timeout: 20_000 }, async () => {
  const container = await renderPage();

  expect(await axe(container)).toHaveNoViolations();
});
{{~ if stands_in ~}}

// Until {{ module.namespace }}Page.data.ts has an example (AGENTS.md), the page is checked only as it loads.
test.runIf(Object.keys(examples).length > 0)('the {{ module.namespace }} page passes axe with its example data', async () => {
  shown.withExamples = true;
  const container = await renderPage();

  expect(await axe(container)).toHaveNoViolations();
});
{{~ end ~}}
