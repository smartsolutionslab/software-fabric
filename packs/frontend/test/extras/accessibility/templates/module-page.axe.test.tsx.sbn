{{~ # Prettier prints a statement on one line when it fits the web app's printWidth (120) and breaks it when it does not, so
    # every line the module's name lengthens is written the way Prettier prints it at that length. ~}}
{{~ func fits(indent, line)
  ret indent + (line | string.size) <= 120
end ~}}
{{~ func braces(indent, before, entries, after)
  line = before + "{ " + (entries | array.join ", ") + " }" + after
  if fits(indent, line)
    ret line
  end
  pad = "  "
  ret before + "{\n" + pad + (entries | array.join (",\n" + pad)) + ",\n}" + after
end ~}}
{{~ func assign(indent, head, value)
  if fits(indent, head + " " + value)
    ret head + " " + value
  end
  ret head + "\n  " + value
end ~}}
{{~ # A test's call: on one line when its head fits, else one argument per line, the callback's body indented once more. ~}}
{{~ func test_call(head, arguments, callback, body)
  line = head + "(" + (arguments | array.join ", ") + ", " + callback + " {"
  if fits(0, line)
    ret line + "\n" + body + "});"
  end
  ret head + "(\n  " + (arguments | array.join ",\n  ") + ",\n  " + callback + " {\n" + (regex.replace body "(?m)^(?=.)" "  ") + "  },\n);"
end ~}}
{{~ editor = module.name == "dashboards" && object.has_key(project, "frontend.dashboards") && array.contains(project["frontend.dashboards"], "user-editable") && project["frontend.api-client"] == "rtk-query-codegen" ~}}
{{~ tanstack = project["frontend.routing"] == "tanstack-router" ~}}
{{~ client = object.has_key(project, "frontend.api-client") ? project["frontend.api-client"] : "" ~}}
{{~ stands_in = client == "rtk-query-codegen" || client == "orval" ~}}
{{~ # Without the generated client's hooks, the module's sample page (#734) reads its samples through its own hook, which stands in. ~}}
{{~ sample_page = project["frontend.architecture"] == "spa" && object.has_key(project, "frontend.ui-library") && (project["frontend.ui-library"] == "shadcn" || project["frontend.ui-library"] == "shadcn-vue") && object.has_key(project, "frontend.api-client") && (project["frontend.api-client"] == "rtk-query-codegen" || project["frontend.api-client"] == "orval" || project["frontend.api-client"] == "openapi-fetch") && module.name != "dashboards" && module.name != "assistant" ~}}
{{~ samples_hook = !stands_in && sample_page ~}}
{{~ with_data = stands_in || samples_hook ~}}
{{~ probe = !stands_in && object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
{{~ signed_in = object.has_key(project, "frontend.auth-client") ~}}
{{~ themes = slots["web.axe-themes"] ~}}
{{~ if probe ~}}
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
{{~ end ~}}
import { cleanup, render } from '@testing-library/react';
{{~ if tanstack ~}}
import { createMemoryHistory, RouterProvider } from '@tanstack/react-router';
{{~ else ~}}
import { MemoryRouter } from 'react-router';
{{~ end ~}}
import { afterEach, expect, test, vi } from 'vitest';
import { axe } from 'vitest-axe';
{{~ if tanstack ~}}
import { App } from '@/App';
{{~ end ~}}
{{~ if signed_in ~}}
import { SignedInAsDeveloper } from '@/auth/SignedInAsDeveloper';
{{~ end ~}}
{{~ if tanstack ~}}
import { createAppRouter } from '@/router';
{{~ end ~}}
{{~ if with_data ~}}
import * as data from './{{ module.namespace }}Page.data';
{{~ end ~}}
{{~ if !tanstack ~}}
import { {{ module.namespace }}Page } from './{{ module.namespace }}Page';
{{~ end ~}}

// The screen's axe check, generated with it. It runs whatever the screen's own component test does, so a check skipped
// or commented out there never leaves the screen unchecked. It asks nothing of what the screen shows, only that axe
// finds no violations in it: what the screen does is its own tests'.
{{~ if editor ~}}

// The page is the dashboard editor, which needs the store and the generated client; its own test checks it with axe on
// its data. Here it stands in, so this test checks the page around it.
vi.mock('@/dashboards/DashboardEditor', () => ({ DashboardEditor: () => <p>The dashboard editor</p> }));
{{~ end ~}}
{{~ if stands_in ~}}

// The page renders on its own, without {{ if client == "orval" }}a query client{{ else }}the store{{ end }} or the host. Each hook of the generated client answers
// as if its request were still on its way or, once the page is shown with data, with its example in the data file:
// examples, or emptyExamples for the page with nothing to show.
const shown = vi.hoisted(() => ({ examples: undefined as Record<string, unknown> | undefined }));
vi.mock('@/api/generated', async (importOriginal) => {
{{~ if client == "orval" ~}}
  const state = (data: unknown, loading: boolean) => ({
    data,
    error: null,
    isLoading: loading,
    isPending: loading,
    isFetching: loading,
    isSuccess: !loading,
    isError: false,
    status: loading ? 'pending' : 'success',
    refetch: vi.fn(),
    mutate: vi.fn(),
    mutateAsync: vi.fn(),
  });
  const answer = (hook: string) =>
    shown.examples !== undefined && hook in shown.examples
      ? state(shown.examples[hook], false)
      : state(undefined, true);
  // A mutation nobody has triggered is idle, not saving: the page shows as it first does.
  const idle = {
    data: undefined,
    error: null,
    isIdle: true,
    isPending: false,
    isSuccess: false,
    isError: false,
    status: 'idle',
    mutate: vi.fn(),
    mutateAsync: vi.fn(),
    reset: vi.fn(),
  };
  const generated = await importOriginal<Record<string, unknown>>();
  const isMutation = (hook: string) => `get${hook.slice('use'.length)}MutationOptions` in generated;
  return Object.fromEntries(
    Object.entries(generated).map(([name, value]) => {
      if (!/^use[A-Z]/.test(name)) {
        return [name, value];
      }
      return [name, isMutation(name) ? () => idle : () => answer(name)];
    }),
  );
{{~ else ~}}
  const state = (data: unknown, loading: boolean) => ({
    data,
    currentData: data,
    error: undefined,
    isLoading: loading,
    isFetching: loading,
    isSuccess: !loading,
    isError: false,
  });
  const answer = (hook: string) =>
    shown.examples !== undefined && hook in shown.examples
      ? state(shown.examples[hook], false)
      : state(undefined, true);
  // A mutation nobody has triggered is idle, not saving: the page shows as it first does.
  const idle = {
    data: undefined,
    error: undefined,
    isUninitialized: true,
    isLoading: false,
    isSuccess: false,
    isError: false,
    reset: vi.fn(),
  };
  const generated = await importOriginal<Record<string, unknown>>();
  return Object.fromEntries(
    Object.entries(generated).map(([name, value]) => {
      if (/^use\w*Mutation$/.test(name)) {
        return [name, () => [vi.fn(), idle]];
      }
      if (/^useLazy\w*Query$/.test(name)) {
        return [name, () => [vi.fn(), answer(name)]];
      }
      return [name, /^use\w*Query$/.test(name) ? () => answer(name) : value];
    }),
  );
{{~ end ~}}
});
{{~ end ~}}
{{~ if samples_hook ~}}

// The page renders on its own, without a query client or the host. Its samples answer as if their request were still on
// its way or, once the page is shown with data, with the example in the data file: examples, or emptyExamples for the
// page with nothing to show.
const shown = vi.hoisted(() => ({ examples: undefined as Record<string, unknown> | undefined }));
vi.mock('./use{{ module.namespace }}Samples', () => ({
  use{{ module.namespace }}Samples: () => {
    {{ assign 4 ("const page = shown.examples?.use" + module.namespace + "Samples as") "{ items: unknown[] } | undefined;" }}
    return page === undefined
      ? { samples: undefined, isLoading: true, isError: false }
      : { samples: page.items, isLoading: false, isError: false };
  },
  {{ braces 2 ("useCreate" + module.namespace + "Sample: () => (") ["create: vi.fn()", "isSaving: false"] ")," }}
}));
{{~ end ~}}

{{~ if with_data ~}}
const { examples } = data;
// A data file written before it had an empty example has none: the page is then not checked with nothing to show.
const emptyExamples = (data as { emptyExamples?: Record<string, unknown> }).emptyExamples ?? {};

{{~ end ~}}
// Whatever else asks the host waits for an answer that never comes.
vi.stubGlobal('fetch', () => new Promise<Response>(() => undefined));

// Without Vitest's globals, Testing Library does not unmount between tests by itself.
afterEach(cleanup);
{{~ if with_data ~}}
afterEach(() => {
  shown.examples = undefined;
});
{{~ end ~}}
{{~ if themes != "" ~}}

// The app's other themes: each check runs again in each, switched on as the app switches it before the screen renders.
const themes = [
{{ themes }},
];

afterEach(() => {
  document.documentElement.removeAttribute('class');
  localStorage.clear();
});
{{~ end ~}}

{{~ if tanstack ~}}
// The router resolves the screen's route before the app renders, so the screen has rendered when render returns.
{{~ if signed_in ~}}
// The screen renders for the local user developer, signed in, without the sign-in provider: the check sees the screen
// as the developer does.
{{~ end ~}}
{{~ if probe ~}}
// The page's permission probe asks through a query client, and never hears back: the page shows as it loads.
{{~ end ~}}
async function renderPage() {
  const router = createAppRouter(createMemoryHistory({ initialEntries: ['/{{ module.name }}'] }), <App />);
  await router.load();
{{~ if probe && signed_in ~}}
  return render(
    <QueryClientProvider client={new QueryClient()}>
      <SignedInAsDeveloper>
        <RouterProvider router={router} />
      </SignedInAsDeveloper>
    </QueryClientProvider>,
  ).container;
{{~ else if probe ~}}
  return render(
    <QueryClientProvider client={new QueryClient()}>
      <RouterProvider router={router} />
    </QueryClientProvider>,
  ).container;
{{~ else if signed_in ~}}
  return render(
    <SignedInAsDeveloper>
      <RouterProvider router={router} />
    </SignedInAsDeveloper>,
  ).container;
{{~ else ~}}
  return render(<RouterProvider router={router} />).container;
{{~ end ~}}
}
{{~ else ~}}
// The screen has rendered when render returns.
{{~ if signed_in ~}}
// The screen renders for the local user developer, signed in, without the sign-in provider: the check sees the screen
// as the developer does.
{{~ end ~}}
{{~ if probe ~}}
// The page's permission probe asks through a query client, and never hears back: the page shows as it loads.
function renderPage() {
  return render(
    <QueryClientProvider client={new QueryClient()}>
{{~ if signed_in ~}}
      <SignedInAsDeveloper>
        <MemoryRouter>
          <{{ module.namespace }}Page />
        </MemoryRouter>
      </SignedInAsDeveloper>
{{~ else ~}}
      <MemoryRouter>
        <{{ module.namespace }}Page />
      </MemoryRouter>
{{~ end ~}}
    </QueryClientProvider>,
  ).container;
}
{{~ else ~}}
function renderPage() {
  return render(
{{~ if signed_in ~}}
    <SignedInAsDeveloper>
      <MemoryRouter>
        <{{ module.namespace }}Page />
      </MemoryRouter>
    </SignedInAsDeveloper>,
{{~ else ~}}
    <MemoryRouter>
      <{{ module.namespace }}Page />
    </MemoryRouter>,
{{~ end ~}}
  ).container;
}
{{~ end ~}}
{{~ end ~}}

// Whichever test renders first in a file also pays for warming up jsdom, React and axe, which in a larger project under
// parallel load passes 2.5 s of the default 5 s.
{{~ capture body ~}}
  const container = {{ if tanstack }}await {{ end }}renderPage();

  expect(await axe(container)).toHaveNoViolations();
{{~ end ~}}
{{ test_call "test" ["'the " + module.namespace + " page has no accessibility violations axe can find'", "{ timeout: 20_000 }"] "async () =>" body }}
{{~ if themes != "" ~}}

test.each(themes)(
  'the {{ module.namespace }} page has no accessibility violations axe can find in the $name theme',
  async ({ switchOn }) => {
    switchOn();
    const container = {{ if tanstack }}await {{ end }}renderPage();

    expect(await axe(container)).toHaveNoViolations();
  },
);
{{~ end ~}}
{{~ if with_data ~}}

// Until {{ module.namespace }}Page.data.ts has an example (AGENTS.md), the page is checked only as it loads.
{{~ capture body ~}}
  shown.examples = examples;
  const container = {{ if tanstack }}await {{ end }}renderPage();

  expect(await axe(container)).toHaveNoViolations();
{{~ end ~}}
{{ test_call "test.runIf(Object.keys(examples).length > 0)" ["'the " + module.namespace + " page passes axe with its example data'"] "async () =>" body }}
{{~ if themes != "" ~}}

test.runIf(Object.keys(examples).length > 0).each(themes)(
  'the {{ module.namespace }} page passes axe with its example data in the $name theme',
  async ({ switchOn }) => {
    shown.examples = examples;
    switchOn();
    const container = {{ if tanstack }}await {{ end }}renderPage();

    expect(await axe(container)).toHaveNoViolations();
  },
);
{{~ end ~}}

// Until {{ module.namespace }}Page.data.ts has an empty example (AGENTS.md), the page is not checked with nothing to show.
{{~ capture body ~}}
  shown.examples = emptyExamples;
  const container = {{ if tanstack }}await {{ end }}renderPage();

  expect(await axe(container)).toHaveNoViolations();
{{~ end ~}}
{{ test_call "test.runIf(Object.keys(emptyExamples).length > 0)" ["'the " + module.namespace + " page passes axe when it has nothing to show'"] "async () =>" body }}
{{~ if themes != "" ~}}

test.runIf(Object.keys(emptyExamples).length > 0).each(themes)(
  'the {{ module.namespace }} page passes axe when it has nothing to show in the $name theme',
  async ({ switchOn }) => {
    shown.examples = emptyExamples;
    switchOn();
    const container = {{ if tanstack }}await {{ end }}renderPage();

    expect(await axe(container)).toHaveNoViolations();
  },
);
{{~ end ~}}
{{~ end ~}}
