{{~ editor = module.name == "dashboards" && object.has_key(project, "frontend.dashboards") && array.contains(project["frontend.dashboards"], "user-editable") && project["frontend.api-client"] == "orval" && (!object.has_key(project, "frontend.state") || project["frontend.state"] != "pinia") ~}}
{{~ stands_in = object.has_key(project, "frontend.api-client") && project["frontend.api-client"] == "orval" && (!object.has_key(project, "frontend.state") || project["frontend.state"] != "pinia") ~}}
{{~ # Without the generated client's hooks, the module's sample page (#734) reads its samples through its own composable, which stands in. ~}}
{{~ sample_page = project["frontend.architecture"] == "spa" && object.has_key(project, "frontend.ui-library") && (project["frontend.ui-library"] == "shadcn" || project["frontend.ui-library"] == "shadcn-vue") && object.has_key(project, "frontend.api-client") && (project["frontend.api-client"] == "rtk-query-codegen" || project["frontend.api-client"] == "orval" || project["frontend.api-client"] == "openapi-fetch") && module.name != "dashboards" && module.name != "assistant" ~}}
{{~ samples_hook = !stands_in && sample_page ~}}
{{~ with_data = stands_in || samples_hook ~}}
{{~ probe = !stands_in && object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
{{~ signed_in = object.has_key(project, "frontend.auth-client") ~}}
{{~ themes = slots["web.axe-themes"] ~}}
{{~ if probe && project["frontend.state"] != "pinia" ~}}
import { VueQueryPlugin } from '@tanstack/vue-query';
{{~ end ~}}
import { cleanup, render } from '@testing-library/vue';
{{~ if probe && project["frontend.state"] == "pinia" ~}}
import { createPinia } from 'pinia';
{{~ end ~}}
import { afterEach, expect, test, vi } from 'vitest';
import { axe } from 'vitest-axe';
import { createMemoryHistory } from 'vue-router';
{{~ if signed_in ~}}
import { signedInAsDeveloper } from '@/auth/signedInAsDeveloper';
{{~ end ~}}
import { createAppRouter } from '@/router';
{{~ if with_data ~}}
import * as data from './{{ module.namespace }}Page.data';
{{~ end ~}}
import {{ module.namespace }}Page from './{{ module.namespace }}Page.vue';

// The screen's axe check, generated with it. It runs whatever the screen's own component test does, so a check skipped
// or commented out there never leaves the screen unchecked. It asks nothing of what the screen shows, only that axe
// finds no violations in it: what the screen does is its own tests'.
{{~ if editor ~}}

// The page is the dashboard editor, which needs the query client and the generated client; its own test checks it with
// axe on its data. Here it stands in, so this test checks the page around it.
vi.mock('@/dashboards/DashboardEditor.vue', async () => {
  const { h } = await import('vue');
  return { default: { render: () => h('p', 'The dashboard editor') } };
});
{{~ end ~}}
{{~ if stands_in ~}}

// The page renders on its own, without a query client or the host. Each hook of the generated client answers as if its
// request were still on its way or, once the page is shown with data, with its example in the data file: examples, or
// emptyExamples for the page with nothing to show.
const shown = vi.hoisted(() => ({ examples: undefined as Record<string, unknown> | undefined }));
vi.mock('@/api/generated', async (importOriginal) => {
  const { ref } = await import('vue');
  const state = (data: unknown, loading: boolean) => ({
    data: ref(data),
    error: ref(null),
    isLoading: ref(loading),
    isPending: ref(loading),
    isFetching: ref(loading),
    isSuccess: ref(!loading),
    isError: ref(false),
    status: ref(loading ? 'pending' : 'success'),
    refetch: vi.fn(),
    mutate: vi.fn(),
    mutateAsync: vi.fn(),
  });
  const answer = (hook: string) =>
    shown.examples !== undefined && hook in shown.examples
      ? state(shown.examples[hook], false)
      : state(undefined, true);
  // A mutation nobody has triggered is idle, not saving: the page shows as it first does.
  const idle = () => ({
    data: ref(undefined),
    error: ref(null),
    isIdle: ref(true),
    isPending: ref(false),
    isSuccess: ref(false),
    isError: ref(false),
    status: ref('idle'),
    mutate: vi.fn(),
    mutateAsync: vi.fn(),
    reset: vi.fn(),
  });
  const generated = await importOriginal<Record<string, unknown>>();
  const isMutation = (hook: string) => `get${hook.slice('use'.length)}MutationOptions` in generated;
  return Object.fromEntries(
    Object.entries(generated).map(([name, value]) => {
      if (!/^use[A-Z]/.test(name)) {
        return [name, value];
      }
      return [name, isMutation(name) ? idle : () => answer(name)];
    }),
  );
});
{{~ end ~}}
{{~ if samples_hook ~}}

// The page renders on its own, without {{ if project["frontend.state"] == "pinia" }}a store{{ else }}a query client{{ end }} or the host. Its samples answer as if their request were still on
// its way or, once the page is shown with data, with the example in the data file: examples, or emptyExamples for the
// page with nothing to show.
const shown = vi.hoisted(() => ({ examples: undefined as Record<string, unknown> | undefined }));
vi.mock('./use{{ module.namespace }}Samples', () => ({
  use{{ module.namespace }}Samples: () => {
    const page = shown.examples?.use{{ module.namespace }}Samples as { items: unknown[] } | undefined;
    return page === undefined
      ? { samples: undefined, isLoading: true, isError: false }
      : { samples: page.items, isLoading: false, isError: false };
  },
  useCreate{{ module.namespace }}Sample: () => ({ create: vi.fn(), isSaving: false }),
}));
{{~ end ~}}
{{~ if with_data ~}}

const { examples } = data;
// A data file written before it had an empty example has none: the page is then not checked with nothing to show.
const emptyExamples = (data as { emptyExamples?: Record<string, unknown> }).emptyExamples ?? {};
{{~ end ~}}

// Whatever else asks the host waits for an answer that never comes.
vi.stubGlobal('fetch', () => new Promise<Response>(() => undefined));

// Without Vitest's globals, Testing Library does not unmount between tests by itself.
afterEach(cleanup);
{{~ if with_data ~}}
afterEach(() => {
  shown.examples = undefined;
});
{{~ end ~}}
{{~ if themes != "" ~}}

// The app's other themes: each check runs again in each, switched on as the app switches it before the screen renders.
const themes = [
{{ themes }},
];

afterEach(() => {
  document.documentElement.removeAttribute('class');
  localStorage.clear();
});
{{~ end ~}}

// The router is on the screen's route before it mounts, and the screen has rendered when render returns.
{{~ if signed_in ~}}
// The screen renders for the local user developer, signed in, without the sign-in plugin: the check sees the screen as
// the developer does.
{{~ end ~}}
{{~ if probe ~}}
// The page's permission probe asks through {{ if project["frontend.state"] == "pinia" }}a store{{ else }}a query client{{ end }}, and never hears back: the page shows as it loads.
{{~ end ~}}
async function renderPage() {
  const router = createAppRouter(createMemoryHistory());
  await router.push('/{{ module.name }}');

{{~ plugins = probe && project["frontend.state"] == "pinia" ? "router, createPinia()" : (probe ? "router, VueQueryPlugin" : "router") ~}}
{{~ if signed_in ~}}
  return render({{ module.namespace }}Page, {
    global: { plugins: [{{ plugins }}, signedInAsDeveloper] },
  }).container;
{{~ else ~}}
  return render({{ module.namespace }}Page, { global: { plugins: [{{ plugins }}] } }).container;
{{~ end ~}}
}

test('the {{ module.namespace }} page has no accessibility violations axe can find', async () => {
  const container = await renderPage();

  expect(await axe(container)).toHaveNoViolations();
});
{{~ if themes != "" ~}}

test.each(themes)(
  'the {{ module.namespace }} page has no accessibility violations axe can find in the $name theme',
  async ({ switchOn }) => {
    switchOn();
    const container = await renderPage();

    expect(await axe(container)).toHaveNoViolations();
  },
);
{{~ end ~}}
{{~ if with_data ~}}

// Until {{ module.namespace }}Page.data.ts has an example (AGENTS.md), the page is checked only as it loads.
test.runIf(Object.keys(examples).length > 0)('the {{ module.namespace }} page passes axe with its example data', async () => {
  shown.examples = examples;
  const container = await renderPage();

  expect(await axe(container)).toHaveNoViolations();
});
{{~ if themes != "" ~}}

test.runIf(Object.keys(examples).length > 0).each(themes)(
  'the {{ module.namespace }} page passes axe with its example data in the $name theme',
  async ({ switchOn }) => {
    shown.examples = examples;
    switchOn();
    const container = await renderPage();

    expect(await axe(container)).toHaveNoViolations();
  },
);
{{~ end ~}}

// Until {{ module.namespace }}Page.data.ts has an empty example (AGENTS.md), the page is not checked with nothing to show.
test.runIf(Object.keys(emptyExamples).length > 0)(
  'the {{ module.namespace }} page passes axe when it has nothing to show',
  async () => {
    shown.examples = emptyExamples;
    const container = await renderPage();

    expect(await axe(container)).toHaveNoViolations();
  },
);
{{~ if themes != "" ~}}

test.runIf(Object.keys(emptyExamples).length > 0).each(themes)(
  'the {{ module.namespace }} page passes axe when it has nothing to show in the $name theme',
  async ({ switchOn }) => {
    shown.examples = emptyExamples;
    switchOn();
    const container = await renderPage();

    expect(await axe(container)).toHaveNoViolations();
  },
);
{{~ end ~}}
{{~ end ~}}
