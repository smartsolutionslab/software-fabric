{{~ editor = module.name == "dashboards" && object.has_key(project, "frontend.dashboards") && array.contains(project["frontend.dashboards"], "user-editable") && project["frontend.api-client"] == "orval" && (!object.has_key(project, "frontend.state") || project["frontend.state"] != "pinia") ~}}
{{~ stands_in = object.has_key(project, "frontend.api-client") && project["frontend.api-client"] == "orval" && (!object.has_key(project, "frontend.state") || project["frontend.state"] != "pinia") ~}}
import { cleanup, render, screen } from '@testing-library/vue';
import { afterEach, expect, test, vi } from 'vitest';
import { axe } from 'vitest-axe';
import { createMemoryHistory } from 'vue-router';
import { createAppRouter } from '@/router';
{{~ if stands_in ~}}
import { examples } from './{{ module.namespace }}Page.data';
{{~ end ~}}
import {{ module.namespace }}Page from './{{ module.namespace }}Page.vue';

// The screen's axe check, generated with it. It runs whatever the screen's own component test does, so a check skipped
// or commented out there never leaves the screen unchecked.
{{~ if editor ~}}

// The page is the dashboard editor, which needs the query client and the generated client; its own test checks it with
// axe on its data. Here it stands in, so this test checks the page around it.
vi.mock('@/dashboards/DashboardEditor.vue', async () => {
  const { h } = await import('vue');
  return { default: { render: () => h('p', 'The dashboard editor') } };
});
{{~ end ~}}
{{~ if stands_in ~}}

// The page renders on its own, without a query client or the host. Each hook of the generated client answers as if its
// request were still on its way or, once the page is shown with its data, with its example in the data file.
const shown = vi.hoisted(() => ({ withExamples: false }));
vi.mock('@/api/generated', async (importOriginal) => {
  const { ref } = await import('vue');
  const { examples } = await import('@/modules/{{ module.name }}/{{ module.namespace }}Page.data');
  const state = (data: unknown, loading: boolean) => ({
    data: ref(data),
    error: ref(null),
    isLoading: ref(loading),
    isPending: ref(loading),
    isFetching: ref(loading),
    isSuccess: ref(!loading),
    isError: ref(false),
    status: ref(loading ? 'pending' : 'success'),
    refetch: vi.fn(),
    mutate: vi.fn(),
    mutateAsync: vi.fn(),
  });
  const answer = (hook: string) =>
    shown.withExamples && hook in examples ? state(examples[hook], false) : state(undefined, true);
  const generated = await importOriginal<Record<string, unknown>>();
  return Object.fromEntries(
    Object.entries(generated).map(([name, value]) => [name, /^use[A-Z]/.test(name) ? () => answer(name) : value]),
  );
});
{{~ end ~}}

// Whatever else asks the host waits for an answer that never comes.
vi.stubGlobal('fetch', () => new Promise<Response>(() => undefined));

// Without Vitest's globals, Testing Library does not unmount between tests by itself.
afterEach(cleanup);

async function renderPage() {
  const router = createAppRouter(createMemoryHistory());
  await router.push('/{{ module.name }}');

  const { container } = render({{ module.namespace }}Page, { global: { plugins: [router] } });
{{~ if editor ~}}
  expect(await screen.findByText('The dashboard editor')).toBeInTheDocument();
{{~ else ~}}
  expect(await screen.findByRole('heading', { name: '{{ module.namespace }}' })).toBeInTheDocument();
{{~ end ~}}
  return container;
}

test('the {{ module.namespace }} page has no accessibility violations axe can find', async () => {
  const container = await renderPage();

  expect(await axe(container)).toHaveNoViolations();
});
{{~ if stands_in ~}}

// Until {{ module.namespace }}Page.data.ts has an example (AGENTS.md), the page is checked only as it loads.
test.runIf(Object.keys(examples).length > 0)('the {{ module.namespace }} page passes axe with its example data', async () => {
  shown.withExamples = true;
  const container = await renderPage();

  expect(await axe(container)).toHaveNoViolations();
});
{{~ end ~}}
