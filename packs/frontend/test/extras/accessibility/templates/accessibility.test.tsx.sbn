{{~ if project["frontend.routing"] == "tanstack-router" ~}}
import { render, screen } from '@testing-library/react';
import { createMemoryHistory, RouterProvider } from '@tanstack/react-router';
import { expect, test } from 'vitest';
import { axe } from 'vitest-axe';
import { App } from './App';
import { createAppRouter } from './router';

// The file's first test also pays for warming up jsdom, React and whatever the app's providers load, which in a
// larger project under parallel load passes 2.5 s of the default 5 s.
test('the start page has no accessibility violations axe can find', { timeout: 20_000 }, async () => {
  const { container } = render(<RouterProvider router={createAppRouter(createMemoryHistory(), <App />)} />);
  await screen.findByRole('heading', { name: '{{ name }}' });

  expect(await axe(container)).toHaveNoViolations();
});
{{~ else ~}}
{{~ user_menu = project["frontend.ui-library"] == "shadcn" && project["frontend.architecture"] == "spa" && object.has_key(project, "frontend.auth-client") && project["frontend.auth-client"] == "oidc-client-ts" ~}}
import { render } from '@testing-library/react';
import { MemoryRouter } from 'react-router';
import { expect, test{{ if user_menu }}, vi{{ end }} } from 'vitest';
import { axe } from 'vitest-axe';
import { App } from './App';
{{~ if user_menu ~}}

// The user menu has its own test; here it stands in, so this test checks the start page.
vi.mock('@/auth/UserMenu', () => ({ UserMenu: () => <p>The user menu</p> }));
{{~ end ~}}

// The file's first test also pays for warming up jsdom, React and whatever the app's providers load, which in a
// larger project under parallel load passes 2.5 s of the default 5 s.
test('the start page has no accessibility violations axe can find', { timeout: 20_000 }, async () => {
  const { container } = render(
    <MemoryRouter>
      <App />
    </MemoryRouter>,
  );

  expect(await axe(container)).toHaveNoViolations();
});
{{~ end ~}}
