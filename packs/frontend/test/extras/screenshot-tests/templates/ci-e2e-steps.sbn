      # A screenshot that differs from its baseline: the baseline, what rendered and the difference between them.
      - if: failure()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: screenshot-diffs
          path: web/app/test-results/screenshots
          if-no-files-found: ignore
