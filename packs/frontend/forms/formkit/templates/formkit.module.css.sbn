{{~ tokens = project["frontend.design-system"] == "tokens" ~}}
{{~ func colour(token, value)
  if tokens
    ret "var(--ds-color-" + token + ")"
  end
  ret value
end ~}}
.outer,
.wrapper {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  line-height: 1;
  font-weight: 500;
  user-select: none;
}

.input {
  width: 100%;
  min-width: 0;
  height: 2.25rem;
  border: 1px solid {{ colour "border" "#cbd5e1" }};
  border-radius: 0.375rem;
  background-color: {{ colour "surface" "#fff" }};
  padding: 0.25rem 0.75rem;
  font: inherit;
  font-size: 0.875rem;
}

.input:focus-visible {
  outline: 2px solid {{ colour "primary" "#64748b" }};
  outline-offset: 2px;
}

.input:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

.outer[data-errors='true'] .input {
  border-color: {{ colour "destructive" "#dc2626" }};
}

.textarea {
  display: flex;
  field-sizing: content;
  height: auto;
  min-height: 4rem;
  padding: 0.5rem 0.75rem;
}

.help {
  font-size: 0.875rem;
  line-height: 1.25rem;
  color: {{ colour "muted-foreground" "#64748b" }};
}

.messages {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.message {
  margin: 0;
  font-size: 0.875rem;
  line-height: 1.25rem;
  color: {{ colour "destructive" "#dc2626" }};
}
