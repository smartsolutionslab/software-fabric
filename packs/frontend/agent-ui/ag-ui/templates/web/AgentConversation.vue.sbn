{{~ ui = project["frontend.ui-library"] ~}}
{{~ vuetify = ui == "vuetify" ~}}
{{~ css_modules = project["frontend.styling"] == "css-modules" && !vuetify ~}}
{{~ if ui == "reka-ui"
  button = "BaseButton"
  button_import = "import BaseButton from '@/components/ui/BaseButton.vue';"
  secondary = "outline"
else if vuetify
  button = "VBtn"
  button_import = "import { VBtn } from 'vuetify/components';"
  secondary = "tonal"
else
  button = "Button"
  button_import = "import { Button } from '@/components/ui/button';"
  secondary = "secondary"
end ~}}
{{~ if vuetify
  primary = ' color="primary"'
else
  primary = ""
end ~}}
{{~ func class_of(tailwind, module, material)
  if vuetify
    ret 'class="' + material + '"'
  end
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  ret 'class="' + tailwind + '"'
end ~}}
{{~ func form_class(tailwind)
  if css_modules
    ret ':form-class="styles.form"'
  end
  ret 'form-class="' + tailwind + '"'
end ~}}
{{~ func themed(shadcn, palette, module, material)
  if vuetify
    ret 'class="' + material + '"'
  end
  if css_modules
    ret ':class="styles.' + module + '"'
  end
  if ui == "reka-ui"
    ret 'class="' + palette + '"'
  end
  ret 'class="' + shadcn + '"'
end ~}}
{{~ if !((ui == "shadcn-vue" || ui == "reka-ui" || ui == "vuetify") && (project["frontend.forms"] == "vee-validate" || project["frontend.forms"] == "tanstack-form" || project["frontend.forms"] == "formkit")) || (project["frontend.validation"] != "zod" && project["frontend.validation"] != "valibot") ~}}
<script lang="ts">
throw new Error('The ag-ui pack builds the Vue agent panel from shadcn-vue, reka-ui or vuetify with vee-validate, TanStack Form or FormKit, and zod or valibot only so far; frontend.ui-library is {{ project["frontend.ui-library"] }}, frontend.forms is {{ project["frontend.forms"] }}, frontend.validation is {{ project["frontend.validation"] }} (docs/adr/0006 of the generator).');
</script>

{{~ end ~}}
{{~ valibot = project["frontend.validation"] == "valibot" ~}}
{{~ tanstack = project["frontend.forms"] == "tanstack-form" ~}}
{{~ formkit = project["frontend.forms"] == "formkit" ~}}
<script setup lang="ts">
import { contentToText } from '@ag-ui/client';
{{~ if formkit ~}}
import { FormKit } from '@formkit/vue';
{{~ if valibot ~}}
import * as v from 'valibot';
import { computed } from 'vue';
{{~ else ~}}
import { computed } from 'vue';
import { z } from 'zod';
{{~ end ~}}
{{ button_import }}
import { schemaSubmit } from '@/forms/schemaSubmit';
{{~ else if tanstack ~}}
import { revalidateLogic, useForm } from '@tanstack/vue-form';
{{~ if valibot ~}}
import * as v from 'valibot';
import { computed, useId } from 'vue';
{{~ else ~}}
import { computed, useId } from 'vue';
import { z } from 'zod';
{{~ end ~}}
{{ button_import }}
{{~ else if valibot ~}}
import * as v from 'valibot';
import { useForm } from 'vee-validate';
import { computed, useId } from 'vue';
{{~ else ~}}
import { useForm } from 'vee-validate';
import { computed, useId } from 'vue';
import { z } from 'zod';
{{~ end ~}}
{{~ if !tanstack && !formkit ~}}
{{ button_import }}
import { toTypedSchema } from '@/forms/toTypedSchema';
{{~ end ~}}
import { useAgent } from './useAgent';
{{~ if css_modules ~}}
import styles from './AgentConversation.module.css';
{{~ end ~}}

/** What the panel shows of one message: the user's text, or the agent's text and tool calls; tool results go with their calls. */
type Entry =
  | { kind: 'user'; key: string; text: string }
  | { kind: 'answer'; key: string; text: string }
  | { kind: 'tool-call'; key: string; name: string; arguments: string; result: string | undefined };

const { agent } = defineProps<{ agent: string }>();

{{~ if valibot ~}}
const messageSchema = v.object({ message: v.pipe(v.string(), v.trim(), v.minLength(1, 'Write a message first.')) });
{{~ else ~}}
const messageSchema = z.object({ message: z.string().trim().min(1, 'Write a message first.') });
{{~ end ~}}

const { messages, running, failure, send } = useAgent(agent);
{{~ if formkit ~}}
// The run is started, not awaited: FormKit would hold the form disabled until it ended.
const submit = schemaSubmit(messageSchema, ({ message }, form) => {
  form.reset();
  void send(message);
});
{{~ else if tanstack ~}}
const form = useForm({
  defaultValues: { message: '' },
  validationLogic: revalidateLogic(),
  validators: { onDynamic: messageSchema },
  onSubmit: async ({ value, formApi }) => {
    const { message } = {{ if valibot }}v.parse(messageSchema, value){{ else }}messageSchema.parse(value){{ end }};
    formApi.reset();
    await send(message);
  },
});
const errors = form.useStore((state) => ({ message: state.fieldMeta.message?.errors[0]?.message }));
{{~ else ~}}
const { defineField, errors, handleSubmit, resetForm } = useForm({
  validationSchema: toTypedSchema(messageSchema),
  initialValues: { message: '' },
});
const [message, messageAttributes] = defineField('message');
{{~ end ~}}
{{~ if tanstack ~}}
const field = useId();

function submit(event: Event) {
  event.preventDefault();
  void form.handleSubmit();
}
{{~ else if !formkit ~}}
const field = useId();

const submit = handleSubmit(async (values) => {
  resetForm();
  await send(values.message);
});
{{~ end ~}}

const entries = computed(() => {
  const results = new Map(
    messages.value.flatMap((each) =>
      each.role === 'tool' ? [[each.toolCallId, contentToText(each.content)] as const] : [],
    ),
  );

  return messages.value.flatMap((each): Entry[] => {
    if (each.role === 'user') {
      return [{ kind: 'user', key: each.id, text: contentToText(each.content) }];
    }

    if (each.role !== 'assistant') {
      return [];
    }

    const text = contentToText(each.content);
    return [
      ...(text ? [{ kind: 'answer', key: each.id, text } as const] : []),
      ...(each.toolCalls ?? []).map((call) => ({
        kind: 'tool-call' as const,
        key: call.id,
        name: call.function.name,
        arguments: call.function.arguments,
        result: results.get(call.id),
      })),
    ];
  });
});
</script>

<template>
  <section :aria-label="`Conversation with ${agent}`" {{ class_of "flex max-w-3xl flex-col gap-4 p-4" "conversation" "d-flex flex-column ga-4 pa-4" }}>
    <ol aria-label="Messages" {{ class_of "flex flex-col gap-3" "messages" "d-flex flex-column ga-3" }}>
      <template v-for="entry in entries" :key="entry.key">
        <li v-if="entry.kind === 'user'" {{ themed "self-end rounded-md bg-primary px-3 py-2 text-primary-foreground" "self-end rounded-md bg-slate-900 px-3 py-2 text-white" "user" "align-self-end rounded bg-primary px-3 py-2" }}>
          <p {{ class_of "text-xs font-medium" "speaker" "text-label-small" }}>You</p>
          <p {{ class_of "whitespace-pre-wrap" "text" "text-pre-wrap" }}>{{ "{{" }} entry.text {{ "}}" }}</p>
        </li>
        <li v-else-if="entry.kind === 'answer'" {{ themed "rounded-md bg-muted px-3 py-2" "rounded-md bg-slate-100 px-3 py-2" "answer" "rounded bg-surface-light px-3 py-2" }}>
          <p {{ themed "text-xs font-medium text-muted-foreground" "text-xs font-medium text-slate-600" "answerSpeaker" "text-label-small text-medium-emphasis" }}>{{ "{{" }} agent {{ "}}" }}</p>
          <p {{ class_of "whitespace-pre-wrap" "text" "text-pre-wrap" }}>{{ "{{" }} entry.text {{ "}}" }}</p>
        </li>
        <li v-else {{ class_of "rounded-md border px-3 py-2 text-sm" "toolCall" "rounded border px-3 py-2 text-body-medium" }}>
          <p {{ themed "text-xs font-medium text-muted-foreground" "text-xs font-medium text-slate-600" "answerSpeaker" "text-label-small text-medium-emphasis" }}>Tool call</p>
          <p>
            <code>{{ "{{" }} entry.name {{ "}}" }}</code> <code {{ class_of "break-all" "arguments" "text-break" }}>{{ "{{" }} entry.arguments {{ "}}" }}</code>
          </p>
          <p v-if="entry.result === undefined">Running…</p>
          <p v-else>
            Result: <code>{{ "{{" }} entry.result {{ "}}" }}</code>
          </p>
        </li>
      </template>
    </ol>
    <p role="status" {{ themed "text-sm text-muted-foreground" "text-sm text-slate-500" "status" "text-body-medium text-medium-emphasis" }}>{{ "{{" }} running ? 'Answering…' : '' {{ "}}" }}</p>
    <p v-if="failure" role="alert" {{ themed "text-sm text-destructive" "text-sm text-red-600" "error" "text-body-medium text-error" }}>The agent could not answer: {{ "{{" }} failure {{ "}}" }}</p>
{{~ if formkit ~}}
{{~ if vuetify ~}}
    <FormKit
      type="form"
      :actions="false"
      :value="{ message: '' }"
      form-class="d-flex flex-column ga-2"
      @submit="submit"
    >
{{~ else ~}}
    <FormKit type="form" :actions="false" :value="{ message: '' }" {{ form_class "flex flex-col gap-2" }} @submit="submit">
{{~ end ~}}
      <FormKit type="textarea" name="message" label="Message" rows="3" />
      <{{ button }}{{ primary }} type="submit" :disabled="running" {{ class_of "self-end" "send" "align-self-end" }}>Send</{{ button }}>
    </FormKit>
{{~ else ~}}
    <form novalidate {{ class_of "flex flex-col gap-2" "form" "d-flex flex-column ga-2" }} @submit="submit">
      <label :for="field" {{ class_of "text-sm font-medium" "label" "text-title-small" }}>Message</label>
{{~ if tanstack ~}}
      <form.Field v-slot="{ field: message }" name="message">
        <textarea
          :id="field"
          :name="message.name"
          :value="message.state.value"
          rows="3"
          :aria-invalid="errors.message ? true : undefined"
          :aria-describedby="errors.message ? `${field}-error` : undefined"
          {{ themed "flex field-sizing-content min-h-16 w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:ring-destructive/40" "flex field-sizing-content min-h-16 w-full rounded-md border border-slate-300 bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-slate-500 focus-visible:border-slate-400 focus-visible:ring-[3px] focus-visible:ring-slate-400/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-red-600 aria-invalid:ring-red-600/20 md:text-sm" "input" "w-100 rounded border px-3 py-2" }}
          @blur="message.handleBlur"
          @input="message.handleChange(($event.target as HTMLTextAreaElement).value)"
        />
      </form.Field>
{{~ else ~}}
      <textarea
        :id="field"
        v-model="message"
        v-bind="messageAttributes"
        rows="3"
        :aria-invalid="errors.message ? true : undefined"
        :aria-describedby="errors.message ? `${field}-error` : undefined"
        {{ themed "flex field-sizing-content min-h-16 w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:ring-destructive/40" "flex field-sizing-content min-h-16 w-full rounded-md border border-slate-300 bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-slate-500 focus-visible:border-slate-400 focus-visible:ring-[3px] focus-visible:ring-slate-400/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-red-600 aria-invalid:ring-red-600/20 md:text-sm" "input" "w-100 rounded border px-3 py-2" }}
      />
{{~ end ~}}
      <p v-if="errors.message" :id="`${field}-error`" role="alert" {{ themed "text-sm text-destructive" "text-sm text-red-600" "error" "text-body-medium text-error" }}>
        {{ "{{" }} errors.message {{ "}}" }}
      </p>
      <{{ button }}{{ primary }} type="submit" :disabled="running" {{ class_of "self-end" "send" "align-self-end" }}>Send</{{ button }}>
    </form>
{{~ end ~}}
  </section>
</template>
