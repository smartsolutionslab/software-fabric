.conversation {
  display: flex;
  max-width: 48rem;
  flex-direction: column;
  gap: 1rem;
  padding: 1rem;
}

.messages {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding: 0;
}

.user {
  align-self: flex-end;
  border-radius: 0.375rem;
  background-color: #0f172a;
  padding: 0.5rem 0.75rem;
  color: #fff;
}

.answer {
  border-radius: 0.375rem;
  background-color: #f1f5f9;
  padding: 0.5rem 0.75rem;
}

.speaker,
.answerSpeaker {
  font-size: 0.75rem;
  line-height: 1rem;
  font-weight: 500;
}

.answerSpeaker {
  color: #64748b;
}

.text {
  white-space: pre-wrap;
}

.toolCall {
  border: 1px solid #e2e8f0;
  border-radius: 0.375rem;
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  line-height: 1.25rem;
}

.arguments {
  word-break: break-all;
}

.status,
.error {
  font-size: 0.875rem;
  line-height: 1.25rem;
}

.status {
  color: #64748b;
}

.error {
  color: #dc2626;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.label {
  font-size: 0.875rem;
  line-height: 1.25rem;
  font-weight: 500;
}

.input {
  display: flex;
  field-sizing: content;
  min-height: 4rem;
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 0.375rem;
  background-color: transparent;
  padding: 0.5rem 0.75rem;
  font: inherit;
  font-size: 0.875rem;
}

.input:focus-visible {
  outline: 2px solid #64748b;
  outline-offset: 2px;
}

.input:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

.input[aria-invalid='true'] {
  border-color: #dc2626;
}

.send {
  align-self: flex-end;
}
