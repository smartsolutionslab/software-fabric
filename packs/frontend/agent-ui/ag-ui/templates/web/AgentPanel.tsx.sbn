{{~ if (project["frontend.ui-library"] != "shadcn" && project["frontend.ui-library"] != "mui") || (project["frontend.forms"] != "react-hook-form" && project["frontend.forms"] != "tanstack-form") || (project["frontend.validation"] != "zod" && project["frontend.validation"] != "valibot") ~}}
throw new Error('The ag-ui pack builds the agent panel from shadcn/ui or MUI with React Hook Form or TanStack Form and zod or valibot only so far; frontend.ui-library is {{ project["frontend.ui-library"] }}, frontend.forms is {{ project["frontend.forms"] }}, frontend.validation is {{ project["frontend.validation"] }} (docs/adr/0006 of the generator).');
{{~ end ~}}
{{~ valibot = project["frontend.validation"] == "valibot" ~}}
{{~ tanstack = project["frontend.forms"] == "tanstack-form" ~}}
{{~ mui = project["frontend.ui-library"] == "mui" ~}}
import { contentToText, type Message } from '@ag-ui/client';
{{~ if mui ~}}
import { Box, Button, Stack, Typography } from '@mui/material';
{{~ end ~}}
{{~ if tanstack ~}}
import { revalidateLogic, useForm } from '@tanstack/react-form';
import { useId } from 'react';
{{~ if valibot ~}}
import * as v from 'valibot';
{{~ else ~}}
import { z } from 'zod';
{{~ end ~}}
{{~ else if valibot ~}}
import { valibotResolver } from '@hookform/resolvers/valibot';
import { useId } from 'react';
import { useForm } from 'react-hook-form';
import * as v from 'valibot';
{{~ else ~}}
import { zodResolver } from '@hookform/resolvers/zod';
import { useId } from 'react';
import { useForm } from 'react-hook-form';
import { z } from 'zod';
{{~ end ~}}
{{~ if !mui ~}}
import { Button } from '@/components/ui/button';
{{~ end ~}}
import { useAgent } from './useAgent';

{{~ if valibot ~}}
const messageSchema = v.object({ message: v.pipe(v.string(), v.trim(), v.minLength(1, 'Write a message first.')) });
{{~ if !tanstack ~}}

type MessageForm = v.InferOutput<typeof messageSchema>;
{{~ end ~}}
{{~ else ~}}
const messageSchema = z.object({ message: z.string().trim().min(1, 'Write a message first.') });
{{~ if !tanstack ~}}

type MessageForm = z.infer<typeof messageSchema>;
{{~ end ~}}
{{~ end ~}}

/**
 * A conversation with one of the host's agents, over AG-UI (POST /api/agents/{name}): the user's messages, each tool
 * call the agent makes with its result, and the agent's answers while they stream in. Another agent starts another
 * conversation.
 */
export function AgentPanel({ agent }: { agent: string }) {
  return <Conversation key={agent} agent={agent} />;
}

function Conversation({ agent }: { agent: string }) {
  const { messages, running, failure, send } = useAgent(agent);
{{~ if tanstack ~}}
  const form = useForm({
    defaultValues: { message: '' },
    validationLogic: revalidateLogic(),
    validators: { onDynamic: messageSchema },
    onSubmit: async ({ value, formApi }) => {
      const { message } = {{ if valibot }}v.parse(messageSchema, value){{ else }}messageSchema.parse(value){{ end }};
      formApi.reset();
      await send(message);
    },
  });
  const field = useId();
{{~ else ~}}
  const {
    register,
    handleSubmit,
    reset,
    formState: { errors },
  } = useForm<MessageForm>({ resolver: {{ if valibot }}valibotResolver{{ else }}zodResolver{{ end }}(messageSchema), defaultValues: { message: '' } });
  const field = useId();

  const onSubmit = handleSubmit(async ({ message }) => {
    reset();
    await send(message);
  });
{{~ end ~}}

  const results = new Map(
    messages.flatMap((message) =>
      message.role === 'tool' ? [[message.toolCallId, contentToText(message.content)] as const] : [],
    ),
  );

{{~ if mui ~}}
{%{  return (
    <Stack component="section" aria-label={`Conversation with ${agent}`} spacing={2} sx={{ maxWidth: 768, p: 2 }}>
      <Stack component="ol" aria-label="Messages" spacing={1.5} sx={{ listStyle: 'none', m: 0, p: 0 }}>
        {messages.flatMap((message) => entries(message, agent, results))}
      </Stack>
      <Typography role="status" variant="body2" color="text.secondary">
        {running ? 'Answering…' : ''}
      </Typography>
      {failure && (
        <Typography role="alert" variant="body2" color="error">
          The agent could not answer: {failure}
        </Typography>
      )}
}%}{{~ if tanstack ~}}
{%{      <Stack
        component="form"
        onSubmit={(event) => {
          event.preventDefault();
          void form.handleSubmit();
        }}
        noValidate
        spacing={1}
      >
        <Typography component="label" htmlFor={field} variant="subtitle2">
          Message
        </Typography>
        <form.Field name="message">
          {({ name, state: { value, meta }, handleBlur, handleChange }) => (
            <>
              <Box
                component="textarea"
                id={field}
                name={name}
                rows={3}
                value={value}
                onBlur={handleBlur}
                onChange={(event) => handleChange(event.target.value)}
                aria-invalid={meta.errors.length > 0 ? true : undefined}
                aria-describedby={meta.errors.length > 0 ? `${field}-error` : undefined}
                sx={nativeControl}
              />
              {meta.errors.length > 0 && (
                <Typography id={`${field}-error`} role="alert" variant="body2" color="error">
                  {meta.errors[0]?.message}
                </Typography>
              )}
            </>
          )}
        </form.Field>
}%}{{~ else ~}}
{%{      <Stack component="form" onSubmit={onSubmit} noValidate spacing={1}>
        <Typography component="label" htmlFor={field} variant="subtitle2">
          Message
        </Typography>
        <Box
          component="textarea"
          id={field}
          rows={3}
          aria-invalid={errors.message ? true : undefined}
          aria-describedby={errors.message ? `${field}-error` : undefined}
          sx={nativeControl}
          {...register('message')}
        />
        {errors.message && (
          <Typography id={`${field}-error`} role="alert" variant="body2" color="error">
            {errors.message.message}
          </Typography>
        )}
}%}{{~ end ~}}
{%{        <Button type="submit" variant="contained" disabled={running} sx={{ alignSelf: 'flex-end' }}>
          Send
        </Button>
      </Stack>
    </Stack>
  );
}

/** What the panel shows of one message: the user's text, or the agent's text and tool calls; tool results go with their calls. */
function entries(message: Message, agent: string, results: ReadonlyMap<string, string>) {
  if (message.role === 'user') {
    return [
      <Box
        component="li"
        key={message.id}
        sx={{
          alignSelf: 'flex-end',
          borderRadius: 1,
          bgcolor: 'primary.main',
          color: 'primary.contrastText',
          px: 1.5,
          py: 1,
        }}
      >
        <Typography variant="caption">You</Typography>
        <Typography sx={{ whiteSpace: 'pre-wrap' }}>{contentToText(message.content)}</Typography>
      </Box>,
    ];
  }

  if (message.role !== 'assistant') {
    return [];
  }

  const text = contentToText(message.content);
  return [
    ...(text
      ? [
          <Box component="li" key={message.id} sx={{ borderRadius: 1, bgcolor: 'action.hover', px: 1.5, py: 1 }}>
            <Typography variant="caption" color="text.secondary">
              {agent}
            </Typography>
            <Typography sx={{ whiteSpace: 'pre-wrap' }}>{text}</Typography>
          </Box>,
        ]
      : []),
    ...(message.toolCalls ?? []).map((call) => {
      const result = results.get(call.id);
      return (
        <Box
          component="li"
          key={call.id}
          sx={{ border: 1, borderColor: 'divider', borderRadius: 1, px: 1.5, py: 1, typography: 'body2' }}
        >
          <Typography variant="caption" color="text.secondary">
            Tool call
          </Typography>
          <Typography variant="body2">
            <code>{call.function.name}</code>{' '}
            <Box component="code" sx={{ wordBreak: 'break-all' }}>
              {call.function.arguments}
            </Box>
          </Typography>
          <Typography variant="body2">
            {result === undefined ? (
              'Running…'
            ) : (
              <>
                Result: <code>{result}</code>
              </>
            )}
          </Typography>
        </Box>
      );
    }),
  ];
}

/** The look of the form's native textarea, from the theme; it stays native so the form library registers it as it is. */
const nativeControl = {
  width: '100%',
  px: 1.5,
  py: 1,
  border: 1,
  borderColor: 'divider',
  borderRadius: 1,
  font: 'inherit',
  '&[aria-invalid="true"]': { borderColor: 'error.main' },
} as const;
}%}{{~ else ~}}
  return (
    <section aria-label={`Conversation with ${agent}`} className="flex max-w-3xl flex-col gap-4 p-4">
      <ol aria-label="Messages" className="flex flex-col gap-3">
        {messages.flatMap((message) => entries(message, agent, results))}
      </ol>
      <p role="status" className="text-sm text-muted-foreground">
        {running ? 'Answering…' : ''}
      </p>
      {failure && (
        <p role="alert" className="text-sm text-destructive">
          The agent could not answer: {failure}
        </p>
      )}
{{~ if tanstack ~}}
      <form
        onSubmit={(event) => {
          event.preventDefault();
          void form.handleSubmit();
        }}
        noValidate
        className="flex flex-col gap-2"
      >
        <label htmlFor={field} className="text-sm font-medium">
          Message
        </label>
        <form.Field name="message">
          {({ name, state: { value, meta }, handleBlur, handleChange }) => (
            <>
              <textarea
                id={field}
                name={name}
                rows={3}
                value={value}
                onBlur={handleBlur}
                onChange={(event) => handleChange(event.target.value)}
                aria-invalid={meta.errors.length > 0 ? true : undefined}
                aria-describedby={meta.errors.length > 0 ? `${field}-error` : undefined}
                className="flex field-sizing-content min-h-16 w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:ring-destructive/40"
              />
              {meta.errors.length > 0 && (
                <p id={`${field}-error`} role="alert" className="text-sm text-destructive">
                  {meta.errors[0]?.message}
                </p>
              )}
            </>
          )}
        </form.Field>
{{~ else ~}}
      <form onSubmit={onSubmit} noValidate className="flex flex-col gap-2">
        <label htmlFor={field} className="text-sm font-medium">
          Message
        </label>
        <textarea
          id={field}
          rows={3}
          aria-invalid={errors.message ? true : undefined}
          aria-describedby={errors.message ? `${field}-error` : undefined}
          className="flex field-sizing-content min-h-16 w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:ring-destructive/40"
          {...register('message')}
        />
        {errors.message && (
          <p id={`${field}-error`} role="alert" className="text-sm text-destructive">
            {errors.message.message}
          </p>
        )}
{{~ end ~}}
        <Button type="submit" disabled={running} className="self-end">
          Send
        </Button>
      </form>
    </section>
  );
}

/** What the panel shows of one message: the user's text, or the agent's text and tool calls; tool results go with their calls. */
function entries(message: Message, agent: string, results: ReadonlyMap<string, string>) {
  if (message.role === 'user') {
    return [
      <li key={message.id} className="self-end rounded-md bg-primary px-3 py-2 text-primary-foreground">
        <p className="text-xs font-medium">You</p>
        <p className="whitespace-pre-wrap">{contentToText(message.content)}</p>
      </li>,
    ];
  }

  if (message.role !== 'assistant') {
    return [];
  }

  const text = contentToText(message.content);
  return [
    ...(text
      ? [
          <li key={message.id} className="rounded-md bg-muted px-3 py-2">
            <p className="text-xs font-medium text-muted-foreground">{agent}</p>
            <p className="whitespace-pre-wrap">{text}</p>
          </li>,
        ]
      : []),
    ...(message.toolCalls ?? []).map((call) => {
      const result = results.get(call.id);
      return (
        <li key={call.id} className="rounded-md border px-3 py-2 text-sm">
          <p className="text-xs font-medium text-muted-foreground">Tool call</p>
          <p>
            <code>{call.function.name}</code> <code className="break-all">{call.function.arguments}</code>
          </p>
          <p>
            {result === undefined ? (
              'Running…'
            ) : (
              <>
                Result: <code>{result}</code>
              </>
            )}
          </p>
        </li>
      );
    }),
  ];
}
{{~ end ~}}
