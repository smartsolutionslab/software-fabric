{{~ ui = project["frontend.ui-library"] ~}}
{{~ css_modules = project["frontend.styling"] == "css-modules" ~}}
{{~ func class_of(tailwind, module)
  if css_modules
    ret 'className={styles.' + module + '}'
  end
  ret 'className="' + tailwind + '"'
end ~}}
{{~ func themed(shadcn, palette, module)
  if css_modules
    ret 'className={styles.' + module + '}'
  end
  if ui == "radix-headless"
    ret 'className="' + palette + '"'
  end
  ret 'className="' + shadcn + '"'
end ~}}
{{~ if (project["frontend.ui-library"] != "shadcn" && project["frontend.ui-library"] != "radix-headless") || (project["frontend.forms"] != "react-hook-form" && project["frontend.forms"] != "tanstack-form") || (project["frontend.validation"] != "zod" && project["frontend.validation"] != "valibot") ~}}
throw new Error('The ag-ui pack builds the agent panel from shadcn/ui or radix-headless with React Hook Form or TanStack Form and zod or valibot only so far; frontend.ui-library is {{ project["frontend.ui-library"] }}, frontend.forms is {{ project["frontend.forms"] }}, frontend.validation is {{ project["frontend.validation"] }} (docs/adr/0006 of the generator).');
{{~ end ~}}
{{~ valibot = project["frontend.validation"] == "valibot" ~}}
{{~ tanstack = project["frontend.forms"] == "tanstack-form" ~}}
import { contentToText, type Message } from '@ag-ui/client';
{{~ if tanstack ~}}
import { revalidateLogic, useForm } from '@tanstack/react-form';
import { useId } from 'react';
{{~ if valibot ~}}
import * as v from 'valibot';
{{~ else ~}}
import { z } from 'zod';
{{~ end ~}}
{{~ else if valibot ~}}
import { valibotResolver } from '@hookform/resolvers/valibot';
import { useId } from 'react';
import { useForm } from 'react-hook-form';
import * as v from 'valibot';
{{~ else ~}}
import { zodResolver } from '@hookform/resolvers/zod';
import { useId } from 'react';
import { useForm } from 'react-hook-form';
import { z } from 'zod';
{{~ end ~}}
import { Button } from '@/components/ui/button';
import { useAgent } from './useAgent';
{{~ if css_modules ~}}
import styles from './AgentPanel.module.css';
{{~ end ~}}

{{~ if valibot ~}}
const messageSchema = v.object({ message: v.pipe(v.string(), v.trim(), v.minLength(1, 'Write a message first.')) });
{{~ if !tanstack ~}}

type MessageForm = v.InferOutput<typeof messageSchema>;
{{~ end ~}}
{{~ else ~}}
const messageSchema = z.object({ message: z.string().trim().min(1, 'Write a message first.') });
{{~ if !tanstack ~}}

type MessageForm = z.infer<typeof messageSchema>;
{{~ end ~}}
{{~ end ~}}

/**
 * A conversation with one of the host's agents, over AG-UI (POST /api/agents/{name}): the user's messages, each tool
 * call the agent makes with its result, and the agent's answers while they stream in. Another agent starts another
 * conversation.
 */
export function AgentPanel({ agent }: { agent: string }) {
  return <Conversation key={agent} agent={agent} />;
}

function Conversation({ agent }: { agent: string }) {
  const { messages, running, failure, send } = useAgent(agent);
{{~ if tanstack ~}}
  const form = useForm({
    defaultValues: { message: '' },
    validationLogic: revalidateLogic(),
    validators: { onDynamic: messageSchema },
    onSubmit: async ({ value, formApi }) => {
      const { message } = {{ if valibot }}v.parse(messageSchema, value){{ else }}messageSchema.parse(value){{ end }};
      formApi.reset();
      await send(message);
    },
  });
  const field = useId();
{{~ else ~}}
  const {
    register,
    handleSubmit,
    reset,
    formState: { errors },
  } = useForm<MessageForm>({ resolver: {{ if valibot }}valibotResolver{{ else }}zodResolver{{ end }}(messageSchema), defaultValues: { message: '' } });
  const field = useId();

  const onSubmit = handleSubmit(async ({ message }) => {
    reset();
    await send(message);
  });
{{~ end ~}}

  const results = new Map(
    messages.flatMap((message) =>
      message.role === 'tool' ? [[message.toolCallId, contentToText(message.content)] as const] : [],
    ),
  );

  return (
    <section aria-label={`Conversation with ${agent}`} {{ class_of "flex max-w-3xl flex-col gap-4 p-4" "conversation" }}>
      <ol aria-label="Messages" {{ class_of "flex flex-col gap-3" "messages" }}>
        {messages.flatMap((message) => entries(message, agent, results))}
      </ol>
      <p role="status" {{ themed "text-sm text-muted-foreground" "text-sm text-slate-500" "status" }}>
        {running ? 'Answering…' : ''}
      </p>
      {failure && (
        <p role="alert" {{ themed "text-sm text-destructive" "text-sm text-red-600" "error" }}>
          The agent could not answer: {failure}
        </p>
      )}
{{~ if tanstack ~}}
      <form
        onSubmit={(event) => {
          event.preventDefault();
          void form.handleSubmit();
        }}
        noValidate
        {{ class_of "flex flex-col gap-2" "form" }}
      >
        <label htmlFor={field} {{ class_of "text-sm font-medium" "label" }}>
          Message
        </label>
        <form.Field name="message">
          {({ name, state: { value, meta }, handleBlur, handleChange }) => (
            <>
              <textarea
                id={field}
                name={name}
                rows={3}
                value={value}
                onBlur={handleBlur}
                onChange={(event) => handleChange(event.target.value)}
                aria-invalid={meta.errors.length > 0 ? true : undefined}
                aria-describedby={meta.errors.length > 0 ? `${field}-error` : undefined}
                {{ themed "flex field-sizing-content min-h-16 w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:ring-destructive/40" "flex field-sizing-content min-h-16 w-full rounded-md border border-slate-300 bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-slate-500 focus-visible:border-slate-400 focus-visible:ring-[3px] focus-visible:ring-slate-400/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-red-600 aria-invalid:ring-red-600/20 md:text-sm" "input" }}
              />
              {meta.errors.length > 0 && (
                <p id={`${field}-error`} role="alert" {{ themed "text-sm text-destructive" "text-sm text-red-600" "error" }}>
                  {meta.errors[0]?.message}
                </p>
              )}
            </>
          )}
        </form.Field>
{{~ else ~}}
      <form onSubmit={onSubmit} noValidate {{ class_of "flex flex-col gap-2" "form" }}>
        <label htmlFor={field} {{ class_of "text-sm font-medium" "label" }}>
          Message
        </label>
        <textarea
          id={field}
          rows={3}
          aria-invalid={errors.message ? true : undefined}
          aria-describedby={errors.message ? `${field}-error` : undefined}
          {{ themed "flex field-sizing-content min-h-16 w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 md:text-sm dark:bg-input/30 dark:aria-invalid:ring-destructive/40" "flex field-sizing-content min-h-16 w-full rounded-md border border-slate-300 bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-slate-500 focus-visible:border-slate-400 focus-visible:ring-[3px] focus-visible:ring-slate-400/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-red-600 aria-invalid:ring-red-600/20 md:text-sm" "input" }}
          {...register('message')}
        />
        {errors.message && (
          <p id={`${field}-error`} role="alert" {{ themed "text-sm text-destructive" "text-sm text-red-600" "error" }}>
            {errors.message.message}
          </p>
        )}
{{~ end ~}}
        <Button type="submit" disabled={running} {{ class_of "self-end" "send" }}>
          Send
        </Button>
      </form>
    </section>
  );
}

/** What the panel shows of one message: the user's text, or the agent's text and tool calls; tool results go with their calls. */
function entries(message: Message, agent: string, results: ReadonlyMap<string, string>) {
  if (message.role === 'user') {
    return [
      <li key={message.id} {{ themed "self-end rounded-md bg-primary px-3 py-2 text-primary-foreground" "self-end rounded-md bg-slate-900 px-3 py-2 text-white" "user" }}>
        <p {{ class_of "text-xs font-medium" "speaker" }}>You</p>
        <p {{ class_of "whitespace-pre-wrap" "text" }}>{contentToText(message.content)}</p>
      </li>,
    ];
  }

  if (message.role !== 'assistant') {
    return [];
  }

  const text = contentToText(message.content);
  return [
    ...(text
      ? [
          <li key={message.id} {{ themed "rounded-md bg-muted px-3 py-2" "rounded-md bg-slate-100 px-3 py-2" "answer" }}>
            <p {{ themed "text-xs font-medium text-muted-foreground" "text-xs font-medium text-slate-600" "answerSpeaker" }}>{agent}</p>
            <p {{ class_of "whitespace-pre-wrap" "text" }}>{text}</p>
          </li>,
        ]
      : []),
    ...(message.toolCalls ?? []).map((call) => {
      const result = results.get(call.id);
      return (
        <li key={call.id} {{ class_of "rounded-md border px-3 py-2 text-sm" "toolCall" }}>
          <p {{ themed "text-xs font-medium text-muted-foreground" "text-xs font-medium text-slate-600" "answerSpeaker" }}>Tool call</p>
          <p>
            <code>{call.function.name}</code> <code {{ class_of "break-all" "arguments" }}>{call.function.arguments}</code>
          </p>
          <p>
            {result === undefined ? (
              'Running…'
            ) : (
              <>
                Result: <code>{result}</code>
              </>
            )}
          </p>
        </li>
      );
    }),
  ];
}
