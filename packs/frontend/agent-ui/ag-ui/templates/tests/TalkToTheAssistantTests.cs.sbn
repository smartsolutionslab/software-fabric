using {{ namespace }}.BuildingBlocks.Messaging;
using {{ namespace }}.Modules.Assistant.Api;
using {{ namespace }}.Modules.Assistant.Application.Queries.CountWords;
using {{ namespace }}.Modules.Assistant.Application.Queries.TalkToTheAssistant;
using {{ namespace }}.Tests.Fakes;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace {{ namespace }}.Modules.Assistant.Tests.Queries;

/// <summary>The assistant run through its query and the dispatcher, as the host's POST /agents/assistant runs it.</summary>
public class TalkToTheAssistantTests
{
    [Fact]
    public async Task The_assistant_streams_a_word_count_its_tool_got_through_the_dispatcher()
    {
        var cancellationToken = TestContext.Current.CancellationToken;
        var model = new ToolCallingChatClient("count_words", new Dictionary<string, object?> { ["text"] = "one two three" });
        await using var services = Services(model);
        await using var scope = services.CreateAsyncScope();
        var dispatcher = scope.ServiceProvider.GetRequiredService<IDispatcher>();

        var result = await dispatcher.QueryAsync(TalkToTheAssistant.Start([new ChatMessage(ChatRole.User, "How many words?")], null), cancellationToken);

        result.IsSuccess.ShouldBeTrue();
        List<ChatResponseUpdate> updates = [];
        await foreach (var update in result.Value.WithCancellation(cancellationToken))
        {
            updates.Add(update);
        }

        model.Offered[0].ShouldBe(["count_words"]);
        updates.SelectMany(update => update.Contents).OfType<FunctionResultContent>().Single().Result?.ToString().ShouldBe("3");
        string.Concat(updates.Select(update => update.Text)).ShouldBe("The tool said: 3");
    }

    [Fact]
    public async Task Counting_the_words_of_an_empty_text_fails_with_its_code()
    {
        await using var services = Services(new FakeChatClient("unused"));
        await using var scope = services.CreateAsyncScope();

        var result = await scope.ServiceProvider.GetRequiredService<IDispatcher>().QueryAsync(new CountWords(" "), TestContext.Current.CancellationToken);

        result.IsSuccess.ShouldBeFalse();
        result.Error.Code.ShouldBe("assistant.nothing-to-count");
    }

    /// <summary>The module's services with what the host provides: the dispatcher and the model.</summary>
    private static ServiceProvider Services(IChatClient model)
    {
        var services = new ServiceCollection().AddLogging();
        var configuration = new ConfigurationBuilder()
            .AddInMemoryCollection(new Dictionary<string, string?> { ["ConnectionStrings:database"] = "Host=localhost" })
            .Build();
        services.AddDispatcher();
        services.AddSingleton(model);
        new AssistantModule().AddServices(services, configuration);
        return services.BuildServiceProvider();
    }
}
