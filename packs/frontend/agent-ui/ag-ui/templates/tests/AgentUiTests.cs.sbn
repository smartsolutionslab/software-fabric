{{~ signed_in = project["backend.auth"] != "none" ~}}
using System.Net;
using System.Text;
using System.Text.Json.Nodes;

namespace {{ namespace }}.Integration.Tests;

/// <summary>
/// The agent panel's endpoint, POST /agents/{name}, against the running application: the assistant's answer arrives as
/// AG-UI events, its text in several chunks, after a tool call its query ran through the dispatcher. The host answers
/// with its stand-in model, which the fixture switches on; no test calls a model.
/// </summary>
public class AgentUiTests({{ integration_fixture }})
{
    private const string Run = """
        {
          "threadId": "thread-1",
          "runId": "run-1",
          "state": {},
          "messages": [{ "id": "message-1", "role": "user", "content": "one two three" }],
          "tools": [],
          "context": [],
          "forwardedProps": {}
        }
        """;

    // The browser sends the whole conversation every turn: here the first turn, its tool call, the call's result and the
    // answer, then a new message.
    private const string SecondTurn = """
        {
          "threadId": "thread-1",
          "runId": "run-2",
          "state": {},
          "messages": [
            { "id": "message-1", "role": "user", "content": "one two three" },
            {
              "id": "message-2",
              "role": "assistant",
              "toolCalls": [{ "id": "call-1", "type": "function", "function": { "name": "count_words", "arguments": "{\"text\":\"one two three\"}" } }]
            },
            { "id": "message-3", "role": "tool", "toolCallId": "call-1", "content": "3" },
            { "id": "message-4", "role": "assistant", "content": "The tool said: 3" },
            { "id": "message-5", "role": "user", "content": "four five" }
          ],
          "tools": [],
          "context": [],
          "forwardedProps": {}
        }
        """;

    {{ test_attribute }}
    public async Task The_assistants_answer_streams_in_several_chunks_after_its_tool_ran_through_the_dispatcher()
    {
        var cancellationToken = {{ test_cancellation_token }};
{{~ if signed_in ~}}
        using var caller = await {{ signed_in_host_client `"developer"` }};
{{~ else ~}}
        using var caller = {{ host_client }};
{{~ end ~}}

        using var response = await PostAsync(caller, "/agents/assistant", Run, cancellationToken);

        {{ `response.StatusCode` | should_be `HttpStatusCode.OK` `await response.Content.ReadAsStringAsync(cancellationToken)` }};
        {{ `response.Content.Headers.ContentType?.MediaType` | should_be `"text/event-stream"` }};
        var events = Events(await response.Content.ReadAsStringAsync(cancellationToken));
        {{ `Types(events).First()` | should_be `"RUN_STARTED"` }};
        {{ `Types(events).Last()` | should_be `"RUN_FINISHED"` }};

        // The stand-in model asks for the first tool it is offered, count_words, with the user's message; the dispatcher
        // sends the tool's query to its handler, which counts three words.
        {{ `events.Single(agUiEvent => Type(agUiEvent) == "TOOL_CALL_START")["toolCallName"]!.GetValue<string>()` | should_be `"count_words"` }};
        {{ `events.Single(agUiEvent => Type(agUiEvent) == "TOOL_CALL_RESULT")["content"]!.GetValue<string>()` | should_be `"3"` }};

        List<string> chunks = [.. events.Where(agUiEvent => Type(agUiEvent) == "TEXT_MESSAGE_CONTENT").Select(agUiEvent => agUiEvent["delta"]!.GetValue<string>())];
        {{ `chunks.Count` | should_be_greater_than `1` }};
        {{ `string.Concat(chunks)` | should_be `"The tool said: 3"` }};
    }

    {{ test_attribute }}
    public async Task In_a_second_turn_the_tool_runs_again_for_the_new_message_and_the_answer_comes_from_that_result()
    {
        var cancellationToken = {{ test_cancellation_token }};
{{~ if signed_in ~}}
        using var caller = await {{ signed_in_host_client `"developer"` }};
{{~ else ~}}
        using var caller = {{ host_client }};
{{~ end ~}}

        using var response = await PostAsync(caller, "/agents/assistant", SecondTurn, cancellationToken);

        var stream = await response.Content.ReadAsStringAsync(cancellationToken);
        {{ `response.StatusCode` | should_be `HttpStatusCode.OK` `stream` }};
        var events = Events(stream);

        // The first turn's result belongs to the first message: the stand-in model asks for the tool again, which counts
        // the two words of the new message, and answers from that result alone.
        {{ `events.Count(agUiEvent => Type(agUiEvent) == "TOOL_CALL_START")` | should_be `1` `stream` }};
        {{ `events.Single(agUiEvent => Type(agUiEvent) == "TOOL_CALL_RESULT")["content"]!.GetValue<string>()` | should_be `"2"` }};
        List<string> chunks = [.. events.Where(agUiEvent => Type(agUiEvent) == "TEXT_MESSAGE_CONTENT").Select(agUiEvent => agUiEvent["delta"]!.GetValue<string>())];
        {{ `chunks.Count` | should_be_greater_than `1` `stream` }};
        {{ `string.Concat(chunks)` | should_be `"The tool said: 2"` }};
    }
{{~ if signed_in ~}}

    {{ test_attribute }}
    public async Task An_anonymous_caller_is_refused()
    {
        using var anonymous = {{ host_client }};

        using var response = await PostAsync(anonymous, "/agents/assistant", Run, {{ test_cancellation_token }});

        {{ `response.StatusCode` | should_be `HttpStatusCode.Unauthorized` }};
    }
{{~ end ~}}

    {{ test_attribute }}
    public async Task An_agent_no_module_registers_is_not_found()
    {
        var cancellationToken = {{ test_cancellation_token }};
{{~ if signed_in ~}}
        using var caller = await {{ signed_in_host_client `"developer"` }};
{{~ else ~}}
        using var caller = {{ host_client }};
{{~ end ~}}

        using var response = await PostAsync(caller, "/agents/nobody", Run, cancellationToken);

        {{ `response.StatusCode` | should_be `HttpStatusCode.NotFound` }};
        {{ `(await response.Content.ReadAsStringAsync(cancellationToken))` | should_contain `"agents.not-found"` }};
    }

    private static async Task<HttpResponseMessage> PostAsync(HttpClient caller, string path, string run, CancellationToken cancellationToken)
    {
        using var content = new StringContent(run, Encoding.UTF8, "application/json");
        return await caller.PostAsync(new Uri(path, UriKind.Relative), content, cancellationToken);
    }

    /// <summary>The events of a server-sent event stream, one per <c>data:</c> line.</summary>
    private static List<JsonObject> Events(string stream) =>
        [.. stream.Split('\n')
            .Where(line => line.StartsWith("data:", StringComparison.Ordinal))
            .Select(line => JsonNode.Parse(line["data:".Length..])!.AsObject())];

    private static IEnumerable<string> Types(IEnumerable<JsonObject> events) => events.Select(Type);

    private static string Type(JsonObject agUiEvent) => agUiEvent["type"]!.GetValue<string>();
}
