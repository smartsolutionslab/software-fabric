import { fileURLToPath } from 'node:url';
import { normalizePath, type Plugin } from 'vite';

/** A file's path as Vite writes module ids, forward slashes on every platform, so paths compare on Windows too. */
const asModuleId = (path: string) => normalizePath(path.replaceAll('\\', '/'));

/**
 * Fails the shell's build, dev server and tests when a file of a remote (web/modules/<module>) is loaded into the
 * shell, whatever path imported it: the shell loads a module's screens from its remote at run time (docs/adr).
 */
export function remoteBoundary(remotes = fileURLToPath(new URL('../modules/', import.meta.url))): Plugin {
  const root = asModuleId(remotes);
  return {
    name: 'remote-boundary',
    enforce: 'pre',
    load(id) {
      if (asModuleId(id).startsWith(root)) {
        this.error(
          `${id} belongs to a remote. The shell loads a module's screens from its remote at run time; it never bundles them (docs/adr).`,
        );
      }

      return null;
    },
  };
}
