{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "{{ if project["frontend.framework"] == "vue" }}preserve{{ else }}react-jsx{{ end }}",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"]
  },
  "include": [{{ if project["frontend.framework"] == "vue" }}"src/**/*.ts", "src/**/*.vue"{{ else }}"src"{{ end }}, "vite.config.ts"]
}
