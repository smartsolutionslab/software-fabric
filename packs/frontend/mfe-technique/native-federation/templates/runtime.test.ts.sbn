import type { initFederation } from '@softarc/native-federation-orchestrator';
import * as react from 'react';
import { expect, test, vi } from 'vitest';
import { loadPage } from './federation';

// jsdom has no object URLs: each one names the blob it was made from, so a test can read it.
const blobs = vi.hoisted(() => {
  const made = new Map<string, Blob>();
  URL.createObjectURL = (blob: Blob) => {
    const url = `blob:shell/${made.size}`;
    made.set(url, blob);
    return url;
  };
  return made;
});

const setImportMap = vi.hoisted(() => vi.fn());

vi.mock('virtual:federation', () => ({
  remotes: { billing: 'http://remote/remoteEntry.json' },
  versions: { react: '19.3.1', 'react-dom': '19.3.1'{{ if project["frontend.design-system"] != "tokens" }}, '@{{ name }}/ui': '0.0.0'{{ end }} },
}));
vi.mock('@softarc/native-federation-orchestrator/options', () => ({ replaceInDOM: () => setImportMap }));

type Options = NonNullable<Parameters<typeof initFederation>[1]>;

// The orchestrator starts once, for the first page; every test reads the options it was started with.
const orchestrator = vi.hoisted(() => {
  const Page = () => null;
  const remote = { loadRemoteModule: async () => ({ default: Page }) };
  return { Page, remote, federation: { initRemoteEntry: async () => remote }, options: undefined as unknown };
});

vi.mock('@softarc/native-federation-orchestrator', () => ({
  initFederation: async (_manifest: unknown, options: unknown) => {
    orchestrator.options = options;
    return orchestrator.federation;
  },
}));

const options = () => orchestrator.options as Options;
const hostEntry = () => (options().hostRemoteEntry as { url: string }).url;

const textOf = (url: string) => {
  const blob = blobs.get(url);
  if (!blob) {
    throw new Error(`No object URL ${url}`);
  }

  return blob.text();
};

test("a module's page is ./Page of the remote its remoteEntry.json describes", async () => {
  const initRemoteEntry = vi.spyOn(orchestrator.federation, 'initRemoteEntry');
  const loadRemoteModule = vi.spyOn(orchestrator.remote, 'loadRemoteModule');

  expect(await loadPage('billing')).toBe(orchestrator.Page);

  expect(initRemoteEntry).toHaveBeenCalledWith('http://remote/remoteEntry.json', 'billing');
  expect(loadRemoteModule).toHaveBeenCalledWith('billing', './Page');
});

test('the shell is the host: its packages at its versions, as singletons the orchestrator holds every remote to', async () => {
  await loadPage('billing');

  expect(options().strict).toEqual({ strictRemoteEntry: true, strictExternalCompatibility: true });
  const entry = JSON.parse(await textOf(hostEntry())) as { name: string; shared: object[] };
  expect(entry.name).toBe('shell');
  const singleton = (packageName: string, outFileName: string, version: string) => ({
    packageName,
    outFileName,
    version,
    requiredVersion: version,
    singleton: true,
    strictVersion: true,
  });
  expect(entry.shared).toEqual([
    singleton('react', 'react.js', '19.3.1'),
    singleton('react-dom', 'react-dom.js', '19.3.1'),
{{~ if project["frontend.design-system"] != "tokens" ~}}
    singleton('@{{ name }}/ui', '@{{ name }}_ui.js', '0.0.0'),
{{~ end ~}}
  ]);
});

test("a remote's import of a shared package gets the shell's own instance", async () => {
  await loadPage('billing');

  options().setImportMapFn?.({
    imports: { react: `${hostEntry()}/react.js`, 'billing/./Page': 'http://remote/Page.js' },
    scopes: { 'http://remote/': { react: `${hostEntry()}/react.js` } },
  });

  const [importMap] = setImportMap.mock.calls[0] ?? [];
  expect(importMap.imports['billing/./Page']).toBe('http://remote/Page.js');
  const module = await textOf(importMap.imports.react);
  expect(importMap.scopes['http://remote/'].react).toBe(importMap.imports.react);
  expect(module).toContain(`globalThis[Symbol.for('native-federation.shell')]["react"]`);
  expect(module).toMatch(/export const \{ [^}]*\buseState\b[^}]*\} = shared;/);
  const instances = globalThis as Record<symbol, Record<string, unknown> | undefined>;
  expect(instances[Symbol.for('native-federation.shell')]?.react).toBe(react);
});
