import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';
import type { Plugin } from 'vite';

// Every module's remote is a directory of web/modules with a package.json, created by fabric add-module; there is no
// list to keep. src/AppHost/Wiring/Remotes.cs finds the same ones.
const modules = fileURLToPath(new URL('../modules', import.meta.url));
const remotes = existsSync(modules)
  ? readdirSync(modules, { withFileTypes: true })
      .filter((entry) => entry.isDirectory() && existsSync(join(modules, entry.name, 'package.json')))
      .map((entry) => entry.name)
      .sort()
  : [];

/**
 * Where the browser loads a remote's remoteEntry.json from. Under Aspire, its own server (REMOTE_<MODULE>_URL, from
 * src/AppHost/Wiring/Remotes.cs); built, /modules/<module>/ next to the shell, where a deployment serves its dist.
 */
const entry = (module: string) =>
  `${process.env[`REMOTE_${module.toUpperCase().replaceAll('-', '_')}_URL`] ?? `/modules/${module}`}/remoteEntry.json`;

/** What the shell shares with every remote as one instance; each remote's federation.config.js shares the same. */
const shared = ['react', 'react-dom', '@{{ name }}/ui'];

/** A shared package's version as installed for the shell; native federation compares it with each remote's. */
const versionOf = (name: string): string => {
  const manifest = new URL(`node_modules/${name}/package.json`, import.meta.url);
  return (JSON.parse(readFileSync(manifest, 'utf8')) as { version: string }).version;
};

const id = 'virtual:federation';

/**
 * The shell's side of native federation: src/remotes/federation.ts imports every remote's remoteEntry.json and the
 * version of each shared package from virtual:federation.
 */
export function shellFederation(): Plugin {
  return {
    name: 'shell-federation',
    resolveId: (source) => (source === id ? `\0${id}` : null),
    load(resolved) {
      if (resolved !== `\0${id}`) {
        return null;
      }

      const manifest = Object.fromEntries(remotes.map((module) => [module, entry(module)]));
      const versions = Object.fromEntries(shared.map((name) => [name, versionOf(name)]));
      return `export const remotes = ${JSON.stringify(manifest)};\nexport const versions = ${JSON.stringify(versions)};\n`;
    },
  };
}
