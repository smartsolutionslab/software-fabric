{{~ if project["frontend.design-system"] == "tokens-and-components" ~}}
import { Badge } from '@{{ name }}/ui';

{{~ else if project["frontend.design-system"] == "web-components" ~}}
// Defines the design system's elements; the remote gets the shell's instance of the package, so they are defined once.
import '@{{ name }}/ui';

{{~ end ~}}
/** The {{ module.name }} module's screens; the shell shows them under /{{ module.name }}. */
export default function {{ module.namespace }}Page() {
  return (
    <main>
      <h1>{{ module.namespace }}</h1>
{{~ if project["frontend.design-system"] == "tokens-and-components" ~}}
      <Badge>Remote</Badge>
{{~ else if project["frontend.design-system"] == "web-components" ~}}
      <ds-badge>Remote</ds-badge>
{{~ end ~}}
    </main>
  );
}
