{{~ if project["backend.auth"] != "keycloak" && project["backend.auth"] != "none" ~}}
throw new Error('This test knows Keycloak\'s login page only so far (docs/adr/0006 of the generator).');
{{~ end ~}}
import { expect, test } from '@playwright/test';

test("{{ module.name }}'s page comes from its own remote", async ({ page }) => {
  const entries: string[] = [];
  page.on('request', (request) => {
    if (request.url().endsWith('/remoteEntry.js')) {
      entries.push(new URL(request.url()).origin);
    }
  });

  await page.goto('/');
{{~ if project["backend.auth"] == "keycloak" ~}}
  await page.getByLabel('Username or email').fill('developer');
  await page.getByLabel('Password', { exact: true }).fill('developer');
  await page.getByRole('button', { name: 'Sign In' }).click();
  await expect(page.getByText('Signed in as developer')).toBeVisible();
{{~ end ~}}

  await page.getByRole('link', { name: '{{ module.namespace }}' }).click();

  await expect(page.getByRole('heading', { name: '{{ module.namespace }}' })).toBeVisible();
  // Loaded from the remote's own dev server, not bundled into the shell.
  const shell = new URL(page.url()).origin;
  expect(entries.some((origin) => origin !== shell)).toBe(true);
});
