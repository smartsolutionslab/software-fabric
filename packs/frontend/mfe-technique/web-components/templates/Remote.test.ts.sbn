import { render, screen, waitFor } from '@testing-library/vue';
import { expect, test, vi } from 'vitest';
import { loadElement } from './elements';
import Remote from './Remote.vue';

vi.mock('./elements', () => ({ loadElement: vi.fn() }));

test("a module's page is the element its remote defines", async () => {
  vi.mocked(loadElement).mockResolvedValue('remote-billing');

  const { container } = render(Remote, { props: { module: 'billing' } });

  await waitFor(() => expect(container.querySelector('remote-billing')).not.toBeNull());
  expect(loadElement).toHaveBeenCalledWith('billing');
});

test('a remote that cannot be loaded leaves the shell running and says so', async () => {
  vi.mocked(loadElement).mockRejectedValue(new Error('remote.js did not load'));

  render(Remote, { props: { module: 'shipping' } });

  expect(await screen.findByRole('alert')).toHaveTextContent('shipping could not be loaded.');
});

test('a remote that failed to load is loaded again the next time its page is shown', async () => {
  vi.mocked(loadElement)
    .mockRejectedValueOnce(new Error('remote.js did not load'))
    .mockResolvedValueOnce('remote-stock');

  const { unmount } = render(Remote, { props: { module: 'stock' } });
  expect(await screen.findByText('stock could not be loaded.')).toBeInTheDocument();
  unmount();

  const { container } = render(Remote, { props: { module: 'stock' } });

  await waitFor(() => expect(container.querySelector('remote-stock')).not.toBeNull());
});
