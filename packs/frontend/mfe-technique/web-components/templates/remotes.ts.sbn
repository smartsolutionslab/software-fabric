import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';
import type { Plugin } from 'vite';

// Every module's remote is a directory of web/modules with a package.json, created by fabric add-module; there is no
// list to keep. src/AppHost/Wiring/Remotes.cs finds the same ones.
const modules = fileURLToPath(new URL('../modules', import.meta.url));
const remotes = existsSync(modules)
  ? readdirSync(modules, { withFileTypes: true })
      .filter((entry) => entry.isDirectory() && existsSync(join(modules, entry.name, 'package.json')))
      .map((entry) => entry.name)
      .sort()
  : [];

/**
 * Where the browser loads a remote's script module from. Under Aspire, its own server (REMOTE_<MODULE>_URL, from
 * src/AppHost/Wiring/Remotes.cs); built, /modules/<module>/ next to the shell, where a deployment serves its dist.
 */
const script = (module: string) =>
  `${process.env[`REMOTE_${module.toUpperCase().replaceAll('-', '_')}_URL`] ?? `/modules/${module}`}/remote.js`;

const id = 'virtual:remotes';

/** The shell's side of its remotes: src/remotes/elements.ts imports every remote's script from virtual:remotes. */
export function shellRemotes(): Plugin {
  return {
    name: 'shell-remotes',
    resolveId: (source) => (source === id ? `\0${id}` : null),
    load(resolved) {
      if (resolved !== `\0${id}`) {
        return null;
      }

      const manifest = Object.fromEntries(remotes.map((module) => [module, script(module)]));
      return `export const remotes = ${JSON.stringify(manifest)};\n`;
    },
  };
}
