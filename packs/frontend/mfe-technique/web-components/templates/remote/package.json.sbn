{{~ ds = project["frontend.design-system"] ~}}
{{~ if project["frontend.framework"] == "vue" ~}}
{
  "name": "@{{ name }}/module-{{ module.name }}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite preview",
    "build": "vue-tsc -b && node check-declarations.mjs && vite build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
{{~ if ds == "web-components" ~}}
    "@{{ name }}/ui": "workspace:*",
{{~ end ~}}
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
{{~ else ~}}
{
  "name": "@{{ name }}/module-{{ module.name }}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite preview",
    "build": "tsc -b && node check-declarations.mjs && vite build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
{{~ if ds == "tokens-and-components" ~}}
    "@{{ name }}/ui": "workspace:*",
{{~ end ~}}
    "@r2wc/react-to-web-component": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
{{~ if ds == "web-components" ~}}
    "@{{ name }}/ui": "workspace:*",
{{~ end ~}}
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
{{~ end ~}}
