func color_scheme_light
  ret `  --primary: oklch(0.527 0.154 150.069);
  --primary-foreground: oklch(0.982 0.018 155.826);
  --ring: oklch(0.627 0.194 149.214);
  --chart-1: oklch(0.871 0.15 154.449);
  --chart-2: oklch(0.723 0.219 149.579);
  --chart-3: oklch(0.627 0.194 149.214);
  --chart-4: oklch(0.527 0.154 150.069);
  --chart-5: oklch(0.448 0.119 151.328);
  --sidebar-primary: oklch(0.527 0.154 150.069);
  --sidebar-primary-foreground: oklch(0.982 0.018 155.826);
  --sidebar-ring: oklch(0.627 0.194 149.214);`
end
func color_scheme_dark
  ret `  --primary: oklch(0.792 0.209 151.711);
  --primary-foreground: oklch(0.266 0.065 152.934);
  --ring: oklch(0.723 0.219 149.579);
  --chart-1: oklch(0.871 0.15 154.449);
  --chart-2: oklch(0.723 0.219 149.579);
  --chart-3: oklch(0.627 0.194 149.214);
  --chart-4: oklch(0.527 0.154 150.069);
  --chart-5: oklch(0.448 0.119 151.328);
  --sidebar-primary: oklch(0.792 0.209 151.711);
  --sidebar-primary-foreground: oklch(0.266 0.065 152.934);
  --sidebar-ring: oklch(0.723 0.219 149.579);`
end
func color_scheme_brand
  ret `      "400": { "$value": "#05df72" },
      "500": { "$value": "#00c950" },
      "700": { "$value": "#008236" },
      "800": { "$value": "#016630" }`
end
func color_scheme_signal
  ret `      "500": { "$value": "#d97706" }`
end
