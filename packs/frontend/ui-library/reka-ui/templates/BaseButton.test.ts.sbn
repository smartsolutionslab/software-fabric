{{~ if project["frontend.styling"] == "css-modules" ~}}
import { render, screen } from '@testing-library/vue';
import { expect, test } from 'vitest';
import { h } from 'vue';
import styles from './BaseButton.module.css';
import BaseButton from './BaseButton.vue';

test('a button is a button with the default look', () => {
  render(BaseButton, { slots: { default: 'Save' } });

  expect(screen.getByRole('button', { name: 'Save' }).classList).toContain(styles.variantDefault);
});

test("with as-child the child takes the button's look and stays what it is", () => {
  render(BaseButton, {
    props: { asChild: true, variant: 'outline' },
    slots: { default: () => h('a', { href: '/billing' }, 'Billing') },
  });

  expect(screen.getByRole('link', { name: 'Billing' }).classList).toContain(styles.variantOutline);
  expect(screen.queryByRole('button')).not.toBeInTheDocument();
});
{{~ else ~}}
import { render, screen } from '@testing-library/vue';
import { expect, test } from 'vitest';
import { h } from 'vue';
import BaseButton from './BaseButton.vue';

test('a button is a button with the default look', () => {
  render(BaseButton, { slots: { default: 'Save' } });

  expect(screen.getByRole('button', { name: 'Save' })).{{ if project["frontend.design-system"] == "tokens" }}toHaveClass('bg-primary'){{ else }}toHaveClass('bg-slate-900'){{ end }};
});

test("with as-child the child takes the button's look and stays what it is", () => {
  render(BaseButton, {
    props: { asChild: true, variant: 'outline' },
    slots: { default: () => h('a', { href: '/billing' }, 'Billing') },
  });

  expect(screen.getByRole('link', { name: 'Billing' })).{{ if project["frontend.design-system"] == "tokens" }}toHaveClass('border-border'){{ else }}toHaveClass('border-slate-300'){{ end }};
  expect(screen.queryByRole('button')).not.toBeInTheDocument();
});
{{~ end ~}}