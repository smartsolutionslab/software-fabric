import { readFileSync } from 'node:fs';
import { expect, test } from 'vitest';

// Read from disk, relative to web/app where Vitest runs: Vitest hands a test a stylesheet empty, even with ?raw.
const styles = readFileSync('src/index.css', 'utf8');
{{~ if project["frontend.design-system"] != "none" ~}}
// The design system's tokens win over the palettes for each colour they set (their Tailwind theme maps --color-primary to
// --ds-color-primary), so they are read as built, which pnpm test does first: tokens.css holds the light values,
// dark.css the dark values of the tokens the dark theme changes.
const tokens = readFileSync('../packages/tokens/dist/tokens.css', 'utf8');
const darkTokens = readFileSync('../packages/tokens/dist/dark.css', 'utf8');
{{~ end ~}}

// jsdom computes no colours, so axe cannot judge contrast in a component test: this test reads both palettes of
// src/index.css instead and checks each text colour the components put on a background against WCAG AA (4.5:1).
const pairs = [
  ['foreground', 'background'],
  ['card-foreground', 'card'],
  ['popover-foreground', 'popover'],
  ['primary-foreground', 'primary'],
  // The button's link variant: the primary colour as text on the page.
  ['primary', 'background'],
  ['secondary-foreground', 'secondary'],
  ['accent-foreground', 'accent'],
  ['muted-foreground', 'background'],
  ['muted-foreground', 'card'],
  ['destructive', 'background'],
  ['sidebar-foreground', 'sidebar'],
  ['sidebar-primary-foreground', 'sidebar-primary'],
  ['sidebar-accent-foreground', 'sidebar-accent'],
] as const;

// The frosted surfaces (the header, the sidebar, dialogs and the command palette) are translucent: their colour depends
// on what is behind them, which the page's content decides. So their text is checked over any backdrop. Browsers blend
// each sRGB channel, so over any backdrop such a surface's luminance lies between its luminance over black and over
// white, and a backdrop blur only averages what is behind it, which stays in between. A text's contrast is lowest at
// one of those two ends, or 1:1 where its own luminance lies between them: those are the worst backdrops.
const glassPairs = [
  // The header's text and a dialog's.
  ['foreground', 'glass'],
  // The breadcrumbs, a dialog's description and the command palette's headings.
  ['muted-foreground', 'glass'],
  // The command palette's pages.
  ['popover-foreground', 'glass'],
  ['sidebar-foreground', 'sidebar-glass'],
] as const;

const backdrops = [
  // Black: every channel 0.
  0,
  // White: every channel 1.
  1,
] as const;

/** The variables of a top-level rule of a stylesheet: :root holds the light palette, .dark the dark one. */
function variables(stylesheet: string, file: string, selector: string): Map<string, string> {
  const block = new RegExp(`^${selector.replace('.', '\\.')} \\{([^}]*)\\}`, 'm').exec(stylesheet)?.[1];
  if (block === undefined) {
    throw new Error(`${file} has no top-level ${selector} block.`);
  }

  return new Map(
    [...block.matchAll(/--([\w-]+):\s*([^;]+);/g)].map(([, name = '', value = '']) => [name, value.trim()]),
  );
}
{{~ if project["frontend.design-system"] != "none" ~}}

const tokenColours = {
  light: variables(tokens, 'tokens.css', ':root'),
  dark: new Map([...variables(tokens, 'tokens.css', ':root'), ...variables(darkTokens, 'dark.css', '.dark')]),
};

/** The colour the token of a palette variable gives it in a theme (primary is --ds-color-primary), or none. */
function token(theme: 'light' | 'dark', name: string): string | undefined {
  let value = tokenColours[theme].get(`ds-color-${name}`);
  while (value?.startsWith('var(--')) {
    value = tokenColours[theme].get(value.slice('var(--'.length, -1));
  }

  return value;
}
{{~ end ~}}

{{~ if project["frontend.design-system"] != "none" ~}}
/** A #rrggbb or oklch() colour's sRGB channels (0 to 1; oklch() through OKLab, clipped to the gamut) and alpha. */
{{~ else ~}}
/** An oklch() colour as sRGB channels from 0 to 1, through OKLab, clipped to the gamut, and its alpha. */
{{~ end ~}}
function srgb(colour: string): { channels: [number, number, number]; alpha: number } {
{{~ if project["frontend.design-system"] != "none" ~}}
  const hex = /^#([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(colour);
  if (hex) {
    const channels = hex.slice(1).map((channel) => parseInt(channel, 16) / 255) as [number, number, number];
    return { channels, alpha: 1 };
  }

{{~ end ~}}
  const match = /^oklch\(([\d.]+) ([\d.]+) ([\d.]+)(?: \/ ([\d.]+)%)?\)$/.exec(colour);
  if (!match) {
    throw new Error(`The contrast test reads {{ if project["frontend.design-system"] != "none" }}#rrggbb and {{ end }}oklch() colours only, not ${colour}.`);
  }

  const [lightness, chroma, hue] = match.slice(1, 4).map(Number) as [number, number, number];
  const a = chroma * Math.cos((hue * Math.PI) / 180);
  const b = chroma * Math.sin((hue * Math.PI) / 180);
  const l = (lightness + 0.3963377774 * a + 0.2158037573 * b) ** 3;
  const m = (lightness - 0.1055613458 * a - 0.0638541728 * b) ** 3;
  const s = (lightness - 0.0894841775 * a - 1.291485548 * b) ** 3;
  const encode = (linear: number) => {
    const value = Math.min(1, Math.max(0, linear));
    return value <= 0.0031308 ? value * 12.92 : 1.055 * value ** (1 / 2.4) - 0.055;
  };
  const channels = [
    encode(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s),
    encode(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s),
    encode(-0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s),
  ] as [number, number, number];
  return { channels, alpha: match[4] === undefined ? 1 : Number(match[4]) / 100 };
}

/** The channels of an opaque colour: a text colour, or a background nothing shows through. */
function opaque(colour: string): [number, number, number] {
  const { channels, alpha } = srgb(colour);
  if (alpha !== 1) {
    throw new Error(`The contrast test reads opaque {{ if project["frontend.design-system"] != "none" }}#rrggbb and {{ end }}oklch() colours here, not ${colour}.`);
  }

  return channels;
}

/** The relative luminance (WCAG) of sRGB channels. */
function luminance(channels: readonly number[]): number {
  const [red, green, blue] = channels.map((value) =>
    value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4,
  ) as [number, number, number];
  return 0.2126 * red + 0.7152 * green + 0.0722 * blue;
}

function contrast(first: number, second: number): number {
  const [lighter, darker] = [first, second].sort((x, y) => y - x) as [number, number];
  return (lighter + 0.05) / (darker + 0.05);
}

/** The lowest contrast of a text colour on a translucent surface over any backdrop (see glassPairs). */
function worstContrast(text: string, surface: string): number {
  const ink = luminance(opaque(text));
  const { channels, alpha } = srgb(surface);
  const [darkest, lightest] = backdrops
    .map((backdrop) => luminance(channels.map((channel) => alpha * channel + (1 - alpha) * backdrop)))
    .sort((x, y) => x - y) as [number, number];
  if (ink >= darkest && ink <= lightest) {
    return 1;
  }

  return Math.min(contrast(ink, darkest), contrast(ink, lightest));
}

/** A variable of the theme's palette, or the design system's token that wins over it. */
function colour(theme: 'light' | 'dark', name: string): string {
  const palette = variables(styles, 'src/index.css', theme === 'light' ? ':root' : '.dark');
  const value = {{ if project["frontend.design-system"] != "none" }}token(theme, name) ?? {{ end }}palette.get(name);
  if (value === undefined) {
    throw new Error(`The ${theme} palette in src/index.css has no --${name}.`);
  }

  return value;
}

const themes = ['light', 'dark'] as const;
const cases = themes.flatMap((theme) => pairs.map(([text, background]) => ({ theme, text, background })));
const glassCases = themes.flatMap((theme) => glassPairs.map(([text, background]) => ({ theme, text, background })));

test.each(cases)(
  'in the $theme theme $text on $background has a contrast of at least 4.5:1',
  ({ theme, text, background }) => {
    const ratio = contrast(luminance(opaque(colour(theme, text))), luminance(opaque(colour(theme, background))));
    expect(ratio).toBeGreaterThanOrEqual(4.5);
  },
);

test.each(glassCases)(
  'in the $theme theme $text on $background has a contrast of at least 4.5:1 over any backdrop',
  ({ theme, text, background }) => {
    expect(worstContrast(colour(theme, text), colour(theme, background))).toBeGreaterThanOrEqual(4.5);
  },
);
