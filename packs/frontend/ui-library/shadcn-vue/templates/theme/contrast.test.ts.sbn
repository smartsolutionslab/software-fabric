import { readFileSync } from 'node:fs';
import { expect, test } from 'vitest';

// Read from disk, relative to web/app where Vitest runs: Vitest hands a test a stylesheet empty, even with ?raw.
const styles = readFileSync('src/index.css', 'utf8');
{{~ if project["frontend.design-system"] != "none" ~}}
// The design system's tokens win over the palettes for each colour they set (their Tailwind theme maps --color-primary to
// --ds-color-primary), so they are read as built, which pnpm test does first: tokens.css holds the light values,
// dark.css the dark values of the tokens the dark theme changes.
const tokens = readFileSync('../packages/tokens/dist/tokens.css', 'utf8');
const darkTokens = readFileSync('../packages/tokens/dist/dark.css', 'utf8');
{{~ end ~}}

// jsdom computes no colours, so axe cannot judge contrast in a component test: this test reads both palettes of
// src/index.css instead and checks each text colour the components put on a background against WCAG AA (4.5:1).
const pairs = [
  ['foreground', 'background'],
  ['card-foreground', 'card'],
  ['popover-foreground', 'popover'],
  ['primary-foreground', 'primary'],
  ['secondary-foreground', 'secondary'],
  ['accent-foreground', 'accent'],
  ['muted-foreground', 'background'],
  ['muted-foreground', 'card'],
  ['destructive', 'background'],
  ['sidebar-foreground', 'sidebar'],
  ['sidebar-primary-foreground', 'sidebar-primary'],
  ['sidebar-accent-foreground', 'sidebar-accent'],
] as const;

/** The variables of a top-level rule of a stylesheet: :root holds the light palette, .dark the dark one. */
function variables(stylesheet: string, file: string, selector: string): Map<string, string> {
  const block = new RegExp(`^${selector.replace('.', '\\.')} \\{([^}]*)\\}`, 'm').exec(stylesheet)?.[1];
  if (block === undefined) {
    throw new Error(`${file} has no top-level ${selector} block.`);
  }

  return new Map(
    [...block.matchAll(/--([\w-]+):\s*([^;]+);/g)].map(([, name = '', value = '']) => [name, value.trim()]),
  );
}
{{~ if project["frontend.design-system"] != "none" ~}}

const tokenColours = {
  light: variables(tokens, 'tokens.css', ':root'),
  dark: new Map([...variables(tokens, 'tokens.css', ':root'), ...variables(darkTokens, 'dark.css', '.dark')]),
};

/** The colour the token of a palette variable gives it in a theme (primary is --ds-color-primary), or none. */
function token(theme: 'light' | 'dark', name: string): string | undefined {
  let value = tokenColours[theme].get(`ds-color-${name}`);
  while (value?.startsWith('var(--')) {
    value = tokenColours[theme].get(value.slice('var(--'.length, -1));
  }

  return value;
}
{{~ end ~}}

{{~ if project["frontend.design-system"] != "none" ~}}
/** The relative luminance (WCAG) of a #rrggbb or an oklch() colour, oklch() through OKLab, clipped to the sRGB gamut. */
{{~ else ~}}
/** The relative luminance (WCAG) of an oklch() colour, through OKLab and linear sRGB, clipped to the sRGB gamut. */
{{~ end ~}}
function luminance(colour: string): number {
{{~ if project["frontend.design-system"] != "none" ~}}
  const hex = /^#([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(colour);
  if (hex) {
    const linear = (channel: string) => {
      const value = parseInt(channel, 16) / 255;
      return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
    };
    const [red, green, blue] = hex.slice(1).map(linear) as [number, number, number];
    return 0.2126 * red + 0.7152 * green + 0.0722 * blue;
  }

{{~ end ~}}
  const match = /^oklch\(([\d.]+) ([\d.]+) ([\d.]+)\)$/.exec(colour);
  if (!match) {
    throw new Error(`The contrast test reads opaque {{ if project["frontend.design-system"] != "none" }}#rrggbb and {{ end }}oklch() colours only, not ${colour}.`);
  }

  const [lightness, chroma, hue] = match.slice(1).map(Number) as [number, number, number];
  const a = chroma * Math.cos((hue * Math.PI) / 180);
  const b = chroma * Math.sin((hue * Math.PI) / 180);
  const l = (lightness + 0.3963377774 * a + 0.2158037573 * b) ** 3;
  const m = (lightness - 0.1055613458 * a - 0.0638541728 * b) ** 3;
  const s = (lightness - 0.0894841775 * a - 1.291485548 * b) ** 3;
  const clip = (channel: number) => Math.min(1, Math.max(0, channel));
  const red = clip(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s);
  const green = clip(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s);
  const blue = clip(-0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s);
  return 0.2126 * red + 0.7152 * green + 0.0722 * blue;
}

function contrast(first: string, second: string): number {
  const [lighter, darker] = [luminance(first), luminance(second)].sort((x, y) => y - x) as [number, number];
  return (lighter + 0.05) / (darker + 0.05);
}

const cases = (['light', 'dark'] as const).flatMap((theme) =>
  pairs.map(([text, background]) => ({ theme, text, background })),
);

test.each(cases)(
  'in the $theme theme $text on $background has a contrast of at least 4.5:1',
  ({ theme, text, background }) => {
    const colours = variables(styles, 'src/index.css', theme === 'light' ? ':root' : '.dark');
    const colour = (name: string) => {
      const value = {{ if project["frontend.design-system"] != "none" }}token(theme, name) ?? {{ end }}colours.get(name);
      if (value === undefined) {
        throw new Error(`The ${theme} palette in src/index.css has no --${name}.`);
      }

      return value;
    };

    expect(contrast(colour(text), colour(background))).toBeGreaterThanOrEqual(4.5);
  },
);
