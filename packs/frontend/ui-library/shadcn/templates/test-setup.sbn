{{~ if project["frontend.architecture"] == "spa" && project["frontend.routing"] == "react-router" ~}}

// jsdom measures nothing: the command palette (cmdk) observes its list's size and scrolls the picked item into view.
globalThis.ResizeObserver ??= class {
  observe() {}
  unobserve() {}
  disconnect() {}
};
Element.prototype.scrollIntoView ??= () => undefined;{{ end }}