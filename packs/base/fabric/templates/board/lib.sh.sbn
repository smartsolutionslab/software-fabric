{%{# Shared by the board scripts (board protocol, docs/adr). Source it; do not run it.
# Talks to GitHub only through `gh api` and REST: Claude Code's cloud sessions refuse GraphQL, which most other gh
# subcommands use. Board fields are the exception (GitHub Projects have no REST API) and stay optional.

set -euo pipefail

board_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"

# Settings: .github/board.env, unless the environment already sets a value.
while IFS='=' read -r key value; do
  [[ "$key" =~ ^BOARD_[A-Z_]+$ ]] || continue
  if [ -z "${!key:-}" ]; then
    export "$key=$value"
  fi
done < "$board_root/.github/board.env"

repo="${GITHUB_REPOSITORY:-}"
if [ -z "$repo" ]; then
  repo="$(git -C "$board_root" remote get-url origin | sed -E 's#\.git$##; s#^.*github\.com[:/]##')"
fi

board_now() {
  echo "${BOARD_NOW:-$(date -u +%s)}"
}

# A branch name for an issue: agent/<number>-<slug of the title>.
board_slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40 | sed -E 's/-+$//'
}

board_default_sha() {
  local branch
  branch="$(gh api "repos/$repo" | jq -r .default_branch)"
  gh api "repos/$repo/git/ref/heads/$branch" | jq -r .object.sha
}

# The first branch under refs/heads/<prefix><issue>-, or nothing.
board_branch_for() {
  local prefix="$1" issue="$2"
  gh api "repos/$repo/git/matching-refs/heads/$prefix$issue-" | jq -r '.[0].ref // empty' | sed 's#^refs/heads/##'
}

# Renaming is atomic on GitHub: of two agents renaming the same branch, one fails.
board_rename() {
  gh api -X POST "repos/$repo/branches/$1/rename" -f "new_name=$2" > /dev/null 2>&1
}

board_park() {
  local issue="$1" branch
  branch="$(board_branch_for agent/ "$issue")"
  if [ -n "$branch" ]; then
    board_rename "$branch" "parked/${branch#agent/}"
  fi
}

board_comment() {
  gh api -X POST "repos/$repo/issues/$1/comments" -f "body=$2" > /dev/null
}

board_uri() {
  jq -rn --arg value "$1" '$value | @uri'
}

# Open issues matching a query string (labels=..., assignee=...), pull requests left out.
board_issues() {
  gh api "repos/$repo/issues?state=open&per_page=100&$1" | jq 'map(select(has("pull_request") | not))'
}

board_issue() {
  gh api "repos/$repo/issues/$1"
}

board_add_label() {
  gh api -X POST "repos/$repo/issues/$1/labels" -f "labels[]=$2" > /dev/null
}

board_remove_label() {
  gh api -X DELETE "repos/$repo/issues/$1/labels/$(board_uri "$2")" > /dev/null
}

board_assign() {
  gh api -X POST "repos/$repo/issues/$1/assignees" -f "assignees[]=$2" > /dev/null
}

# Board fields (Status, Executor) live on the GitHub Project named in .github/board.env.
# Without one, the labels and comments still carry the protocol.
board_project_configured() {
  [ -n "${BOARD_PROJECT_NUMBER:-}" ] && [ -n "${BOARD_PROJECT_OWNER:-}" ]
}

board_item() {
  local issue="$1" url item
  url="https://github.com/$repo/issues/$issue"
  item="$(gh project item-list "$BOARD_PROJECT_NUMBER" --owner "$BOARD_PROJECT_OWNER" --format json --limit 1000 \
    | jq -r --arg url "$url" '.items[] | select(.content.url == $url) | .id' | head -n1)"
  if [ -z "$item" ]; then
    item="$(gh project item-add "$BOARD_PROJECT_NUMBER" --owner "$BOARD_PROJECT_OWNER" --url "$url" --format json | jq -r .id)"
  fi
  echo "$item"
}

board_field() {
  local issue="$1" field="$2" value="$3" project fields field_id item
  board_project_configured || return 0
  project="$(gh project view "$BOARD_PROJECT_NUMBER" --owner "$BOARD_PROJECT_OWNER" --format json | jq -r .id)"
  fields="$(gh project field-list "$BOARD_PROJECT_NUMBER" --owner "$BOARD_PROJECT_OWNER" --format json)"
  field_id="$(jq -r --arg name "$field" '.fields[] | select(.name == $name) | .id' <<< "$fields")"
  if [ -z "$field_id" ]; then
    echo "The board has no field '$field'; run .github/scripts/board/setup.sh." >&2
    return 1
  fi
  item="$(board_item "$issue")"
  if jq -e --arg name "$field" '.fields[] | select(.name == $name) | has("options")' <<< "$fields" > /dev/null; then
    local option
    option="$(jq -r --arg name "$field" --arg value "$value" '.fields[] | select(.name == $name) | .options[] | select(.name == $value) | .id' <<< "$fields")"
    if [ -z "$option" ]; then
      echo "The board's '$field' field has no option '$value'; run .github/scripts/board/setup.sh." >&2
      return 1
    fi
    gh project item-edit --id "$item" --project-id "$project" --field-id "$field_id" --single-select-option-id "$option" > /dev/null
  elif [ -z "$value" ]; then
    gh project item-edit --id "$item" --project-id "$project" --field-id "$field_id" --clear > /dev/null
  else
    gh project item-edit --id "$item" --project-id "$project" --field-id "$field_id" --text "$value" > /dev/null
  fi
}

board_status() {
  board_field "$1" Status "$2"
}

board_executor() {
  board_field "$1" Executor "$2"
}
}%}