{%{name: board-return

# An escalated issue goes back to the agents once its developer unassigns themselves (board protocol, docs/adr).
on:
  issues:
    types: [unassigned]

# No concurrency group: each run returns a different issue, and every run has the same ref, so a group would cancel
# the pending return of one issue for another's.
permissions:
  contents: read
  issues: write

jobs:
  return-to-todo:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
      - run: bash .github/scripts/board/return-to-todo.sh "${{ github.event.issue.number }}"
        env:
          GH_TOKEN: ${{ secrets.BOARD_TOKEN || github.token }}
          BOARD_PROJECT_OWNER: ${{ vars.BOARD_PROJECT_OWNER }}
          BOARD_PROJECT_NUMBER: ${{ vars.BOARD_PROJECT_NUMBER }}
}%}
