{%{name: cross-model-review

# The reviewer is from a different model family than the author (board protocol, docs/adr). Its findings land on the
# pull request, and a blocking one fails the check.
# Needs the secret of the reviewing family: ANTHROPIC_API_KEY for claude, OPENAI_API_KEY for codex.
#
# The gate's own files (its scripts, the findings schema, the reviewer briefs) come from the base branch, checked out
# into .gate: a pull request must not choose its own reviewer or post its own verdict. The pull request's copies are
# used only while the base branch has none, which is the pull request that brings the protocol. This workflow file
# itself still comes from the pull request, so .github/ needs a code owner's review (docs/adr).
on:
  pull_request:
    types: [opened, synchronize, reopened]

permissions:
  contents: read
  pull-requests: write

jobs:
  choose:
    runs-on: ubuntu-latest
    outputs:
      reviewer: ${{ steps.choose.outputs.reviewer }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.base.sha }}
          path: .gate
      - name: Use the gate's files from the base branch
        run: |
          if [ -f .gate/.github/scripts/board/reviewer.sh ]; then gate=.gate; else gate=.; fi
          echo "GATE=$gate/.github" >> "$GITHUB_ENV"
          echo "BRIEFS=$gate" >> "$GITHUB_ENV"
      - id: choose
        # Assigned first: inside echo's arguments a failing reviewer.sh would not fail the step, and no review would run.
        run: |
          reviewer="$(bash "$GATE/scripts/board/reviewer.sh" "$BASE" "$HEAD")"
          echo "reviewer=$reviewer" >> "$GITHUB_OUTPUT"
        env:
          GH_TOKEN: ${{ github.token }}
          BASE: ${{ github.event.pull_request.base.sha }}
          HEAD: ${{ github.event.pull_request.head.sha }}

  claude:
    needs: choose
    if: needs.choose.outputs.reviewer == 'claude'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.base.sha }}
          path: .gate
      - name: Use the gate's files from the base branch
        run: |
          if [ -f .gate/.github/scripts/board/reviewer.sh ]; then gate=.gate; else gate=.; fi
          echo "GATE=$gate/.github" >> "$GITHUB_ENV"
          echo "BRIEFS=$gate" >> "$GITHUB_ENV"
      - id: schema
        run: echo "json=$(jq -c . "$GATE/review-findings.schema.json")" >> "$GITHUB_OUTPUT"
      - id: review
        uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          # The workflow's own token: without one the action fetches an app token through OIDC (id-token: write),
          # which this job does not need, since report-review.sh posts the findings.
          github_token: ${{ github.token }}
          claude_args: --json-schema '${{ steps.schema.outputs.json }}'
          prompt: |
            Review pull request #${{ github.event.pull_request.number }} as the reviewers in ${{ env.BRIEFS }}/.claude/agents/
            describe (backend-reviewer, frontend-reviewer, security-reviewer: whichever the diff touches). Read
            ${{ env.BRIEFS }}/AGENTS.md first: those are the base branch's rules, which the change is held to.
            Do not comment on the pull request yourself. Answer with every finding: its file, its line (null when it has
            none), whether it is blocking or optional, and what is wrong.
      - name: Post the findings; a blocking one fails this check
        env:
          GH_TOKEN: ${{ github.token }}
          FINDINGS: ${{ steps.review.outputs.structured_output }}
          PR: ${{ github.event.pull_request.number }}
        run: |
          printf '%s' "$FINDINGS" > "$RUNNER_TEMP/findings.json"
          bash "$GATE/scripts/board/report-review.sh" "$PR" "$RUNNER_TEMP/findings.json" claude

  codex:
    needs: choose
    if: needs.choose.outputs.reviewer == 'codex'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.base.sha }}
          path: .gate
      - name: Use the gate's files from the base branch
        run: |
          if [ -f .gate/.github/scripts/board/reviewer.sh ]; then gate=.gate; else gate=.; fi
          echo "GATE=$gate/.github" >> "$GITHUB_ENV"
          echo "BRIEFS=$gate" >> "$GITHUB_ENV"
      - id: review
        uses: openai/codex-action@v1
        with:
          openai-api-key: ${{ secrets.OPENAI_API_KEY }}
          output-schema-file: ${{ env.GATE }}/review-findings.schema.json
          prompt: |
            Review pull request #${{ github.event.pull_request.number }} as the reviewers in ${{ env.BRIEFS }}/.claude/agents/
            describe (backend-reviewer, frontend-reviewer, security-reviewer: whichever the diff touches). Read
            ${{ env.BRIEFS }}/AGENTS.md first: those are the base branch's rules, which the change is held to.
            Answer with every finding: its file, its line (null when it has none), whether it is blocking or optional,
            and what is wrong.
      - name: Post the findings; a blocking one fails this check
        env:
          GH_TOKEN: ${{ github.token }}
          FINDINGS: ${{ steps.review.outputs.final-message }}
          PR: ${{ github.event.pull_request.number }}
        run: |
          printf '%s' "$FINDINGS" > "$RUNNER_TEMP/findings.json"
          bash "$GATE/scripts/board/report-review.sh" "$PR" "$RUNNER_TEMP/findings.json" codex
}%}
