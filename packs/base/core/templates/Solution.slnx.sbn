<Solution>
  <Folder Name="/src/">
    <Project Path="src/AppHost/AppHost.csproj" />
    <Project Path="src/BuildingBlocks/BuildingBlocks.csproj" />
    <Project Path="src/Contracts/Contracts.csproj" />
    <Project Path="src/Kernel/Kernel.csproj" />
    <Project Path="src/ServiceDefaults/ServiceDefaults.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Architecture.Tests/Architecture.Tests.csproj" />
    <Project Path="tests/Kernel/Paging.Tests/Paging.Tests.csproj" />
  </Folder>
{{ slots["solution.projects"] }}
{{~ for module in modules ~}}
  <Project Path="src/Modules/{{ module.namespace }}/{{ module.namespace }}.Domain/{{ module.namespace }}.Domain.csproj" />
  <Project Path="src/Modules/{{ module.namespace }}/{{ module.namespace }}.Application/{{ module.namespace }}.Application.csproj" />
  <Project Path="src/Modules/{{ module.namespace }}/{{ module.namespace }}.Infrastructure/{{ module.namespace }}.Infrastructure.csproj" />
  <Project Path="src/Modules/{{ module.namespace }}/{{ module.namespace }}.Api/{{ module.namespace }}.Api.csproj" />
  <Project Path="tests/Modules/{{ module.namespace }}.Tests/{{ module.namespace }}.Tests.csproj" />
{{~ end ~}}
</Solution>
