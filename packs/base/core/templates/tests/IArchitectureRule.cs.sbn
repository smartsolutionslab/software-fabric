namespace {{ namespace }}.Architecture.Tests;

/// <summary>
/// One architectural rule a choice made for this project. Rules do not depend on a test framework: the chosen
/// framework runs every implementation in this assembly and fails on any violation.
/// </summary>
public interface IArchitectureRule
{
    string Description { get; }

    IEnumerable<string> Violations(ArchitectureModel model);
}

/// <summary>Thrown by the test that runs a rule when the rule has violations; works the same under any test framework.</summary>
public sealed class ArchitectureViolationException : Exception
{
    public ArchitectureViolationException()
    {
    }

    public ArchitectureViolationException(string message)
        : base(message)
    {
    }

    public ArchitectureViolationException(string message, Exception innerException)
        : base(message, innerException)
    {
    }
}
