using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Syntax;

namespace {{ namespace }}.Architecture.Tests.Rules;

/// <summary>
/// The AppHost's build compiles every project it runs, so Aspire starts each with <c>dotnet run --no-build</c>: an
/// <c>AddProject&lt;Projects.X&gt;</c>{{ if project["backend.topology"] == "services" }}, or <c>AddBuiltProject</c> for a project found by path{{ end }}. <c>AddProject</c> with a
/// path rebuilds the project at every start, all of them at once on a test run's start-up. Sources are parsed, not
/// grepped: a comment is prose.
/// </summary>
public sealed class TheAppHostRunsWhatItBuilt : IArchitectureRule
{
    public string Description => "The AppHost adds every project from its own build: AddProject<Projects.X>{{ if project["backend.topology"] == "services" }} or AddBuiltProject{{ end }}, never AddProject with a path, which Aspire rebuilds at every start.";

    public IEnumerable<string> Violations(ArchitectureModel model)
    {
        {{ not_null "model" }}

        var root = RepositoryRoot();
        var appHost = Path.Combine(root, "src", "AppHost");
        List<string> violations = [];
        foreach (var path in Directory.EnumerateFiles(appHost, "*.cs", SearchOption.AllDirectories)
            .Select(path => Path.GetRelativePath(root, path).Replace('\\', '/'))
            .Where(path => !path.Contains("/bin/", StringComparison.Ordinal) && !path.Contains("/obj/", StringComparison.Ordinal))
            .Order(StringComparer.Ordinal))
        {
            var source = CSharpSyntaxTree.ParseText(File.ReadAllText(Path.Combine(root, path))).GetRoot();
            foreach (var call in source.DescendantNodes().OfType<InvocationExpressionSyntax>())
            {
                if (call.Expression is MemberAccessExpressionSyntax { Name: IdentifierNameSyntax { Identifier.Text: "AddProject" } name })
                {
                    violations.Add($"{path}:{name.GetLocation().GetLineSpan().StartLinePosition.Line + 1}: adds a project by path with AddProject, so Aspire rebuilds it at every start; {{ if project["backend.topology"] == "services" }}add it with AddBuiltProject, which runs it from the AppHost's build{{ else }}reference it from AppHost.csproj and add it as AddProject<Projects.X>, which runs it from the AppHost's build{{ end }}.");
                }
            }
        }

        return violations;
    }

    /// <summary>The project root: the directory above the test output that holds build.proj.</summary>
    private static string RepositoryRoot()
    {
        var directory = new DirectoryInfo(AppContext.BaseDirectory);
        while (directory is not null && !File.Exists(Path.Combine(directory.FullName, "build.proj")))
        {
            directory = directory.Parent;
        }

        return directory?.FullName ?? throw new InvalidOperationException("build.proj not found above the test output directory.");
    }
}
