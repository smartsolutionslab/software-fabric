<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>{{ namespace }}.BuildingBlocks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
{{~ if project["backend.llm"] != "none" || (array.contains project["backend.mcp"] "client") ~}}
    <PackageReference Include="Microsoft.Extensions.AI" />
{{~ end ~}}
{{ slots["buildingblocks.packages"] }}
  </ItemGroup>

</Project>
