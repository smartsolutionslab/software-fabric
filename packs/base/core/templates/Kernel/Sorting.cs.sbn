namespace {{ namespace }}.Kernel;

/// <summary>
/// The order a list query returns its items in: a field the query declares as an enum
/// (<c>enum InvoiceSortField { Number, IssuedOn }</c>), so a caller can sort by nothing the query did not offer. The
/// field's enum carries <c>[JsonConverter(typeof(JsonStringEnumConverter&lt;InvoiceSortField&gt;))]</c>, as
/// <see cref="SortDirection"/> does, so it travels by name.
/// </summary>
public sealed record Sorting<TField>(TField Field, SortDirection Direction)
    where TField : struct, Enum;
