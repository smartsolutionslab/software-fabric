<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>{{ namespace }}.Modules.{{ module.namespace }}.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Modules/{{ module.namespace }}/{{ module.namespace }}.Api/{{ module.namespace }}.Api.csproj" />
{{~ if project["backend.llm"] != "none" ~}}
    <Compile Include="../../Fakes/*.cs" Link="Fakes/%(Filename)%(Extension)" />
{{~ end ~}}
  </ItemGroup>

</Project>
