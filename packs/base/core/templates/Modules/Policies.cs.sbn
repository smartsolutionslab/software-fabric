{{~
  # cross_tenant_reads is the tenant-column pack's; no other tenancy defines it.
  across = false
  if project["backend.tenancy"] == "column"
    across = cross_tenant_reads
  end
~}}
{{~
  requirements = []
  if project["backend.authorization"] | array.contains "roles"
    requirements = requirements | array.add "RequireRole(\"manager\")"
  end
  if project["backend.authorization"] | array.contains "claims"
    requirements = requirements | array.add "RequireClaim(\"department\", \"finance\")"
  end
~}}
using {{ namespace }}.BuildingBlocks.Modules;
{{~ if across ~}}
using {{ namespace }}.BuildingBlocks.Tenancy;
{{~ end ~}}
using {{ namespace }}.Modules.{{ module.namespace }}.Application;
using Microsoft.AspNetCore.Authorization;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Api;

/// <summary>
/// The module's authorization policies, registered under the names in <see cref="{{ module.namespace }}PolicyNames"/>; its
/// endpoints name them.
/// </summary>
public sealed class {{ module.namespace }}Policies : IModulePolicies
{
    public void AddPolicies(AuthorizationBuilder policies)
    {
        {{ not_null "policies" }}

        policies.AddPolicy({{ module.namespace }}PolicyNames.Manage, policy => policy.{{ requirements | array.join "." }});
{{~ if across ~}}
        policies.AddPolicy({{ module.namespace }}PolicyNames.ReadAllTenants, policy => policy.RequireRole(CrossTenantRole.Name));
        policies.AddPolicy({{ module.namespace }}PolicyNames.WriteSharedRecords, policy => policy.RequireRole(CrossTenantRole.Name));
{{~ end ~}}
    }
}
