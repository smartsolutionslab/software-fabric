{{~
  requirements = []
  if project["backend.authorization"] | array.contains "roles"
    requirements = requirements | array.add "RequireRole(\"manager\")"
  end
  if project["backend.authorization"] | array.contains "claims"
    requirements = requirements | array.add "RequireClaim(\"department\", \"finance\")"
  end
~}}
using {{ namespace }}.BuildingBlocks.Modules;
using Microsoft.AspNetCore.Authorization;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Api;

/// <summary>The module's authorization policies, each named <c>{{ module.name }}.&lt;permission&gt;</c>; its endpoints name them.</summary>
public sealed class {{ module.namespace }}Policies : IModulePolicies
{
    public const string Manage = "{{ module.name }}.manage";

    public void AddPolicies(AuthorizationBuilder policies)
    {
        {{ not_null "policies" }}

        policies.AddPolicy(Manage, policy => policy.{{ requirements | array.join "." }});
    }
}
