using {{ namespace }}.BuildingBlocks.Modules;
using Microsoft.AspNetCore.Authorization;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Api;

/// <summary>The module's authorization policies, each named <c>{{ module.name }}.&lt;permission&gt;</c>; its endpoints name them.</summary>
public sealed class {{ module.namespace }}Policies : IModulePolicies
{
    public const string Manage = "{{ module.name }}.manage";

    public void AddPolicies(AuthorizationBuilder policies)
    {
        {{ not_null "policies" }}

        policies.AddPolicy(Manage, policy => policy.RequireRole("manager"));
    }
}
