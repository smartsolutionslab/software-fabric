using {{ namespace }}.BuildingBlocks.Api;
using {{ namespace }}.Modules.{{ module.namespace }}.Application;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Routing;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Api.Endpoints;

/// <summary>
/// 200 when the caller holds the policy {{ module.name }}.manage, 403 when not: the frontend can ask before it offers to
/// manage {{ module.name }}. It is also the sample of an endpoint naming one of its module's policies.
/// </summary>
public sealed class CanManage : IEndpoint
{
    public void Map(IEndpointRouteBuilder endpoints) =>
        endpoints.MapGet("/permissions/manage", () => TypedResults.Ok())
            .RequireAuthorization({{ module.namespace }}PolicyNames.Manage);
}
