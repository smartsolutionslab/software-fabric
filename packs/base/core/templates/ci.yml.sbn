name: ci

on:
  push:
    branches: [main]
  pull_request:

jobs:
  backend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          global-json-file: global.json
      - run: dotnet build build.proj -c Release
{{ slots["ci.backend-steps"] }}

  frontend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{{ slots["ci.frontend-steps"] }}
