<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
{{ slots["dotnet.build-properties"] }}
  </PropertyGroup>

  <!-- One type per file, named after the type: SA1402 and SA1649, configured in stylecop.json and .editorconfig. -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!-- The time comes from TimeProvider, never DateTime.Now and friends (RS0030); the AppHost composes processes and is exempt. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'AppHost'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build/time/BannedSymbols.txt" />
  </ItemGroup>

  <!-- Every Guid is a time-ordered Guid v7, never Guid.NewGuid (RS0030), tests included; the AppHost creates none and is exempt. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'AppHost'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build/ids/BannedSymbols.txt" />
  </ItemGroup>

  <!-- src/Kernel is available everywhere but the AppHost, which composes processes and needs none of it. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Kernel' And '$(MSBuildProjectName)' != 'AppHost'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Kernel/Kernel.csproj" />
    <Using Include="{{ namespace }}.Kernel" />
  </ItemGroup>

{{ slots["dotnet.build-items"] }}
</Project>
