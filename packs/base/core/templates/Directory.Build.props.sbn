<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
{{ slots["dotnet.build-properties"] }}
  </PropertyGroup>

  <!-- One type per file, named after the type: SA1402 and SA1649, configured in stylecop.json and .editorconfig. -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'AppHost'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- src/Kernel is available everywhere but the AppHost, which composes processes and needs none of it. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Kernel' And '$(MSBuildProjectName)' != 'AppHost'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Kernel/Kernel.csproj" />
    <Using Include="{{ namespace }}.Kernel" />
  </ItemGroup>

{{ slots["dotnet.build-items"] }}
</Project>
