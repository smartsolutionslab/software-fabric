# Dependabot keeps every package ecosystem this project has current (docs/adr). Minor and patch updates come
# grouped in one pull request per ecosystem; a major update comes on its own, since it may need code changes.
# Commits are chore(deps), so the project's commit check accepts them.
version: 2
updates:
  - package-ecosystem: nuget
    directory: /
    schedule:
      interval: weekly
    commit-message:
      prefix: chore(deps)
    groups:
      nuget-minor-and-patch:
        update-types: [minor, patch]

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    commit-message:
      prefix: chore(deps)
    groups:
      actions-minor-and-patch:
        update-types: [minor, patch]
{{ if slots["dependabot.updates"] != "" }}

{{ slots["dependabot.updates"] }}
{{ end }}
