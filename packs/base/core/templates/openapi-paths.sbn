{{~ if object.has_key(project, "backend.authorization") && array.size(project["backend.authorization"]) > 0 ~}}
{{~
  # The host maps modules in the order of their namespaces (ModuleDiscovery).
  probes = []
  for chosen in modules | array.sort "namespace"
    capture probe
~}}
    "/{{ chosen.name }}/permissions/manage": {
      "get": {
        "tags": [
          "Host"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PermissionDto"
                }
              }
            }
          }
        }
      }
    }
{{~
    end
    probes = probes | array.add (probe | string.rstrip)
  end
~}}
{{ probes | array.join ",\n" }}{{ end }}