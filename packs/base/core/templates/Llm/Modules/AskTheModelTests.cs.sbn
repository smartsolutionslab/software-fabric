using {{ namespace }}.Tests.Fakes;

namespace {{ namespace }}.Modules.{{ module.namespace }}.Tests.Queries;

public class AskTheModelTests
{
    {{ test_attribute }}
    public async Task The_answer_is_the_text_the_model_gave_to_the_question_it_was_asked()
    {
        using var model = new FakeChatClient("Paid on 3 March.");
        var handler = new AskTheModelHandler(model);

        var result = await handler.HandleAsync(new AskTheModel("When was invoice 7 paid?"), {{ test_cancellation_token }});

        {{ `result.IsSuccess` | should_be_true }};
        {{ `result.Value` | should_be `"Paid on 3 March."` }};
        {{ (((`model.Requests` | should_have_single_item) | should_have_single_item) + `.Text`) | should_be `"When was invoice 7 paid?"` }};
    }
}
