{%{name: red-first

on:
  pull_request:
    types: [opened, edited, synchronize, reopened]

# One run per workflow and ref; a newer push or body edit is checked against the latest body and diff, so the run
# before it is cancelled.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  failing-tests-quoted:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      - name: Source changes quote the tests they made fail first
        # A dependency update by Dependabot (its author dependabot[bot], manifests and lockfiles only) quotes no failing
        # test; the base branch's dependency-update.sh decides it, the pull request's copy only while the base has none.
        env:
          BODY: ${{ github.event.pull_request.body }}
          BASE: ${{ github.event.pull_request.base.sha }}
          AUTHOR: ${{ github.event.pull_request.user.login }}
        run: |
          exemption=.github/scripts/board/dependency-update.sh
          git show "$BASE:$exemption" > "$RUNNER_TEMP/dependency-update.sh" 2>/dev/null || cp "$exemption" "$RUNNER_TEMP/dependency-update.sh"
          if note="$(bash "$RUNNER_TEMP/dependency-update.sh" "$AUTHOR" "$BASE" HEAD)"; then
            echo "::notice title=red-first::$note"
            exit 0
          fi
          printf '%s' "$BODY" > "$RUNNER_TEMP/body.md"
          git diff --name-only "$BASE"...HEAD > "$RUNNER_TEMP/changed.txt"
          bash .github/scripts/check-red-first.sh "$RUNNER_TEMP/body.md" "$RUNNER_TEMP/changed.txt"
}%}