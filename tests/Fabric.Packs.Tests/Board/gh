#!/usr/bin/env bash
# A stand-in for the GitHub CLI holding a repository's issues, branches, pull requests and board in $GH_FAKE_STATE.
# It answers exactly the calls the board scripts make; anything else fails loudly.
set -euo pipefail

state="$GH_FAKE_STATE"
echo "gh $*" >> "$state/log"

# Flags as an associative array; repeated flags (--label) joined by newlines; the rest positional.
declare -A flag=()
positional=()
while [ $# -gt 0 ]; do
  case "$1" in
    --*)
      name="${1#--}"
      if [ $# -gt 1 ] && [[ "$2" != --* ]] && [ "$name" != clear ]; then
        flag[$name]="${flag[$name]:+${flag[$name]}$'\n'}$2"
        shift 2
      else
        flag[$name]=1
        shift
      fi
      ;;
    -X) flag[method]="$2"; shift 2 ;;
    -f) flag["f:${2%%=*}"]="${2#*=}"; shift 2 ;;
    *) positional+=("$1"); shift ;;
  esac
done

issues="$state/issues.json"
now_iso="$(date -u -d "@${BOARD_NOW:-$(date -u +%s)}" +%Y-%m-%dT%H:%M:%SZ)"

update_issue() {
  jq --argjson number "$1" "map(if .number == \$number then $2 else . end)" "$issues" > "$issues.tmp"
  mv "$issues.tmp" "$issues"
}

case "${positional[0]} ${positional[1]:-}" in
  "api repos/"*)
    path="${positional[1]#repos/*/*/}"
    method="${flag[method]:-GET}"
    case "$method $path" in
      "GET repos/"*) echo '{"default_branch":"main"}' ;;
      "GET git/ref/heads/main") echo '{"object":{"sha":"main-sha"}}' ;;
      "GET git/matching-refs/heads/"*)
        prefix="${path#git/matching-refs/heads/}"
        (cd "$state/refs" && find . -type f | sed 's#^\./##' | sort) | while read -r branch; do
          [[ "$branch" == "$prefix"* ]] && jq -n --arg ref "refs/heads/$branch" --arg sha "$(cat "$state/refs/$branch")" '{ref: $ref, object: {sha: $sha}}'
        done | jq -s .
        ;;
      # Like Claude Code's cloud sessions: branch writes through the API are refused; agents push with git.
      "POST git/refs" | "POST branches/"* | "PATCH git/refs/"* | "DELETE git/refs/"*)
        echo '{"message":"Write access to this GitHub API path is not permitted through this proxy."}' >&2
        exit 1
        ;;
      "GET commits/"*) jq -n --arg date "$(cat "$state/commits/${path#commits/}" 2>/dev/null || echo 2000-01-01T00:00:00Z)" '{commit: {committer: {date: $date}}}' ;;
      "GET issues/"*"/comments") n="${path#issues/}"; cat "$state/comments/${n%/comments}.json" 2>/dev/null || echo '[]' ;;
      "GET issues?"*)
        query="${path#issues?}"
        param() { tr '&' '\n' <<< "$query" | sed -n "s/^$1=//p" | sed 's/%3A/:/g; s/%2C/,/g'; }
        jq --arg state "$(param state)" --arg labels "$(param labels)" --arg assignee "$(param assignee)" '
          ($labels | split(",") | map(select(. != ""))) as $wanted
          | map(select(.state == $state)
                | select([.labels[].name] as $have | all($wanted[]; . as $w | $have | index($w)))
                | select($assignee == "" or ([.assignees[].login] | index($assignee))))' "$issues"
        ;;
      "GET issues/"*) jq --argjson number "${path#issues/}" '.[] | select(.number == $number)' "$issues" ;;
      "POST issues/"*"/comments")
        n="${path#issues/}"; n="${n%/comments}"; file="$state/comments/$n.json"; mkdir -p "$state/comments"
        [ -e "$file" ] || echo '[]' > "$file"
        jq --arg body "${flag[f:body]}" --arg at "$now_iso" '. + [{body: $body, created_at: $at}]' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
        echo "{}"
        ;;
      "POST issues/"*"/labels") n="${path#issues/}"; key='f:labels[]'; update_issue "${n%/labels}" ".labels += [{name: \"${flag[$key]}\"}]"; echo "[]" ;;
      "DELETE issues/"*"/labels/"*)
        n="${path#issues/}"; name="$(sed 's/%3A/:/g' <<< "${n#*/labels/}")"
        update_issue "${n%%/*}" ".labels |= map(select(.name != \"$name\"))"; echo "[]"
        ;;
      "POST issues/"*"/assignees") n="${path#issues/}"; key='f:assignees[]'; update_issue "${n%/assignees}" ".assignees += [{login: \"${flag[$key]}\"}]"; echo "{}" ;;
      "POST pulls/"*"/reviews")
        payload="$(cat "${flag[input]}")"
        if [ -e "$state/reject-inline" ] && [ "$(jq '.comments // [] | length' <<< "$payload")" -gt 0 ]; then
          echo '{"message":"Unprocessable Entity","errors":["Line could not be resolved"]}' >&2
          exit 1
        fi
        file="$state/reviews.json"
        [ -e "$file" ] || echo '[]' > "$file"
        jq --argjson review "$payload" '. + [$review]' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
        echo '{"id":1}'
        ;;
      "GET pulls?"*)
        head="$(tr '&' '\n' <<< "${path#pulls?}" | sed -n 's/^head=//p' | sed 's/%3A/:/g; s/%2F/\//g; s/^[^:]*://')"
        jq --arg head "$head" 'map(select(.head.ref == $head))' "$state/prs.json" 2>/dev/null || echo '[]'
        ;;
      *) echo "fake gh: no answer for api $method $path" >&2; exit 64 ;;
    esac
    ;;
  # Like Claude Code's cloud sessions: these subcommands need GraphQL, which is refused there.
  "issue "* | "pr "* | "repo "*)
    echo "HTTP 403: GitHub GraphQL is not available from Claude Code sessions; use the REST API (gh api repos/{owner}/{repo}/...)." >&2
    exit 1
    ;;
  "project view") echo '{"id":"PROJECT"}' ;;
  "project field-list")
    echo '{"fields":[{"id":"STATUS","name":"Status","options":[{"id":"Todo","name":"Todo"},{"id":"Claimed","name":"Claimed"},{"id":"In Progress","name":"In Progress"},{"id":"In Review","name":"In Review"},{"id":"Blocked","name":"Blocked"},{"id":"Done","name":"Done"}]},{"id":"EXECUTOR","name":"Executor"}]}'
    ;;
  "project item-list") jq --arg repo "$GITHUB_REPOSITORY" '{items: map({id: "ITEM-\(.number)", content: {url: "https://github.com/\($repo)/issues/\(.number)"}})}' "$issues" ;;
  "project item-edit")
    item="${flag[id]#ITEM-}"; field="${flag[field-id]}"
    value="${flag[single-select-option-id]:-${flag[text]:-}}"
    mkdir -p "$state/board"
    printf '%s' "$value" > "$state/board/$item.$field"
    ;;
  "label create") ;;
  *) echo "fake gh: no answer for $*" >&2; exit 64 ;;
esac
